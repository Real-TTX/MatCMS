@page
@model MatCMS.Cloud.Pages.Admin.Store.IndexModel
@{
    ViewData["Title"] = T["store.title"];
}
<div class="page-head">
    <h1>@T["store.title"]</h1>
</div>


<div class="tabs" role="tablist">
    <button type="button" class="tab active" data-tab="plugins">@T["profiles.tabPlugins"]</button>
    <button type="button" class="tab" data-tab="templates">@T["profiles.tabTemplates"]</button>
    <button type="button" class="tab" data-tab="components">@T["profiles.tabComponents"]</button>
</div>

@* ============ PLUGINS ============ *@
<div class="tab-panel" data-panel="plugins">
    <div data-list data-list-key="store-plugins" class="list-view-table">
        <div class="page-head">
            <h2>@T["profiles.tabPlugins"]</h2>
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
                <partial name="_ViewToggle" />
            </div>
        </div>
        <table class="data" data-list-table>
            <thead>
                <tr><th>@T["common.name"]</th><th>@T["profiles.pluginKey"]</th><th>@T["instances.version"]</th><th>@T["store.usedBy"]</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Plugins.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["store.noPlugins"]' />
                }
                else
                {
                    @foreach (var p in Model.Plugins)
                    {
                        <tr data-search="@(p.Name + " " + p.Key + " " + p.Description)">
                            <td>
                                <a asp-page="Plugin" asp-route-id="@p.Id"><strong>@p.Name</strong></a>
                                <div class="muted">@p.Description</div>
                            </td>
                            <td class="mono">@p.Key</td>
                            <td class="mono">@p.Version</td>
                            <td><span class="badge badge-off">@T["store.profileCount", Model.Uses(Model.PluginUse, p.Id)]</span></td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-sm btn-ghost" asp-page="Plugin" asp-route-id="@p.Id">@T["action.edit"]</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <partial name="_PayloadTiles" model="Model.PluginTiles" />
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        @* Same dialog as a profile's, minus "Aus Global" — this IS the global side. No import for a
           plugin either: its create page is the bundle upload. *@
        <partial name="_AddMenu" model='new AddMenu("store-plugins", Url.Page("Plugin")!, "add.createPlugin")' />
    </div>
</div>

@* ============ TEMPLATES ============ *@
<div class="tab-panel" data-panel="templates" hidden>
    <div data-list data-list-key="store-templates" class="list-view-table">
        <div class="page-head">
            <h2>@T["profiles.tabTemplates"]</h2>
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
                <partial name="_ViewToggle" />
            </div>
        </div>
        <table class="data" data-list-table>
            <thead>
                <tr><th>@T["common.name"]</th><th>@T["profiles.templateColors"]</th><th>@T["profiles.templateFonts"]</th><th>@T["store.usedBy"]</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Templates.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["store.noTemplates"]' />
                }
                else
                {
                    @foreach (var t in Model.Templates)
                    {
                        <tr data-search="@(t.Name + " " + t.Description)">
                            <td>
                                <a asp-page="Template" asp-route-id="@t.Id"><strong>@t.Name</strong></a>
                                <div class="muted">@t.Description</div>
                            </td>
                            <td><span class="token-chip" style="background:@t.AccentColor;color:#fff;border-color:@t.AccentColor;">@t.AccentColor</span></td>
                            <td class="muted">@t.HeadingFont / @t.BodyFont</td>
                            <td><span class="badge badge-off">@T["store.profileCount", Model.Uses(Model.TemplateUse, t.Id)]</span></td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-sm btn-ghost" asp-page="Template" asp-route-id="@t.Id">@T["action.edit"]</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <partial name="_PayloadTiles" model="Model.TemplateTiles" />
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        <partial name="_AddMenu" model='new AddMenu("store-templates", Url.Page("Template")!, "add.createTemplate", null, "import-store-template")' />
    </div>

    @* Posts to the Template page's own Import handler rather than a copy of it here — one parser for
       the store's templates, and it lands the operator on the imported template afterwards. *@
    <div class="card" id="import-store-template" hidden>
        <h2>@T["profiles.templateImport"]</h2>
        <p class="muted">@T["profiles.templateImportHint"]</p>
        <form method="post" asp-page="Template" asp-page-handler="Import">
            <div class="form-field">
                <textarea name="templateJson" rows="6" spellcheck="false" data-code="json" placeholder='{ "Name": "..." }'></textarea>
            </div>
            <div><button type="submit" class="btn btn-ghost">@T["import.btn"]</button></div>
        </form>
    </div>
</div>

@* ============ COMPONENTS ============ *@
<div class="tab-panel" data-panel="components" hidden>
    <div data-list data-list-key="store-components" class="list-view-table">
        <div class="page-head">
            <h2>@T["profiles.tabComponents"]</h2>
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
                <partial name="_ViewToggle" />
            </div>
        </div>
        <table class="data" data-list-table>
            <thead>
                <tr><th>@T["common.name"]</th><th>@T["profiles.componentType"]</th><th>@T["store.usedBy"]</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Components.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["store.noComponents"]' />
                }
                else
                {
                    @foreach (var c in Model.Components)
                    {
                        <tr data-search="@(c.Name + " " + c.Type + " " + c.Description)">
                            <td>
                                <a asp-page="Component" asp-route-id="@c.Id"><strong>@c.Name</strong></a>
                                <div class="muted">@c.Description</div>
                            </td>
                            <td class="mono">@c.Type</td>
                            <td><span class="badge badge-off">@T["store.profileCount", Model.Uses(Model.ComponentUse, c.Id)]</span></td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-sm btn-ghost" asp-page="Component" asp-route-id="@c.Id">@T["action.edit"]</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <partial name="_PayloadTiles" model="Model.ComponentTiles" />
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        <partial name="_AddMenu" model='new AddMenu("store-components", Url.Page("Component")!, "add.createComponent", null, "import-store-component")' />
    </div>

    <div class="card" id="import-store-component" hidden>
        <h2>@T["import.componentTitle"]</h2>
        <p class="muted">@T["import.componentHint"]</p>
        <form method="post" asp-page-handler="ImportComponent">
            <div class="form-field">
                <textarea name="componentJson" rows="6" spellcheck="false" data-code="json" placeholder='{ "Type": "..." }'></textarea>
            </div>
            <div><button type="submit" class="btn btn-ghost">@T["import.btn"]</button></div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_CodeEditorAssets" />
    <partial name="_TabsScript" />
    <partial name="_AddMenuScript" />
}
