@page "{id:int}"
@model MatCMS.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = T["users.edit"] + " " + Model.Current.Username;
}
@* Nur die Überschrift: der Weg zurück steht unten neben dem Speichern-Knopf, wie im Plugin-Editor. *@
<div class="page-head">
    <h1>@T["users.edit"] @Model.Current.Username</h1>
</div>

<div class="card">
    <form method="post" class="form-grid">
        <div class="form-field">
            <label for="Email">@T["users.email"]</label>
            <input id="Email" name="Email" type="email" value="@Model.Email" placeholder="name@example.com" />
            <div class="help">@T["users.emailLogin"]</div>
        </div>
        <div class="form-field">
            <label for="DisplayName">@T["users.displayName"]</label>
            <input id="DisplayName" name="DisplayName" value="@Model.DisplayName" />
        </div>
        <div class="form-field">
            <label for="NewPassword">@T["users.newPassword"]</label>
            <input id="NewPassword" name="NewPassword" type="password" placeholder="@T["users.newPasswordPlaceholder"]" />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">@T["action.save"]</button>
            <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
        </div>
    </form>
</div>

@if (Model.Current.TwoFactorEnabled)
{
    <div class="card">
        <h2>@T["twofactor.title"]</h2>
        <div class="kv">
            <div class="kv-label">@T["twofactor.status"]</div>
            <div class="kv-value"><span class="badge badge-on">@T["twofactor.on"]</span></div>
        </div>
        <p class="help">@T["users.2faResetHint"]</p>
        <form method="post" asp-page-handler="ResetTwoFactor" asp-route-id="@Model.Current.Id"
              onsubmit="return confirm('@T["users.2faResetConfirm"]');">
            <button type="submit" class="btn btn-danger">@T["users.2faReset"]</button>
        </form>
    </div>
}
