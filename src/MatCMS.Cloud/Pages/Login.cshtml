@page "/login"
@model MatCMS.Cloud.Pages.LoginModel
@inject MatCMS.Cloud.Services.CloudContext Cloud
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de" data-app="matcms" data-theme="light" data-density="compact">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* Break out of any frame BEFORE rendering. The cloud login (and the SSO authorize it protects) must
       run first-party: inside a cross-site frame the SameSite=Lax auth/antiforgery cookies are dropped
       and the login POST fails with 400. SSO from the cloud's instance iframe opens in a NEW TAB (the
       instance login button uses target=_blank), so this normally never fires; it only guards an
       unintended embed. No self-reload fallback — that would loop when top-nav is blocked. *@
    <script>
        if (window.top !== window.self) { try { window.top.location.replace(window.location.href); } catch (e) {} }
    </script>
    <title>@T["login.pageTitle"] – @Cloud.CloudName</title>
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/lib/matui/matui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cloud.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin-matui.css" asp-append-version="true" />
    @MatCMS.Shared.Web.Pwa.Head("light", MatCMS.Shared.Web.Pwa.ShortName(Cloud.CloudName), "cloud")
    <link rel="icon" href="@Cloud.FaviconUrl" />
</head>
<body class="login-page login-matui">
    <div class="login-card">
        <img class="login-logo" src="@Cloud.LogoUrl" alt="@Cloud.CloudName" />
        <h1>@T["login.heading"]</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert-error">@Model.Error</div>
        }
        @if (Model.PendingLink is not null)
        {
            <div class="alert alert-info">@T["login.linkIntro"]</div>
        }
        else if (Model.LinkExpired)
        {
            <div class="alert alert-error">@T["login.linkExpired"]</div>
        }
        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div class="form-field">
                <label for="Username">@T["login.username"]</label>
                <input id="Username" name="Username" value="@Model.Username" autofocus required />
            </div>
            <div class="form-field">
                <label for="Password">@T["login.password"]</label>
                <input id="Password" name="Password" type="password" required />
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="RememberMe" value="true" /> @T["login.rememberMe"]
            </label>
            <button type="submit" class="btn btn-block">@T["login.submit"]</button>
        </form>
        @if (Model.PendingLink is not null)
        {
            <form method="post" asp-page-handler="CancelLink">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn btn-ghost btn-block">@T["login.linkCancel"]</button>
            </form>
        }
        else if (Model.IdentityEnabled)
        {
            <a class="btn btn-ghost btn-block" href="@Model.IdentitySignInUrl">@T["login.identity"]</a>
        }
    </div>
</body>
</html>
