@page
@model MatCMS.Cloud.Pages.Admin.Instances.UpdateAllModel
@{
    ViewData["Title"] = "Alle aktualisieren";
}
<div class="page-head">
    <h1>Alle aktualisieren</h1>
    <div class="list-toolbar">
        <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
    </div>
</div>

@if (Model.RunId is null)
{
    @* Auswahl: welche lokalen Instanzen haben ein Update? *@
    <div class="card">
        @if (Model.Candidates.Count == 0)
        {
            <p class="muted">Es gibt aktuell keine lokalen Instanzen mit verfügbarem Update. (Entfernte Instanzen aktualisieren sich selbst — die Cloud kann sie nicht anfassen.)</p>
        }
        else
        {
            <p class="help">Diese lokalen Instanzen werden nacheinander aktualisiert — jede mit Rollback bei Fehler. Neueste Version: <span class="mono">@Model.LatestVersion</span></p>
            <table class="data">
                <thead><tr><th>Instanz</th><th>Von</th><th></th><th>Auf</th></tr></thead>
                <tbody>
                    @foreach (var i in Model.Candidates)
                    {
                        <tr>
                            <td><strong>@i.Name</strong></td>
                            <td class="muted mono">@(i.Version ?? "?")</td>
                            <td class="muted">→</td>
                            <td class="mono">@Model.LatestVersion</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="list-actions">
                <form method="post" asp-page-handler="Start">
                    <button type="submit" class="btn"><i class="ti ti-refresh" aria-hidden="true"></i> @Model.Candidates.Count Instanz(en) jetzt aktualisieren</button>
                </form>
            </div>
        }
    </div>
}
else
{
    @* Fortschritt: Balken oben, darunter die Live-Tabelle mit Status-Icon je Instanz. Eine Fehler-/
       Warnungs-Meldung erscheint als umrahmte „Attention"-Zeile unter der Zeile; bei Erfolg steckt die
       Meldung im Tooltip des Icons. Per Polling gefüllt. *@
    <div class="card" data-run="@Model.RunId">
        @* Progressbar oben, prominent und über die volle Breite. *@
        <div class="ua-progress">
            <div class="ua-progress-head">
                <span id="ua-state" class="badge badge-new">läuft…</span>
                <span class="ua-count"><span id="ua-done">0</span>&nbsp;/&nbsp;<span id="ua-total">@("?")</span></span>
            </div>
            <div class="quota-bar ua-bar"><span id="ua-bar" style="width:0%"></span></div>
        </div>

        <table class="data ua-table" style="margin-top:16px;">
            <thead><tr><th>Instanz</th><th>Von</th><th></th><th>Auf</th><th class="ua-th-status">Status</th></tr></thead>
            <tbody id="ua-rows">
                <tr><td colspan="99" class="muted"><em>Wird gestartet…</em></td></tr>
            </tbody>
        </table>
        <div class="list-actions">
            <a class="btn btn-ghost" asp-page="Index" id="ua-back" hidden>@T["action.back"]</a>
        </div>
    </div>

    <script>
            (function () {
                var run = document.querySelector('[data-run]').getAttribute('data-run');
                var esc = function (s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; };
                // icon, colour class, label, and whether an error/warning attention row is shown.
                var STAT = {
                    pending:  { icon: 'ti-clock',                 cls: 'uas-pending',  label: 'wartet',         attn: false },
                    updating: { icon: 'ti-loader-2',              cls: 'uas-updating', label: 'aktualisiert…',  attn: false },
                    done:     { icon: 'ti-circle-check-filled',   cls: 'uas-done',     label: 'fertig',         attn: false },
                    failed:   { icon: 'ti-alert-circle-filled',   cls: 'uas-failed',   label: 'Fehler',         attn: true },
                    skipped:  { icon: 'ti-alert-triangle-filled', cls: 'uas-warn',     label: 'übersprungen',   attn: true }
                };
                function render(d) {
                    document.getElementById('ua-total').textContent = d.total;
                    document.getElementById('ua-done').textContent = d.completed;
                    var pct = d.total ? Math.round(d.completed * 100 / d.total) : 0;
                    document.getElementById('ua-bar').style.width = pct + '%';

                    var html = '';
                    (d.items || []).forEach(function (i) {
                        var s = STAT[i.status] || { icon: 'ti-point', cls: 'uas-pending', label: i.status, attn: false };
                        var msg = i.message || '';
                        // Success (and any non-error state) with a message: it lives in the icon's tooltip.
                        var title = (!s.attn && msg) ? msg : s.label;
                        var spin = i.status === 'updating' ? ' ua-spin' : '';
                        html += '<tr class="ua-row"><td><strong>' + esc(i.name) + '</strong></td>' +
                            '<td class="muted mono">' + esc(i.from || '?') + '</td><td class="muted">→</td>' +
                            '<td class="mono">' + esc(i.to) + '</td>' +
                            '<td class="ua-status"><i class="ti ' + s.icon + ' ' + s.cls + spin + '" title="' + esc(title) + '" aria-label="' + esc(s.label) + '"></i></td></tr>';
                        // Error / warning: a bordered attention line spanning the row.
                        if (s.attn && msg) {
                            html += '<tr class="ua-attn-row"><td colspan="99">' +
                                '<div class="ua-attn ua-attn-' + (i.status === 'failed' ? 'err' : 'warn') + '">' +
                                '<i class="ti ' + (i.status === 'failed' ? 'ti-alert-circle' : 'ti-alert-triangle') + '" aria-hidden="true"></i>' +
                                '<span>' + esc(msg) + '</span></div></td></tr>';
                        }
                    });
                    if (html) document.getElementById('ua-rows').innerHTML = html;

                    if (d.done) {
                        var st = document.getElementById('ua-state');
                        var failed = (d.items || []).some(function (i) { return i.status === 'failed'; });
                        st.className = 'badge ' + (failed ? 'badge-err' : 'badge-on');
                        st.textContent = failed ? 'abgeschlossen (mit Fehlern)' : 'abgeschlossen';
                        document.getElementById('ua-back').hidden = false;
                    }
                }
                function poll() {
                    fetch('?handler=Status&run=' + encodeURIComponent(run), { headers: { 'X-Requested-With': 'fetch' } })
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            if (!d.found) { return; }
                            render(d);
                            if (!d.done) setTimeout(poll, 1500);
                        })
                        .catch(function () { setTimeout(poll, 2000); });
                }
                poll();
            })();
    </script>
}
