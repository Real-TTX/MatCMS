@page "{id:int}"
@model MatCMS.Pages.Admin.Plugins.EditModel
@{
    ViewData["Title"] = T["plugins.edit"];
}
<div class="page-head">
    <h1>@T["plugins.edit"]</h1>
    <div class="head-actions">
        <a class="btn btn-sm btn-ghost" asp-page-handler="Export" asp-route-id="@Model.Current.Id">Exportieren (ZIP)</a>
        <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
    </div>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.RunError))
    {
        <div class="alert alert-error"><strong>@T["plugins.runError"]:</strong> <span class="mono">@Model.RunError</span></div>
    }
    <form method="post" class="form-grid" id="plugin-form">
        <div class="form-row">
            <div class="form-field">
                <label for="Name">@T["plugins.name"]</label>
                <input id="Name" name="Name" value="@Model.Name" required />
            </div>
            <div class="form-field">
                <label for="Description">@T["plugins.description"]</label>
                <input id="Description" name="Description" value="@Model.Description" />
            </div>
            <div class="form-field" style="max-width:130px;">
                <label for="Version">Version</label>
                <input id="Version" name="Version" value="@Model.Version" placeholder="z.B. 1.0" spellcheck="false" />
                @if (!string.IsNullOrWhiteSpace(Model.Current.DataVersion))
                {
                    <div class="help">Daten migriert bis: @Model.Current.DataVersion</div>
                }
            </div>
        </div>
        <label class="check">
            <input type="checkbox" name="Enabled" value="true" @(Model.Enabled ? "checked" : "") /> @T["plugins.enabledLabel"]
        </label>
        <div class="form-field">
            <label for="Code">@T["plugins.code"]</label>
            <textarea id="Code" name="Code" rows="16" class="code" spellcheck="false">@Model.Code</textarea>
            <div class="help">@Html.Raw(T["plugins.codeHelp"])</div>
        </div>

        @* Weitere Dateien des Plugins. Vorerst als JSON-Karte Pfad → Inhalt — der Ordnerbaum baut
           darauf auf. Schon jetzt nützlich, weil sich der Code damit aufteilen lässt, statt in einem
           einzigen Feld zu wachsen. *@
        <div class="form-field">
            <label for="FilesJson">@T["plugins.files"]</label>
            <textarea id="FilesJson" name="FilesJson" rows="8" class="code" data-code="json" spellcheck="false">@Model.FilesJson</textarea>
            <div class="help">@Html.Raw(T["plugins.filesHelp"])</div>
        </div>

        <h3 class="form-section">Konfiguration</h3>
        <div class="help">Schlüssel/Wert-Paare, die das Plugin per <code>Config("schlüssel")</code> liest — getrennt vom Code, damit man ein Plugin einstellen kann, ohne es zu bearbeiten.</div>
        <div id="cfg-rows" data-config="@Model.ConfigJson"></div>
        <div style="margin-top:8px;"><button type="button" class="btn btn-sm btn-ghost" id="cfg-add">＋ Feld</button></div>
        <input type="hidden" name="ConfigJson" id="ConfigJson" />

    </form>
</div>

@* Save and delete on one line, positive before negative. The save button sits outside its form and
   reaches it by id, because the delete is a form of its own and the two cannot nest. *@
<div class="form-actions">
    <button type="submit" class="btn" form="plugin-form">@T["action.save"]</button>
    <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@Model.Current.Id"
          onsubmit="return confirm('@T["plugins.confirmDelete"]');">
        <button type="submit" class="btn btn-danger">@T["plugins.deletePlugin"]</button>
    </form>
</div>

<div class="card">
    <h2>Dateien dieses Plugins</h2>
    <p class="help">
        Eigener Asset-Ordner: <code>/plugin-assets/@Model.Current.Key/</code>. Im Plugin-Code einbinden mit
        <code>IncludeScript("datei.js")</code>, <code>IncludeStyle("datei.css")</code> oder per URL
        <code>AssetUrl("datei")</code>. So bleibt jedes Plugin ein eigenständiges Bündel.
    </p>
    <form method="post" asp-page-handler="UploadAsset" asp-route-id="@Model.Current.Id" enctype="multipart/form-data" class="asset-upload">
        <input type="file" name="file" required
               accept=".js,.mjs,.css,.json,.map,.woff,.woff2,.ttf,.eot,.png,.jpg,.jpeg,.gif,.webp" />
        <button type="submit" class="btn btn-sm">Hochladen</button>
    </form>
    @if (Model.Assets.Count == 0)
    {
        <p class="muted">Noch keine Dateien in diesem Plugin.</p>
    }
    else
    {
        <table class="asset-table">
            <thead>
                <tr><th>Datei</th><th>Typ</th><th>Größe</th><th>URL</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Assets)
                {
                    var url = "/plugin-assets/" + Model.Current.Key + "/" + a.Name;
                    <tr>
                        <td class="a-name">@a.Name</td>
                        <td><span class="badge">@a.Kind</span></td>
                        <td>@(a.Size < 1024 ? a.Size + " B" : (a.Size / 1024) + " KB")</td>
                        <td><input class="a-url" value="@url" readonly onclick="this.select()" /></td>
                        <td>
                            <form class="inline-form" method="post" asp-page-handler="DeleteAsset" asp-route-id="@Model.Current.Id" asp-route-name="@a.Name"
                                  onsubmit="return confirm('Datei „@a.Name“ wirklich löschen?');">
                                <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="card">
    <h2>@T["plugins.log"]</h2>
    @if (Model.Log.Count == 0)
    {
        <p class="muted">@T["plugins.logEmpty"]</p>
    }
    else
    {
        <pre class="plugin-log">@string.Join("\n", Model.Log.Reverse())</pre>
    }
</div>

@section Scripts {
    <script>
        // Plugin configuration: key/value rows -> hidden ConfigJson on submit of the main form.
        (function () {
            var rows = document.getElementById('cfg-rows');
            var addBtn = document.getElementById('cfg-add');
            var hidden = document.getElementById('ConfigJson');
            var form = hidden ? hidden.closest('form') : null;
            if (!rows || !form || !addBtn) return;
            function addRow(k, v) {
                var row = document.createElement('div'); row.className = 'field-row';
                var key = document.createElement('input'); key.type = 'text'; key.placeholder = 'Schlüssel'; key.className = 'cfg-key fr-label'; key.value = k || '';
                var val = document.createElement('input'); val.type = 'text'; val.placeholder = 'Wert'; val.className = 'cfg-val fr-label'; val.value = v || '';
                var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'btn btn-sm btn-danger btn-icon'; rm.title = '@T["action.delete"]';
                rm.innerHTML = '<i class="ti ti-trash" aria-hidden="true"></i>';
                rm.addEventListener('click', function () { row.remove(); });
                row.appendChild(key); row.appendChild(val); row.appendChild(rm);
                rows.appendChild(row);
            }
            var data = {};
            try { data = JSON.parse(rows.getAttribute('data-config') || '{}') || {}; } catch (e) { }
            Object.keys(data).forEach(function (k) { addRow(k, data[k]); });
            addBtn.addEventListener('click', function () { addRow('', ''); });
            form.addEventListener('submit', function () {
                var o = {};
                Array.prototype.slice.call(rows.querySelectorAll('.field-row')).forEach(function (r) {
                    var k = r.querySelector('.cfg-key').value.trim();
                    if (k) o[k] = r.querySelector('.cfg-val').value;
                });
                hidden.value = JSON.stringify(o);
            });
        })();
    </script>
}
