@page "{id:int}"
@model MatCMS.Pages.Admin.MailTemplates.EditModel
@{
    ViewData["Title"] = Model.Current.Name;
}
@* Nur die Überschrift: alle Aktionen dieser Seite stehen unten in EINER Reihe — dieselbe Ordnung
   wie im Plugin-Editor. *@
<div class="page-head">
    <h1>@Model.Current.Name</h1>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <p class="muted">@Model.Current.Description</p>

    <form method="post" class="form-grid" id="mailtpl-form" asp-route-id="@Model.Current.Id">
        <label class="checkbox-row">
            <input type="checkbox" name="Enabled" value="true" checked="@(Model.Enabled ? "checked" : null)" />
            @T["mailtpl.enabledLabel"]
        </label>
        <div class="help">@T["mailtpl.enabledHint"]</div>

        <label class="checkbox-row">
            <input type="checkbox" name="IsHtml" value="true" id="IsHtml" checked="@(Model.IsHtml ? "checked" : null)" />
            @T["mailtpl.isHtml"]
        </label>
        <div class="help">@T["mailtpl.isHtmlHint"]</div>

        <div class="form-field">
            <label for="Subject">@T["mailtpl.subject"]</label>
            <input id="Subject" name="Subject" value="@Model.Subject" required />
        </div>
        <div class="form-field">
            <label for="Body">@T["mailtpl.body"]</label>
            <textarea id="Body" name="Body" rows="18" spellcheck="false" data-code="html">@Model.Body</textarea>
        </div>

        @if (Model.Definition is { Placeholders.Count: > 0 })
        {
            @* The list comes from the code that fills them in — the only honest source for what an
               operator is allowed to write. Clicking one inserts it at the cursor. *@
            <div class="form-field">
                <label>@T["mailtpl.placeholders"]</label>
                <div class="code-toolbar">
                    @foreach (var p in Model.Definition.Placeholders)
                    {
                        <button type="button" class="token-chip" data-insert="{{@p.Token}}" data-target="Body" title="@p.Description">{{@p.Token}}</button>
                    }
                </div>
                <div class="help">@T["mailtpl.placeholdersHint"]</div>
            </div>
        }
        else
        {
            <div class="help">@T["mailtpl.unknownKey"] <span class="mono">@Model.Current.Key</span></div>
        }

        @if (Model.Definition is { Loops.Count: > 0 })
        {
            @* A block is inserted whole, with its inner placeholders already in it: the point of a
               loop is the markup AROUND the values, and starting from an empty {{#fields}}{{/fields}}
               means writing that markup blind. *@
            <div class="form-field">
                <label>@T["mailtpl.loops"]</label>
                <div class="code-toolbar">
                    @foreach (var loop in Model.Definition.Loops)
                    {
                        var inner = string.Join(" ", loop.Fields.Select(fl => "{{" + fl.Token + "}}"));
                        var block = "\n{{#" + loop.Name + "}}\n  " + inner + "\n{{/" + loop.Name + "}}\n";
                        <button type="button" class="token-chip" data-insert="@block" data-target="Body" title="@loop.Description">{{#@loop.Name}}…{{/@loop.Name}}</button>
                    }
                </div>
                <div class="help">@T["mailtpl.loopsHint"]</div>
                @foreach (var loop in Model.Definition.Loops)
                {
                    <div class="help">
                        <span class="mono">{{#@loop.Name}}</span> — @loop.Description:
                        @string.Join(", ", loop.Fields.Select(fl => "{{" + fl.Token + "}} " + fl.Description))
                    </div>
                }
            </div>
        }
    </form>
</div>

@* The preview renders SERVER-SIDE, through the same code that builds the real mail — a JavaScript
   copy would be live as you type and would drift, and a preview that lies about what will be sent is
   worse than none. It takes what is in the boxes, not what is saved, so it answers "what am I
   writing". The form targets the frame, so no page reload and no route of its own. *@
<div class="card">
    <div class="menu-card-head">
        <h2>@T["mailtpl.preview"]</h2>
        <button type="button" class="btn btn-sm btn-ghost" id="preview-refresh">@T["mailtpl.previewRefresh"]</button>
    </div>
    <p class="muted">@T["mailtpl.previewHint"]</p>
    <form method="post" asp-page-handler="Preview" asp-route-id="@Model.Current.Id"
          target="mail-preview" id="preview-form">
        <input type="hidden" name="body" id="preview-body" />
        <input type="hidden" name="isHtml" id="preview-ishtml" value="false" />
    </form>
    @* Abgeschottet: eine Mail besteht aus Verweisen, und ohne sandbox trug ein Klick darauf die
       fremde Seite in die Vorschau (oder, mit target="_top", die Editorseite fort). Der <base>
       im gelieferten Dokument macht daraus einen Versuch, ein Fenster zu öffnen — den der
       Sandkasten verbietet. Das Formular daneben darf den Rahmen weiterhin beladen: sandbox
       beschränkt den INHALT, nicht den, der ihn hineinlädt. *@
    <iframe name="mail-preview" id="mail-preview" class="mail-preview" sandbox title="@T["mailtpl.preview"]"></iframe>
</div>

<div class="card">
    <h2>@T["mailtpl.test"]</h2>
    <p class="muted">@T["mailtpl.testHint"]</p>
    <form method="post" asp-page-handler="Test" asp-route-id="@Model.Current.Id">
        <div class="form-field">
            <label for="testTo">@T["mailtpl.testTo"]</label>
            <input id="testTo" name="testTo" type="email" placeholder="test@@beispiel.de" spellcheck="false" />
        </div>
        <div class="form-actions"><button type="submit" class="btn btn-ghost">@T["mailtpl.testSend"]</button></div>
    </form>
</div>

@* Speichern, dann Zurück — dieselbe Ordnung und dieselben Klassen wie in Plugins/Edit. Der
   Speichern-Knopf erreicht sein Formular über form="mailtpl-form", weil die Testmail ein eigenes
   Formular ist und zwei Formulare nicht ineinander stehen dürfen. *@
<div class="form-actions">
    <button type="submit" class="btn" form="mailtpl-form">@T["action.save"]</button>
    <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
</div>

@section Scripts {
    @* The same CodeMirror bundle and upgrader the cloud uses — it lives in the shared library now, so
       a data-code field behaves identically in both admins. It also drives the token chips, which is
       the only thing that works once the textarea has been upgraded. *@
    <partial name="_CodeEditorAssets" />
    <script>
        (function () {
            var htmlBox = document.getElementById('IsHtml');
            var body = document.getElementById('Body');
            if (!body) return;

            // Everything below has to go THROUGH CodeMirror once it has taken the textarea over:
            // the textarea is then hidden and its value only catches up on save().
            function cm() { return body.nextElementSibling && body.nextElementSibling.CodeMirror; }
            function read() { var e = cm(); return e ? e.getValue() : body.value; }
            function write(v) { var e = cm(); if (e) e.setValue(v); else body.value = v; }

            var pForm = document.getElementById('preview-form');
            var pBody = document.getElementById('preview-body');
            var pHtml = document.getElementById('preview-ishtml');
            var refresh = document.getElementById('preview-refresh');
            var timer;

            // The preview form carries a copy of what is in the editor; refreshed on demand, once at
            // the start, and shortly after typing stops — so it keeps up without a request per
            // keystroke.
            function preview() {
                if (!pForm) return;
                pBody.value = read();
                pHtml.value = htmlBox && htmlBox.checked ? 'true' : 'false';
                pForm.submit();
            }
            function previewSoon() { clearTimeout(timer); timer = setTimeout(preview, 700); }

            var starter = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HtmlStarter));
            var original = read();
            if (htmlBox && starter) {
                // Switching to HTML on a body that is still the plain-text default offers the
                // starting point from the declaration — the same loops and placeholders that will
                // actually be filled. Only when nothing has been written yet: overwriting somebody's
                // text because they ticked a box would be unforgivable.
                htmlBox.addEventListener('change', function () {
                    if (!htmlBox.checked) return;
                    var now = read();
                    if (now.trim() !== original.trim()) return;   // touched — leave it alone
                    if (now.indexOf('<') >= 0) return;            // already markup
                    write(starter);
                });
            }

            if (refresh) refresh.addEventListener('click', preview);
            if (htmlBox) htmlBox.addEventListener('change', previewSoon);
            body.addEventListener('input', previewSoon);
            // CodeMirror does not fire input on the textarea, so hook the editor once it exists.
            setTimeout(function () {
                var e = cm();
                if (e) e.on('change', previewSoon);
                preview();
            }, 0);
        })();
    </script>
}
