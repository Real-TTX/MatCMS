@page "{id:int?}"
@model MatCMS.Cloud.Pages.Admin.Store.PluginModel
@{
    ViewData["Title"] = Model.IsNew ? T["profiles.addPlugin"] : Model.Item.Name;
}
@* Heading only: every action on this page sits in ONE row at the bottom, in the CMS's order
   (save, download, back, destructive last). *@
<div class="page-head">
    <h1>
        @(Model.IsNew ? T["profiles.addPlugin"] : Model.Item.Name)
        <span class="muted" style="font-size:14px;font-weight:400;"> — @T["store.title"]</span>
    </h1>
</div>

@if (Model.Item.Origin == MatCMS.Cloud.Services.MatcmsStoreService.Origin)
{
    <div class="alert alert-info">@T["store.matcms.fromStore", Model.Item.SignatureKeyId]</div>
}
@if (!Model.IsNew && Model.UsedBy.Count > 0)
{
    @* An edit here reaches every profile that selected this entry — say so before it is saved, not
       after. *@
    <div class="alert alert-info">
        @T["store.usedByWarning"] <strong>@string.Join(", ", Model.UsedBy)</strong>
    </div>
}

@* A plugin is created by uploading a bundle, not by typing one.
   OHNE asp-route-id, wie auf der Profilseite: die Kennung steht ohnehin schon in der Adresse und
   wird beim Erzeugen der Ziel-URL von dort übernommen (/Admin/Store/Plugin/5?handler=Upload).
   WARUM NICHT MEHR MITGEGEBEN: beim NEUEN Plugin war der Wert null, und ein leerer Wert erfüllt die
   Routenbedingung {id:int?} nicht — die URL ließ sich nicht bilden, das Formular stand mit
   action="" da und schickte an die AKTUELLE Adresse, also OHNE ?handler=Upload. Es lief damit
   OnPostAsync(int id) mit id=0, das fand keinen Datensatz und leitete wortlos zur Store-Liste
   zurück: ein Plugin ließ sich im Store gar nicht anlegen. Am laufenden System nachgestellt. *@
<form method="post" asp-page-handler="Upload" enctype="multipart/form-data" id="upload-form">
    <div class="card">
        <h2>@(Model.IsNew ? T["profiles.addPlugin"] : T["profiles.pluginReplace"])</h2>
        <div class="form-field">
            <label for="bundle">@T["profiles.pluginUpload"]</label>
            <input id="bundle" name="bundle" type="file" accept=".zip" required />
            <div class="help">@T["profiles.pluginUploadHint"]</div>
        </div>
        <div><button type="submit" class="btn@(Model.IsNew ? "" : " btn-ghost")">@T["profiles.pluginUploadBtn"]</button></div>
    </div>
</form>

@if (!Model.IsNew)
{
    @* Das BEARBEITEN-Formular, mit eigener Kennung: der Speichern-Knopf unten steht außerhalb (das
       Löschen ist ein eigenes Formular, und zwei Formulare dürfen nicht ineinander stehen) und
       findet es über form="plugin-form" — genau wie in Plugins/Edit des CMS.
       WIE ES VORHER WAR: dieses Formular hatte gar keine Kennung, "editor-form" hing am Upload
       darüber, und der Speichern-Knopf zeigte damit auf den Upload. Name, Version und Code waren in
       dem abgeschickten Formular gar nicht enthalten und ließen sich hier nie speichern. *@
    <form method="post" asp-route-id="@Model.Item.Id" id="plugin-form">
        <div class="card">
            <h2>@T["profiles.pluginEdit"]</h2>
            <p class="muted">@T["profiles.pluginEditHint"]</p>
            <div class="form-grid">
                <div class="form-row">
                    <div class="form-field">
                        <label for="pname">@T["common.name"]</label>
                        <input id="pname" name="name" value="@Model.Item.Name" required />
                    </div>
                    <div class="form-field">
                        <label for="pversion">@T["instances.version"]</label>
                        <input id="pversion" name="version" value="@Model.Item.Version" placeholder="1.0" spellcheck="false" />
                        <div class="help">@T["profiles.pluginVersionHint"]</div>
                    </div>
                </div>
            </div>
            <div class="form-field">
                <label for="pdesc">@T["profiles.description"]</label>
                <input id="pdesc" name="description" value="@Model.Item.Description" />
            </div>
            <div class="kv">
                <div class="kv-label">@T["profiles.pluginKey"]</div>
                <div class="kv-value mono">@Model.Item.Key</div>
            </div>
            @if (Model.Files.Count > 0)
            {
                <div class="kv">
                    <div class="kv-label">@T["profiles.pluginFiles"]</div>
                    <div class="kv-value">
                        <div class="code-toolbar">
                            @foreach (var file in Model.Files)
                            {
                                <span class="token-chip">@file</span>
                            }
                        </div>
                        <div class="help">@T["profiles.pluginFilesHint"]</div>
                    </div>
                </div>
            }
            @if (Model.Assets.Count > 0)
            {
                <div class="kv">
                    <div class="kv-label">@T["profiles.pluginAssets"]</div>
                    <div class="kv-value">
                        <div class="code-toolbar">
                            @foreach (var asset in Model.Assets)
                            {
                                <span class="token-chip">@asset</span>
                            }
                        </div>
                        <div class="help">@T["profiles.pluginAssetsHint"]</div>
                    </div>
                </div>
            }
        </div>

        @if (Model.Native is { } native)
        {
            <div class="card">
                <h2>@T["profiles.pluginNative"] <span class="badge badge-new">@T["profiles.pluginNativeBadge"]</span></h2>
                <p class="muted">@T["profiles.pluginNativeHint"]</p>
                <div class="kv"><div class="kv-label">@T["profiles.pluginNativeEntry"]</div><div class="kv-value mono">@native.Entry</div></div>
                <div class="kv"><div class="kv-label">API</div><div class="kv-value mono">@native.Api</div></div>
                <div class="kv"><div class="kv-label">SHA-256</div><div class="kv-value mono" style="word-break:break-all;">@native.Sha256</div></div>
                <div class="kv">
                    <div class="kv-label">@T["profiles.pluginFiles"]</div>
                    <div class="kv-value"><div class="code-toolbar">@foreach (var f in native.Files) { <span class="token-chip" title="@f.Size B">src/@f.Path</span> }</div></div>
                </div>
            </div>
        }
        else
        {
        <div class="card">
            <h2>@T["profiles.pluginCode"]</h2>
            <div class="form-field">
                <textarea id="pcode" name="code" rows="24" spellcheck="false" data-code="js">@Model.Code</textarea>
                <div class="help">@T["profiles.pluginCodeHint"]</div>
            </div>
        </div>
        }

</form>

    @* Who publishes the plugin — a property of the store entry, saved on its own like the pictures. *@
    <div class="card" id="herausgeber">
        <h2>@T["store.publisher"]</h2>
        <p class="muted">@T["store.publisherHint"]</p>
        <form method="post" asp-page-handler="Publisher" asp-route-id="@Model.Item.Id">
            <div class="form-row">
                <div class="form-field">
                    <label for="publisher">@T["store.publisherName"]</label>
                    <input id="publisher" name="publisher" maxlength="@MatCMS.Cloud.Services.StoreService.MaxPublisherLength" value="@Model.Item.Publisher" />
                </div>
                <div class="form-field">
                    <label for="publisherUrl">@T["store.publisherUrl"]</label>
                    <input id="publisherUrl" name="publisherUrl" type="url" maxlength="300" placeholder="https://" value="@Model.Item.PublisherUrl" />
                    <div class="help">@T["store.publisherUrlHint"]</div>
                </div>
            </div>
            <div><button type="submit" class="btn btn-ghost">@T["common.save"]</button></div>
        </form>
    </div>

    @* The pictures the sites' store dialog shows (cover = the first). Their own forms, outside plugin-form — forms cannot nest — and
       each saves at once, so there is nothing here the Save button below would have to carry. *@
    <div class="card" id="bilder">
        <h2>@T["store.images"] <span class="muted" style="font-size:13px;font-weight:400;">@Model.Images.Count / @MatCMS.Cloud.Services.StoreService.MaxPluginImages</span></h2>
        <p class="muted">@T["store.imagesHint"]</p>
        @if (Model.Images.Count > 0)
        {
            <div class="media-grid store-shots-edit">
                @for (var i = 0; i < Model.Images.Count; i++)
                {
                    var img = Model.Images[i];
                    var src = Url.Page("Plugin", "Image", new { id = Model.Item.Id, imageId = img.Id });
                    <div class="media-card store-shot-card">
                        <a class="media-thumb" href="@src" target="_blank" rel="noopener" style="background-image:url('@src')" aria-label="@T["store.imageOpen"]"></a>
                        @if (i == 0)
                        {
                            <span class="badge badge-new store-shot-cover">@T["store.imageCover"]</span>
                        }
                        <div class="media-meta">
                            <form method="post" asp-page-handler="ImageCaption" asp-route-id="@Model.Item.Id" class="store-shot-caption">
                                <input type="hidden" name="imageId" value="@img.Id" />
                                <input name="caption" value="@img.Caption" maxlength="200" placeholder="@T["store.imageCaption"]" aria-label="@T["store.imageCaption"]" />
                                <button type="submit" class="btn btn-ghost btn-sm btn-icon" title="@T["settings.save"]" aria-label="@T["settings.save"]"><i class="ti ti-check" aria-hidden="true"></i></button>
                            </form>
                            <div class="actions">
                                <span class="muted mono" style="font-size:11px;margin-right:auto;">@(img.Size / 1024) KB</span>
                                @if (i > 0)
                                {
                                    <form class="inline-form" method="post" asp-page-handler="ImageMove" asp-route-id="@Model.Item.Id">
                                        <input type="hidden" name="imageId" value="@img.Id" /><input type="hidden" name="delta" value="-1" />
                                        <button type="submit" class="btn btn-ghost btn-sm btn-icon" title="@T["store.imageEarlier"]" aria-label="@T["store.imageEarlier"]"><i class="ti ti-arrow-left" aria-hidden="true"></i></button>
                                    </form>
                                }
                                @if (i < Model.Images.Count - 1)
                                {
                                    <form class="inline-form" method="post" asp-page-handler="ImageMove" asp-route-id="@Model.Item.Id">
                                        <input type="hidden" name="imageId" value="@img.Id" /><input type="hidden" name="delta" value="1" />
                                        <button type="submit" class="btn btn-ghost btn-sm btn-icon" title="@T["store.imageLater"]" aria-label="@T["store.imageLater"]"><i class="ti ti-arrow-right" aria-hidden="true"></i></button>
                                    </form>
                                }
                                <form class="inline-form" method="post" asp-page-handler="ImageDelete" asp-route-id="@Model.Item.Id" data-confirm="@T["store.imageDeleteConfirm"]">
                                    <input type="hidden" name="imageId" value="@img.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm btn-icon btn-danger" title="@T["common.delete"]" aria-label="@T["common.delete"]"><partial name="_IconTrash" /></button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        @if (Model.Images.Count < MatCMS.Cloud.Services.StoreService.MaxPluginImages)
        {
            <form method="post" asp-page-handler="ImageAdd" asp-route-id="@Model.Item.Id" enctype="multipart/form-data" class="store-shot-add">
                <div class="form-row">
                    <div class="form-field">
                        <label for="images">@T["store.imageAdd"]</label>
                        <input id="images" name="images" type="file" accept="image/png,image/jpeg,image/webp" multiple required />
                        <div class="help">@T["store.imageAddHint"]</div>
                    </div>
                    <div class="form-field">
                        <label for="icaption">@T["store.imageCaption"]</label>
                        <input id="icaption" name="caption" maxlength="200" />
                        <div class="help">@T["store.imageCaptionHint"]</div>
                    </div>
                </div>
                <div><button type="submit" class="btn btn-ghost">@T["store.imageUpload"]</button></div>
            </form>
        }
    </div>

}

@* Save, download, back, delete on one line, positive before negative: what to do with this record
   is one decision, and burying the destructive half in a card further down made it read as a
   separate page. The delete keeps its confirm, which is what actually guards it.
   The row itself sits OUTSIDE the !IsNew block on purpose: a plugin that does not exist yet has
   nothing to save, download or delete — but it still needs the way back, and while the row was
   inside, the upload page was a dead end with no exit at all. *@
<div class="form-actions">
    @if (!Model.IsNew)
    {
        <button type="submit" class="btn" form="plugin-form">@T["settings.save"]</button>
        <a class="btn btn-ghost" asp-page="Plugin" asp-page-handler="Download" asp-route-id="@Model.Item.Id">
            <i class="ti ti-download" aria-hidden="true"></i> @T["profiles.pluginDownload"]
        </a>
    }
    <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
    @if (!Model.IsNew)
    {
        <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@Model.Item.Id"
            data-confirm="@T["store.pluginDeleteConfirm"]">
            <button type="submit" class="btn btn-danger">@T["common.delete"]</button>
        </form>
    }
</div>

@section Scripts {
    <partial name="_CodeEditorAssets" />
}
