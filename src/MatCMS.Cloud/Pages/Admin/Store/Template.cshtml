@page "{id:int?}"
@model MatCMS.Cloud.Pages.Admin.Store.TemplateModel
@{
    ViewData["Title"] = Model.IsNew ? T["profiles.templateAdd"] : Model.Item.Name;
    var et = Model.Item;

    // Same pseudo-files as the CMS; only the field names are this page's own.
    var bodyTokens = new[]
    {
        new TemplateToken("{{content}}", T["templates.tokContent"]),
        new TemplateToken("{{logo}}", T["templates.tokLogo"]),
        new TemplateToken("{{site_name}}", T["templates.tokSiteName"]),
        new TemplateToken("{{footer_text}}", T["templates.tokFooterText"]),
        new TemplateToken("{{year}}", T["templates.tokYear"]),
        new TemplateToken("{{menu:primary}}", T["templates.tokMenu"]),
        new TemplateToken("{{param:id}}", T["templates.tokParam"]),
    };
    var postTokens = new[]
    {
        new TemplateToken("{{post_image}}", T["templates.tok.image"]),
        new TemplateToken("{{post_date}}", T["templates.tok.date"]),
        new TemplateToken("{{post_title}}", T["templates.tok.title"]),
        new TemplateToken("{{post_excerpt}}", T["templates.tok.excerpt"]),
        new TemplateToken("{{post_body}}", T["templates.tok.body"]),
    };
    var paramToken = new[] { new TemplateToken("{{param:id}}", T["templates.tokParam"]) };

    var templateFiles = new TemplateFiles(
        T["tplfiles.intro"],
        new[]
        {
            new TemplateFile("body.html", "html", T["tplfiles.body.desc"], "layoutHtml", et.LayoutHtml,
                "htmlmixed", bodyTokens),
            new TemplateFile("article.html", "html", T["tplfiles.article.desc"], "Parts[post]", Model.Part("post"),
                "htmlmixed", postTokens),
            new TemplateFile("styles.css", "css", T["tplfiles.styles.desc"], "customCss", et.CustomCss,
                "css", paramToken),
            new TemplateFile("script.js", "js", T["tplfiles.script.desc"], "customJs", et.CustomJs,
                "javascript", System.Array.Empty<TemplateToken>()),
            new TemplateFile("maintenance.html", "html", T["tplfiles.maintenance.desc"], "Parts[maintenance]", Model.Part("maintenance"),
                "htmlmixed", paramToken),
        },
        new TemplateFileLabels(
            T["tplfiles.edit"], T["tplfiles.tokens"], T["tplfiles.insertDefault"],
            T["tplfiles.insertDefaultConfirm"],
            T["tplfiles.badgeCustom"], T["tplfiles.badgeEmpty"],
            T["tplfiles.pick"], T["tplfiles.menu"], T["tplfiles.toggle"],
            T["tplfiles.raw"], T["tplfiles.root"]),
        // Die Wurzel des Baums ist dieses Template. Ein neues hat noch keinen Namen — dann greift
        // das Ersatzwort aus den Beschriftungen.
        et.Name ?? "");
}
<div class="page-head">
    <h1>
        @(Model.IsNew ? T["profiles.templateAdd"] : Model.Item.Name)
        <span class="muted" style="font-size:14px;font-weight:400;"> — @T["store.title"]</span>
    </h1>
    <div class="list-toolbar">
        @if (!Model.IsNew)
        {
            <a class="btn btn-sm btn-ghost" asp-page="Template" asp-page-handler="Export" asp-route-id="@et.Id">
                <i class="ti ti-download" aria-hidden="true"></i> @T["templates.exportJson"]
            </a>
        }
        <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
    </div>
</div>

@if (!Model.IsNew && Model.UsedBy.Count > 0)
{
    <div class="alert alert-info">
        @T["store.usedByWarning"] <strong>@string.Join(", ", Model.UsedBy)</strong>
    </div>
}

@if (Model.IsNew)
{
    <div class="card">
        <h2>@T["profiles.templateImport"]</h2>
        <p class="muted">@T["profiles.templateImportHint"]</p>
        <form method="post" asp-page-handler="Import">
            <div class="form-field">
                <textarea name="templateJson" rows="5" spellcheck="false" data-code="json" placeholder='{ "Name": "..." }'></textarea>
            </div>
            <div><button type="submit" class="btn btn-ghost">@T["profiles.templateImportBtn"]</button></div>
        </form>
    </div>
}

<form method="post" asp-route-id="@(Model.IsNew ? null : (int?)et.Id)" id="template-form">
    <div class="card tpl-preview-card">
        <div class="cp-head">
            <h2 style="margin:0;">@T["profiles.livePreview"]</h2>
            <span class="muted">@T["profiles.templatePreviewHint"]</span>
        </div>
        <div class="cp-frame-wrap">
            <iframe id="tpl-frame" class="cp-frame tpl-frame" title="@T["profiles.livePreview"]"></iframe>
        </div>
    </div>

    <div class="tabs" role="tablist">
        <button type="button" class="tab active" data-tab="designer">@T["profiles.tplTabDesigner"]</button>
        <button type="button" class="tab" data-tab="layout">@T["profiles.tplTabLayout"]</button>
        <button type="button" class="tab" data-tab="params">@T["profiles.tplTabParams"]</button>
    </div>

    <div class="tab-panel" data-panel="designer">
        <div class="card">
            <h2>@T["profiles.tplTabDesigner"]</h2>
            <div class="form-grid">
                <div class="form-row">
                    <div class="form-field">
                        <label for="tname">@T["common.name"]</label>
                        <input id="tname" name="name" value="@et.Name" required />
                        <div class="help">@T["profiles.templateNameHint"]</div>
                    </div>
                    <div class="form-field">
                        <label for="tdesc">@T["profiles.description"]</label>
                        <input id="tdesc" name="description" value="@et.Description" />
                    </div>
                </div>
            </div>

            <h3 class="form-section">@T["profiles.templateColors"]</h3>
            @* Required colours use .color-field (the colour input IS the posted value); optional ones
               use [data-optcolor], where the text field is posted and may be empty ("inherit"). *@
            <div class="color-grid">
                @{
                    var required = new (string Field, string Label, string Value, string Fallback)[]
                    {
                        ("accentColor", T["profiles.tplAccent"], et.AccentColor, "#de7e11"),
                        ("headingColor", T["profiles.tplHeading"], et.HeadingColor, "#010101"),
                        ("textColor", T["profiles.tplText"], et.TextColor, "#1a1a1a"),
                        ("backgroundColor", T["profiles.tplBackground"], et.BackgroundColor, "#ffffff"),
                        ("altBackground", T["profiles.tplAltBackground"], et.AltBackground, "#f6f7f9")
                    };
                }
                @foreach (var c in required)
                {
                    <div class="form-field">
                        <label for="@c.Field">@c.Label</label>
                        <div class="color-field">
                            <input id="@c.Field" name="@c.Field" type="color" value="@(string.IsNullOrWhiteSpace(c.Value) ? c.Fallback : c.Value)" />
                            <input type="text" class="hex" value="@(string.IsNullOrWhiteSpace(c.Value) ? c.Fallback : c.Value)" aria-label="@c.Label" spellcheck="false" />
                        </div>
                    </div>
                }
            </div>
            <div class="color-grid">
                @{
                    var optional = new (string Field, string Label, string Value, string Pick)[]
                    {
                        ("secondaryColor", T["profiles.tplSecondary"], et.SecondaryColor, "#ffffff"),
                        ("headerBackground", T["profiles.tplHeaderBg"], et.HeaderBackground, "#ffffff"),
                        ("headerTextColor", T["profiles.tplHeaderText"], et.HeaderTextColor, "#111111")
                    };
                }
                @foreach (var c in optional)
                {
                    <div class="form-field">
                        <label for="@c.Field">@c.Label</label>
                        <div class="optcolor" data-optcolor>
                            <input type="color" class="optcolor-pick" value="@(string.IsNullOrWhiteSpace(c.Value) ? c.Pick : c.Value)" aria-label="@c.Label" />
                            <input type="text" id="@c.Field" name="@c.Field" class="optcolor-hex" value="@c.Value" placeholder="@T["profiles.tplInherit"]" spellcheck="false" />
                            <button type="button" class="optcolor-clear" title="@T["action.clear"]" aria-label="@T["action.clear"]">×</button>
                        </div>
                    </div>
                }
            </div>

            <h3 class="form-section">@T["profiles.templateFonts"]</h3>
            <div class="form-grid">
                <div class="form-field">
                    <label for="headingFont">@T["profiles.tplHeadingFont"]</label>
                    <input id="headingFont" name="headingFont" value="@et.HeadingFont" />
                </div>
                <div class="form-field">
                    <label for="bodyFont">@T["profiles.tplBodyFont"]</label>
                    <input id="bodyFont" name="bodyFont" value="@et.BodyFont" />
                </div>
                <div class="form-field">
                    <label for="buttonStyle">@T["profiles.tplButtonStyle"]</label>
                    <select id="buttonStyle" name="buttonStyle">
                        <option value="solid" selected="@(et.ButtonStyle != "outline" ? "selected" : null)">solid</option>
                        <option value="outline" selected="@(et.ButtonStyle == "outline" ? "selected" : null)">outline</option>
                    </select>
                </div>
                <div class="form-field">
                    <label for="containerWidth">@T["profiles.tplContainerWidth"]</label>
                    <input id="containerWidth" name="containerWidth" value="@et.ContainerWidth" inputmode="numeric" />
                </div>
                <div class="form-field">
                    <label for="buttonRadius">@T["profiles.tplButtonRadius"]</label>
                    <input id="buttonRadius" name="buttonRadius" value="@et.ButtonRadius" inputmode="numeric" />
                </div>
                <div class="form-field">
                    <label for="headerPadding">@T["profiles.tplHeaderPadding"]</label>
                    <input id="headerPadding" name="headerPadding" value="@et.HeaderPadding" inputmode="numeric" />
                </div>
            </div>
        </div>
    </div>

    <div class="tab-panel" data-panel="layout" hidden>
        <div class="card">
            <partial name="_TemplateFiles" model="templateFiles" />
        </div>
    </div>


    <div class="tab-panel" data-panel="params" hidden>
        <div class="card">
            <h2>@T["profiles.tplParameters"]</h2>
            <div class="form-field">
                <textarea id="parametersJson" name="parametersJson" rows="10" spellcheck="false" data-code="json">@et.ParametersJson</textarea>
                <div class="help">@T["profiles.tplParametersHint"]</div>
            </div>
        </div>
        <div class="card">
            <h2>@T["profiles.tplMenuMap"]</h2>
            <div class="form-field">
                <textarea id="menuMapJson" name="menuMapJson" rows="6" spellcheck="false" data-code="json">@et.MenuMapJson</textarea>
                <div class="help">@T["profiles.tplMenuMapHint"]</div>
            </div>
        </div>
    </div>

</form>

@* Save and delete on one line, positive before negative: what to do with this record is
   one decision, and burying the destructive half in a card further down made it read as a separate
   page. The delete keeps its confirm, which is what actually guards it. *@
<div class="form-actions">
    <button type="submit" class="btn" form="template-form">@T["settings.save"]</button>
    @if (!Model.IsNew)
    {
        <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@et.Id"
            onsubmit="return confirm('@T["store.templateDeleteConfirm"]');">
            <button type="submit" class="btn btn-danger">@T["common.delete"]</button>
        </form>
    }
</div>


@section Scripts {
    <partial name="_CodeEditorAssets" />
    <partial name="_ColorFields" />
    <script>
        window.CLOUD_TPL_PREVIEW = {
            brand: "@T["profiles.previewBrand"]",
            navHome: "@T["profiles.previewNavHome"]",
            navAbout: "@T["profiles.previewNavAbout"]",
            navContact: "@T["profiles.previewNavContact"]",
            heroTitle: "@T["profiles.previewHeroTitle"]",
            heroText: "@T["profiles.previewHeroText"]",
            cta: "@T["profiles.previewCta"]",
            cta2: "@T["profiles.previewCta2"]",
            card: "@T["profiles.previewCard"]",
            cardText: "@T["profiles.previewCardText"]"
        };
    </script>
    <script src="~/js/template-preview.js" asp-append-version="true"></script>
    <partial name="_TabsScript" />
}
