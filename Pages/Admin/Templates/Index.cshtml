@page
@model MatCMS.Pages.Admin.Templates.IndexModel
@{
    ViewData["Title"] = T["templates.title"];
}
<div class="page-head">
    <h1>@T["templates.title"]</h1>
</div>

<table class="data">
    <thead>
        <tr>
            <th>@T["templates.colName"]</th>
            <th>@T["templates.colAccent"]</th>
            <th>@T["templates.colHeading"]</th>
            <th>@T["templates.colBody"]</th>
            <th>@T["templates.colButtons"]</th>
            <th>@T["templates.colStatus"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Items)
        {
            <tr>
                <td><strong>@t.Name</strong></td>
                <td>
                    <span style="display:inline-flex;align-items:center;gap:8px;">
                        <span style="width:18px;height:18px;border-radius:4px;border:1px solid var(--line);background:@t.AccentColor;display:inline-block;"></span>
                        <code>@t.AccentColor</code>
                    </span>
                </td>
                <td>@t.HeadingFont</td>
                <td>@t.BodyFont</td>
                <td>@(t.ButtonStyle == "outline" ? T["templates.buttonOutline"] : T["templates.buttonSolid"])</td>
                <td>
                    @if (t.IsActive)
                    {
                        <span class="badge badge-on">@T["templates.active"]</span>
                    }
                    else
                    {
                        <span class="muted">—</span>
                    }
                </td>
                <td>
                    <div class="actions">
                        @if (!t.IsActive)
                        {
                            <form class="inline-form" method="post" asp-page-handler="Activate" asp-route-id="@t.Id">
                                <button type="submit" class="btn btn-sm btn-ghost">@T["templates.activate"]</button>
                            </form>
                        }
                        <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@t.Id">@T["action.edit"]</a>
                        @if (!t.IsActive)
                        {
                            <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@t.Id" onsubmit="return confirm('@T["templates.confirmDelete", t.Name]');">
                                <button type="submit" class="btn btn-sm btn-danger">@T["action.delete"]</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="list-actions">
    <a class="btn" asp-page="Create">@T["templates.create"]</a>
</div>
