@model MatCMS.Content.ContainerBlockModel
@{
    var heading = Model.Data.Str("heading");
    var intro = Model.Data.Str("intro");
    var display = Model.Data.StrOr("display", "grid") == "list" ? "list" : "grid";
    var columns = Model.Data.StrOr("columns", "3");
    // Kachel vs. Liste is a class on the wrapper only. The child partial renders the same markup in
    // both, so switching the view never touches a stored reference — and a reference written while
    // "Kachel" was set reads back identically under "Liste".
    var cls = "refs refs--" + display + (display == "grid" ? " cols-" + columns : "");
}
<section class="section refs-block">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(heading) || !string.IsNullOrWhiteSpace(intro))
        {
            <div class="section__intro">
                @if (!string.IsNullOrWhiteSpace(heading)) { <h2>@heading</h2> }
                @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
            </div>
        }
        <div class="@cls">
            @foreach (var child in Model.Children)
            {
                @await Html.PartialAsync(child.Partial, child.Data)
            }
        </div>
    </div>
</section>
<style>
    .refs { display: grid; gap: 26px; }
    .refs--grid { grid-template-columns: repeat(3, 1fr); }
    .refs--grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
    .refs--grid.cols-4 { grid-template-columns: repeat(4, 1fr); }
    .refs--list { grid-template-columns: 1fr; gap: 18px; }

    .ref-card { display: flex; flex-direction: column; background: #fff; border: 1px solid #ece3d5;
        border-radius: 16px; overflow: hidden; box-shadow: 0 2px 12px rgba(26,21,18,.06); }
    .ref-card__media { display: block; margin: 0; background: var(--bg-alt, #f5f0e8); }
    .ref-card__media img { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 10; }
    .ref-card__body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; min-width: 0; }
    .ref-card h3 { font-family: var(--font-head); margin: 0; font-size: 20px; line-height: 1.3; }
    .ref-card h3 a { color: inherit; text-decoration: none; }
    .ref-card h3 a:hover { text-decoration: underline; }
    .ref-card__text { margin: 0; line-height: 1.6; opacity: .85; }
    .ref-card__tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .ref-card__tag { font-size: 12px; font-weight: 600; color: var(--accent); background: var(--bg-alt, #f5f0e8);
        padding: 3px 10px; border-radius: 999px; }
    .ref-card__link { margin-top: auto; align-self: flex-start; font-weight: 600; font-size: 14px;
        color: var(--accent); text-decoration: none; word-break: break-all; }
    .ref-card__link:hover { text-decoration: underline; }

    /* Screenshots: a scroll strip of thumbnails, full size only in the lightbox. The images here are
       the generated 320-px copies, not the originals scaled by CSS: displayed at 104 px, a project
       with ten screenshots used to cost ten full-size downloads on first paint. */
    .ref-card__shots { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px;
        scrollbar-width: thin; -webkit-overflow-scrolling: touch; }
    .ref-card__shot { flex: 0 0 auto; display: block; border-radius: 8px; overflow: hidden;
        border: 1px solid #ece3d5; line-height: 0; }
    .ref-card__shot img { width: 104px; height: 68px; object-fit: cover; display: block; }

    /* Liste: image beside the text instead of above it. */
    .refs--list .ref-card { flex-direction: row; align-items: stretch; }
    .refs--list .ref-card__media { flex: 0 0 34%; max-width: 320px; }
    .refs--list .ref-card__media img { height: 100%; aspect-ratio: auto; min-height: 160px; }
    .refs--list .ref-card__body { padding: 18px 22px; }

    /* 390 px: both views become one readable column with the image on top. */
    @@media (max-width: 900px) {
        .refs--grid, .refs--grid.cols-2, .refs--grid.cols-4 { grid-template-columns: 1fr; }
    }
    @@media (max-width: 640px) {
        .refs--list .ref-card { flex-direction: column; }
        .refs--list .ref-card__media { flex: none; max-width: none; }
        .refs--list .ref-card__media img { aspect-ratio: 16 / 10; min-height: 0; }
        .ref-card__shot img { width: 88px; height: 58px; }
    }
</style>
