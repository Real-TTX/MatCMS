@page "/login"
@model MatCMS.Pages.LoginModel
@inject MatCMS.Services.SiteContext Site
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Anmeldung – @Site.SiteName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@@500;600;700&family=Inter:wght@@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="icon" href="@Site.LogoUrl" />
</head>
<body class="login-page">
    <div class="login-card">
        <img class="login-logo" src="@Site.LogoUrl" alt="@Site.SiteName" />
        <h1>Admin-Anmeldung</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert-error">@Model.Error</div>
        }
        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div class="form-field">
                <label for="Username">Benutzername</label>
                <input id="Username" name="Username" value="@Model.Username" autofocus required />
            </div>
            <div class="form-field">
                <label for="Password">Passwort</label>
                <input id="Password" name="Password" type="password" required />
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="RememberMe" value="true" /> Angemeldet bleiben
            </label>
            <button type="submit" class="btn btn-block">Anmelden</button>
        </form>
        <a class="login-back" href="/">← Zurück zur Website</a>
    </div>
</body>
</html>
