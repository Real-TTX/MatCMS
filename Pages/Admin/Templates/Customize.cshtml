@page "{id:int}"
@model MatCMS.Pages.Admin.Templates.CustomizeModel
@{
    ViewData["Title"] = "Template anpassen";
    string V(string id) => Model.Values.TryGetValue(id, out var v) ? v : "";
}
<div class="page-head">
    <h1>Template anpassen – @Model.Current.Name</h1>
    <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
</div>

<div class="card">
    <p class="help">Hier stellst du die vom Designer bereitgestellten Parameter dieses Templates ein — ohne das Template selbst zu bearbeiten.</p>
    @if (Model.Params.Count == 0)
    {
        <p class="muted">Dieses Template stellt keine Parameter zum Anpassen bereit.</p>
    }
    else
    {
        <form method="post" class="form-grid">
            @foreach (var p in Model.Params)
            {
                <div class="form-field">
                    <label>@p.Label</label>
                    @switch (p.Type)
                    {
                        case "select":
                            <select name="Val[@p.Id]">
                                @foreach (var o in p.OptionList())
                                {
                                    <option value="@o" selected="@(V(p.Id) == o)">@o</option>
                                }
                            </select>
                            break;
                        case "color":
                            <input type="color" name="Val[@p.Id]" value="@(string.IsNullOrWhiteSpace(V(p.Id)) ? "#000000" : V(p.Id))" />
                            break;
                        case "number":
                            <input type="number" name="Val[@p.Id]" value="@V(p.Id)" />
                            break;
                        case "bool":
                            <label class="check"><input type="checkbox" name="Val[@p.Id]" value="true" @(V(p.Id) == "true" ? "checked" : "") /> aktiv</label>
                            break;
                        default:
                            <input type="text" name="Val[@p.Id]" value="@V(p.Id)" />
                            break;
                    }
                    <div class="help mono">{{param:@p.Id}}</div>
                </div>
            }
            <div><button type="submit" class="btn">Speichern</button></div>
        </form>
    }
</div>
