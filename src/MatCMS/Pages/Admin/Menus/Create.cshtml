@page
@model MatCMS.Pages.Admin.Menus.CreateModel
@{
    ViewData["Title"] = T["menus.new"];
    var vm = new MatCMS.Pages.Admin.Menus.MenuItemFormVm
    {
        Menu = Model.Menu,
        Locale = Model.Locale,
        Label = Model.Label,
        Url = Model.Url,
        Icon = Model.Icon,
        OpenInNewTab = Model.OpenInNewTab,
        ParentId = Model.ParentId,
        ParentOptions = Model.ParentOptions,
        Menus = Model.Menus,
        Pages = Model.Pages,
        QuickPickHelpKey = "menus.quickPickHelpCreate",
        SubmitLabelKey = "menus.addSubmit",
        AutofocusLabel = true,
        // Zurück führt dorthin, wo man hergekommen ist: zu dem Menü, in das der Eintrag soll —
        // und nur ohne dieses Menü zur Übersicht.
        BackUrl = Model.MenuId is int backId
            ? Url.Page("EditMenu", new { id = backId, locale = Model.Locale })!
            : Url.Page("Index")!
    };
}
@* Nur die Überschrift: der Weg zurück steht unten neben dem Anlegen-Knopf, wie im Plugin-Editor. *@
<div class="page-head">
    <h1>
        @T["menus.new"]
        @if (!string.IsNullOrEmpty(Model.Locale))
        {
            <span class="badge badge-on mono" style="margin-left:8px;font-size:12px;vertical-align:middle;">@MatCMS.Services.Localizer.DisplayName(Model.Locale) (@Model.Locale.ToUpperInvariant())</span>
        }
    </h1>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <partial name="_MenuItemForm" model="vm" />
</div>
