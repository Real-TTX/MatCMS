<Project Sdk="Microsoft.NET.Sdk">

  <!-- Club management (members, documents to confirm or sign, meetings with minutes, templates, uploads) as a NATIVE plugin: it runs only where the
       operator allowed native plugins. Same settings as the forum so it stays loadable and unloadable (docs/plugin-system-v2.md, section 7). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>MatCMS.Plugin.Verein</RootNamespace>
    <AssemblyName>Verein</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MatCMS.Plugin.Abstractions\MatCMS.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
