@model MatCMS.Content.BlockData
@{
    var heading = Model.Str("heading");
    var items = Model.List("items");

    static string SafeSrc(string image) =>
        (!string.IsNullOrWhiteSpace(image)
            && (image.StartsWith("/") || image.StartsWith("http://") || image.StartsWith("https://"))
            && image.IndexOfAny(new[] { '\'', '"', '(', ')', '\\', '\n', '\r' }) < 0)
            ? image : "";
    static string SafeUrl(string url) =>
        (!string.IsNullOrWhiteSpace(url)
            && (url.StartsWith("/") || url.StartsWith("http://") || url.StartsWith("https://"))
            && url.IndexOfAny(new[] { '"', '\'', '\\', '\n', '\r', ' ' }) < 0)
            ? url : "";
}
<section class="section logostrip-block">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(heading))
        {
            <div class="section__intro">
                <h2>@heading</h2>
            </div>
        }
        <div class="logostrip">
            @foreach (var item in items)
            {
                var src = SafeSrc(item.Str("image"));
                if (string.IsNullOrEmpty(src)) { continue; }
                var alt = item.Str("alt");
                var url = SafeUrl(item.Str("url"));
                if (!string.IsNullOrEmpty(url))
                {
                    <a class="logostrip__item" href="@url" target="_blank" rel="noopener">
                        <img src="@src" alt="@alt" />
                    </a>
                }
                else
                {
                    <div class="logostrip__item">
                        <img src="@src" alt="@alt" />
                    </div>
                }
            }
        </div>
    </div>
</section>
