@page "/registrieren"
@model MatCMS.Pages.RegistrierenModel
@{
    ViewData["Title"] = T["member.register"];
}
<partial name="_MemberAuthStyle" />
<section class="member-auth">
    <div class="member-auth-card">
        <h1>@T["member.register"]</h1>
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <p class="member-auth-error">@Model.Error</p>
        }
        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div class="member-auth-hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
            <label class="member-auth-field">
                <span>@T["member.reg.name"]</span>
                <input name="name" value="@Model.Name" autocomplete="name" />
            </label>
            <label class="member-auth-field">
                <span>@T["member.reg.email"]</span>
                <input name="email" type="email" value="@Model.Email" autocomplete="email" required autofocus />
            </label>
            <label class="member-auth-field">
                <span>@T["member.reg.password", MatCMS.Services.MemberService.MinPasswordLength]</span>
                <input name="password" type="password" autocomplete="new-password" minlength="@MatCMS.Services.MemberService.MinPasswordLength" required />
            </label>
            <button type="submit" class="btn">@T["member.register"]</button>
        </form>
        <p class="member-auth-links"><a href="/anmelden@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : "?returnUrl=" + System.Net.WebUtility.UrlEncode(Model.ReturnUrl))">@T["member.reg.haveAccount"]</a></p>
    </div>
</section>
