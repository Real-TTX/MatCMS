@page
@model MatCMS.Pages.Admin.Pages.CreateModel
@{
    ViewData["Title"] = T["pages.new"];
}
<div class="page-head">
    <h1>@T["pages.new"]</h1>
    <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" class="form-grid">
        <div class="form-row">
            <div class="form-field">
                <label for="Title">@T["pages.titleField"]</label>
                <input id="Title" name="Title" value="@Model.Title" required autofocus />
            </div>
            <div class="form-field">
                <label for="Slug">@T["pages.slugOptional"]</label>
                <input id="Slug" name="Slug" value="@Model.Slug" placeholder="@T["pages.slugPlaceholder"]" />
            </div>
        </div>
        <div>
            <button type="submit" class="btn">@T["pages.createAndEdit"]</button>
        </div>
    </form>
</div>
