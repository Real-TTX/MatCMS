@page "{id:int?}"
@model MatCMS.Cloud.Pages.Admin.Hosting.Nodes.DetailsModel
@using MatCMS.Cloud.Services
@{
    var n = Model.Item;
    var h = Model.Host;
    var name = n?.Name ?? T["nodes.thisHost"];
    ViewData["Title"] = name;
    var now = DateTime.UtcNow;
    var on = n?.IsOnline(now) ?? (h?.Online ?? false);
    // "Dieser Host": proxy and port settings only matter while the module provisions and routes sites.
    var showProxy = n is not null || Model.ModuleEnabled;
}
<partial name="_HostingTabs" model='"nodes"' />

<div class="page-head">
    <h1>@name</h1>
    <div class="list-toolbar">
        @if (n?.Revoked == true) { <span class="badge badge-err">@T["nodes.revoked"]</span> }
        else if (n is not null && n.LastSeenAt is null) { <span class="badge badge-new">@T["nodes.neverSeen"]</span> }
        else if (n is null && !(h?.Online ?? false)) { <span class="badge badge-err">@T["settings.dockerUnreachable"]</span> }
        else { <span class="badge @(on ? "badge-on" : "badge-err")">@(on ? T["nodes.online"] : T["nodes.offline"])</span> }
    </div>
</div>

@* The one moment the token is visible (after creating or rotating) — it is stored as a hash only. *@
@if (Model.Command is not null)
{
    <div class="alert alert-success">
        <strong>@T["nodes.commandTitle"]</strong>
        <div class="help">@T["nodes.commandOnce"]</div>
        <pre class="mono is-secret" style="margin:.5rem 0 0;white-space:pre-wrap;word-break:break-all;">@Model.Command</pre>
    </div>
}

<div class="tabs" role="tablist">
    <button type="button" class="tab active" data-tab="overview">@T["nodes.tabOverview"]</button>
    <button type="button" class="tab" data-tab="containers">@T["nodes.tabContainers"] (@Model.Sites.Count)</button>
    <button type="button" class="tab" data-tab="docker">Docker</button>
    @if (showProxy) { <button type="button" class="tab" data-tab="proxy">Proxy</button> }
    @if (Model.ShowMatcad) { <button type="button" class="tab" data-tab="matcad">Matcad</button> }
    @if (showProxy) { <button type="button" class="tab" data-tab="settings">@T["hosting.navSettings"]</button> }
    @if (n is not null) { <button type="button" class="tab" data-tab="jobs">@T["nodes.tabJobs"]</button> }
</div>

@* ============ ÜBERSICHT ============ *@
<div class="tab-panel" data-panel="overview">
    <div class="card">
        @if (n is not null)
        {
            <div class="kv"><div class="kv-label">@T["nodes.id"]</div><div class="kv-value mono">@n.PublicId</div></div>
            <div class="kv"><div class="kv-label">@T["nodes.host"]</div><div class="kv-value mono">@(n.HostName ?? "—")</div></div>
            <div class="kv">
                <div class="kv-label">@T["nodes.agent"]</div>
                <div class="kv-value">
                    <span class="mono">@(n.AgentVersion ?? "—")</span>
                    @if (Model.AgentOutdated) { <span class="badge badge-new">@T["nodes.agentOutdated", Model.CloudVersion]</span> }
                </div>
            </div>
        }
        else
        {
            <div class="kv"><div class="kv-label">@T["nodes.host"]</div><div class="kv-value muted">@T["nodes.thisHostHint"]</div></div>
            <div class="kv"><div class="kv-label">@T["settings.dockerEndpoint"]</div><div class="kv-value mono">@(Model.Endpoint ?? "—")</div></div>
        }
        <div class="kv"><div class="kv-label">@T["nodes.docker"]</div><div class="kv-value mono">@(h?.DockerVersion ?? n?.DockerVersion ?? "—")</div></div>
        @if (!string.IsNullOrEmpty(n?.DockerError ?? h?.Error))
        {
            <div class="kv"><div class="kv-label">@T["nodes.dockerError"]</div><div class="kv-value"><span class="badge badge-err">@(n?.DockerError ?? h?.Error)</span></div></div>
        }
        @if (h is not null)
        {
            <div class="kv"><div class="kv-label">@T["hostdash.sites"]</div><div class="kv-value mono">@h.Running<span class="muted">/@h.Total</span></div></div>
            <div class="kv">
                <div class="kv-label">@T["hostdash.resources"]</div>
                <div class="kv-value usage-cell" style="min-width:240px;">
                    <partial name="_UsageBar" model="@(new UsageBar(h.Cpu, (h.Cpus ?? 0) * 100.0, h.Cpus is int c ? $"{h.Cpu:0.#} % · {c} CPU" : $"{h.Cpu:0.#} %", "CPU"))" />
                    <partial name="_UsageBar" model="@(new UsageBar(h.Mem, h.MemTotal ?? 0, h.MemTotal is long mt ? $"{HostFmt.Bytes(h.Mem)} / {HostFmt.Bytes(mt)}" : HostFmt.Bytes(h.Mem), "RAM"))" />
                </div>
            </div>
        }
        @if (n is not null)
        {
            <div class="kv"><div class="kv-label">@T["nodes.lastSeen"]</div><div class="kv-value mono">@(n.LastSeenAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</div></div>
            <div class="kv"><div class="kv-label">@T["nodes.created"]</div><div class="kv-value mono">@n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div></div>
        }
    </div>
    @if (n is not null && on)
    {
        <div class="list-actions">
            <form class="inline-form" method="post" asp-page-handler="UpdateAgent" asp-route-id="@n.Id" data-confirm="@T["nodes.updateAgentConfirm"]">
                <button type="submit" class="btn @(Model.AgentOutdated ? "" : "btn-ghost")">@T["nodes.updateAgent"]</button>
            </form>
        </div>
    }
</div>

@* ============ CONTAINER ============ *@
<div class="tab-panel" data-panel="containers" hidden>
    <div data-list>
        <partial name="_HostSites" model="(Model.Sites, false)" />
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
    </div>
    @if (Model.ModuleEnabled && (n is null || !n.Revoked))
    {
        <div class="list-actions"><a class="btn" asp-page="/Admin/Instances/New">@T["hosting.newInstance"]</a></div>
    }
</div>

@* ============ DOCKER ============ *@
<div class="tab-panel" data-panel="docker" hidden>
    <div data-images data-src="@Url.Page("/Admin/Hosting/Nodes/Details", MatCMS.Cloud.Pages.Admin.Hosting.Nodes.DetailsModel.Route(n?.Id, "Images"))"><div class="card muted">…</div></div>
</div>

@if (showProxy)
{
@* ============ PROXY ============ *@
<div class="tab-panel" data-panel="proxy" hidden>
    <form method="post" action="@Url.Page("/Admin/Hosting/Nodes/Details", MatCMS.Cloud.Pages.Admin.Hosting.Nodes.DetailsModel.Route(n?.Id, "Proxy"))">
        @Html.AntiForgeryToken()
        <div class="card">
            <h2>@T["settings.hostingRouting"]</h2>
            <partial name="_ProxyFields" model="Model.ProxyFields" />
            @if (n is not null) { <div class="help">@T["nodes.proxyHint"]</div> }
            <div class="list-actions">
                <button type="submit" class="btn">@T["common.save"]</button>
                <button type="submit" class="btn btn-ghost" formaction="@Url.Page("/Admin/Hosting/Nodes/Details", MatCMS.Cloud.Pages.Admin.Hosting.Nodes.DetailsModel.Route(n?.Id, "ProxyTest"))">@T["settings.hostingProxyTest"]</button>
            </div>
        </div>
    </form>

    @* How this host is addressed: its automatic addresses (name.<base>, at this host's proxy) and — for a node — the
       address under which the cloud's edge reaches it. Own form, so saving it never re-posts the proxy key above. *@
    <form method="post" action="@Url.Page("/Admin/Hosting/Nodes/Details", MatCMS.Cloud.Pages.Admin.Hosting.Nodes.DetailsModel.Route(n?.Id, "Addresses"))">
        @Html.AntiForgeryToken()
        <div class="card">
            <h2>@T["autodomain.title"]</h2>
            <label class="checkbox-row">
                <input type="checkbox" name="autoDomainEnabled" value="true" data-reveal="host-auto" checked="@(Model.AutoDomainEnabled ? "checked" : null)" />
                @T["autodomain.enable"]
            </label>
            <div data-reveal-target="host-auto" hidden="@(Model.AutoDomainEnabled ? null : "hidden")">
                <div class="form-field">
                    <label for="autoDomainBase">@T["autodomain.base"]</label>
                    <input id="autoDomainBase" name="autoDomainBase" value="@Model.AutoDomainBase" placeholder="@(n is null ? "cloud.example.de" : "server1.example.de")" spellcheck="false" />
                    <div class="help">@T["autodomain.baseHint"]</div>
                </div>
                <partial name="_WildcardFields" model="Model.WildcardView" />
            </div>
            @if (n is not null)
            {
                <div class="form-field">
                    <label for="nodeAddress">@T["edge.nodeAddress"]</label>
                    <input id="nodeAddress" name="address" value="@n.Address" placeholder="10.0.0.3" spellcheck="false" />
                    <div class="help">@T["edge.nodeAddressHint"]</div>
                </div>
            }
            <div class="list-actions">
                <button type="submit" class="btn">@T["common.save"]</button>
                @if (Model.AutoDomainEnabled && Model.MissingHostAddresses > 0)
                {
                    <button type="submit" class="btn btn-ghost" formaction="@Url.Page("/Admin/Hosting/Nodes/Details", MatCMS.Cloud.Pages.Admin.Hosting.Nodes.DetailsModel.Route(n?.Id, "AddressBackfill"))">@T["autodomain.backfill", Model.MissingHostAddresses]</button>
                }
            </div>
        </div>
    </form>
</div>

@if (Model.ShowMatcad)
{
@* ============ MATCAD ============ *@
<div class="tab-panel" data-panel="matcad" hidden>
    <div data-lazy="matcad" data-src="@Url.Page("/Admin/Hosting/Nodes/Details", "Matcad")"><div class="card muted">…</div></div>
</div>
}

@* ============ EINSTELLUNGEN ============ *@
<div class="tab-panel" data-panel="settings" hidden>
    <form method="post" action="@Url.Page("/Admin/Hosting/Nodes/Details", MatCMS.Cloud.Pages.Admin.Hosting.Nodes.DetailsModel.Route(n?.Id, "Settings"))">
        @Html.AntiForgeryToken()
        <div class="card">
            @if (n is not null)
            {
                <div class="form-field">
                    <label for="name">@T["common.name"]</label>
                    <input id="name" name="name" value="@n.Name" required />
                </div>
            }
            @* Der Portbereich gilt für beide Wege: auch eine Instanz hinter einem Proxy braucht einen Port auf dem Host,
               unter dem der Proxy sie findet (Modus „Host-Port“). *@
            <div class="form-row">
                <div class="form-field">
                    <label for="portFrom">@T["settings.hostingPortFrom"]</label>
                    <input id="portFrom" name="portFrom" inputmode="numeric" value="@(n?.PortFrom.ToString() ?? Model.Get(SettingKeys.HostingPortFrom))" placeholder="9201" />
                </div>
                <div class="form-field">
                    <label for="portTo">@T["settings.hostingPortTo"]</label>
                    <input id="portTo" name="portTo" inputmode="numeric" value="@(n?.PortTo.ToString() ?? Model.Get(SettingKeys.HostingPortTo))" placeholder="9299" />
                </div>
            </div>
            <div class="help">@T[n is null ? "settings.hostingPortsHint" : "nodes.portsHint"]</div>
            @if (n is null)
            {
                <div class="form-field">
                    <label for="namePattern">@T["settings.hostingNamePattern"]</label>
                    <input id="namePattern" name="namePattern" value="@Model.Get(SettingKeys.HostingNamePattern)" placeholder="@HostingService.DefaultNamePattern" spellcheck="false" />
                    <div class="help">@T["settings.hostingNamePatternHint"]</div>
                    <div class="help mono" data-name-preview></div>
                </div>
                <div class="kv" style="margin-top:12px;">
                    <div class="kv-label">@T["settings.hostingNextPort"]</div>
                    <div class="kv-value">
                        @if (Model.NextPort is int np) { <span class="mono">@np</span> <span class="muted">@T["settings.hostingPortsUsed", Model.UsedPortCount]</span> }
                        else { <span class="badge badge-err">@T["settings.hostingNoPort"]</span> }
                    </div>
                </div>
            }
            <div style="margin-top:14px;"><button type="submit" class="btn">@T["common.save"]</button></div>
        </div>
    </form>

    @if (n is not null)
    {
        <div class="card">
            <h2>@T["nodes.agent"]</h2>
            <div class="list-actions">
                <form class="inline-form" method="post" asp-page-handler="Rotate" asp-route-id="@n.Id" data-confirm="@T["nodes.rotateConfirm"]">
                    <button type="submit" class="btn btn-ghost">@T["nodes.rotate"]</button>
                </form>
                <form class="inline-form" method="post" asp-page-handler="Revoke" asp-route-id="@n.Id" asp-route-revoked="@(!n.Revoked)"
                      data-confirm="@(n.Revoked ? null : T["nodes.revokeConfirm"])">
                    <button type="submit" class="btn btn-ghost">@(n.Revoked ? T["nodes.activate"] : T["nodes.revoke"])</button>
                </form>
                <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@n.Id" data-confirm="@T["nodes.deleteConfirm"]">
                    <button type="submit" class="btn btn-danger">@T["action.delete"]</button>
                </form>
            </div>
        </div>
    }
</div>
}

@if (n is not null)
{
@* ============ AUFTRÄGE ============ *@
<div class="tab-panel" data-panel="jobs" hidden>
    <table class="data">
        <thead>
            <tr>
                <th style="width:70px;">#</th>
                <th>@T["nodes.jobKind"]</th>
                <th style="width:100px;">@T["common.status"]</th>
                <th>@T["nodes.jobMessage"]</th>
                <th>@T["nodes.jobBy"]</th>
                <th style="width:150px;">@T["nodes.jobAt"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Jobs.Count == 0)
            {
                <partial name="_EmptyRow" model='@T["nodes.noJobs"]' />
            }
            @foreach (var j in Model.Jobs)
            {
                var badge = j.State switch
                {
                    MatCMS.Cloud.Models.NodeJobState.Done => "badge-on",
                    MatCMS.Cloud.Models.NodeJobState.Failed => "badge-err",
                    _ => "badge-new",
                };
                <tr>
                    <td class="mono muted">@j.Id</td>
                    <td class="mono">@j.Kind</td>
                    <td><span class="badge @badge">@T["nodes.state." + j.State.ToString().ToLowerInvariant()]</span></td>
                    <td class="muted">@j.Message</td>
                    <td class="mono muted">@j.RequestedBy</td>
                    <td class="mono muted">@j.CreatedAt.ToLocalTime().ToString("dd.MM. HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
}

@section Scripts {
    <partial name="_TabsScript" />
    <script>
        (function () {
            // A switch reveals its fields ([data-reveal] → [data-reveal-target]).
            document.querySelectorAll('[data-reveal]').forEach(function (box) {
                var target = document.querySelector('[data-reveal-target="' + box.getAttribute('data-reveal') + '"]');
                if (!target) return;
                var sync = function () { target.hidden = !box.checked; };
                box.addEventListener('change', sync);
                sync();
            });

            // Wildcard with Matcad: "Neuen DNS-Anbieter anlegen" reveals the type's fields; the other types' fields are
            // disabled, so a key two types share posts once.
            var wcProv = document.querySelector('[data-wc-provider]');
            var wcNew = document.querySelector('[data-wc-new]');
            var wcType = document.querySelector('[data-wc-type]');
            if (wcProv && wcNew && wcType) {
                var syncWc = function () {
                    var isNew = wcProv.value === '__new';
                    wcNew.hidden = !isNew;
                    document.querySelectorAll('[data-wc-fields]').forEach(function (g) {
                        var on = isNew && g.getAttribute('data-wc-fields') === wcType.value;
                        g.hidden = !on;
                        g.querySelectorAll('input').forEach(function (i) { i.disabled = !on; });
                    });
                };
                wcProv.addEventListener('change', syncWc);
                wcType.addEventListener('change', syncWc);
                syncWc();
            }

            // Docker tab: the images are fetched when the tab is first shown — for a node that is a job its agent
            // runs, which should not slow down every visit of the page.
            var box = document.querySelector('[data-images]');
            var loaded = false;
            function loadImages() {
                if (loaded || !box) return;
                loaded = true;
                fetch(box.getAttribute('data-src'), { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
                    .then(function (html) { box.innerHTML = html; })
                    .catch(function () { loaded = false; box.innerHTML = '<div class="card"><span class="badge badge-err">@T["common.error"]</span></div>'; });
            }
            var tab = document.querySelector('.tab[data-tab="docker"]');
            if (tab) tab.addEventListener('click', loadImages);
            if (box && !box.closest('.tab-panel').hidden) loadImages();

            // Matcad tab: the same on-demand load (three calls to Matcad).
            var mc = document.querySelector('[data-lazy="matcad"]');
            var mcLoaded = false;
            function loadMatcad() {
                if (mcLoaded || !mc) return;
                mcLoaded = true;
                fetch(mc.getAttribute('data-src'), { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
                    .then(function (html) { mc.innerHTML = html; })
                    .catch(function () { mcLoaded = false; mc.innerHTML = '<div class="card"><span class="badge badge-err">@T["common.error"]</span></div>'; });
            }
            var mcTab = document.querySelector('.tab[data-tab="matcad"]');
            if (mcTab) mcTab.addEventListener('click', loadMatcad);
            if (mc && !mc.closest('.tab-panel').hidden) loadMatcad();

            // The Matcad forms arrive with the fetched HTML, so their behaviour is delegated from here.
            function mcForm(kind) { return document.querySelector('[data-matcad-form="' + kind + '"]'); }
            function syncRoute(f) {
                var t = f.querySelector('[data-matcad-target]').value;
                f.querySelectorAll('[data-target-only]').forEach(function (el) { el.hidden = el.getAttribute('data-target-only') !== t; });
                f.querySelector('[data-wildcard-only]').hidden = !f.querySelector('[data-reveal-wildcard]').checked;
            }
            function syncProvider(f, item) {
                var type = f.querySelector('[data-ptype-select]').value;
                f.querySelectorAll('[data-ptype]').forEach(function (g) {
                    var on = g.getAttribute('data-ptype') === type;
                    g.hidden = !on;
                    g.querySelectorAll('input').forEach(function (i) {
                        i.disabled = !on;
                        var key = i.getAttribute('data-key');
                        var secret = i.getAttribute('data-secret') === '1';
                        var same = item && item.type === type;
                        i.value = same && !secret && item.values && item.values[key] != null ? item.values[key] : '';
                        i.placeholder = same && secret && item.secretsSet && item.secretsSet.indexOf(key) >= 0 ? i.getAttribute('data-keep') : '';
                    });
                });
            }
            function openForm(kind, item) {
                var f = mcForm(kind);
                if (!f) return;
                f.reset();
                f.querySelector('[name="id"]').value = item ? item.id : '';
                var h = f.querySelector('h2');
                h.textContent = h.getAttribute(item ? 'data-title-edit' : 'data-title-new');
                if (kind === 'route') {
                    if (item) {
                        f.querySelector('[name="host"]').value = item.host || '';
                        f.querySelector('[name="name"]').value = item.name && item.name !== item.host ? item.name : '';
                        f.querySelector('[name="target"]').value = item.target || 'proxy';
                        f.querySelector('[name="upstream"]').value = item.upstream || '';
                        f.querySelector('[name="fallbackUrl"]').value = item.fallbackUrl || '';
                        f.querySelector('[name="wildcard"]').checked = !!item.wildcard;
                        f.querySelector('[name="providerId"]').value = item.providerId == null ? '' : String(item.providerId);
                        f.querySelector('[name="enabled"]').checked = !!item.enabled;
                        f.querySelector('[name="allowEmbedding"]').checked = !!item.allowEmbedding;
                    }
                    syncRoute(f);
                } else {
                    if (item) {
                        f.querySelector('[name="name"]').value = item.name || '';
                        f.querySelector('[name="type"]').value = item.type || '';
                    }
                    f.dataset.item = item ? JSON.stringify(item) : '';
                    syncProvider(f, item);
                }
                f.hidden = false;
                f.scrollIntoView({ behavior: 'smooth', block: 'start' });
                var first = f.querySelector('input:not([type=hidden]):not([disabled])');
                if (first) first.focus({ preventScroll: true });
            }
            document.addEventListener('click', function (e) {
                var b = e.target.closest('[data-matcad-new],[data-matcad-edit],[data-matcad-cancel]');
                if (!b) return;
                if (b.hasAttribute('data-matcad-cancel')) { b.closest('form').hidden = true; return; }
                var kind = b.getAttribute('data-matcad-new') || b.getAttribute('data-matcad-edit');
                openForm(kind, b.hasAttribute('data-item') ? JSON.parse(b.getAttribute('data-item')) : null);
            });
            document.addEventListener('change', function (e) {
                var f = e.target.closest('[data-matcad-form]');
                if (!f) return;
                if (f.getAttribute('data-matcad-form') === 'route') syncRoute(f);
                else if (e.target.hasAttribute('data-ptype-select')) syncProvider(f, f.dataset.item ? JSON.parse(f.dataset.item) : null);
            });

            // Spiegelt HostingService.Normalise: klein, alles Nicht-Alphanumerische zu Bindestrichen. Nur Anzeige.
            var pat = document.getElementById('namePattern');
            var prev = document.querySelector('[data-name-preview]');
            if (pat && prev) {
                var demo = 'Meine Seite.de';
                var slug = demo.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
                var sync = function () {
                    var p = (pat.value || pat.placeholder || '').trim();
                    var out = /{name}/i.test(p) ? p.replace(/{name}/ig, slug)
                            : p.indexOf('$NAME') >= 0 ? p.split('$NAME').join(slug)
                            : (p.replace(/-+$/, '') + '-' + slug);
                    prev.textContent = '„' + demo + '" → ' + out.toLowerCase();
                };
                pat.addEventListener('input', sync);
                sync();
            }
        })();
    </script>
}
