<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shop as a NATIVE plugin. It used to be compiled into the CMS (docs/builtin-extraction.md, docs/shop-plugin.md); signed by the MatCMS
       Store it runs without "Native Plugins erlauben" and takes the place of the old built-in row — key "shop": on/off, settings, the tables
       p_shop_*, its block pages, menu elements and files carry over. The settings below keep it loadable and unloadable
       (docs/plugin-system-v2.md, section 7). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>MatCMS.Plugin.Shop</RootNamespace>
    <AssemblyName>Shop</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests use the shop's own types (store, model, pure rules) next to the copy the application loads. -->
    <InternalsVisibleTo Include="MatCMS.Plugins.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MatCMS.Plugin.Abstractions\MatCMS.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
