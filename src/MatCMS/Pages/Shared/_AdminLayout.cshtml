@inject MatCMS.Services.SiteContext Site
@inject MatCMS.Services.PluginRegistry Plugins
@inject MatCMS.Services.VersionService Version
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Builder.RequestLocalizationOptions> LocOptions
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    var title = ViewData["Title"] as string ?? "Admin";
    string Active(string path) =>
        Context.Request.Path.StartsWithSegments(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Admin";

    // Admin-UI language switcher: only offer cultures that actually have an admin translation file
    // (Resources/<lang>.json). A content-only language (e.g. English pages) must NOT add an admin-UI
    // toggle here — the visitor-facing language selector lives in the public template, not the admin.
    var allUiCultures = LocOptions.Value.SupportedUICultures ?? new System.Collections.Generic.List<System.Globalization.CultureInfo>();
    string _uiLang(System.Globalization.CultureInfo c) => c.Name.Split('-', 2)[0];
    var cultures = allUiCultures.Where(c => System.IO.File.Exists(
        System.IO.Path.Combine(Env.ContentRootPath, "Resources", _uiLang(c) + ".json"))).ToList();
    // Use Name (not TwoLetterISOLanguageName): under InvariantGlobalization the latter collapses to "iv".
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name.Split('-', 2)[0];
    if (string.IsNullOrEmpty(currentCulture)) currentCulture = MatCMS.Services.Localizer.ResourceFallbackCulture;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title – @Site.SiteName Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@@500;600;700&family=Inter:wght@@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/lib/tabler-icons/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin.css" asp-append-version="true" />
    <link rel="icon" href="@Site.FaviconUrl" />
    @* Embedded in the cloud's instance view: that page already carries a bar with the instance
       switcher and the actions, so this one would be a second bar saying the same kind of thing.
       Decided from being FRAMED rather than from a ?embed=1 flag — a flag has to survive every link
       on every sub-page, and the first one that forgets it puts the bar back halfway through a
       session. Being in a frame is true for every page without anyone carrying it along.
       Set in the head and applied by CSS, so the bar is never painted and then removed. *@
    <script>
        if (window.self !== window.top) document.documentElement.classList.add('is-embedded');
    </script>
    <style>
        html.is-embedded .admin-topbar { display: none; }
    </style>
</head>
<body class="admin">
    <aside class="admin-sidebar">
        <div class="admin-brand">
            <a class="admin-brand-link" asp-page="/Admin/Index" title="@Site.SiteName">
                <img class="admin-logo" src="@Site.LogoUrl" alt="@Site.SiteName" />
            </a>
        </div>
        <nav class="admin-nav">
            @* Inhalt *@
            <a class="@Active("/admin/pages")" asp-page="/Admin/Pages/Index">📄 @T["nav.pages"]</a>
            <a class="@Active("/admin/posts")" asp-page="/Admin/Posts/Index">📰 @T["nav.posts"]</a>
            <a class="@Active("/admin/menus")" asp-page="/Admin/Menus/Index">🧭 @T["nav.menus"]</a>
            <a class="@Active("/admin/forms")" asp-page="/Admin/Forms/Index">📝 @T["nav.forms"]</a>
            <a class="@Active("/admin/media")" asp-page="/Admin/Media/Index">🖼️ @T["nav.media"]</a>
            <div class="admin-nav-sep" role="separator"></div>
            @* Gestaltung & Konfiguration *@
            <a class="@Active("/admin/templates")" asp-page="/Admin/Templates/Index">🎨 @T["nav.templates"]</a>
            <a class="@Active("/admin/components")" asp-page="/Admin/Components/Index">🧩 @T["nav.components"]</a>
            <a class="@Active("/admin/plugins")" asp-page="/Admin/Plugins/Index">🔌 @T["nav.plugins"]</a>
            <a class="@Active("/admin/mailtemplates")" asp-page="/Admin/MailTemplates/Index">✉️ @T["nav.mailtemplates"]</a>
            <a class="@Active("/admin/settings")" asp-page="/Admin/Settings/Index">⚙️ @T["nav.settings"]</a>
            <div class="admin-nav-sep" role="separator"></div>
            @* Verwaltung & System *@
            <a class="@Active("/admin/users")" asp-page="/Admin/Users/Index">👤 @T["nav.users"]</a>
            <a class="@Active("/admin/backup")" asp-page="/Admin/Backup/Index">💾 @T["nav.backup"]</a>
            @if (Plugins.AdminMenu.Count > 0)
            {
                <div class="admin-nav-plugins">
                    @foreach (var entry in Plugins.AdminMenu)
                    {
                        <a href="@entry.Url">@entry.Icon @entry.Label</a>
                    }
                </div>
            }
        </nav>
        <div class="admin-nav-foot">
            <div class="admin-foot-actions">
                <a class="admin-foot-btn admin-foot-icon" href="/" target="_blank" rel="noopener" title="@T["nav.viewSite"]" aria-label="@T["nav.viewSite"]">🌐</a>
                @if (cultures.Count > 1)
                {
                    <div class="admin-foot-lang" data-lang>
                        <button type="button" class="admin-foot-btn" data-lang-toggle aria-haspopup="true" aria-expanded="false" title="@T["admin.language"]">@currentCulture.ToUpperInvariant()</button>
                        <div class="admin-foot-lang-menu" data-lang-menu hidden>
                            @foreach (var c in cultures)
                            {
                                var lc = _uiLang(c);
                                <form method="post" action="/set-language">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <input type="hidden" name="culture" value="@lc" />
                                    <button type="submit" class="admin-lang-opt@(lc == currentCulture ? " is-current" : "")">@T["lang." + lc] <span class="muted mono">@lc.ToUpperInvariant()</span></button>
                                </form>
                            }
                        </div>
                    </div>
                }
                <form method="post" asp-page="/Logout" class="admin-foot-logout">
                    <button type="submit" class="admin-foot-btn">🚪 @T["nav.logout"]</button>
                </form>
            </div>
            <a class="admin-cms-foot" asp-page="/Admin/About/Index" title="@T["nav.about"]">
                <span class="cms">MatCMS</span>
                <span class="admin-version">v@(Version.Current)</span>
            </a>
        </div>
    </aside>
    <div class="admin-backdrop" data-admin-backdrop></div>

    <div class="admin-main">
        <header class="admin-topbar">
            <button type="button" class="admin-menu-toggle" data-admin-toggle aria-label="@T["nav.menu"]" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
            <div class="admin-topbar-title">@title</div>
            <div class="admin-topbar-right"></div>
        </header>
        @* The title the hidden bar would have shown is handed to the embedding page instead, so it
           can put it in ITS bar. Cross-origin, hence postMessage — the cloud cannot read this
           document, and should not have to. *@
        <script>
            if (window.self !== window.top) {
                try {
                    window.parent.postMessage({ type: 'mat-admin-title', title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(title)) }, '*');
                } catch (e) { }
            }
        </script>

        <main class="admin-content">
            @if (TempData["Flash"] is string flash && !string.IsNullOrWhiteSpace(flash))
            {
                <div class="alert alert-success">@flash</div>
            }
            @if (TempData["FlashError"] is string flashError && !string.IsNullOrWhiteSpace(flashError))
            {
                <div class="alert alert-error">@flashError</div>
            }
            @RenderBody()
        </main>
    </div>

    <script>
        // Mobile admin menu: off-canvas drawer toggle.
        (function () {
            var body = document.body;
            var toggle = document.querySelector('[data-admin-toggle]');
            var backdrop = document.querySelector('[data-admin-backdrop]');
            function setOpen(open) {
                body.classList.toggle('nav-open', open);
                if (toggle) toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            }
            if (toggle) toggle.addEventListener('click', function () { setOpen(!body.classList.contains('nav-open')); });
            if (backdrop) backdrop.addEventListener('click', function () { setOpen(false); });
            // Close when a nav link is followed.
            document.querySelectorAll('.admin-sidebar a').forEach(function (a) {
                a.addEventListener('click', function () { setOpen(false); });
            });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
        })();

        // Language dropdown in the sidebar footer (the "EN"/"DE" button).
        (function () {
            var wrap = document.querySelector('[data-lang]');
            if (!wrap) return;
            var btn = wrap.querySelector('[data-lang-toggle]');
            var menu = wrap.querySelector('[data-lang-menu]');
            function close() { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var open = menu.hidden;
                menu.hidden = !open; btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
            document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) close(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
        })();
    </script>
    <script src="~/js/media-picker.js" asp-append-version="true"></script>
    <script src="~/_content/MatCMS.Shared.Web/js/admin-list.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
