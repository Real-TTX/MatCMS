@page
@model MatCMS.Pages.Admin.Menus.IndexModel
@{
    ViewData["Title"] = T["menus.title"];
}
<div class="page-head">
    <h1>@T["menus.heading"]</h1>
</div>

<div class="card">
    <div class="block-list">
        @foreach (var menu in Model.Menus)
        {
            var count = Model.Counts.TryGetValue(menu.Key, out var c) ? c : 0;
            <a class="block-item block-item-link" asp-page="EditMenu" asp-route-id="@menu.Id">
                <div class="b-info">
                    <div class="b-type">@menu.Name</div>
                    <div class="b-sum mono">@menu.Key@(menu.Key == "toolbar" ? " · " + T["menus.toolbarMenu"] : "")</div>
                </div>
                <div class="actions">
                    <span class="badge badge-off">@count @T["menus.entries"]</span>
                    <span class="btn btn-sm btn-ghost">@T["menus.manage"]</span>
                </div>
            </a>
        }
    </div>
    <div class="list-actions">
        <a class="btn" asp-page="CreateMenu">@T["menus.newMenu"]</a>
    </div>
</div>
