@page "{id:int?}"
@model MatCMS.Cloud.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = Model.IsNew ? T["users.add"] : T["users.edit"];
}
@* Heading only: the way back sits next to the save button at the bottom, as in the CMS. *@
<div class="page-head">
    <h1>@ViewData["Title"]</h1>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post">
        <div class="form-field">
            <label for="Username">@T["users.username"]</label>
            <input id="Username" name="Username" value="@Model.Username" required />
        </div>
        <div class="form-field">
            <label for="Email">@T["users.email"]</label>
            <input id="Email" name="Email" type="email" value="@Model.Email" />
        </div>
        <div class="form-field">
            <label for="DisplayName">@T["users.displayName"]</label>
            <input id="DisplayName" name="DisplayName" value="@Model.DisplayName" />
        </div>
        <div class="form-field">
            <label for="Password">@T["users.password"]</label>
            <input id="Password" name="Password" type="password" placeholder="@(Model.IsNew ? "" : T["users.passwordKeep"])" />
        </div>
        <div class="form-field">
            <label for="Role">@T["users.role"]</label>
            <select id="Role" name="Role" data-role-select>
                <option value="Admin" selected="@(Model.Role == "Admin")">@T["users.roleAdmin"]</option>
                <option value="Operator" selected="@(Model.Role == "Operator")">@T["users.roleOperator"]</option>
            </select>
            <div class="help">@T["users.roleHelp"]</div>
        </div>
        <div class="form-field" data-operator-instances style="@(Model.Role == "Operator" ? "" : "display:none")">
            <label>@T["users.instances"]</label>
            <div class="help">@T["users.instancesHelp"]</div>
            @if (Model.AllInstances.Count == 0)
            {
                <p class="muted">@T["users.noInstances"]</p>
            }
            else
            {
                <div class="check-list">
                    @foreach (var i in Model.AllInstances)
                    {
                        <label class="check">
                            <input type="checkbox" name="InstanceIds" value="@i.Id" @(Model.InstanceIds.Contains(i.Id) ? "checked" : "") />
                            <span>@i.Name</span>
                        </label>
                    }
                </div>
            }
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">@T["common.save"]</button>
            <a class="btn btn-ghost" asp-page="Index">@T["common.back"]</a>
        </div>
    </form>
</div>
<script>
    (function () {
        var sel = document.querySelector('[data-role-select]');
        var box = document.querySelector('[data-operator-instances]');
        if (sel && box) sel.addEventListener('change', function () {
            box.style.display = sel.value === 'Operator' ? '' : 'none';
        });
    })();
</script>
