@page
@model MatCMS.Pages.Admin.IndexModel
@{
    ViewData["Title"] = T["dashboard.title"];
    var dashUser = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Admin";
}
<div class="page-head">
    <h1>@T["dashboard.title"]</h1>
    <div class="dash-actions" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <span class="muted">@T["dashboard.welcome"] <strong>@dashUser</strong></span>
        <a class="btn btn-sm" href="/" target="_blank" rel="noopener"><i class="ti ti-external-link" aria-hidden="true"></i> @T["dashboard.viewSite"]</a>
        <form method="post" asp-page="/Logout" class="inline-form" style="margin:0;">
            <button type="submit" class="btn btn-sm btn-ghost"><i class="ti ti-logout" aria-hidden="true"></i> @T["nav.logout"]</button>
        </form>
    </div>
</div>

@if (!Model.SetupComplete)
{
    <div class="alert alert-info setup-banner">
        <div>
            @Html.Raw(T["dashboard.setupBanner"])
        </div>
        <a class="btn btn-sm" asp-page="/Admin/Setup/Index">@T["dashboard.setupStart"]</a>
    </div>
}

<div class="stat-grid">
    <a class="stat" asp-page="/Admin/Pages/Index">
        <div class="n">@Model.PageCount</div>
        <div class="l">@T["dashboard.pages"]</div>
    </a>
    <a class="stat" asp-page="/Admin/Posts/Index">
        <div class="n">@Model.PostCount</div>
        <div class="l">@T["dashboard.posts"]</div>
    </a>
    <a class="stat" asp-page="/Admin/Media/Index">
        <div class="n">@Model.MediaCount</div>
        <div class="l">@T["dashboard.media"]</div>
    </a>
    <a class="stat" asp-page="/Admin/Forms/Index">
        <div class="n">@Model.UnreadCount</div>
        <div class="l">@T["dashboard.newSubmissions"]</div>
    </a>
    <a class="stat" asp-page="/Admin/Forms/Index">
        <div class="n">@Model.SubmissionCount</div>
        <div class="l">@T["dashboard.totalSubmissions"]</div>
    </a>
    <a class="stat" asp-page="/Admin/Users/Index">
        <div class="n">@Model.UserCount</div>
        <div class="l">@T["dashboard.users"]</div>
    </a>
</div>

<div class="card">
    <h2>@T["dashboard.cloud"]</h2>
    <div class="kv">
        <div class="kv-label">@T["dashboard.cloudStatus"]</div>
        <div class="kv-value">
            @if (Model.CloudConnected)
            {
                <span class="badge badge-on">@T["dashboard.cloudConnected"]</span>
                @if (Model.CloudOutOfSync)
                {
                    <span class="badge badge-new">@T["dashboard.cloudOutOfSync"]</span>
                }
                else
                {
                    <span class="badge badge-on">@T["dashboard.cloudSynced"]</span>
                }
            }
            else
            {
                <span class="badge badge-off">@T["dashboard.cloudDisconnected"]</span>
            }
        </div>
    </div>
    @if (Model.CloudConnected && Model.CloudLastSync is not null)
    {
        <div class="kv">
            <div class="kv-label">@T["dashboard.lastSync"]</div>
            <div class="kv-value muted">@Model.CloudLastSync.Value.ToString("dd.MM.yyyy HH:mm") UTC</div>
        </div>
    }
</div>

@if (Model.RecentSubmissions.Count > 0)
{
    <div data-list>
        <div class="page-head"><h2>@T["dashboard.recentSubmissions"]</h2></div>
        <table class="data" data-list-table>
            <thead>
                <tr>
                    <th style="width:160px;">@T["dashboard.time"]</th>
                    <th>@T["dashboard.formLabel"]</th>
                    <th style="width:110px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.RecentSubmissions)
                {
                    <tr>
                        <td class="muted mono">@s.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(s.Form?.Name ?? "—")</td>
                        <td>@if (!s.IsRead) { <span class="badge badge-new">@T["dashboard.unread"]</span> }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="list-actions"><a class="btn btn-ghost" asp-page="/Admin/Forms/Index">@T["dashboard.allSubmissions"]</a></div>
}

<div class="card">
    <h2>@T["dashboard.quickstart"]</h2>
    <p class="muted">
        @Html.Raw(T["dashboard.quickstartText"])
    </p>
</div>
