@inject MatCMS.Services.SiteContext Site
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Builder.RequestLocalizationOptions> LocOptions
@{
    var title = ViewData["Title"] as string ?? "Admin";
    string Active(string path) =>
        Context.Request.Path.StartsWithSegments(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Admin";

    // Language switcher: enumerate supported cultures (lights up once a 2nd language is added).
    var cultures = LocOptions.Value.SupportedUICultures ?? new System.Collections.Generic.List<System.Globalization.CultureInfo>();
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    // Brand wordmark is driven by the site name (not hardcoded); split roughly in half for the two-tone look.
    var brand = string.IsNullOrWhiteSpace(Site.SiteName) ? "MatCMS" : Site.SiteName;
    var brandSplit = (brand.Length + 1) / 2;
    var brandA = brand.Substring(0, brandSplit);
    var brandB = brand.Substring(brandSplit);
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title – @Site.SiteName Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@@500;600;700&family=Inter:wght@@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="icon" href="@Site.LogoUrl" />
</head>
<body class="admin">
    <aside class="admin-sidebar">
        <div class="admin-brand">
            <span class="wm">@brandA<span>@brandB</span></span>
            <span class="cms">MatCMS</span>
        </div>
        <nav class="admin-nav">
            <a class="@Active("/admin/pages")" asp-page="/Admin/Pages/Index">📄 @T["nav.pages"]</a>
            <a class="@Active("/admin/menus")" asp-page="/Admin/Menus/Index">🧭 @T["nav.menus"]</a>
            <a class="@Active("/admin/submissions")" asp-page="/Admin/Submissions/Index">✉️ @T["nav.submissions"]</a>
            <a class="@Active("/admin/forms")" asp-page="/Admin/Forms/Index">📝 @T["nav.forms"]</a>
            <a class="@Active("/admin/users")" asp-page="/Admin/Users/Index">👤 @T["nav.users"]</a>
            <a class="@Active("/admin/settings")" asp-page="/Admin/Settings/Index">⚙️ @T["nav.settings"]</a>
            <a class="@Active("/admin/templates")" asp-page="/Admin/Templates/Index">🎨 @T["nav.templates"]</a>
            <a class="@Active("/admin/backup")" asp-page="/Admin/Backup/Index">💾 @T["nav.backup"]</a>
        </nav>
        <div class="admin-nav-foot">
            <a href="/" target="_blank">🌐 @T["nav.viewSite"]</a>
            <form method="post" asp-page="/Logout">
                <button type="submit" class="linklike">🚪 @T["nav.logout"]</button>
            </form>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div class="admin-topbar-title">@title</div>
            <div class="admin-topbar-right">
                @if (cultures.Count > 1)
                {
                    <form class="lang-switch" method="post" action="/set-language">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <select name="culture" aria-label="@T["admin.language"]" onchange="this.form.submit()">
                            @foreach (var c in cultures)
                            {
                                var code = c.TwoLetterISOLanguageName;
                                <option value="@code" selected="@(code == currentCulture)">@T["lang." + code]</option>
                            }
                        </select>
                    </form>
                }
                <div class="admin-user">@T["admin.loggedInAs"] <strong>@displayName</strong></div>
            </div>
        </header>

        <main class="admin-content">
            @if (TempData["Flash"] is string flash && !string.IsNullOrWhiteSpace(flash))
            {
                <div class="alert alert-success">@flash</div>
            }
            @if (TempData["FlashError"] is string flashError && !string.IsNullOrWhiteSpace(flashError))
            {
                <div class="alert alert-error">@flashError</div>
            }
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
