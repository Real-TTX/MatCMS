@page "{id:int}"
@model MatCMS.Pages.Admin.Forms.SubmissionsModel
@{
    ViewData["Title"] = T["forms.submissionsTitle"];
}
<div class="page-head">
    <h1>@Model.Current.Name – @T["forms.submissions"]</h1>
    <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="card"><p class="muted">@T["forms.noSubmissions"]</p></div>
}
else
{
    <table class="data">
        <thead>
            <tr>
                <th>@T["submissions.colDate"]</th>
                <th>@T["forms.colData"]</th>
                <th>@T["submissions.colStatus"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Items)
            {
                <tr class="@(s.IsRead ? "" : "row-unread")">
                    <td class="muted">@s.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <dl class="sub-fields">
                            @foreach (var f in s.Fields)
                            {
                                <dt>@f.Label</dt>
                                <dd>@(string.IsNullOrWhiteSpace(f.Value) ? "—" : f.Value)</dd>
                            }
                        </dl>
                    </td>
                    <td>
                        @if (!s.IsRead)
                        {
                            <span class="badge badge-new">@T["submissions.new"]</span>
                        }
                        else
                        {
                            <span class="badge badge-off">@T["submissions.read"]</span>
                        }
                    </td>
                    <td>
                        <div class="actions">
                            <form class="inline-form" method="post" asp-page-handler="ToggleRead" asp-route-id="@Model.Current.Id" asp-route-subId="@s.Id">
                                <button type="submit" class="btn btn-sm btn-ghost">@(s.IsRead ? T["submissions.markNew"] : T["submissions.markRead"])</button>
                            </form>
                            <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@Model.Current.Id" asp-route-subId="@s.Id" onsubmit="return confirm('@T["submissions.confirmDelete"]');">
                                <button type="submit" class="btn btn-sm btn-danger">@T["action.delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
