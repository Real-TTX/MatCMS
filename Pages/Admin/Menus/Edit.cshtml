@page "{id:int}"
@model MatCMS.Pages.Admin.Menus.EditModel
@{
    ViewData["Title"] = "Menüpunkt bearbeiten";
}
<div class="page-head">
    <h1>Menüpunkt bearbeiten</h1>
    <a class="btn btn-sm btn-ghost" asp-page="Index">Zurück</a>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" class="form-grid">
        <div class="form-row">
            <div class="form-field">
                <label for="Menu">Menü</label>
                <select id="Menu" name="Menu">
                    <option value="header" selected="@(Model.Menu == "header" ? "selected" : null)">Hauptmenü (Header)</option>
                    <option value="footer" selected="@(Model.Menu == "footer" ? "selected" : null)">Footer-Menü</option>
                </select>
            </div>
            <div class="form-field">
                <label for="page-picker">Schnellauswahl: Seite</label>
                <select id="page-picker">
                    <option value="">— eigene URL —</option>
                    @foreach (var p in Model.Pages)
                    {
                        var purl = p.Slug == "home" ? "/" : "/" + p.Slug;
                        <option value="@purl" data-title="@p.Title">@p.Title</option>
                    }
                </select>
                <div class="help">Setzt das Ziel (URL) aus einer Seite.</div>
            </div>
        </div>
        <div class="form-field">
            <label for="mi-label">Label (Menütext)</label>
            <input id="mi-label" name="Label" value="@Model.Label" required />
        </div>
        <div class="form-field">
            <label for="mi-url">Ziel (URL)</label>
            <input id="mi-url" name="Url" value="@Model.Url" placeholder="/kontakt oder https://…" required />
        </div>
        <label class="check">
            <input type="checkbox" name="OpenInNewTab" value="true" @(Model.OpenInNewTab ? "checked" : "") /> In neuem Tab öffnen
        </label>
        <div>
            <button type="submit" class="btn">Speichern</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var picker = document.getElementById("page-picker");
            var label = document.getElementById("mi-label");
            var url = document.getElementById("mi-url");
            if (!picker) return;
            picker.addEventListener("change", function () {
                if (!picker.value) return;
                url.value = picker.value;
                var opt = picker.options[picker.selectedIndex];
                if (!label.value) label.value = opt.getAttribute("data-title") || "";
            });
        })();
    </script>
}
