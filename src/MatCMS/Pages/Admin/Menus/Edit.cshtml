@page "{id:int}"
@model MatCMS.Pages.Admin.Menus.EditModel
@{
    ViewData["Title"] = T["menus.edit"];
    var vm = new MatCMS.Pages.Admin.Menus.MenuItemFormVm
    {
        Menu = Model.Menu,
        Label = Model.Label,
        Url = Model.Url,
        Icon = Model.Icon,
        OpenInNewTab = Model.OpenInNewTab,
        ParentId = Model.ParentId,
        ParentOptions = Model.ParentOptions,
        Menus = Model.Menus,
        Pages = Model.Pages,
        QuickPickHelpKey = "menus.quickPickHelpEdit",
        SubmitLabelKey = "action.save",
        AutofocusLabel = false,
        // Zurück führt dorthin, wo man hergekommen ist: zu dem Menü, in dem der Eintrag steht —
        // und nur ohne dieses Menü zur Übersicht.
        BackUrl = Model.MenuId is int backId
            ? Url.Page("EditMenu", new { id = backId, locale = Model.ItemLocale })!
            : Url.Page("Index")!
    };
}
@* Nur die Überschrift: der Weg zurück steht unten neben dem Speichern-Knopf, wie im Plugin-Editor. *@
<div class="page-head">
    <h1>
        @T["menus.edit"]
        <span class="badge badge-on mono" style="margin-left:8px;font-size:12px;vertical-align:middle;">@MatCMS.Services.Localizer.DisplayName(Model.ItemLocale) (@Model.ItemLocale.ToUpperInvariant())</span>
    </h1>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <partial name="_MenuItemForm" model="vm" />
</div>
