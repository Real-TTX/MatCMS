@page
@model MatCMS.Cloud.Pages.Admin.Hosting.SettingsModel
@using MatCMS.Cloud.Services
@{
    ViewData["Title"] = T["hosting.title"];
}
<partial name="_HostingTabs" model='"settings"' />

@* Only what applies to hosting as a whole. A host's proxy, ports and naming are on its page (Hosting → Hosts). *@
<form method="post" asp-page-handler="Module">
    <div class="card">
        <h2>@T["hosting.module"]</h2>
        <label class="checkbox-row">
            <input type="checkbox" name="hostingEnabled" value="true" checked="@(Model.ModuleEnabled ? "checked" : null)" />
            @T["settings.hostingEnabled"]
        </label>
        <div class="help">@T["settings.hostingEnabledHint"]</div>
        <div style="margin-top:14px;"><button type="submit" class="btn">@T["settings.save"]</button></div>
    </div>
</form>

@* Automatic updates are an operating rule, not a notification — who is TOLD about updates is the matrix. *@
<form method="post" asp-page-handler="Auto">
    <div class="card">
        <h2>@T["updates.auto"]</h2>
        <label class="checkbox-row">
            <input type="checkbox" name="autoUpdate" value="true" checked="@(Model.AutoUpdate ? "checked" : null)" />
            @T["settings.autoUpdateLocal"]
        </label>
        <div class="help">@T["settings.autoUpdateLocalHint"]</div>
        <div style="margin-top:14px;"><button type="submit" class="btn">@T["settings.save"]</button></div>
    </div>
</form>
