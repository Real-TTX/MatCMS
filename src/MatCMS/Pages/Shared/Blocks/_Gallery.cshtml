@model MatCMS.Content.BlockData
@inject MatCMS.Services.PublicContentService PublicContent
@inject MatCMS.Services.Localizer T
@inject MatCMS.Services.MediaFocus Focus
@{
    var heading = Model.Str("heading");
    var layout = Model.StrOr("layout", "grid");
    var columns = Model.StrOr("columns", "3");
    var source = Model.StrOr("source", "manual");
    var showFilter = Model.StrOr("showFilter", "yes") != "no";
    // Opt-in, default off: a filmstrip appearing under every existing customer gallery after an
    // update is a redesign nobody asked for. Stored blocks have no "strip" key at all, so they read
    // back as "no" and render exactly as before.
    var strip = Model.StrOr("strip", "no") == "yes";

    static string SafeSrc(string image) =>
        (!string.IsNullOrWhiteSpace(image)
            && (image.StartsWith("/") || image.StartsWith("http://") || image.StartsWith("https://"))
            && image.IndexOfAny(new[] { '\'', '"', '(', ')', '\\', '\n', '\r' }) < 0)
            ? image : "";

    // Collect gallery items from either the manual list or the media library (by tag).
    var items = new List<(string Src, string Alt, string Caption, string Tags)>();
    var filterTags = new List<string>();

    if (source == "media")
    {
        var wanted = MatCMS.Content.TagUtil.Split(Model.Str("tags")).ToList();
        foreach (var m in await PublicContent.ListMediaAsync(wanted))
        {
            var src = SafeSrc(m.Url);
            if (src.Length == 0) continue;
            items.Add((src, m.Alt ?? "", "", string.Join(" ", m.Tags)));
        }
        // The block's own filter tag(s) select which media appear; they'd be redundant as filter
        // buttons (every shown item has them), so offer only the remaining tags (e.g. room categories)
        // as filters — and none at all when there are no sub-categories.
        filterTags = items.SelectMany(i => i.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            .Where(t => !wanted.Contains(t, StringComparer.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(t => t, StringComparer.OrdinalIgnoreCase).ToList();
    }
    else
    {
        foreach (var item in Model.List("images"))
        {
            var src = SafeSrc(item.Str("image"));
            if (src.Length == 0) continue;
            items.Add((src, item.Str("alt"), item.Str("caption"), ""));
        }
    }

    var cls = "gallery gallery--" + (layout == "masonry" ? "masonry" : "grid") + " cols-" + columns;
    // The option rides in the VALUE of the group attribute, not in a second data-strip attribute.
    // Razor does not drop an attribute just because its value is null (measured: it emits
    // data-strip=""), so a separate flag would leave an empty attribute on every existing gallery
    // that never switched the option on. The group attribute has to be there either way.
    string? group = strip ? "strip" : null;

    // Carousel layout: a horizontal, swipeable strip with desktop arrows (carousel.js). "vary" keeps
    // each image's aspect ratio (variable width, whole image, no crop); "uniform" crops to equal tiles.
    // "single" = one image at a time, paged like an Instagram post: full width, no scrollbar, arrows only on hover,
    // dots + counter. Same track and script as the carousel, so swipe, snap, lightbox and autoplay come along.
    var isSingle = layout == "single";
    var isCarousel = layout == "carousel" || isSingle;
    var carVary = Model.StrOr("carouselFit", "uniform") == "vary";
    var autoplay = Model.StrOr("autoplay", "off") == "on";
}
<section class="section gallery-block">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(heading))
        {
            <div class="section__intro"><h2>@heading</h2></div>
        }
        @if (showFilter && filterTags.Count > 0)
        {
            <div class="gallery-filter" data-gallery-filter>
                <button type="button" class="gfilter active" data-tag="">@T["gallery.all"]</button>
                @foreach (var t in filterTags)
                {
                    <button type="button" class="gfilter" data-tag="@t">@t</button>
                }
            </div>
        }
        @* data-lightbox-group closes this gallery off: prev/next stay inside THIS block. Before, the
           lightbox collected every [data-lightbox] on the page, so two gallery blocks under each other
           were silently one chain and "weiter" walked out of the gallery the visitor had opened. *@
        @if (isCarousel)
        {
            <div class="gallery-carousel@(isSingle ? " is-single" : carVary ? " is-vary" : "")" data-carousel data-gallery data-lightbox-group="carousel"
                 data-prev="@T["carousel.prev"]" data-next="@T["carousel.next"]"@(autoplay ? " data-autoplay" : "")
                 @(isSingle ? Html.Raw($" data-dots data-slide-label=\"{System.Net.WebUtility.HtmlEncode(T["carousel.slide"].ToString())}\"") : null)>
                <div class="gallery-track" data-carousel-track>
                    @foreach (var it in items)
                    {
                        var cfocus = Focus.Position(it.Src);
                        <figure class="gallery-slide" data-tags="@it.Tags">
                            <a href="@it.Src" class="gallery__link" data-lightbox data-caption="@it.Caption">
                                <img src="@MatCMS.Services.ThumbnailService.Url(it.Src, 1400)" alt="@it.Alt" loading="lazy" style="@(string.IsNullOrEmpty(cfocus) ? null : "object-position:" + cfocus)" />
                            </a>
                            @if (!string.IsNullOrWhiteSpace(it.Caption))
                            {
                                <figcaption>@it.Caption</figcaption>
                            }
                        </figure>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="@cls" data-gallery data-lightbox-group="@group">
                @foreach (var it in items)
                {
                    // Whole-attribute-or-nothing, and a null IHtmlContent in CONTENT position writes
                    // nothing — the only way to leave the tag of an unchanged gallery untouched. Html.Raw
                    // is safe here: SafeSrc above already rejected quotes, parentheses and backslashes,
                    // and the URL builder only prefixes a fixed path.
                    var thumbAttr = strip
                        ? Html.Raw($" data-thumb=\"{MatCMS.Services.ThumbnailService.Url(it.Src, 320)}\"")
                        : null;
                    <figure class="gallery__item" data-tags="@it.Tags">
                        @{ var gfocus = Focus.Position(it.Src); }
                        <a href="@it.Src" class="gallery__link" data-lightbox data-caption="@it.Caption"@thumbAttr>
                            <img src="@MatCMS.Services.ThumbnailService.Url(it.Src, 1200)" alt="@it.Alt" loading="lazy" style="@(string.IsNullOrEmpty(gfocus) ? null : "object-position:" + gfocus)" />
                        </a>
                        @if (!string.IsNullOrWhiteSpace(it.Caption))
                        {
                            <figcaption>@it.Caption</figcaption>
                        }
                    </figure>
                }
            </div>
        }
    </div>
</section>
@if (isCarousel)
{
    <style>
        /* Gallery carousel: swipeable strip + desktop arrows (carousel.js). "vary" keeps each image's
           aspect (variable width, whole image); default crops to equal-width tiles via the focal point. */
        .gallery-carousel { position: relative; }
        .gallery-track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory;
            padding-bottom: 12px; scrollbar-width: thin; }
        .gallery-slide { margin: 0; flex: 0 0 auto; scroll-snap-align: start; }
        .gallery-slide .gallery__link { display: block; }
        .gallery-slide img { display: block; height: 380px; border-radius: 14px; box-shadow: 0 6px 20px rgba(0,0,0,.12); }
        .gallery-carousel:not(.is-vary) .gallery-slide img { width: 500px; object-fit: cover; }
        .gallery-carousel.is-vary .gallery-slide img { width: auto; max-width: 82vw; object-fit: contain; background: var(--bg-alt, #f1efe9); }
        .gallery-slide figcaption { margin-top: 8px; text-align: center; font-size: 14px; color: var(--muted, #6b7280); }
        .gallery-carousel .carousel-btn { position: absolute; top: 190px; transform: translateY(-50%); z-index: 3;
            width: 44px; height: 44px; border-radius: 50%; border: 1px solid #e2d6c3; background: #fff; cursor: pointer;
            font-size: 22px; line-height: 1; box-shadow: 0 4px 14px rgba(0,0,0,.16); display: flex; align-items: center; justify-content: center; }
        .gallery-carousel .carousel-btn[disabled] { opacity: .35; cursor: default; }
        .gallery-carousel .carousel-btn.prev { left: -6px; }
        .gallery-carousel .carousel-btn.next { right: -6px; }
        @@media (max-width: 700px) {
            .gallery-slide img { height: 260px; }
            .gallery-carousel:not(.is-vary) .gallery-slide img { width: 320px; }
        }
        /* "single": one image at a time, like an Instagram post. The frame is 4:5 (Instagram's portrait format);
           other formats sit inside it whole (contain), never cropped. No scrollbar, arrows only while the pointer is
           over it (touch devices swipe), dots and a counter instead. */
        .gallery-carousel.is-single { max-width: min(100%, 620px, calc(82vh * .8)); margin: 0 auto; }
        .gallery-carousel.is-single .gallery-track { gap: 0; padding-bottom: 0; scrollbar-width: none; -ms-overflow-style: none;
            border-radius: 14px; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; }
        .gallery-carousel.is-single .gallery-track::-webkit-scrollbar { display: none; }
        .gallery-carousel.is-single .gallery-slide { flex: 0 0 100%; scroll-snap-align: center; scroll-snap-stop: always; }
        .gallery-carousel.is-single .gallery-slide img { width: 100%; height: auto; max-width: none; aspect-ratio: 4 / 5;
            object-fit: contain; border-radius: 0; box-shadow: none; background: transparent; }
        .gallery-carousel.is-single .carousel-btn { top: calc(50% - 14px); opacity: 0; pointer-events: none;
            transition: opacity .2s ease; background: rgba(255,255,255,.92); border-color: transparent; }
        .gallery-carousel.is-single .carousel-btn.prev { left: 10px; }
        .gallery-carousel.is-single .carousel-btn.next { right: 10px; }
        .gallery-carousel.is-single:hover .carousel-btn:not([disabled]),
        .gallery-carousel.is-single .carousel-btn:focus-visible { opacity: 1; pointer-events: auto; }
        @@media (hover: none) { .gallery-carousel.is-single .carousel-btn { display: none; } }
        .gallery-carousel .carousel-count { position: absolute; top: 12px; right: 12px; z-index: 3; padding: 3px 10px;
            border-radius: 999px; background: rgba(0,0,0,.55); color: #fff; font-size: 12px; line-height: 1.6; pointer-events: none; }
        .gallery-carousel .carousel-dots { display: flex; justify-content: center; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
        /* Mid grey reads on light and dark themes alike (the text colour does not — a dark theme's gallery section can
           inherit a dark one); the current dot takes the template's accent. */
        .gallery-carousel .carousel-dot { width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%; cursor: pointer;
            background: #8a8a8a; opacity: .55; transition: opacity .2s ease, transform .2s ease, background-color .2s ease; }
        .gallery-carousel .carousel-dot.is-active { opacity: 1; transform: scale(1.3); background: var(--accent, #8a8a8a); }
    </style>
}
