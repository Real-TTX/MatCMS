@page "{id:int}"
@using MatCMS.Content
@model MatCMS.Pages.Admin.Forms.EditModel
@{
    ViewData["Title"] = T["forms.editorTitle"];
    var editing = Model.SelectedElement is not null;
    var previewUrl = $"/admin/forms/preview/{Model.Current.Id}?builder=1";

    string TypeName(string t) => T["forms.el." + t + ".name"];
    string ElSummary(FormElement e)
    {
        var lbl = string.IsNullOrWhiteSpace(e.Label) ? T["editor.blockEmpty"] : e.Label;
        if (e.Type == "group") return $"{lbl} · {e.Fields.Count} {T["forms.fieldsShort"]}";
        return lbl;
    }
}

<div class="live-editor form-builder@(editing ? " editing" : "")" data-form-id="@Model.Current.Id" data-selected-element="@(Model.SelectedElement?.Id)">
    <aside class="le-sidebar">
        @if (editing)
        {
            var sel = Model.SelectedElement!;
            <div class="le-head">
                <a class="le-back" asp-page="Edit" asp-route-id="@Model.Current.Id">@T["forms.allElements"]</a>
            </div>
            <div class="le-panel">
                <div class="le-panel-head">
                    <span class="le-panel-title">@TypeName(sel.Type)</span>
                </div>
                <form id="element-form" method="post" asp-page-handler="SaveElement" asp-route-id="@Model.Current.Id" asp-route-elementId="@sel.Id">
                    <input type="hidden" name="ElementJson" id="ElementJson" />
                    <div id="element-editor"></div>
                </form>
                @* Same compact icon action row as the block editor: delete left, save + done right. *@
                <div class="le-panel-actions">
                    <form class="inline-form le-delete" method="post" asp-page-handler="DeleteElement" asp-route-id="@Model.Current.Id" asp-route-elementId="@sel.Id" onsubmit="return confirm('@T["forms.confirmDeleteElement"]');">
                        <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["forms.deleteElement"]" aria-label="@T["forms.deleteElement"]"><i class="ti ti-trash" aria-hidden="true"></i></button>
                    </form>
                    <button type="submit" form="element-form" class="btn btn-sm btn-icon le-save" title="@T["action.save"]" aria-label="@T["action.save"]"><i class="ti ti-device-floppy" aria-hidden="true"></i></button>
                    <a class="btn btn-sm btn-ghost btn-icon" asp-page="Edit" asp-route-id="@Model.Current.Id" title="@T["editor.done"]" aria-label="@T["editor.done"]"><i class="ti ti-check" aria-hidden="true"></i></a>
                </div>
            </div>
            <script id="element-data" type="application/json">@Html.Raw(Model.ElementJsonData.Replace("</", "<\\/"))</script>
            <script id="available-fields" type="application/json">@Html.Raw(Model.AvailableFieldsJson.Replace("</", "<\\/"))</script>
            <script id="element-type" type="application/json">"@sel.Type"</script>
            @* All elements as the client draft — the live preview re-renders this on every edit. *@
            <script id="form-elements" type="application/json">@Html.Raw(FormDefinition.Serialize(Model.Elements).Replace("</", "<\\/"))</script>
        }
        else
        {
            <div class="le-head">
                <a class="le-back" asp-page="Index">@T["forms.backToForms"]</a>
                <div class="le-title">@Model.Current.Name</div>
            </div>

            <div class="le-scroll">
                <div class="le-section-label">@T["forms.elements"]</div>
                @if (Model.Elements.Count == 0)
                {
                    <p class="muted" style="padding:0 4px;">@T["forms.noElements"]</p>
                }
                <div class="block-list sortable" id="element-list" data-sortable data-reorder-form="reorder-form">
                    @foreach (var e in Model.Elements)
                    {
                        var svg = MatCMS.Pages.Admin.Forms.EditModel.ElementTypes.FirstOrDefault(t => t.Type == e.Type).Svg;
                        <div class="block-item sortable-item" data-item-id="@e.Id" data-element-id="@e.Id">
                            <span class="drag-handle" title="@T["editor.dragToSort"]" aria-hidden="true">⠿</span>
                            <a class="b-open" asp-page="Edit" asp-route-id="@Model.Current.Id" asp-route-element="@e.Id">
                                <span class="b-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(svg)</svg>
                                </span>
                                <span class="b-info">
                                    <span class="b-type">@TypeName(e.Type)</span>
                                    <span class="b-sum">@ElSummary(e)</span>
                                </span>
                            </a>
                            <form class="inline-form" method="post" asp-page-handler="DeleteElement" asp-route-id="@Model.Current.Id" asp-route-elementId="@e.Id" onsubmit="return confirm('@T["forms.confirmDeleteElement"]');">
                                <button type="submit" class="icon-btn" title="@T["editor.delete"]">✕</button>
                            </form>
                        </div>
                    }
                </div>
                <form id="reorder-form" method="post" asp-page-handler="Reorder" asp-route-id="@Model.Current.Id" style="display:none;">
                    <div data-order-inputs></div>
                </form>

                <div class="le-add">
                    <button type="button" class="btn btn-block" id="add-element-btn">@T["forms.addElement"]</button>
                </div>

                <details class="le-settings">
                    <summary>@T["forms.settings"]</summary>
                    <form method="post" asp-page-handler="Meta" asp-route-id="@Model.Current.Id" class="form-grid">
                        <div class="form-field">
                            <label>@T["forms.nameField"]</label>
                            <input name="Meta.Name" value="@Model.Meta.Name" required />
                        </div>
                        <div class="form-field">
                            <label>@T["forms.slug"]</label>
                            <input name="Meta.Slug" value="@Model.Meta.Slug" required />
                        </div>
                        <div><button type="submit" class="btn btn-sm">@T["action.save"]</button></div>
                    </form>
                </details>

                <details class="le-settings">
                    <summary>@T["forms.notifyTitle"]</summary>
                    <form method="post" asp-page-handler="Settings" asp-route-id="@Model.Current.Id" class="form-grid">
                        <div class="form-field">
                            <label>@T["forms.successMessage"]</label>
                            <textarea name="Settings.SuccessMessage" rows="2" placeholder="@T["forms.successPlaceholder"]">@Model.Settings.SuccessMessage</textarea>
                            <div class="help">@T["forms.successHelp"]</div>
                        </div>
                        <div class="form-field">
                            <label>@T["forms.submitLabel"]</label>
                            <input type="text" name="Settings.SubmitLabel" value="@Model.Settings.SubmitLabel" placeholder="@T["form.submit"]" />
                            <div class="help">@T["forms.submitLabelHelp"]</div>
                        </div>
                        <div class="form-field">
                            <label class="check">
                                <input type="checkbox" name="Settings.NotifyEnabled" value="true" @(Model.Settings.NotifyEnabled ? "checked" : "") />
                                <span>@T["forms.notifyEnable"]</span>
                            </label>
                            <div class="help">@T["forms.notifyHelp"]</div>
                        </div>
                        <div class="form-field">
                            <label>@T["forms.notifyUsers"]</label>
                            @if (Model.AllUsers.Count == 0)
                            {
                                <p class="muted">@T["forms.notifyNoUsers"]</p>
                            }
                            else
                            {
                                <div class="check-list">
                                    @foreach (var u in Model.AllUsers)
                                    {
                                        var hasEmail = !string.IsNullOrWhiteSpace(u.Email);
                                        <label class="check@(hasEmail ? "" : " is-muted")">
                                            <input type="checkbox" name="Settings.NotifyUserIds" value="@u.Id"
                                                   @(Model.Settings.NotifyUserIds.Contains(u.Id) ? "checked" : "") @(hasEmail ? "" : "disabled") />
                                            <span>@(string.IsNullOrWhiteSpace(u.DisplayName) ? u.Username : u.DisplayName)</span>
                                            <span class="muted">@(hasEmail ? u.Email : T["forms.notifyNoEmail"])</span>
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                        <div class="form-field">
                            <label>@T["forms.notifyEmails"]</label>
                            <textarea name="Settings.NotifyEmails" rows="2" placeholder="@T["forms.notifyPlaceholder"]">@Model.Settings.NotifyEmails</textarea>
                            <div class="help">@T["forms.notifyEmailsHelp"]</div>
                        </div>
                        <div><button type="submit" class="btn btn-sm">@T["action.save"]</button></div>
                    </form>
                </details>
            </div>

            @* Add-element modal *@
            <div class="modal-overlay" id="add-element-modal">
                <div class="modal" role="dialog" aria-modal="true" aria-label="@T["forms.addElement"]">
                    <div class="modal-head">
                        <h2>@T["forms.addElement"]</h2>
                        <button type="button" class="modal-close" id="add-element-close" aria-label="@T["editor.close"]">✕</button>
                    </div>
                    <div class="modal-body bpick">
                        @{
                            var elCat = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                            {
                                ["title"] = "text", ["description"] = "text", ["text"] = "text", ["textarea"] = "text",
                                ["number"] = "input", ["phone"] = "input", ["email"] = "input",
                                ["select"] = "choice", ["richselect"] = "choice", ["multiselect"] = "choice",
                                ["date"] = "date", ["daterange"] = "date",
                                ["group"] = "layout"
                            };
                            string ElCat(string t) => elCat.TryGetValue(t, out var c) ? c : "input";
                            var elTypes = MatCMS.Pages.Admin.Forms.EditModel.ElementTypes;
                            var elOrder = new[] { "text", "input", "choice", "date", "layout" };
                            var elPresent = elOrder.Where(k => elTypes.Any(e => ElCat(e.Type) == k)).ToList();
                        }
                        <div class="bpick-search">
                            <svg class="bpick-sico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
                            <input type="search" id="fpick-search" placeholder="@T["editor.searchBlocks"]" autocomplete="off" />
                        </div>
                        <div class="bpick-layout">
                            <aside class="bpick-cats">
                                <button type="button" class="bpick-cat is-active" data-cat="all"><span class="bpick-clabel">@T["blockcat.all"]</span><span class="bpick-n">@elTypes.Length</span></button>
                                @foreach (var k in elPresent)
                                {
                                    <button type="button" class="bpick-cat" data-cat="@k"><span class="bpick-clabel">@T["formcat." + k]</span><span class="bpick-n">@elTypes.Count(e => ElCat(e.Type) == k)</span></button>
                                }
                            </aside>
                            <div class="bpick-main">
                                @foreach (var k in elPresent)
                                {
                                    <section class="bpick-group" data-group="@k">
                                        <div class="bpick-grouphead">@T["formcat." + k]</div>
                                        <div class="bpick-grid">
                                            @foreach (var t in elTypes.Where(e => ElCat(e.Type) == k))
                                            {
                                                <form method="post" asp-page-handler="AddElement" asp-route-id="@Model.Current.Id" asp-route-type="@t.Type">
                                                    <button type="submit" class="tile" data-cat="@ElCat(t.Type)"
                                                            title="@T["forms.el." + t.Type + ".desc"]"
                                                            data-name="@(((string)TypeName(t.Type)).ToLowerInvariant())"
                                                            data-desc="@(((string)T["forms.el." + t.Type + ".desc"]).ToLowerInvariant())">
                                                        <span class="t-icon">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(t.Svg)</svg>
                                                        </span>
                                                        <span class="t-name">@TypeName(t.Type)</span>
                                                        <span class="t-desc">@T["forms.el." + t.Type + ".desc"]</span>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </section>
                                }
                                <p class="bpick-empty" hidden>@T["editor.noBlocksFound"]</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </aside>

    <main class="le-preview">
        <div class="le-toolbar">
            <span class="le-url mono">@T["forms.previewLabel"]</span>
        </div>
        <div class="le-frame-wrap">
            <iframe id="preview-frame" src="@previewUrl" title="@T["editor.livePreview"]"></iframe>
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/admin-sortable.js" asp-append-version="true"></script>
    <script src="~/js/admin-form-builder.js" asp-append-version="true"></script>
}
