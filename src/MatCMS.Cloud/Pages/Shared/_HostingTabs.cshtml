@model string
@inject MatCMS.Cloud.Services.CloudContext Cloud
@* Hosting is ONE menu item; its areas are tabs. Each tab is its own page (they are long and have their own
   handlers), so the tabs are links — the same look as the in-page tabs elsewhere. Nodes, Domains and Proxy belong to
   the optional module and only appear while it is switched on; the dashboard (with the updates), Instanzen and
   Docker are there regardless, because running and updating the sites on this host predates the module. *@
@{
    var on = Cloud.Flag(MatCMS.Cloud.Services.SettingKeys.HostingEnabled);
    string Cls(string key) => key == Model ? "tab active" : "tab";
}
<nav class="tabs">
    <a class="@Cls("overview")" asp-page="/Admin/Hosting/Index">@T["hosting.navOverview"]</a>
    @if (on)
    {
        <a class="@Cls("nodes")" asp-page="/Admin/Hosting/Nodes/Index">@T["nodes.title"]</a>
    }
    <a class="@Cls("instances")" asp-page="/Admin/Hosting/Instances">@T["nav.instances"]</a>
    @if (on)
    {
        <a class="@Cls("domains")" asp-page="/Admin/Hosting/Domains">@T["hosting.navDomains"]</a>
        <a class="@Cls("proxy")" asp-page="/Admin/Hosting/Proxy">Proxy</a>
    }
    <a class="@Cls("docker")" asp-page="/Admin/Hosting/Docker">Docker</a>
    <a class="@Cls("settings")" asp-page="/Admin/Hosting/Settings">@T["hosting.navSettings"]</a>
</nav>
