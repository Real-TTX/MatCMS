@page "/{slug?}"
@model MatCMS.Pages.ViewModel
@{
    // Editor preview mode: only for admins, adds per-block wrappers + inspector highlighting.
    var http = ViewContext.HttpContext;
    var editor = http.Request.Query.ContainsKey("editor") && http.User.IsInRole("Admin");
    // Tell the admin bar which page this is, so it can offer a direct "edit this page" link.
    ViewData["AdminEditPageId"] = Model.CurrentPage.Id;
}
@if (!string.IsNullOrWhiteSpace(Model.CurrentPage.CustomCss))
{
    @* Page-specific CSS: this <style> is only emitted on this page's own response, so it is
       naturally scoped to the page. Admin-entered and output raw (like the template's CustomCss);
       the </style guard prevents an early tag close from breaking out into HTML. *@
    <style>@Html.Raw(System.Text.RegularExpressions.Regex.Replace(Model.CurrentPage.CustomCss, "</\\s*style", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase))</style>
}
@if (editor)
{
    <div id="mat-blocks">
        @await Html.PartialAsync("_BlockList", new MatCMS.Content.BlockListModel(Model.CurrentPage.Blocks, Model.Registry, true))
    </div>
}
else
{
    @await Html.PartialAsync("_BlockList", new MatCMS.Content.BlockListModel(Model.CurrentPage.Blocks, Model.Registry, false))
}

@if (editor)
{
    <style>
        /* Editor mode: only blocks are interactive — everything else (header, menu, footer) is off-limits. */
        html { cursor: not-allowed; }
        .mat-ed-block { position: relative; }
        .mat-ed-block::after {
            content: attr(data-block-name);
            position: absolute; top: 6px; left: 6px; z-index: 9998;
            background: #2563eb; color: #fff; font: 600 11px/1 Inter, sans-serif;
            padding: 4px 8px; border-radius: 5px; letter-spacing: .03em;
            opacity: 0; transform: translateY(-4px); transition: opacity .12s ease, transform .12s ease;
            pointer-events: none;
        }
        .mat-ed-block { cursor: pointer; }
        /* Subtle hover affordance — clearly different from the solid "selected" outline. */
        .mat-ed-block:hover { outline: 1px dashed rgba(37, 99, 235, .5); outline-offset: -1px; }
        .mat-ed-block:hover::after { opacity: 1; transform: translateY(0); }
        .mat-ed-block.mat-selected { outline: 3px solid #2563eb; outline-offset: -3px; }
        .mat-ed-block.mat-selected:hover { outline: 3px solid #2563eb; }
        .mat-ed-block.mat-flash { animation: matFlash 1s ease; }
        /* Children of a container (editor v2): the mark sits on a display:contents wrapper, so the hover
           and the selection go on the element it wraps. */
        .mat-ed-child > *:hover { outline: 1px dashed rgba(37, 99, 235, .6); outline-offset: 2px; }
        .mat-sel-child { outline: 2px solid #2563eb !important; outline-offset: 2px; }
        /* Typing in place: a calm frame, the text cursor back, no hover dashes. */
        .mat-inline { outline: 2px solid #f59e0b !important; outline-offset: 3px; cursor: text !important; background: rgba(245, 158, 11, .06); }
        .mat-ed-child .el-heading :is(h1, h2, h3, h4), .mat-ed-child .el-text, .mat-ed-child .el-btn { cursor: pointer; }
        /* An element that renders nothing yet (image without image, empty column) — clickable stand-in. */
        .mat-ed-empty { min-height: 56px; display: flex; align-items: center; justify-content: center; border: 1.5px dashed rgba(37, 99, 235, .45); border-radius: 8px; color: rgba(37, 99, 235, .85); font: 600 12px/1.2 Inter, sans-serif; background: rgba(37, 99, 235, .05); padding: 10px; }
        /* Insert-between-blocks zones (page-builder style) shown in the preview. */
        .mat-insert { display: block; width: 100%; border: none; background: none; padding: 0; margin: 0; cursor: pointer; position: relative; height: 22px; opacity: 0; transition: opacity .12s ease; z-index: 9997; }
        .mat-insert::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 3px; background: #2563eb; border-radius: 3px; transform: translateY(-50%); }
        .mat-insert span { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 1; font: 700 11px/1 Inter, sans-serif; background: #2563eb; color: #fff; padding: 4px 14px; border-radius: 999px; white-space: nowrap; box-shadow: 0 2px 8px rgba(37,99,235,.4); opacity: 0; transition: opacity .12s ease; }
        /* When the pointer is over the preview, the insert zones become clearly visible (line only);
           hovering a specific zone lights it up fully and reveals its "+ Block" label. */
        body:hover .mat-insert { opacity: .45; }
        .mat-insert:hover { opacity: 1; }
        .mat-insert:hover span { opacity: 1; }
        .mat-insert span { opacity: 0; }
        @@keyframes matFlash { 0%,100% { background: transparent; } 30% { background: rgba(37,99,235,.10); } }
    </style>
    <script>
        (function () {
            var selected = null;
            var pendingRender = null;
            function applyRender(html) {
                var container = document.getElementById("mat-blocks");
                if (container) { container.innerHTML = html; selected = null; buildInsertZones(); }
            }
            function post(msg) { if (window.parent && window.parent !== window) window.parent.postMessage(msg, "*"); }

            // Selecting a block reloads the editor page, which reloads this iframe. Persist the
            // scroll position so the preview stays put instead of jumping back to the top.
            var scrollKey = "mat-ed-scroll:" + location.pathname;
            function saveScroll() { try { sessionStorage.setItem(scrollKey, String(window.scrollY)); } catch (e) {} }
            function restoreScroll() {
                try { var y = parseInt(sessionStorage.getItem(scrollKey) || "0", 10); if (y > 0) window.scrollTo(0, y); } catch (e) {}
            }
            window.addEventListener("scroll", saveScroll, { passive: true });
            window.addEventListener("beforeunload", saveScroll);
            restoreScroll();
            window.addEventListener("load", restoreScroll);

            // Only scroll when the element isn't already comfortably in view (avoids re-scrolling
            // to a block that's already visible).
            function inView(el) {
                var r = el.getBoundingClientRect();
                var h = window.innerHeight || document.documentElement.clientHeight;
                return r.top >= 0 && r.bottom <= h;
            }
            function ensureVisible(el) {
                if (!inView(el)) el.scrollIntoView({ behavior: "smooth", block: "center" });
            }

            // In editor mode, clicking anywhere selects the containing block (and never navigates).
            document.addEventListener("click", function (e) {
                // A click inside the text being typed in places the caret — nothing else.
                if (e.target.closest("[contenteditable=true]")) { var la = e.target.closest("a"); if (la) e.preventDefault(); return; }
                // The innermost mark wins: a click on a card selects the card, not the cards block.
                var block = e.target.closest("[data-block-id]");
                if (block) { e.preventDefault(); e.stopPropagation(); post({ type: "mat-select-block", id: block.getAttribute("data-block-id") }); }
                else {
                    var a = e.target.closest("a");
                    if (a) e.preventDefault(); // keep the preview stable
                }
            }, true);

            // Receive scroll/select requests from the editor.
            window.addEventListener("message", function (e) {
                var d = e.data || {};
                if (d.type === "mat-scroll" && d.id) {
                    var el = document.getElementById("block-" + d.id);
                    if (el) { ensureVisible(el); el.classList.add("mat-flash"); setTimeout(function () { el.classList.remove("mat-flash"); }, 1000); }
                }
                if (d.type === "mat-select" && d.id) {
                    if (selected) selected.classList.remove("mat-selected", "mat-sel-child");
                    // A child has no box of its own (display:contents wrapper) — its first element stands
                    // in. A child the block's markup does not mark falls back to the block it is in.
                    var child = document.querySelector('.mat-ed-child[data-block-id="' + d.id + '"]');
                    var target = child && child.firstElementChild;
                    if (target) { selected = target; target.classList.add("mat-sel-child"); }
                    else {
                        selected = document.getElementById("block-" + d.id) || (d.fallback ? document.getElementById("block-" + d.fallback) : null);
                        if (selected) selected.classList.add("mat-selected");
                    }
                    if (selected) ensureVisible(selected);
                }
                // Live preview: replace the block area with freshly-rendered draft HTML (no reload).
                if (d.type === "mat-render" && typeof d.html === "string") {
                    // Never swap the page out from under somebody typing into it — the redraw waits for
                    // the field to be left (applyPendingRender in the inline editor below).
                    if (document.querySelector("[contenteditable=true]")) { pendingRender = d.html; return; }
                    applyRender(d.html);
                }
            });

            // Insert-between-blocks zones: one before each top-level block + one at the end.
            // A function (not an IIFE) so it can be re-run after a live-preview swap.
            function buildInsertZones() {
                Array.prototype.slice.call(document.querySelectorAll(".mat-insert")).forEach(function (z) { z.remove(); });
                var blocks = Array.prototype.slice.call(document.querySelectorAll(".mat-ed-block"));
                function makeZone(index) {
                    var z = document.createElement("button");
                    z.type = "button";
                    z.className = "mat-insert";
                    z.title = "Block hier einfügen";
                    z.innerHTML = "<span>+ Block</span>";
                    z.addEventListener("click", function (e) {
                        e.preventDefault(); e.stopPropagation();
                        post({ type: "mat-insert-at", index: index });
                    });
                    return z;
                }
                blocks.forEach(function (b, i) { b.parentNode.insertBefore(makeZone(i), b); });
                if (blocks.length) blocks[blocks.length - 1].insertAdjacentElement("afterend", makeZone(blocks.length));
            }
            buildInsertZones();

            // ---- Typing straight into the preview (editor v2) ----
            // A double click on a heading, a text or a button of an element block makes it editable in
            // place. Every keystroke goes to the editor as the FIELD value (mat-inline), which writes it
            // into the draft; the preview is not re-rendered while typing (that would take the caret
            // away) but once the field is left (mat-inline-done).
            var INLINE = {
                "el-heading": { sel: "h1, h2, h3, h4", field: "text", read: readHeading, plain: true },
                "el-text": { sel: ".el-text", field: "body", read: function (el) { return el.innerHTML.trim(); } },
                "el-button": { sel: "a", field: "text", read: function (el) { return el.textContent.trim(); }, plain: true }
            };
            // The heading's field is plain text with **word** for the highlight and real line breaks.
            function readHeading(el) {
                var c = el.cloneNode(true);
                c.querySelectorAll(".el-hl").forEach(function (h) { h.replaceWith("**" + h.textContent + "**"); });
                c.querySelectorAll("br").forEach(function (b) { b.replaceWith("\n"); });
                return c.textContent.replace(/ /g, " ").trim();
            }
            document.addEventListener("dblclick", function (e) {
                var wrap = e.target.closest(".mat-ed-child[data-block-type]");
                var spec = wrap && INLINE[wrap.getAttribute("data-block-type")];
                if (!spec) return;
                var el = wrap.querySelector(spec.sel);
                if (!el || el.isContentEditable) return;
                e.preventDefault();
                var id = wrap.getAttribute("data-block-id");
                el.contentEditable = "true";
                el.classList.add("mat-inline");
                el.focus();
                post({ type: "mat-inline-start", id: id });
                function send(type) { post({ type: type, id: id, field: spec.field, value: spec.read(el) }); }
                function onInput() { send("mat-inline"); }
                function onKey(k) {
                    // One line break in a heading or button, never a new paragraph block.
                    if (spec.plain && k.key === "Enter") { k.preventDefault(); if (spec.field === "text" && el.tagName !== "A") document.execCommand("insertLineBreak"); else el.blur(); }
                    if (k.key === "Escape") el.blur();
                    // Select all = this element only. The browser would select the whole page, and in a
                    // link that takes the editing host — and the focus — with it.
                    if ((k.ctrlKey || k.metaKey) && k.key.toLowerCase() === "a") {
                        k.preventDefault();
                        var rg = document.createRange(); rg.selectNodeContents(el);
                        var sl = window.getSelection(); sl.removeAllRanges(); sl.addRange(rg);
                    }
                }
                function onPaste(p) {
                    if (!spec.plain) return;
                    p.preventDefault();
                    document.execCommand("insertText", false, (p.clipboardData || window.clipboardData).getData("text/plain"));
                }
                function done() {
                    el.contentEditable = "false";
                    el.classList.remove("mat-inline");
                    el.removeEventListener("input", onInput); el.removeEventListener("keydown", onKey);
                    el.removeEventListener("paste", onPaste); el.removeEventListener("blur", done);
                    send("mat-inline-done");
                    if (pendingRender != null) { var h = pendingRender; pendingRender = null; applyRender(h); }
                }
                el.addEventListener("input", onInput);
                el.addEventListener("keydown", onKey);
                el.addEventListener("paste", onPaste);
                el.addEventListener("blur", done);
            });

            post({ type: "mat-preview-ready" });
        })();
    </script>
}
