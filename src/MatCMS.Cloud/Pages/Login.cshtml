@page "/login"
@model MatCMS.Cloud.Pages.LoginModel
@inject MatCMS.Cloud.Services.CloudContext Cloud
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* Break out of any frame BEFORE rendering. The cloud login (and the SSO authorize it protects) must
       run first-party: inside a cross-site frame — e.g. the instance embedded in the cloud's site view —
       the SameSite=Lax auth/antiforgery cookies are unreliable and the login POST fails with 400. On
       top level the existing cloud session is used and the flow just continues. Never legitimately
       framed, so this only ever fires on the broken embedded path. *@
    <script>
        // If blocked (sandbox without allow-top-navigation) the top-nav quietly fails and the page just
        // renders in the frame — deliberately NO self-reload fallback, which would spin an infinite
        // reload loop. The cloud's own instance-embed grants allow-top-navigation so the break-out works.
        if (window.top !== window.self) { try { window.top.location.replace(window.location.href); } catch (e) {} }
    </script>
    <title>@T["login.pageTitle"] – @Cloud.CloudName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@@500;600;700&family=Inter:wght@@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cloud.css" asp-append-version="true" />
    <link rel="icon" href="@Cloud.LogoUrl" />
</head>
<body class="login-page">
    <div class="login-card">
        <img class="login-logo" src="@Cloud.LogoUrl" alt="@Cloud.CloudName" />
        <h1>@T["login.heading"]</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert-error">@Model.Error</div>
        }
        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div class="form-field">
                <label for="Username">@T["login.username"]</label>
                <input id="Username" name="Username" value="@Model.Username" autofocus required />
            </div>
            <div class="form-field">
                <label for="Password">@T["login.password"]</label>
                <input id="Password" name="Password" type="password" required />
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="RememberMe" value="true" /> @T["login.rememberMe"]
            </label>
            <button type="submit" class="btn btn-block">@T["login.submit"]</button>
        </form>
    </div>
</body>
</html>
