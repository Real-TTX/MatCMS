@page "/{slug?}"
@model MatCMS.Pages.ViewModel
@{
    // Editor preview mode: only for admins, adds per-block wrappers + inspector highlighting.
    var http = ViewContext.HttpContext;
    var editor = http.Request.Query.ContainsKey("editor") && http.User.IsInRole("Admin");
    // Tell the admin bar which page this is, so it can offer a direct "edit this page" link.
    ViewData["AdminEditPageId"] = Model.CurrentPage.Id;
}
@if (!string.IsNullOrWhiteSpace(Model.CurrentPage.CustomCss))
{
    @* Page-specific CSS: this <style> is only emitted on this page's own response, so it is
       naturally scoped to the page. Admin-entered and output raw (like the template's CustomCss);
       the </style guard prevents an early tag close from breaking out into HTML. *@
    <style>@Html.Raw(System.Text.RegularExpressions.Regex.Replace(Model.CurrentPage.CustomCss, "</\\s*style", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase))</style>
}
@if (editor)
{
    <div id="mat-blocks">
        @await Html.PartialAsync("_BlockList", new MatCMS.Content.BlockListModel(Model.CurrentPage.Blocks, Model.Registry, true))
    </div>
}
else
{
    @await Html.PartialAsync("_BlockList", new MatCMS.Content.BlockListModel(Model.CurrentPage.Blocks, Model.Registry, false))
}

@if (editor)
{
    @await Html.PartialAsync("_PreviewChrome", true)
}
