@* CodeMirror bundle + the shared upgrader. Included by every page that has a data-code textarea, so
   the asset list lives in exactly one place. Same files and version as MatCMS ships. *@
<link rel="stylesheet" href="~/lib/codemirror/codemirror.min.css" asp-append-version="true" />
<script src="~/lib/codemirror/codemirror.min.js" asp-append-version="true"></script>
<script src="~/lib/codemirror/mode/xml.min.js" asp-append-version="true"></script>
<script src="~/lib/codemirror/mode/javascript.min.js" asp-append-version="true"></script>
<script src="~/lib/codemirror/mode/css.min.js" asp-append-version="true"></script>
<script src="~/lib/codemirror/mode/htmlmixed.min.js" asp-append-version="true"></script>
<script src="~/lib/codemirror/addon/closebrackets.min.js" asp-append-version="true"></script>
<script src="~/lib/codemirror/addon/matchbrackets.min.js" asp-append-version="true"></script>
<script src="~/lib/codemirror/addon/active-line.min.js" asp-append-version="true"></script>
<script src="~/js/code-editor.js" asp-append-version="true"></script>
<script>
    // Token chips: insert at the caret of the CodeMirror bound to [data-target], or append when the
    // editor has never been focused — clicking a token should never silently do nothing.
    document.querySelectorAll('[data-insert]').forEach(function (chip) {
        chip.addEventListener('click', function () {
            var area = document.getElementById(chip.dataset.target);
            if (!area) return;
            var cm = area.nextElementSibling && area.nextElementSibling.CodeMirror;
            if (cm) { cm.replaceSelection(chip.dataset.insert); cm.focus(); cm.save(); }
            else { area.value += chip.dataset.insert; area.focus(); }
        });
    });
</script>
