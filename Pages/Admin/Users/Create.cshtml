@page
@model MatCMS.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = "Neuer Benutzer";
}
<div class="page-head">
    <h1>Neuer Benutzer</h1>
    <a class="btn btn-sm btn-ghost" asp-page="Index">Zurück</a>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" class="form-grid">
        <div class="form-row">
            <div class="form-field">
                <label for="Username">Benutzername</label>
                <input id="Username" name="Username" value="@Model.Username" required autofocus />
            </div>
            <div class="form-field">
                <label for="DisplayName">Anzeigename (optional)</label>
                <input id="DisplayName" name="DisplayName" value="@Model.DisplayName" />
            </div>
        </div>
        <div class="form-field">
            <label for="Password">Passwort</label>
            <input id="Password" name="Password" type="password" required />
        </div>
        <div>
            <button type="submit" class="btn">Benutzer anlegen</button>
        </div>
    </form>
</div>
