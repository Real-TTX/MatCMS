@page
@model MatCMS.Pages.Admin.Settings.IndexModel
@using MatCMS.Services
@{
    ViewData["Title"] = T["settings.title"];
    string V(string key) => Model.Values.TryGetValue(key, out var v) ? v : "";
}
<div class="page-head">
    <h1>@T["settings.title"]</h1>
</div>

<form method="post">
    <div class="card">
        <h2>@T["settings.general"]</h2>
        <div class="form-field">
            <label>@T["settings.siteName"]</label>
            <input name="Values[@SettingKeys.SiteName]" value="@V(SettingKeys.SiteName)" />
        </div>
        <div class="form-field">
            <label>@T["settings.logo"]</label>
            <div class="image-field" data-upload>
                <div class="preview" data-preview></div>
                <div class="image-controls">
                    <input name="Values[@SettingKeys.LogoUrl]" value="@V(SettingKeys.LogoUrl)" placeholder="/img/logo.svg oder /uploads/..." data-url />
                    <div style="margin-top:8px;">
                        <button type="button" class="btn btn-ghost btn-sm" data-upload-btn>@T["settings.uploadLogo"]</button>
                        <input type="file" accept="image/*" style="display:none;" data-file />
                    </div>
                </div>
            </div>
        </div>
        <div class="form-field">
            <label>@T["settings.favicon"]</label>
            <div class="image-field" data-upload>
                <div class="preview" data-preview></div>
                <div class="image-controls">
                    <input name="Values[@SettingKeys.FaviconUrl]" value="@V(SettingKeys.FaviconUrl)" placeholder="@T["settings.faviconPlaceholder"]" data-url />
                    <div style="margin-top:8px;">
                        <button type="button" class="btn btn-ghost btn-sm" data-upload-btn>@T["settings.uploadFavicon"]</button>
                        <input type="file" accept="image/*,.ico" style="display:none;" data-file />
                    </div>
                    <div class="help">@T["settings.faviconHelp"]</div>
                </div>
            </div>
        </div>
        <div class="form-field">
            <label>@T["settings.footerText"]</label>
            <input name="Values[@SettingKeys.FooterText]" value="@V(SettingKeys.FooterText)" />
        </div>
        <div class="form-field">
            <label>@T["settings.contactEmail"]</label>
            <input name="Values[@SettingKeys.ContactRecipient]" value="@V(SettingKeys.ContactRecipient)" />
            <div class="help">@T["settings.contactEmailHelp"]</div>
        </div>
    </div>

    <div class="card">
        <h2>@T["settings.topBar"]</h2>
        <p class="help">@Html.Raw(T["settings.topBarMoved"])</p>
    </div>

    <button type="submit" class="btn">@T["settings.save"]</button>
</form>

@section Scripts {
    <script>
        // Wire every [data-upload] image field (logo, favicon, …) to the shared upload endpoint.
        document.querySelectorAll('.image-field[data-upload]').forEach(function (field) {
            var input = field.querySelector('[data-url]');
            var file = field.querySelector('[data-file]');
            var btn = field.querySelector('[data-upload-btn]');
            var prev = field.querySelector('[data-preview]');
            if (!btn || !input) return;
            function setPrev(u) { if (prev) prev.style.backgroundImage = u ? "url('" + u + "')" : ''; }
            setPrev(input.value);
            input.addEventListener('input', function () { setPrev(input.value); });
            btn.addEventListener('click', function () { file.click(); });
            var label = btn.textContent;
            file.addEventListener('change', function () {
                if (!file.files || !file.files[0]) return;
                btn.disabled = true; btn.textContent = '@T["action.uploading"]';
                var fd = new FormData(); fd.append('file', file.files[0]);
                fetch('/admin/api/upload', { method: 'POST', body: fd })
                    .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
                    .then(function (r) {
                        if (r.ok && r.j.url) { input.value = r.j.url; setPrev(r.j.url); }
                        else alert(r.j.error || 'Upload fehlgeschlagen.');
                    })
                    .catch(function () { alert('Upload fehlgeschlagen.'); })
                    .then(function () { btn.disabled = false; btn.textContent = label; file.value = ''; });
            });
        });
    </script>
}
