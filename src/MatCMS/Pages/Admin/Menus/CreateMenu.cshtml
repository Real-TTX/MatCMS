@page
@model MatCMS.Pages.Admin.Menus.CreateMenuModel
@{
    ViewData["Title"] = T["menus.newMenu"];
}
@* Nur die Überschrift: der Weg zurück steht unten neben dem Anlegen-Knopf, wie im Plugin-Editor. *@
<div class="page-head">
    <h1>@T["menus.newMenu"]</h1>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" class="form-grid">
        <div class="form-field">
            <label for="Name">@T["menus.menuName"]</label>
            <input id="Name" name="Name" value="@Model.Name" required autofocus />
            <div class="help">@T["menus.newMenuHelp"]</div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">@T["menus.createMenu"]</button>
            <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
        </div>
    </form>
</div>
