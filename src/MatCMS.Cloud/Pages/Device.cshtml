@page "/device"
@model MatCMS.Cloud.Pages.DeviceModel
@inject MatCMS.Cloud.Services.CloudContext Cloud
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* Like /oauth/authorize this must run first-party: break out of any unintended frame. *@
    <script>
        if (window.top !== window.self) { try { window.top.location.replace(window.location.href); } catch (e) {} }
    </script>
    <title>@T["device.pageTitle"] – @Cloud.CloudName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@@500;600;700&family=Inter:wght@@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cloud.css" asp-append-version="true" />
    <link rel="icon" href="@Cloud.LogoUrl" />
</head>
<body class="login-page">
    <div class="login-card">
        <img class="login-logo" src="@Cloud.LogoUrl" alt="@Cloud.CloudName" />
        @if (Model.Result == "approved")
        {
            <h1>@T["device.approvedTitle"]</h1>
            <div class="alert alert-ok">@T["device.approved"]</div>
            <a class="login-back" href="/admin">@T["device.toDashboard"]</a>
        }
        else if (Model.Result == "denied")
        {
            <h1>@T["device.deniedTitle"]</h1>
            <p class="help" style="text-align:center;">@T["device.denied"]</p>
            <a class="login-back" href="/admin">@T["device.toDashboard"]</a>
        }
        else if (Model.Found)
        {
            @* Explicit consent — always a click. The card states plainly that this grants FULL operator
               access, so an operator cannot be walked into approving a code they did not start. *@
            <h1>@T["device.heading"]</h1>
            <p class="help" style="text-align:center;">@T["device.intro", Model.ClientLabel]</p>
            <div class="alert alert-error" style="text-align:left;">@T["device.warn"]</div>
            @if (!string.IsNullOrEmpty(Model.AccountLabel))
            {
                <p class="muted" style="text-align:center;">@T["device.asAccount", Model.AccountLabel]</p>
            }
            <form method="post">
                <input type="hidden" name="userCode" value="@Model.Code" />
                <button type="submit" name="decision" value="allow" class="btn btn-block">@T["device.allow"]</button>
                <button type="submit" name="decision" value="deny" class="btn btn-ghost btn-block" style="margin-top:8px;">@T["device.deny"]</button>
            </form>
        }
        else
        {
            @* No code, or an unknown/expired/already-decided one → the enter-code form. *@
            <h1>@T["device.enterTitle"]</h1>
            @if (Model.Unknown)
            {
                <div class="alert alert-error">@T["device.unknown"]</div>
            }
            <p class="help" style="text-align:center;">@T["device.enterHelp"]</p>
            <form method="post">
                <input type="text" name="userCode" value="@Model.Code" placeholder="@T["device.enterPlaceholder"]"
                       autocomplete="one-time-code" autocapitalize="characters" spellcheck="false"
                       style="text-align:center;letter-spacing:.25em;text-transform:uppercase;font-size:1.2rem;" autofocus />
                <button type="submit" class="btn btn-block" style="margin-top:10px;">@T["device.enterSubmit"]</button>
            </form>
        }
    </div>
</body>
</html>
