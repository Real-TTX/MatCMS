@page "{profileId:int}"
@model MatCMS.Cloud.Pages.Admin.Profiles.SmtpModel
@{
    ViewData["Title"] = T["settings.smtp"];
}
@* Heading only: every action on this page sits in ONE row at the bottom, in the CMS's order
   (save, export, back, destructive last). *@
<div class="page-head">
    <h1>
        @T["settings.smtp"]
        <span class="muted" style="font-size:14px;font-weight:400;"> — @Model.Owner.Name</span>
    </h1>
</div>

<form method="post" asp-route-profileId="@Model.Owner.Id" id="editor-form">
    <div class="card">
        <h2>@T["settings.smtp"]</h2>

        @* How mail leaves the instances is the one decision this page starts with, so it sits at the
           top: everything below only applies to one of the three answers. *@
        <div class="form-field">
            <label>@T["profiles.mailSource"]</label>
            <label class="checkbox-row">
                <input type="radio" name="mailSource" value="@MailSources.Global" data-mail-source
                       checked="@(Model.Owner.MailSource == MailSources.Global ? "checked" : null)" />
                @T["add.fromGlobal"]
            </label>
            <div class="help">@T["profiles.useGlobalSmtpHint"]</div>
            <label class="checkbox-row">
                <input type="radio" name="mailSource" value="@MailSources.Own" data-mail-source
                       checked="@(Model.Owner.MailSource == MailSources.Own ? "checked" : null)" />
                @T["add.smtpOwn"]
            </label>
            <div class="help">@T["add.smtpOwnHint"]</div>
            <label class="checkbox-row">
                <input type="radio" name="mailSource" value="@MailSources.Cloud" data-mail-source
                       checked="@(Model.Owner.MailSource == MailSources.Cloud ? "checked" : null)" />
                @T["profiles.mailViaCloud"]
            </label>
            <div class="help">@T["profiles.mailViaCloudHint"]</div>
        </div>

        <div class="form-grid" data-smtp-block hidden="@(Model.Owner.MailSource == MailSources.Cloud ? "hidden" : null)">
            <div class="form-row">
                <div class="form-field">
                    <label for="host">@T["settings.smtpHost"]</label>
                    <input id="host" name="host" value="@Model.Field("smtp.host")" readonly="@(Model.FieldsEditable ? null : "readonly")" data-smtp-own spellcheck="false" />
                </div>
                <div class="form-field">
                    <label for="port">@T["settings.smtpPort"]</label>
                    <input id="port" name="port" value="@Model.Field("smtp.port")" readonly="@(Model.FieldsEditable ? null : "readonly")" data-smtp-own placeholder="587" inputmode="numeric" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label for="user">@T["settings.smtpUser"]</label>
                    <input id="user" name="user" value="@Model.Field("smtp.user")" readonly="@(Model.FieldsEditable ? null : "readonly")" data-smtp-own spellcheck="false" />
                </div>
                <div class="form-field">
                    <label for="password">@T["settings.smtpPassword"]</label>
                    <input id="password" name="password" type="password" placeholder="@T["settings.smtpPasswordKeep"]" autocomplete="new-password" readonly="@(Model.FieldsEditable ? null : "readonly")" data-smtp-own />
                    @* Without this a stored password could only ever be replaced, never removed. *@
                    @if (!string.IsNullOrEmpty(Model.Setting("smtp.password")))
                    {
                        <label class="checkbox-row">
                            <input type="checkbox" name="clearPassword" value="true" />
                            @T["settings.smtpPasswordClear"]
                        </label>
                    }
                </div>
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label for="fromEmail">@T["settings.smtpFromEmail"]</label>
                    <input id="fromEmail" name="fromEmail" value="@Model.Field("smtp.fromEmail")" readonly="@(Model.FieldsEditable ? null : "readonly")" data-smtp-own spellcheck="false" />
                </div>
                <div class="form-field">
                    <label for="fromName">@T["settings.smtpFromName"]</label>
                    <input id="fromName" name="fromName" value="@Model.Field("smtp.fromName")" readonly="@(Model.FieldsEditable ? null : "readonly")" data-smtp-own />
                </div>
            </div>
        </div>
        <label class="checkbox-row" data-smtp-block hidden="@(Model.Owner.MailSource == MailSources.Cloud ? "hidden" : null)">
            <input type="checkbox" name="ssl" value="true" checked="@(Model.Flag("smtp.ssl") ? "checked" : null)" />
            @T["settings.smtpSsl"]
        </label>
    </div>
</form>

@* Save and delete on one line, positive before negative. "Entfernen" stops the rollout; the stored
   values survive, which is why it is not worded as deleting them. *@
<div class="form-actions">
    <button type="submit" class="btn" form="editor-form">@T["settings.save"]</button>
    <a class="btn btn-ghost" asp-page="Edit" asp-route-id="@Model.Owner.Id" asp-route-tab="settings">@T["action.back"]</a>
    @if (!Model.IsNew)
    {
        <form class="inline-form" method="post" asp-page-handler="Remove" asp-route-profileId="@Model.Owner.Id"
              onsubmit="return confirm('@T["profiles.smtpRemoveConfirm"]');">
            <button type="submit" class="btn btn-danger">@T["profiles.removeFromProfile"]</button>
        </form>
    }
</div>

@section Scripts {
    <script>
        // Picking a source takes effect at once, not only after saving: the fields lock, fill with
        // what would actually be rolled out, or disappear entirely for the relay.
        (function () {
            var radios = Array.prototype.slice.call(document.querySelectorAll('[data-mail-source]'));
            if (!radios.length) return;
            var blocks = Array.prototype.slice.call(document.querySelectorAll('[data-smtp-block]'));
            var own = Array.prototype.slice.call(document.querySelectorAll('[data-smtp-own]'));
            var global = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
            {
                host = Model.Global("smtp.host"),
                port = Model.Global("smtp.port"),
                user = Model.Global("smtp.user"),
                fromEmail = Model.Global("smtp.fromEmail"),
                fromName = Model.Global("smtp.fromName")
            }));
            // What the profile itself has, so unticking gives the operator their own values back
            // instead of leaving the global ones sitting in the boxes as if they were theirs.
            var mine = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
            {
                host = Model.Setting("smtp.host"),
                port = Model.Setting("smtp.port"),
                user = Model.Setting("smtp.user"),
                fromEmail = Model.Setting("smtp.fromEmail"),
                fromName = Model.Setting("smtp.fromName")
            }));
            function apply() {
                var chosen = (radios.filter(function (r) { return r.checked; })[0] || {}).value || 'own';
                blocks.forEach(function (b) { b.hidden = chosen === 'cloud'; });
                var src = chosen === 'global' ? global : mine;
                own.forEach(function (el) {
                    el.readOnly = chosen !== 'own';
                    if (el.type === 'password') { el.value = ''; return; }
                    if (Object.prototype.hasOwnProperty.call(src, el.id)) el.value = src[el.id];
                });
            }
            radios.forEach(function (r) { r.addEventListener('change', apply); });
        })();
    </script>
}
