<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MatCMS Store — the store SERVER, as a NATIVE plugin that runs only on matcms.de (docs/official-store.md). Not in any image, not in the
       cloud's store: matcms.de imports it like any native plugin. The settings below keep it loadable and unloadable (docs/plugin-system-v2.md §7). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>MatCMS.Plugin.MatcmsStore</RootNamespace>
    <AssemblyName>MatcmsStore</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MatCMS.Plugin.Abstractions\MatCMS.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
