@page
@model MatCMS.Pages.Admin.MailTemplates.IndexModel
@{
    ViewData["Title"] = T["mailtpl.title"];
}
<div data-list>
    <div class="page-head">
        <h1>@T["mailtpl.title"]</h1>
        <div class="list-toolbar">
            <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
        </div>
    </div>

    <table class="data" data-list-table>
        <thead>
            <tr>
                <th>@T["mailtpl.name"]</th>
                <th>@T["mailtpl.subject"]</th>
                <th>@T["mailtpl.status"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <partial name="_EmptyRow" model='@T["mailtpl.none"]' />
            }
            else
            {
                @foreach (var t in Model.Items)
                {
                    <tr data-search="@(t.Name + " " + t.Key + " " + t.Subject)">
                        <td>
                            <a asp-page="Edit" asp-route-id="@t.Id"><strong>@t.Name</strong></a>
                            <div class="muted">@t.Description</div>
                        </td>
                        <td class="muted">@t.Subject</td>
                        <td>
                            @if (t.Enabled)
                            {
                                <span class="badge badge-on">@T["mailtpl.enabled"]</span>
                            }
                            else
                            {
                                <span class="badge badge-off">@T["mailtpl.disabled"]</span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                @if (MatCMS.Pages.Admin.MailTemplates.IndexModel.IsUnknown(t))
                                {
                                    @* Only for a key nothing in this build sends: such a row can only
                                       have arrived from a cloud rollout for a mail this version does
                                       not have, so it is wording that will never be used. A declared
                                       one stays undeletable — the code still asks for it. *@
                                    <span class="badge badge-off" title="@T["mailtpl.unknownKeyShort"]">@T["mailtpl.unused"]</span>
                                    <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@t.Id"
                                          onsubmit="return confirm('@T["mailtpl.deleteUnknownConfirm"]');">
                                        <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
    @* No create action: which mails exist is decided by the code that sends them. *@
</div>
