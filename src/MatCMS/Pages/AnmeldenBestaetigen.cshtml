@page "/anmelden/bestaetigen"
@model MatCMS.Pages.AnmeldenBestaetigenModel
@{
    ViewData["Title"] = T["member.confirm.title"];
}
<partial name="_MemberAuthStyle" />
<section class="member-auth">
    <div class="member-auth-card">
        <h1>@T["member.confirm.title"]</h1>
        @if (Model.Confirmed)
        {
            <p class="member-auth-ok">@T["member.confirm.ok"]</p>
            <p><a class="btn" href="/">@T["member.home"]</a></p>
        }
        else
        {
            <p class="member-auth-error">@T["member.err.linkUsed"]</p>
        }
    </div>
</section>
