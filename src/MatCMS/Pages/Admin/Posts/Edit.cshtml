@page "{id:int}"
@model MatCMS.Pages.Admin.Posts.EditModel
@{
    ViewData["Title"] = Model.IsNew ? T["posts.newTitle"] : T["posts.editTitle"];
}
@* Nur die Überschrift: alle Aktionen dieser Seite stehen unten in EINER Reihe — dieselbe Ordnung
   wie im Plugin-Editor. Oben stand ein "Zurück", unten ein "Abbrechen" — zwei Beschriftungen für
   denselben Weg an zwei Orten. *@
<div class="page-head post-head">
    <h1>@(Model.IsNew ? T["posts.newTitle"] : T["posts.editTitle"])</h1>
    @* Aus Link übernehmen: ein dezenter Knopf oben rechts, die Eingabe im Dialog. Er liest einen
       Beitrag (Instagram, Facebook, jede Seite mit Vorschau-Daten) EINMAL und füllt die Felder;
       gespeichert wird erst mit "Speichern". Die Bilder liegen danach in der Mediathek (Tag "import"). *@
    <button type="button" class="btn btn-ghost btn-sm post-import-open" id="pi-open"><i class="ti ti-link" aria-hidden="true"></i> @T["posts.import.heading"]</button>
</div>

<dialog class="mat-dialog post-import" id="pi-dialog"
        data-url="@Url.Page(null, "ImportLink", new { id = Model.PostId })"
        data-busy="@T["posts.import.busy"]" data-done="@T["posts.import.done"]"
        data-overwrite="@T["posts.import.overwrite"]" data-failed="@T["posts.import.failed"]">
    <h3 class="post-import__title">@T["posts.import.heading"]</h3>
    <div class="post-import__row field">
        <input type="url" id="pi-url" placeholder="@T["posts.import.placeholder"]" inputmode="url" autocomplete="off" />
        <button type="button" class="btn" id="pi-go">@T["posts.import.button"]</button>
    </div>
    <div class="help">@T["posts.import.hint"]</div>
    <div id="pi-status" class="post-import__status" role="status" hidden></div>
    <div class="post-import__foot">
        <button type="button" class="btn btn-ghost btn-sm" id="pi-close">@T["action.close"]</button>
    </div>
</dialog>

<form method="post" asp-route-id="@Model.PostId" id="post-form" class="form-grid" style="max-width:860px;">
    <div asp-validation-summary="All" class="alert alert-error" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="field">
        <label>@T["posts.heading"]</label>
        <input asp-for="Input.Title" placeholder="@T["posts.headingPlaceholder"]" required />
    </div>

    <div class="field">
        <label>@T["posts.slug"] <span class="muted">@T["posts.slugHint"]</span></label>
        <input asp-for="Input.Slug" placeholder="@T["posts.slugExample"]" />
    </div>

    <div class="field">
        <label>@T["posts.titleImage"]</label>
        <div class="image-field">
            <div class="preview" id="ti-preview" style="@(string.IsNullOrWhiteSpace(Model.Input.TitleImage) ? "" : $"background-image:url('{Model.Input.TitleImage}')")"></div>
            <div class="image-controls">
                <input asp-for="Input.TitleImage" id="ti-url" placeholder="@T["posts.imgPlaceholder"]" />
                <div style="margin-top:8px;">
                    <button type="button" class="btn btn-ghost btn-sm" id="ti-pick">@T["posts.pickImage"]</button>
                </div>
            </div>
        </div>
    </div>

    <div class="field">
        <label>@T["posts.gallery"] <span class="muted">@T["posts.galleryHint"]</span></label>
        <div id="gal-list" class="gal-list"></div>
        <div class="gal-actions">
            <button type="button" class="btn btn-ghost btn-sm" id="gal-add">@T["posts.galleryAdd"]</button>
            <label class="gal-layout">@T["posts.galleryLayout"]
                <select asp-for="Input.GalleryLayout">
                    <option value="carousel">@T["posts.galleryCarousel"]</option>
                    <option value="grid">@T["posts.galleryGrid"]</option>
                </select>
            </label>
        </div>
        <input type="hidden" asp-for="Input.GalleryJson" id="gal-json" />
    </div>

    <div class="field">
        <label>@T["posts.excerpt"] <span class="muted">@T["posts.excerptHint"]</span></label>
        <textarea asp-for="Input.Excerpt" rows="2" placeholder="@T["posts.excerptPlaceholder"]"></textarea>
        @if (Model.AiEnabled)
        {
            <button type="button" class="btn btn-sm btn-ghost" style="margin-top:6px;" data-ai-seo
                    data-ai-url="@Url.Page(null, "AiExcerpt", new { id = Model.PostId })"
                    data-target="Input_Excerpt" data-content-from="rt-editor" data-title-from="Input_Title"
                    data-title="@T["editor.aiExcerptTitle"]">
                <i class="ti ti-sparkles" aria-hidden="true"></i> @T["editor.aiExcerptButton"]
            </button>
        }
    </div>

    <div class="field">
        <label>@T["posts.content"]</label>
        <div class="rt-toolbar" id="rt-toolbar">
            <button type="button" data-cmd="bold" title="@T["posts.rtBold"]">F</button>
            <button type="button" data-cmd="italic" title="@T["posts.rtItalic"]">K</button>
            <button type="button" data-cmd="formatBlock" data-arg="H2" title="@T["posts.rtH2"]">H2</button>
            <button type="button" data-cmd="formatBlock" data-arg="H3" title="@T["posts.rtH3"]">H3</button>
            <button type="button" data-cmd="formatBlock" data-arg="P" title="@T["posts.rtParagraph"]">¶</button>
            <button type="button" data-cmd="insertUnorderedList" title="@T["posts.rtList"]">@T["posts.rtListLabel"]</button>
            <button type="button" data-cmd="createLink" data-prompt="1" title="@T["posts.rtLink"]">@T["posts.rtLink"]</button>
            <button type="button" data-cmd="removeFormat" title="@T["posts.rtClear"]">✕</button>
        </div>
        <div class="rt-editor" id="rt-editor" contenteditable="true" style="min-height:220px;">@Html.Raw(Model.Input.ContentHtml)</div>
        <input type="hidden" asp-for="Input.ContentHtml" id="rt-hidden" />
    </div>

    <div class="field">
        <label>@T["media.tags"] <span class="muted">@T["posts.tagsHint"]</span></label>
        <div class="tag-input" id="pt-tag-input">
            <input type="text" id="pt-tag-entry" class="tag-entry" placeholder="@T["posts.tagEntryPlaceholder"]" autocomplete="off" hidden />
            <button type="button" class="tag-add-chip" id="pt-tag-add" title="@T["posts.addTag"]" aria-label="@T["posts.addTag"]">+</button>
        </div>
        <input type="hidden" asp-for="Input.Tags" id="pt-tags" />
        @if (Model.AllTags.Count > 0)
        {
            <div class="tag-suggest" id="pt-suggest">
                @foreach (var t in Model.AllTags)
                {
                    <button type="button" class="mini-chip mini-chip-add" data-tag="@t">+ @t</button>
                }
            </div>
            <div class="help">@T["posts.tagSuggestHint"]</div>
        }
    </div>

    <div class="field">
        <label>@T["posts.attachments"] <span class="muted">@T["posts.attachmentsHint"]</span></label>
        <div id="att-list" class="att-list" style="display:flex;flex-wrap:wrap;gap:8px;"></div>
        <div style="margin-top:8px;">
            <button type="button" class="btn btn-ghost btn-sm" id="att-add">@T["posts.addAttachment"]</button>
        </div>
        <input type="hidden" asp-for="Input.AttachmentsJson" id="att-json" />
    </div>

    <div class="field">
        <label><input type="checkbox" asp-for="Input.IsPublished" /> @T["posts.publishedLabel"]</label>
    </div>

    <div class="field">
        <label>@T["posts.date"]</label>
        <input type="date" asp-for="Input.PublishedAt" />
    </div>

    <div class="field">
        <label>@T["posts.source"] <span class="muted">@T["posts.sourceHint"]</span></label>
        <div class="src-row">
            <input asp-for="Input.SourceUrl" id="src-url" type="url" placeholder="https://www.instagram.com/p/…" />
            <input asp-for="Input.SourceName" id="src-name" placeholder="@T["posts.sourceNamePlaceholder"]" />
        </div>
    </div>

    @* Speichern, Ansehen, Zurück — dieselbe Ordnung wie in Plugins/Edit. "Ansehen" stand oben in
       der Kopfzeile und war damit von dem Knopf getrennt, der den Beitrag erst speichert; das
       "Abbrechen" hier unten führte ohnehin schon zur Liste und heißt jetzt wie überall "Zurück".
       Das style-Attribut ist weg: .form-actions bringt Flex und Abstand selbst mit. *@
    <div class="form-actions">
        <button type="submit" class="btn">@T["action.save"]</button>
        @if (!Model.IsNew)
        {
            <a class="btn btn-ghost" href="/blog/@Model.Input.Slug" target="_blank" rel="noopener"><i class="ti ti-external-link" aria-hidden="true"></i> @T["posts.view"]</a>
        }
        <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
    </div>
</form>

@section Scripts {
    @if (Model.AiEnabled)
    {
        <partial name="_AiSeoDialog" />
    }
    <style>
        .rt-toolbar { display:flex; flex-wrap:wrap; gap:4px; margin-bottom:6px; }
        .rt-toolbar button { padding:5px 10px; border:1px solid var(--line,#ddd); background:#fff; border-radius:6px; cursor:pointer; font-size:13px; }
        .rt-toolbar button:hover { background:var(--bg-alt,#f1efe9); }
        .rt-editor { border:1px solid var(--line,#ddd); border-radius:8px; padding:12px 14px; background:#fff; }
        .rt-editor:focus { outline:2px solid var(--accent,#b23a2e); outline-offset:-1px; }
        .att-chip { display:inline-flex; align-items:center; gap:6px; background:var(--bg-alt,#f1efe9); border:1px solid #e2d6c3; border-radius:8px; padding:6px 10px; font-size:13px; }
        .att-chip a { text-decoration:none; color:var(--accent,#b23a2e); }
        .att-chip button { border:0; background:none; cursor:pointer; color:#a00; font-weight:700; }
        /* Aligned with the form below (860 px), small on every screen — a side door, not the main entrance. */
        .post-head { max-width:860px; margin-bottom:8px; }
        .page-head .post-import-open { margin-left:auto; width:auto; flex:0 0 auto; display:inline-flex; align-items:center; gap:6px; }
        .post-import { width:min(620px, 92vw); }
        .post-import__title { margin:0 0 12px; }
        .post-import__foot { display:flex; justify-content:flex-end; margin-top:14px; }
        .post-import__row { display:flex; gap:8px; }
        .post-import__row input { flex:1; min-width:0; }
        .post-import__status { margin-top:10px; font-size:14px; }
        .post-import__status.is-error { color:#a3271c; }
        .post-import__status ul { margin:6px 0 0; padding-left:18px; color:var(--muted,#6b6257); }
        .gal-list { display:flex; flex-wrap:wrap; gap:10px; }
        .gal-item { position:relative; width:112px; }
        .gal-item img { width:112px; height:112px; object-fit:cover; border-radius:8px; display:block; border:1px solid var(--line,#ddd); }
        .gal-item .gal-tools { display:flex; justify-content:space-between; margin-top:4px; }
        .gal-item button { border:1px solid var(--line,#ddd); background:#fff; border-radius:6px; cursor:pointer; font-size:12px; padding:2px 7px; }
        .gal-item .gal-first { position:absolute; left:6px; top:6px; background:rgba(0,0,0,.6); color:#fff; font-size:11px; padding:1px 6px; border-radius:4px; }
        .gal-actions { display:flex; flex-wrap:wrap; align-items:center; gap:14px; margin-top:8px; }
        .gal-layout { display:inline-flex; align-items:center; gap:8px; font-weight:400; margin:0; }
        .src-row { display:grid; grid-template-columns:2fr 1fr; gap:8px; }
        @@media (max-width:640px) { .post-import__row, .src-row { display:grid; grid-template-columns:1fr; } }
    </style>
    <script>
        (function () {
            // ---- Rich text ----
            var ed = document.getElementById('rt-editor');
            var hidden = document.getElementById('rt-hidden');
            document.getElementById('rt-toolbar').addEventListener('click', function (e) {
                var b = e.target.closest('button'); if (!b) return;
                ed.focus();
                var cmd = b.getAttribute('data-cmd'), arg = b.getAttribute('data-arg');
                if (b.getAttribute('data-prompt')) {
                    var url = window.prompt('@T["posts.linkPrompt"]', 'https://'); if (url) document.execCommand(cmd, false, url);
                } else { document.execCommand(cmd, false, arg || null); }
            });
            document.getElementById('post-form').addEventListener('submit', function () { hidden.value = ed.innerHTML.trim(); });

            // ---- Title image ----
            var tiUrl = document.getElementById('ti-url'), tiPrev = document.getElementById('ti-preview');
            function syncTi() { tiPrev.style.backgroundImage = tiUrl.value ? "url('" + tiUrl.value + "')" : ''; }
            tiUrl.addEventListener('input', syncTi);
            document.getElementById('ti-pick').addEventListener('click', function () {
                if (window.openMediaPicker) window.openMediaPicker(function (u) { tiUrl.value = u; syncTi(); });
            });

            // ---- Attachments ----
            var attJson = document.getElementById('att-json'), attList = document.getElementById('att-list');
            var atts = [];
            try { atts = JSON.parse(attJson.value || '[]') || []; } catch (e) { atts = []; }
            function nameFromUrl(u) { try { return decodeURIComponent((u || '').split('/').pop().split('?')[0]); } catch (e) { return u; } }
            function renderAtts() {
                attList.innerHTML = '';
                atts.forEach(function (a, i) {
                    var chip = document.createElement('span'); chip.className = 'att-chip';
                    var link = document.createElement('a'); link.href = a.url; link.target = '_blank'; link.rel = 'noopener'; link.textContent = a.name || nameFromUrl(a.url);
                    var x = document.createElement('button'); x.type = 'button'; x.textContent = '×';
                    x.addEventListener('click', function () { atts.splice(i, 1); sync(); });
                    chip.appendChild(link); chip.appendChild(x); attList.appendChild(chip);
                });
            }
            function sync() { attJson.value = JSON.stringify(atts); renderAtts(); }
            document.getElementById('att-add').addEventListener('click', function () {
                if (!window.openMediaPicker) return;
                window.openMediaPicker(function (urls) {
                    (Array.isArray(urls) ? urls : [urls]).forEach(function (u) { if (u) atts.push({ url: u, name: nameFromUrl(u) }); });
                    sync();
                }, { multiple: true });
            });
            renderAtts();
        })();

        // ---- Gallery (1:N images) ----
        window.MatPostGallery = (function () {
            var json = document.getElementById('gal-json'), list = document.getElementById('gal-list');
            var items = [];
            try { items = JSON.parse(json.value || '[]') || []; } catch (e) { items = []; }
            function btn(label, title, fn) {
                var b = document.createElement('button'); b.type = 'button'; b.textContent = label; b.title = title;
                b.addEventListener('click', fn); return b;
            }
            function render() {
                json.value = JSON.stringify(items);
                list.innerHTML = '';
                items.forEach(function (it, i) {
                    var box = document.createElement('div'); box.className = 'gal-item';
                    var img = document.createElement('img'); img.src = it.url; img.alt = it.alt || ''; img.loading = 'lazy';
                    box.appendChild(img);
                    if (i === 0) { var f = document.createElement('span'); f.className = 'gal-first'; f.textContent = '1'; box.appendChild(f); }
                    var tools = document.createElement('div'); tools.className = 'gal-tools';
                    tools.appendChild(btn('←', '@T["posts.galleryLeft"]', function () { if (i > 0) { items.splice(i - 1, 0, items.splice(i, 1)[0]); render(); } }));
                    tools.appendChild(btn('×', '@T["posts.galleryRemove"]', function () { items.splice(i, 1); render(); }));
                    tools.appendChild(btn('→', '@T["posts.galleryRight"]', function () { if (i < items.length - 1) { items.splice(i + 1, 0, items.splice(i, 1)[0]); render(); } }));
                    box.appendChild(tools); list.appendChild(box);
                });
            }
            document.getElementById('gal-add').addEventListener('click', function () {
                if (!window.openMediaPicker) return;
                window.openMediaPicker(function (urls) {
                    (Array.isArray(urls) ? urls : [urls]).forEach(function (u) { if (u) items.push({ url: u, alt: '' }); });
                    render();
                }, { multiple: true });
            });
            render();
            return {
                count: function () { return items.length; },
                add: function (urls, alt) { urls.forEach(function (u) { items.push({ url: u, alt: alt || '' }); }); render(); }
            };
        })();

        // ---- Aus Link übernehmen ----
        (function () {
            var box = document.getElementById('pi-dialog'); if (!box) return;
            document.getElementById('pi-open').addEventListener('click', function () { box.showModal(); document.getElementById('pi-url').focus(); });
            document.getElementById('pi-close').addEventListener('click', function () { box.close(); });
            var input = document.getElementById('pi-url'), go = document.getElementById('pi-go'), status = document.getElementById('pi-status');
            var token = document.querySelector('#post-form input[name="__RequestVerificationToken"]');
            function show(text, isError, notes) {
                status.hidden = false; status.className = 'post-import__status' + (isError ? ' is-error' : '');
                status.textContent = text;
                if (notes && notes.length) {
                    var ul = document.createElement('ul');
                    notes.forEach(function (n) { var li = document.createElement('li'); li.textContent = n; ul.appendChild(li); });
                    status.appendChild(ul);
                }
            }
            function val(id) { var el = document.getElementById(id); return el ? el.value.trim() : ''; }
            function set(id, v) { var el = document.getElementById(id); if (el && v != null) el.value = v; }
            function run() {
                var url = input.value.trim(); if (!url) { input.focus(); return; }
                go.disabled = true; show(box.dataset.busy, false);
                var fd = new FormData(); fd.append('url', url); if (token) fd.append('__RequestVerificationToken', token.value);
                fetch(box.dataset.url, { method: 'POST', body: fd, credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d.ok) { show(d.error || box.dataset.failed, true, d.notes); return; }
                        var ed = document.getElementById('rt-editor');
                        var filled = val('Input_Title') || val('Input_Excerpt') || (ed && ed.textContent.trim());
                        var overwrite = !filled || window.confirm(box.dataset.overwrite);
                        if (overwrite) {
                            if (d.title) set('Input_Title', d.title);
                            if (d.excerpt) set('Input_Excerpt', d.excerpt);
                            if (d.html && ed) { ed.innerHTML = d.html; document.getElementById('rt-hidden').value = d.html; }
                            if (d.date) set('Input_PublishedAt', d.date);
                        }
                        set('src-url', d.sourceUrl); set('src-name', d.sourceName);
                        if (d.images && d.images.length) {
                            var ti = document.getElementById('ti-url');
                            if (ti && !ti.value) { ti.value = d.images[0]; ti.dispatchEvent(new Event('input')); }
                            window.MatPostGallery.add(d.images, d.title);
                        }
                        show(box.dataset.done.replace('{0}', d.via).replace('{1}', (d.images || []).length), false, d.notes);
                        // Nothing to read beyond the success line: the filled form behind is the result.
                        if (!d.notes || !d.notes.length) box.close();
                    })
                    .catch(function () { show(box.dataset.failed, true); })
                    .finally(function () { go.disabled = false; });
            }
            go.addEventListener('click', run);
            input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); run(); } });
        })();

        // ---- Tag picker (chips + suggestions), syncs the hidden Input.Tags field ----
        (function () {
            var box = document.getElementById('pt-tag-input');
            var entry = document.getElementById('pt-tag-entry');
            var addBtn = document.getElementById('pt-tag-add');
            var hidden = document.getElementById('pt-tags');
            var suggest = document.getElementById('pt-suggest');
            if (!box || !entry || !addBtn || !hidden) return;
            var chips = [];
            function showEntry() { addBtn.hidden = true; entry.hidden = false; entry.focus(); }
            function hideEntry() { entry.hidden = true; addBtn.hidden = false; }
            addBtn.addEventListener('click', showEntry);
            function render() {
                Array.prototype.slice.call(box.querySelectorAll('.tag-chip-item')).forEach(function (e) { e.remove(); });
                chips.forEach(function (tag) {
                    var el = document.createElement('span'); el.className = 'tag-chip-item'; el.textContent = tag;
                    var x = document.createElement('button'); x.type = 'button'; x.className = 'tag-x'; x.setAttribute('aria-label', '@T["posts.tagRemove"]'); x.textContent = '×';
                    x.addEventListener('click', function () { removeTag(tag); entry.focus(); });
                    el.appendChild(x); box.insertBefore(el, entry);
                });
                hidden.value = chips.join(', ');
            }
            function addTag(raw) {
                var t = (raw || '').replace(/,/g, ' ').trim(); if (!t) return;
                if (chips.some(function (c) { return c.toLowerCase() === t.toLowerCase(); })) return;
                chips.push(t); render();
            }
            function removeTag(tag) { chips = chips.filter(function (c) { return c !== tag; }); render(); }
            function setTags(str) {
                var seen = {};
                chips = (str || '').split(',').map(function (s) { return s.trim(); }).filter(function (c) {
                    if (!c) return false; var k = c.toLowerCase(); if (seen[k]) return false; seen[k] = 1; return true;
                });
                render();
            }
            entry.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addTag(entry.value); entry.value = ''; }
                else if (e.key === 'Escape') { e.preventDefault(); entry.value = ''; hideEntry(); }
                else if (e.key === 'Backspace' && !entry.value && chips.length) { removeTag(chips[chips.length - 1]); }
            });
            entry.addEventListener('blur', function () { if (entry.value.trim()) { addTag(entry.value); entry.value = ''; } hideEntry(); });
            box.addEventListener('click', function (e) { if (e.target === box) showEntry(); });
            if (suggest) suggest.addEventListener('click', function (e) {
                var c = e.target.closest('.mini-chip-add'); if (!c) return; addTag(c.getAttribute('data-tag')); entry.focus();
            });
            var form = document.getElementById('post-form');
            if (form) form.addEventListener('submit', function () { if (entry.value.trim()) { addTag(entry.value); entry.value = ''; } });
            setTags(hidden.value);
        })();
    </script>
}
