             {
                 <tr data-search="@(u.Username + " " + u.Email + " " + u.DisplayName)">
diff --git a/src/MatCMS.Cloud/Pages/Shared/PayloadTile.cs b/src/MatCMS.Cloud/Pages/Shared/PayloadTile.cs
index 5ffc8c9..d27fec5 100644
--- a/src/MatCMS.Cloud/Pages/Shared/PayloadTile.cs
