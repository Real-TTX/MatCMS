@page "/login"
@model MatCMS.Pages.LoginModel
@inject MatCMS.Services.SiteContext Site
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de" data-app="matcms" data-theme="light" data-density="compact">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@T["login.pageTitle"] – @Site.SiteName</title>
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/lib/matui/matui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin-matui.css" asp-append-version="true" />
    @MatCMS.Shared.Web.Pwa.Head("light", MatCMS.Shared.Web.Pwa.ShortName(Site.SiteName), "matcms")
    <link rel="icon" href="@Site.FaviconUrl" />
</head>
<body class="login-page login-matui">
    <div class="login-card">
        <img class="login-logo" src="@Site.LogoUrl" alt="@Site.SiteName" />
        <h1>@T["login.heading"]</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert-error">@Model.Error</div>
        }
        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div class="form-field">
                <label for="Username">@T["login.username"]</label>
                <input id="Username" name="Username" value="@Model.Username" autofocus required />
            </div>
            <div class="form-field">
                <label for="Password">@T["login.password"]</label>
                <input id="Password" name="Password" type="password" required />
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="RememberMe" value="true" /> @T["login.rememberMe"]
            </label>
            <button type="submit" class="btn btn-block">@T["login.submit"]</button>
        </form>
        @if (Model.SsoAvailable)
        {
            <div style="text-align:center;color:#9aa0a6;font-size:13px;margin:14px 0 10px;">@T["login.or"]</div>
            @* target="_blank": Läuft dieser Login im Cloud-iFrame (Instanz-Ansicht), MUSS der OAuth-Ablauf
               in einem neuen Tab (First-Party) laufen — im Cross-Site-iFrame blockt der Browser die
               Anmelde-Cookies (das ließ sich mit SameSite=None/CHIPS nicht zuverlässig lösen, v. a. Brave).
               Im neuen Tab wird die bestehende Cloud-Sitzung erkannt. Ohne iFrame öffnet _blank einfach
               einen Tab — akzeptabel für den seltenen SSO-Klick. *@
            <a class="btn btn-ghost btn-block" target="_blank" rel="noopener" href="/sso/start?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/admin")">@T["login.sso"]</a>
        }
        <a class="login-back" href="/">@T["login.back"]</a>
    </div>
</body>
</html>
