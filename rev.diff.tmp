diff --git a/src/MatCMS/Pages/Shared/StoreDialogModel.cs b/src/MatCMS/Pages/Shared/StoreDialogModel.cs
new file mode 100644
index 0000000..fa0b289
--- /dev/null
+++ b/src/MatCMS/Pages/Shared/StoreDialogModel.cs
@@ -0,0 +1,30 @@
+namespace MatCMS.Pages.Shared;
+
+/// <summary>
+/// One offering in the cloud store dialog.
+/// </summary>
+/// <param name="Title">Display name.</param>
+/// <param name="Sub">Identity line under the title (plugin key, component type, template name).</param>
+/// <param name="Description">Free text; may be empty.</param>
+/// <param name="RouteValue">Value passed to the install handler — the item's identity.</param>
+/// <param name="InstalledVersion">Version already on this site, or null when it is not installed.
+/// Drives the badge and whether the button reads "install" or "update".</param>
+/// <param name="Version">Version offered by the store, or null for things that have none.</param>
+/// <param name="Accent">Optional colour for the card's strip (templates).</param>
+public sealed record StoreItem(
+    string Title, string Sub, string Description, string RouteValue,
+    string? InstalledVersion = null, string? Version = null, string? Accent = null);
+
+/// <summary>
+/// Everything <c>_StoreDialog.cshtml</c> needs: the catalogue for ONE kind of thing, plus how to
+/// install it. Rendered by the plugins, templates and components pages, which differ only in the
+/// route parameter their install handler expects.
+/// </summary>
+/// <param name="TitleKey">Resource key for the dialog heading — user-facing text belongs in
+/// <c>Resources/*.json</c>, and a page model has no localizer.</param>
+/// <param name="IntroKey">Resource key for the one-line explanation.</param>
+/// <param name="RouteName">Name of the install handler's route parameter ("key", "name", "type").</param>
+/// <param name="Items">What the cloud offers. Empty = the dialog says so rather than showing nothing.</param>
+/// <param name="Error">Set when the catalogue could not be fetched; shown instead of the list.</param>
+public sealed record StoreDialog(
+    string TitleKey, string IntroKey, string RouteName, List<StoreItem> Items, string? Error = null);
diff --git a/src/MatCMS/Pages/Shared/_StoreDialog.cshtml b/src/MatCMS/Pages/Shared/_StoreDialog.cshtml
new file mode 100644
index 0000000..e2331bc
--- /dev/null
+++ b/src/MatCMS/Pages/Shared/_StoreDialog.cshtml
@@ -0,0 +1,114 @@
+@model MatCMS.Pages.Shared.StoreDialog
+@*
+    The cloud catalogue as a store, in a dialog rather than appended under the list — browsing what
+    you could install is a different activity from managing what you already have, and hanging it
+    below the page made it look like part of the inventory.
+
+    Opens by itself when the page was loaded with ?browse=true, because that IS the request to browse.
+    Uses the admin's own .modal-overlay/.modal; only the card grid inside is new.
+*@
+<div class="modal-overlay store-overlay" id="store-dialog">
+    <div class="modal modal-store" role="dialog" aria-modal="true" aria-labelledby="store-title">
+        <div class="modal-head">
+            <h2 id="store-title">@T[Model.TitleKey]</h2>
+            <button type="button" class="modal-close" data-store-close aria-label="@T["action.close"]">✕</button>
+        </div>
+        <div class="modal-body">
+            @if (Model.Error is not null)
+            {
+                <div class="alert alert-error">@Model.Error</div>
+            }
+            else if (Model.Items.Count == 0)
+            {
+                <p class="muted">@T[Model.IntroKey]</p>
+                <div class="list-empty">@T["store.dialogEmpty"]</div>
+            }
+            else
+            {
+                <p class="muted">@T[Model.IntroKey]</p>
+                <div class="store-search">
+                    <input type="search" class="list-search" id="store-search"
+                           placeholder="@T["store.dialogSearch"]" aria-label="@T["store.dialogSearch"]" autocomplete="off" />
+                </div>
+                <div class="store-grid" id="store-grid">
+                    @foreach (var item in Model.Items)
+                    {
+                        <div class="store-card" data-store-search="@($"{item.Title} {item.Sub} {item.Description}")">
+                            @if (!string.IsNullOrWhiteSpace(item.Accent))
+                            {
+                                <span class="store-card-strip" style="background:@item.Accent;"></span>
+                            }
+                            <div class="store-card-head">
+                                <strong>@item.Title</strong>
+                                @if (item.InstalledVersion is not null)
+                                {
+                                    <span class="badge badge-off">@T["store.dialogInstalled"]</span>
+                                }
+                            </div>
+                            <div class="store-card-sub mono">@item.Sub</div>
+                            @if (!string.IsNullOrWhiteSpace(item.Description))
+                            {
+                                <div class="store-card-text">@item.Description</div>
+                            }
+                            <div class="store-card-foot">
+                                @if (!string.IsNullOrWhiteSpace(item.Version))
+                                {
+                                    <span class="muted mono">@item.Version</span>
+                                }
+                                <form method="post" asp-page-handler="InstallFromCloud"
+                                      asp-all-route-data="@(new Dictionary<string, string> { [Model.RouteName] = item.RouteValue })">
+                                    <button type="submit" class="btn btn-sm">
+                                        @(item.InstalledVersion is null ? T["store.dialogInstall"] : T["store.dialogUpdate"])
+                                    </button>
+                                </form>
+                            </div>
+                        </div>
+                    }
+                </div>
+                <div class="list-empty" id="store-noresults" hidden>@T["list.noResults"]</div>
+            }
+        </div>
+        <div class="modal-foot">
+            <button type="button" class="btn btn-ghost" data-store-close>@T["action.close"]</button>
+        </div>
+    </div>
+</div>
+
+<script>
+    (function () {
+        var dialog = document.getElementById('store-dialog');
+        if (!dialog) return;
+
+        // The page was loaded because somebody asked to browse — so show it straight away.
+        dialog.classList.add('open');
+
+        function close() {
+            dialog.classList.remove('open');
+            // Drop ?browse=true so a reload (or the back button) does not reopen it.
+            var url = new URL(window.location.href);
+            url.searchParams.delete('browse');
+            window.history.replaceState({}, '', url);
+        }
+
+        dialog.querySelectorAll('[data-store-close]').forEach(function (b) { b.addEventListener('click', close); });
+        dialog.addEventListener('click', function (e) { if (e.target === dialog) close(); });
+        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && dialog.classList.contains('open')) close(); });
+
+        var search = document.getElementById('store-search');
+        var grid = document.getElementById('store-grid');
+        var none = document.getElementById('store-noresults');
+        if (search && grid) {
+            search.addEventListener('input', function () {
+                var q = search.value.trim().toLowerCase();
+                var shown = 0;
+                grid.querySelectorAll('.store-card').forEach(function (card) {
+                    var hit = !q || (card.getAttribute('data-store-search') || '').toLowerCase().indexOf(q) !== -1;
+                    card.hidden = !hit;
+                    if (hit) shown++;
+                });
+                if (none) none.hidden = shown !== 0;
+            });
+            search.focus();
+        }
+    })();
+</script>
diff --git a/src/MatCMS/Pages/_ViewImports.cshtml b/src/MatCMS/Pages/_ViewImports.cshtml
index fbecc61..f3b5f59 100644
--- a/src/MatCMS/Pages/_ViewImports.cshtml
+++ b/src/MatCMS/Pages/_ViewImports.cshtml
@@ -2,6 +2,7 @@
 @using MatCMS.Models
 @using MatCMS.Content
 @using MatCMS.Services
+@using MatCMS.Shared.Web
 @namespace MatCMS.Pages
 @addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
 @inject MatCMS.Services.Localizer T
