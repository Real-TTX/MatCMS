@page "{id:int}"
@using MatCMS.Services
@model MatCMS.Pages.Admin.Pages.DiffModel
@{
    ViewData["Title"] = T["diff.title"];
    string Loc(string c) => Localizer.DisplayName(c) + " (" + c + ")";
    string CellClass(string s) => s switch
    {
        "identical" => "d-identical",
        "translated" => "d-translated",
        "struct" => "d-struct",
        "missing" => "d-missing",
        "extra" => "d-extra",
        "na" => "d-na",
        _ => "d-empty"
    };
}
<div class="page-head">
    <h1>@T["diff.title"]</h1>
    <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@Model.Source.Id">@T["diff.back"]</a>
</div>

@if (Model.Locales.Count == 0)
{
    <div class="card"><p class="muted">@T["diff.noBlocks"]</p></div>
}
else
{
    <div class="card">
        <div class="d-heads">
            <span class="badge badge-on mono">@Model.Source.Locale</span>
            <strong>@Model.Source.Title</strong>
            <span class="muted">– @T["diff.source"] (@Loc(Model.Source.Locale))</span>
        </div>

        <div class="d-summary">
            @foreach (var loc in Model.Locales)
            {
                var c = Model.Totals[loc];
                <div class="d-sumcard">
                    <span class="badge badge-off mono">@loc.ToUpperInvariant()</span>
                    <span class="d-pill d-translated">@c.Translated @T["diff.translated"]</span>
                    <span class="d-pill d-identical">@c.Identical @T["diff.identical"]</span>
                    <span class="d-pill d-missing">@c.Missing @T["diff.missing"]</span>
                    @if (c.Extra > 0)
                    {
                        <span class="d-pill d-extra-pill">@c.Extra @T["diff.extra"]</span>
                    }
                </div>
            }
        </div>

        <div class="d-legend">
            <span class="muted">@T["diff.legend"]:</span>
            <span class="wd"><ins>@T["diff.legendIns"]</ins></span>
            <span class="wd"><del>@T["diff.legendDel"]</del></span>
            <span>@T["diff.legendPlain"]</span>
            <span class="d-flag d-flag-missing">@T["diff.missing"]</span>
            <span class="d-flag d-flag-extra">@T["diff.extra"]</span>
        </div>

        <div class="d-scroll">
            <table class="data d-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Loc(Model.Source.Locale) · @T["diff.source"]</th>
                        @foreach (var loc in Model.Locales)
                        {
                            <th>@Loc(loc)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var rowMissing = row.Cells.Any(c => c.Status == "missing");
                        var rowExtra = row.Cells.Any(c => c.Status == "extra");
                        <tr class="@(rowMissing ? "d-row-missing" : rowExtra ? "d-row-extra" : "")">
                            <td class="mono">@row.Index<div class="muted d-type">@row.BlockType</div></td>
                            <td class="d-src">@(string.IsNullOrWhiteSpace(row.SourceText) ? "—" : row.SourceText)</td>
                            @foreach (var cell in row.Cells)
                            {
                                <td class="wd @CellClass(cell.Status)"
                                    title="@(cell.Status == "identical" ? T["diff.identicalHint"] : cell.Status == "missing" ? T["diff.missingHint"] : cell.Status == "extra" ? T["diff.extraHint"] : "")">
                                    @if (cell.Status == "missing")
                                    {
                                        <span class="d-flag d-flag-missing">✗ @T["diff.missing"]</span>
                                    }
                                    else if (cell.Status == "extra")
                                    {
                                        <span class="d-flag d-flag-extra">＋ @T["diff.extra"]</span>
                                        @if (!string.IsNullOrWhiteSpace(cell.DiffHtml))
                                        {
                                            <div class="d-extra-text">@Html.Raw(cell.DiffHtml)</div>
                                        }
                                    }
                                    else if (cell.Status == "na")
                                    {
                                        <span class="muted">·</span>
                                    }
                                    else
                                    {
                                        @Html.Raw(cell.DiffHtml)
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <style>
        .d-heads { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
        .d-summary { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 12px; }
        .d-sumcard { display: flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1px solid var(--line, #e2e4e8); border-radius: 10px; background: #fff; }
        .d-pill { font-size: 12px; padding: 2px 9px; border-radius: 999px; border: 1px solid var(--line, #e2e4e8); }
        .d-pill.d-translated { background: #e6f7ea; border-color: #bfe6c8; color: #1a7f37; }
        .d-pill.d-identical { background: #fff8e6; border-color: #f0dca0; color: #9a6b00; }
        .d-pill.d-missing { background: #fdeeee; border-color: #f0bcbc; color: #cf222e; }
        .d-pill.d-extra-pill { background: #eaf3ff; border-color: #b6d7ff; color: #0969da; }
        /* Prominent inline flags for a missing / translation-only block (legend + cells). */
        .d-flag { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600;
                  padding: 2px 9px; border-radius: 999px; white-space: nowrap; }
        .d-flag-missing { background: #fdeeee; border: 1px solid #f0bcbc; color: #cf222e; }
        .d-flag-extra { background: #eaf3ff; border: 1px solid #b6d7ff; color: #0969da; }
        .d-extra-text { margin-top: 6px; }
        .d-legend { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; font-size: 12.5px; }
        .d-scroll { overflow-x: auto; }
        /* Fixed layout so columns share the width evenly and long text WRAPS instead of overflowing. */
        .d-table { width: 100%; table-layout: fixed; min-width: 760px; }
        .d-table td, .d-table th { vertical-align: top; font-size: 13.5px; line-height: 1.55; overflow-wrap: anywhere; word-break: break-word; white-space: normal; }
        /* First column carries the row number AND the block-type label below it — needs enough width
           so the block name (e.g. RICHTEXT, GALLERY) stays on one readable line instead of being
           squeezed to a sliver by table-layout:fixed. */
        .d-table th:first-child, .d-table td:first-child { width: 116px; }
        /* Override the shared .data rule (table.data td:last-child { width:1%; white-space:nowrap }, meant
           for an actions column) — here the last column is a language column and MUST wrap. */
        table.data.d-table td:last-child, table.data.d-table th:last-child { width: auto; white-space: normal; }
        .d-type { font-size: 11px; text-transform: uppercase; letter-spacing: .03em; margin-top: 3px; white-space: nowrap; }
        /* Git-style word diff */
        .wd ins { background: #e6f7ea; color: #1a7f37; text-decoration: none; border-radius: 3px; padding: 0 2px; }
        .wd del { background: #ffeef0; color: #cf222e; text-decoration: line-through; border-radius: 3px; padding: 0 2px; }
        /* cell tints by status */
        .d-identical { background: #fffdf5; }
        .d-translated { background: #fbfefb; }
        .d-missing { background: #fdf4f4; }
        .d-struct { background: #fdf1e7; }
        .d-extra { background: #f3f9ff; }
        .d-na { background: #fafafa; }
        /* Whole-row emphasis when a block is missing (red edge) or only in a translation (blue edge). */
        tr.d-row-missing td:first-child { box-shadow: inset 3px 0 0 #cf222e; }
        tr.d-row-extra td:first-child { box-shadow: inset 3px 0 0 #0969da; }
    </style>
}
