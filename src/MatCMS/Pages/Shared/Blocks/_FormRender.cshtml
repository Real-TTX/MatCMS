@using MatCMS.Content
@using Microsoft.AspNetCore.Html
@inject MatCMS.Services.Localizer T
@model MatCMS.Content.FormRenderModel
@{
    var containerId = "form-" + Model.Slug;

    // Localized labels for the shared custom datepicker (single + range). Set via a global window var
    // so the JS file needs no C#/@T awareness. The "||=" guard keeps multiple forms on one page safe.
    var dpI18nJson = System.Text.Json.JsonSerializer.Serialize(new
    {
        today = T["dp.today"].ToString(),
        clear = T["dp.clear"].ToString(),
        cancel = T["dp.cancel"].ToString(),
        ok = T["dp.ok"].ToString(),
        prev = T["dp.prevMonth"].ToString(),
        next = T["dp.nextMonth"].ToString(),
        to = T["dp.to"].ToString(),
        placeholder = T["dp.placeholder"].ToString(),
        placeholderRange = T["dp.placeholderRange"].ToString(),
        startLabel = T["dp.startLabel"].ToString(),
        endLabel = T["dp.endLabel"].ToString()
    });

    // Renders a single input element (text/date/number/phone/email/select).
    Func<FormElement, IHtmlContent> renderInput = null!;
    renderInput = el =>
    {
        var htmlType = el.Type switch
        {
            "email" => "email",
            "number" => "number",
            "date" => "date",
            "phone" => "tel",
            _ => "text"
        };
        var val = Model.Values.TryGetValue(el.Id, out var v) ? v : "";
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"form-field\" data-el=\"").Append(el.Id).Append('"');
        if (el.Condition is not null && el.Condition.IsSet)
        {
            sb.Append(" data-cond-field=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Field)).Append('"');
            sb.Append(" data-cond-op=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Op)).Append('"');
            sb.Append(" data-cond-value=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Value ?? "")).Append('"');
        }
        sb.Append('>');

        if (!string.IsNullOrWhiteSpace(el.Label))
        {
            sb.Append("<label for=\"fld_").Append(el.Id).Append("\">").Append(System.Net.WebUtility.HtmlEncode(el.Label));
            if (el.Required) sb.Append(" <span class=\"req\">*</span>");
            sb.Append("</label>");
        }

        var reqAttr = el.Required ? " required data-required=\"1\"" : "";
        var disAttr = Model.Preview ? " disabled" : "";
        if (el.Type == "textarea")
        {
            sb.Append("<textarea class=\"mat-input\" id=\"fld_").Append(el.Id).Append("\" name=\"").Append(el.Id).Append("\" rows=\"5\"");
            if (!string.IsNullOrWhiteSpace(el.Placeholder))
                sb.Append(" placeholder=\"").Append(System.Net.WebUtility.HtmlEncode(el.Placeholder)).Append('"');
            sb.Append(reqAttr).Append(disAttr).Append('>');
            sb.Append(System.Net.WebUtility.HtmlEncode(val));
            sb.Append("</textarea>");
        }
        else if (el.Type == "date" || el.Type == "daterange")
        {
            // Custom picker: value stays ISO ("YYYY-MM-DD" or "YYYY-MM-DD..YYYY-MM-DD") on the hidden
            // input so server-side validation/notification is unchanged; the visible button carries the
            // locale-formatted display, populated by mat-datepicker.js (open + close = single dialog).
            var isRange = el.Type == "daterange";
            var placeholder = !string.IsNullOrWhiteSpace(el.Placeholder)
                ? el.Placeholder
                : (isRange ? T["dp.placeholderRange"].ToString() : T["dp.placeholder"].ToString());
            var mode = isRange ? "range" : "single";
            sb.Append("<div class=\"mat-dp\" data-dp-mode=\"").Append(mode).Append('"').Append(el.Flex ? " data-dp-flex=\"1\"" : "");
            // Per-field text overrides for the picker buttons/labels — rendered as data-dp-t-<key>.
            // mat-datepicker.js applies these per trigger, falling back to the localized defaults.
            if (el.Texts is not null)
            {
                foreach (var key in new[] { "ok", "clear", "today", "cancel", "flexTitle", "exact" })
                {
                    if (el.Texts.TryGetValue(key, out var tv) && !string.IsNullOrWhiteSpace(tv))
                        sb.Append(" data-dp-t-").Append(key.ToLowerInvariant()).Append("=\"")
                          .Append(System.Net.WebUtility.HtmlEncode(tv)).Append('"');
                }
            }
            sb.Append(">");
            sb.Append("<button type=\"button\" class=\"mat-input mat-dp-btn-trigger\" data-dp-btn").Append(disAttr).Append(">");
            sb.Append("<span class=\"mat-dp-display mat-dp-placeholder\" data-dp-display data-placeholder=\"")
              .Append(System.Net.WebUtility.HtmlEncode(placeholder)).Append("\">")
              .Append(System.Net.WebUtility.HtmlEncode(placeholder))
              .Append("</span>");
            sb.Append("<span class=\"mat-dp-icon\" aria-hidden=\"true\">")
              .Append("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">")
              .Append("<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 9h18\"/><path d=\"M8 3v4\"/><path d=\"M16 3v4\"/>")
              .Append("</svg></span>");
            sb.Append("</button>");
            sb.Append("<input type=\"hidden\" id=\"fld_").Append(el.Id).Append("\" name=\"").Append(el.Id).Append("\" value=\"")
              .Append(System.Net.WebUtility.HtmlEncode(val)).Append("\" data-dp-input");
            if (el.Required) sb.Append(" data-required=\"1\"");
            sb.Append(" />");
            sb.Append("</div>");
        }
        else if (el.Type == "richselect" || el.Type == "multiselect")
        {
            System.Func<string, string> E = s => System.Net.WebUtility.HtmlEncode(s ?? "");
            var multi = el.Type == "multiselect";
            // One comma-separated value for both variants, so a field switched between them keeps
            // everything it ever saved and the submission list needs no second format.
            // Read with the SAME separator it writes with, so the field recognises its own value.
            var sep = string.IsNullOrEmpty(el.Separator) ? ", " : el.Separator!;
            var chosen = multi
                ? val.Split(sep.Trim().Length > 0 ? sep.Trim() : sep, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()
                : new List<string>();
            System.Func<MatCMS.Content.FormOption, bool> isOn = o => multi
                ? chosen.Contains(o.Value, StringComparer.OrdinalIgnoreCase)
                : string.Equals(o.Value, val, StringComparison.Ordinal);
            var selOpt = multi ? null : el.Options.FirstOrDefault(o => string.Equals(o.Value, val, StringComparison.Ordinal));
            var ph = string.IsNullOrWhiteSpace(el.Placeholder) ? T["form.selectPlaceholder"].ToString() : el.Placeholder;
            sb.Append("<div class=\"mat-rs\" data-rs").Append(multi ? " data-rs-multi" : "").Append(">");
            sb.Append("<button type=\"button\" class=\"mat-input mat-rs-trigger\" data-rs-btn").Append(disAttr).Append(">");
            var nothingChosen = multi ? chosen.Count == 0 : selOpt == null;
            sb.Append("<span class=\"mat-rs-current").Append(nothingChosen ? " mat-rs-placeholder" : "").Append("\" data-rs-current>");
            if (multi && chosen.Count > 0)
            {
                // Names while they still fit, a count after that: a truncated list reads as if the
                // rest had not been selected.
                var names = el.Options.Where(o => isOn(o)).Select(o => string.IsNullOrWhiteSpace(o.Label) ? o.Value : o.Label).ToList();
                sb.Append("<span class=\"mat-rs-cur-title\">")
                  .Append(E(names.Count <= 2 ? string.Join(sep, names) : names.Count + " gewählt"))
                  .Append("</span>");
            }
            else if (selOpt != null)
            {
                if (!string.IsNullOrWhiteSpace(selOpt.Image)) sb.Append("<span class=\"mat-rs-cur-img\" style=\"background-image:url('").Append(E(selOpt.Image)).Append("')\"></span>");
                sb.Append("<span class=\"mat-rs-cur-title\">").Append(E(selOpt.Label)).Append("</span>");
            }
            else { sb.Append(E(ph)); }
            sb.Append("</span><span class=\"mat-rs-chev\" aria-hidden=\"true\">▾</span></button>");
            sb.Append("<input type=\"hidden\" id=\"fld_").Append(el.Id).Append("\" name=\"").Append(el.Id).Append("\" value=\"").Append(E(val)).Append("\" data-rs-input");
            if (el.Required) sb.Append(" data-required=\"1\"");
            sb.Append(" data-placeholder=\"").Append(E(ph)).Append("\"")
              .Append(multi ? " data-many=\"{0} gewählt\" data-sep=\"" + E(sep) + "\"" : "").Append(">");
            sb.Append("<div class=\"mat-rs-menu\" data-rs-menu hidden>");
            // Mobile: the menu is presented as a bottom-sheet dialog with a title + close (✕) header
            // (hidden on desktop, where the menu stays an inline dropdown).
            sb.Append("<div class=\"mat-rs-sheet-head\"><span class=\"mat-rs-sheet-title\">")
              .Append(E(string.IsNullOrWhiteSpace(el.Label) ? ph : el.Label)).Append("</span>")
              .Append("<button type=\"button\" class=\"mat-rs-close\" data-rs-close aria-label=\"")
              .Append(E((string)T["form.close"])).Append("\">✕</button></div>");
            sb.Append("<div class=\"mat-rs-scroll\">");
            foreach (var o in el.Options)
            {
                var isSel = isOn(o);
                sb.Append("<button type=\"button\" class=\"mat-rs-opt").Append(isSel && multi ? " on" : "").Append("\" data-rs-opt data-value=\"").Append(E(o.Value)).Append("\"").Append(isSel ? " aria-selected=\"true\"" : "").Append(">");
                if (!string.IsNullOrWhiteSpace(o.Image)) sb.Append("<span class=\"mat-rs-opt-img\" style=\"background-image:url('").Append(E(o.Image)).Append("')\"></span>");
                sb.Append("<span class=\"mat-rs-opt-body\"><span class=\"mat-rs-opt-title\">").Append(E(string.IsNullOrWhiteSpace(o.Label) ? o.Value : o.Label)).Append("</span>");
                if (!string.IsNullOrWhiteSpace(o.Description)) sb.Append("<span class=\"mat-rs-opt-desc\">").Append(E(o.Description)).Append("</span>");
                if (o.Tags != null && o.Tags.Any(tg => !string.IsNullOrWhiteSpace(tg)))
                {
                    sb.Append("<span class=\"mat-rs-opt-tags\">");
                    foreach (var tg in o.Tags) if (!string.IsNullOrWhiteSpace(tg)) sb.Append("<span class=\"mat-rs-tag\">").Append(E(tg)).Append("</span>");
                    sb.Append("</span>");
                }
                sb.Append("</span></button>");
            }
            sb.Append("</div>");   // .mat-rs-scroll
            sb.Append("</div></div>");
        }
        else if (el.Type == "select")
        {
            sb.Append("<select class=\"mat-input\" id=\"fld_").Append(el.Id).Append("\" name=\"").Append(el.Id).Append('"').Append(reqAttr).Append(disAttr).Append('>');
            var selPh = string.IsNullOrWhiteSpace(el.Placeholder) ? T["form.selectPlaceholder"].ToString() : el.Placeholder;
            sb.Append("<option value=\"\">").Append(System.Net.WebUtility.HtmlEncode(selPh)).Append("</option>");
            foreach (var o in el.Options)
            {
                var sel = string.Equals(o.Value, val, StringComparison.Ordinal) ? " selected" : "";
                sb.Append("<option value=\"").Append(System.Net.WebUtility.HtmlEncode(o.Value)).Append('"').Append(sel).Append('>')
                  .Append(System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(o.Label) ? o.Value : o.Label)).Append("</option>");
            }
            sb.Append("</select>");
        }
        else
        {
            sb.Append("<input class=\"mat-input\" type=\"").Append(htmlType).Append("\" id=\"fld_").Append(el.Id).Append("\" name=\"").Append(el.Id).Append('"');
            sb.Append(" value=\"").Append(System.Net.WebUtility.HtmlEncode(val)).Append('"');
            if (!string.IsNullOrWhiteSpace(el.Placeholder))
                sb.Append(" placeholder=\"").Append(System.Net.WebUtility.HtmlEncode(el.Placeholder)).Append('"');
            if (!string.IsNullOrWhiteSpace(el.Regex))
                sb.Append(" pattern=\"").Append(System.Net.WebUtility.HtmlEncode(el.Regex)).Append('"');
            sb.Append(reqAttr).Append(disAttr).Append('>');
        }

        if (!string.IsNullOrWhiteSpace(el.Help))
            sb.Append("<div class=\"field-help\">").Append(System.Net.WebUtility.HtmlEncode(el.Help)).Append("</div>");
        sb.Append("</div>");
        return new HtmlString(sb.ToString());
    };

    Func<FormElement, IHtmlContent> renderElement = null!;
    renderElement = el =>
    {
        switch (el.Type)
        {
            // data-el on these two as well: they are top-level elements like any other, so the
            // builder has to be able to click them and has to be able to count them when it works
            // out where a new element goes. The attribute is inert outside the builder.
            case "title":
                return new HtmlString("<h3 class=\"form-el-title\" data-el=\"" + System.Net.WebUtility.HtmlEncode(el.Id) + "\">" + System.Net.WebUtility.HtmlEncode(el.Label) + "</h3>");
            case "description":
                return new HtmlString("<p class=\"form-el-desc\" data-el=\"" + System.Net.WebUtility.HtmlEncode(el.Id) + "\">" + System.Net.WebUtility.HtmlEncode(el.Label) + "</p>");
            case "group":
            {
                var sb = new System.Text.StringBuilder();
                sb.Append("<fieldset class=\"form-group\" data-el=\"").Append(el.Id).Append('"');
                if (el.Condition is not null && el.Condition.IsSet)
                {
                    sb.Append(" data-cond-field=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Field)).Append('"');
                    sb.Append(" data-cond-op=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Op)).Append('"');
                    sb.Append(" data-cond-value=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Value ?? "")).Append('"');
                }
                sb.Append('>');
                if (!string.IsNullOrWhiteSpace(el.Label))
                    sb.Append("<legend>").Append(System.Net.WebUtility.HtmlEncode(el.Label)).Append("</legend>");
                sb.Append("</fieldset>");
                // Build the fieldset content by concatenating children html, then inject.
                var inner = new System.Text.StringBuilder();
                foreach (var c in el.Fields)
                    inner.Append(FormDefinition.IsInput(c.Type) ? renderInput(c).ToString() : renderElement(c).ToString());
                var html = sb.ToString().Replace("</fieldset>", inner + "</fieldset>");
                return new HtmlString(html);
            }
            default:
                return renderInput(el);
        }
    };
}
@* Builder mode only. Same vocabulary as the PAGE preview (Pages/View.cshtml): .mat-ed-block for a
   selectable element, .mat-selected for the one being edited, .mat-insert for the gap between two —
   the two previews should not need two words for the same thing. Nothing of this reaches the public
   site, which never renders with Builder = true. *@
@if (Model.Builder)
{
    <style>
        /* Only elements are interactive; the rest of the page is not a target. */
        html { cursor: not-allowed; }
        .mat-ed-block { position: relative; cursor: pointer; }
        .mat-ed-block::after {
            content: attr(data-block-name);
            /* Right-hand side: a form field carries its own label on the LEFT, and the name tag sat
               straight on top of it. */
            position: absolute; top: 2px; right: 4px; z-index: 9998;
            background: #2563eb; color: #fff; font: 600 11px/1 Inter, system-ui, sans-serif;
            padding: 4px 8px; border-radius: 5px; letter-spacing: .03em;
            opacity: 0; transform: translateY(-4px); transition: opacity .12s ease, transform .12s ease;
            pointer-events: none;
        }
        /* The preview renders every control DISABLED, and a disabled control emits no click at all —
           so a click on the text box itself, which is most of what a field looks like, reached nothing
           and the whole select-in-the-preview felt broken. In the builder the controls are a picture of
           the form, not the form: the pointer goes straight through them to the element. */
        .mat-ed-block input, .mat-ed-block select, .mat-ed-block textarea,
        .mat-ed-block button, .mat-ed-block label { pointer-events: none; }
        .mat-ed-block:hover { outline: 1px dashed rgba(37, 99, 235, .5); outline-offset: 2px; }
        .mat-ed-block:hover::after { opacity: 1; transform: translateY(0); }
        .mat-ed-block.mat-selected { outline: 3px solid #2563eb; outline-offset: 2px; }
        .mat-insert { display: block; width: 100%; border: none; background: none; padding: 0; margin: 0; cursor: pointer; position: relative; height: 22px; opacity: 0; transition: opacity .12s ease; z-index: 9997; }
        .mat-insert::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 3px; background: #2563eb; border-radius: 3px; transform: translateY(-50%); }
        .mat-insert span { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 1; font: 700 11px/1 Inter, system-ui, sans-serif; background: #2563eb; color: #fff; padding: 4px 14px; border-radius: 999px; white-space: nowrap; box-shadow: 0 2px 8px rgba(37,99,235,.4); opacity: 0; transition: opacity .12s ease; }
        body:hover .mat-insert { opacity: .45; }
        .mat-insert:hover { opacity: 1; }
        .mat-insert:hover span { opacity: 1; }
        /* A gap that only appears under a mouse pointer does not exist on a phone. Where there is no
           hover, the zones are simply always there — visible, and tall enough to hit with a thumb. */
        @@media (hover: none) {
            .mat-insert { opacity: .6; height: 40px; }
            .mat-insert span { opacity: 1; padding: 7px 16px; }
            /* The name tag stays hover-only even here: shown permanently it printed itself
               over every heading and label in the form. The GAPS are what has to be reachable
               without a pointer; the tag is not. */
        }
    </style>
}
<link rel="stylesheet" href="~/css/mat-datepicker.css" asp-append-version="true" />
<script>window.matDpI18n = window.matDpI18n || @Html.Raw(dpI18nJson);</script>
<script src="~/js/mat-datepicker.js" asp-append-version="true" defer></script>
<link rel="stylesheet" href="~/css/mat-richselect.css" asp-append-version="true" />
<script src="~/js/mat-richselect.js" asp-append-version="true" defer></script>
<section class="contact-block form-block" id="@containerId" data-form-slug="@Model.Slug">
    <div class="container">
        <div class="contact-wrap">
            @if (!string.IsNullOrWhiteSpace(Model.Heading))
            {
                <h2>@Model.Heading</h2>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Intro))
            {
                <p class="text-center">@Model.Intro</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Success))
            {
                <div class="alert alert-success">@Model.Success</div>
            }
            @if (Model.Errors.Count > 0)
            {
                <div class="alert alert-error">@string.Join(" ", Model.Errors)</div>
            }

            @{
                var submitLabel = !string.IsNullOrWhiteSpace(Model.SubmitLabel) ? Model.SubmitLabel! : T["form.submit"].ToString();
            }
            @if (Model.Elements.Count == 0)
            {
                <p class="muted text-center">@T["form.noFields"]</p>
            }
            else if (Model.Preview)
            {
                <form onsubmit="return false;" class="form-fields">
                    @foreach (var el in Model.Elements)
                    {
                        @renderElement(el)
                    }
                    <button type="submit" class="btn" disabled>@submitLabel</button>
                </form>
            }
            else
            {
                @* Explicit action: the content page uses custom routing (/{slug?}), where the
                   asp-page-handler tag helper can't resolve the ambient page and renders an empty
                   action. Post to the current path with ?handler=Form so OnPostFormAsync runs. A plain
                   <form> gets no auto antiforgery token, so add it explicitly. *@
                <form method="post" action="@(ViewContext.HttpContext.Request.Path)?handler=Form" class="form-fields">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="__formSlug" value="@Model.Slug" />
                    @foreach (var el in Model.Elements)
                    {
                        @renderElement(el)
                    }
                    <button type="submit" class="btn">@submitLabel</button>
                </form>
            }
        </div>
    </div>
</section>
<script>
    (function () {
        var root = document.getElementById("@containerId");
        if (!root) return;
        var conds = Array.prototype.slice.call(root.querySelectorAll("[data-cond-field]"));

        function valueOf(name) {
            var el = root.querySelector("[name='" + (window.CSS && CSS.escape ? CSS.escape(name) : name) + "']");
            if (!el) return "";
            return (el.value || "").trim();
        }
        function apply() {
            conds.forEach(function (w) {
                var f = w.getAttribute("data-cond-field");
                var op = w.getAttribute("data-cond-op");
                var target = w.getAttribute("data-cond-value") || "";
                var v = valueOf(f);
                var show;
                switch (op) {
                    case "neq": show = v.toLowerCase() !== target.toLowerCase(); break;
                    case "contains": show = v.toLowerCase().indexOf(target.toLowerCase()) >= 0; break;
                    case "filled": show = v !== ""; break;
                    default: show = v.toLowerCase() === target.toLowerCase();
                }
                w.style.display = show ? "" : "none";
                Array.prototype.slice.call(w.querySelectorAll("input,select,textarea")).forEach(function (inp) {
                    if (show) {
                        if (inp.getAttribute("data-required") === "1") inp.required = true;
                        inp.disabled = @(Model.Preview ? "true" : "false");
                    } else {
                        inp.required = false;
                        inp.disabled = true;
                    }
                });
            });
        }
        root.addEventListener("input", apply);
        root.addEventListener("change", apply);
        apply();

        // Enter must not submit the form from a single-line field (that surprised users). A textarea
        // keeps Enter = newline; buttons still work; the form is submitted only via "Absenden".
        root.addEventListener("keydown", function (e) {
            if (e.key !== "Enter" && e.keyCode !== 13) return;
            var t = e.target;
            if (!t || !t.tagName) return;
            var tag = t.tagName.toLowerCase();
            if (tag === "textarea") return;
            if (tag === "input") {
                var type = (t.getAttribute("type") || "text").toLowerCase();
                if (type === "submit" || type === "button") return;
                e.preventDefault();
            }
        });

        @if (Model.Builder)
        {
            <text>
            // ---- Builder bridge --------------------------------------------------------------
            // Two things travel up to the editor: which element was clicked, and where a new one
            // should go. Everything here re-runs after a live-preview swap, because that swap
            // replaces the whole body and takes the decorations with it.
            function post(msg) { if (window.parent && window.parent !== window) window.parent.postMessage(msg, "*"); }
            // NOT the captured `root`: a live-preview swap replaces the body, so the old node is
            // detached and every query against it silently returns nothing.
            function scope() { return document.getElementById("@containerId") || document; }
            var selectedEl = null;

            document.addEventListener("click", function (e) {
                if (e.target.closest(".mat-insert")) return;   // the zone posts its own message
                var host = e.target.closest("[data-el]");
                if (host) { e.preventDefault(); e.stopPropagation(); post({ type: "mat-select-element", id: host.getAttribute("data-el") }); }
            }, true);

            // Top-level elements only. A field inside a group carries its own data-el (clicking it
            // selects the group, which the server resolves), but a new element is never inserted
            // INTO a group from out here — the group's own panel does that.
            function topHosts() {
                var f = scope().querySelector ? scope().querySelector("form.form-fields") : null;
                if (!f) return [];
                return Array.prototype.slice.call(f.children).filter(function (c) {
                    return c.nodeType === 1 && c.hasAttribute("data-el");
                });
            }

            function decorate() {
                var hosts = topHosts();
                hosts.forEach(function (h) {
                    h.classList.add("mat-ed-block");
                    // The label the operator sees in the sidebar, taken from what is on screen —
                    // no second source that could drift from the first.
                    var lbl = h.querySelector("label, legend");
                    var name = (lbl ? lbl.textContent : h.textContent) || "";
                    h.setAttribute("data-block-name", name.replace(/\s+/g, " ").trim().slice(0, 40) || "@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)T["forms.elementFallbackName"]).Trim('"'))");
                });
                Array.prototype.slice.call(scope().querySelectorAll(".mat-insert")).forEach(function (z) { z.remove(); });
                var label = "@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)T["forms.insertHere"]).Trim('"'))";
                function makeZone(index) {
                    var z = document.createElement("button");
                    z.type = "button";
                    z.className = "mat-insert";
                    z.title = label;
                    z.setAttribute("aria-label", label);
                    z.innerHTML = "<span></span>";
                    z.firstChild.textContent = label;
                    z.addEventListener("click", function (e) {
                        e.preventDefault(); e.stopPropagation();
                        post({ type: "mat-insert-at", index: index });
                    });
                    return z;
                }
                hosts.forEach(function (h, i) { h.parentNode.insertBefore(makeZone(i), h); });
                // One at the very end, so appending is the same gesture as inserting.
                if (hosts.length) hosts[hosts.length - 1].insertAdjacentElement("afterend", makeZone(hosts.length));
                if (selectedEl) markSelected(selectedEl);
            }

            function markSelected(id) {
                selectedEl = id;
                Array.prototype.slice.call(scope().querySelectorAll(".mat-selected")).forEach(function (n) { n.classList.remove("mat-selected"); });
                var el = scope().querySelector("[data-el='" + id + "']");
                if (el) el.classList.add("mat-selected");
            }

            window.addEventListener("message", function (e) {
                var d = e.data || {};
                if (d.type === "mat-render" && typeof d.html === "string") { document.body.innerHTML = d.html; decorate(); return; }
                if (d.type === "mat-select-el" && d.id) { markSelected(d.id); return; }
                if (d.type === "mat-scroll-element" && d.id) {
                    var el = scope().querySelector("[data-el='" + d.id + "']");
                    if (el) el.scrollIntoView({ behavior: "smooth", block: "center" });
                }
            });

            decorate();
            post({ type: "mat-preview-ready" });
            </text>
        }
    })();
</script>
