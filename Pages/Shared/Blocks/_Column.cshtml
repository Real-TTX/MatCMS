@model MatCMS.Content.BlockData
@{
    var title = Model.Str("title");
    var body = Model.Str("body");
    var bg = Model.Str("bg");
    var fg = Model.Str("fg");
    var tinted = !string.IsNullOrWhiteSpace(bg) || !string.IsNullOrWhiteSpace(fg);
    var style = "";
    if (!string.IsNullOrWhiteSpace(bg)) style += $"background:{bg};";
    if (!string.IsNullOrWhiteSpace(fg)) style += $"color:{fg};";
}
<div class="column@(tinted ? " column--tinted" : "")"@(tinted ? new Microsoft.AspNetCore.Html.HtmlString($" style=\"{style}\"") : Microsoft.AspNetCore.Html.HtmlString.Empty)>
    @if (!string.IsNullOrWhiteSpace(title))
    {
        <h3>@title</h3>
    }
    <div class="rich">@Html.Raw(body)</div>
</div>
