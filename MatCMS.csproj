<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MatCMS</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Default assembly version. InformationalVersion is supplied at build time
         via -p:InformationalVersion=<APP_VERSION> (see Dockerfile / GitHub Actions). -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating 10.0.* so restores/rebuilds always pick up the latest patch ("immer aktuell"). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.*" />
    <!-- Override the transitive (vulnerable) SQLitePCLRaw 2.1.11 with the current 3.0.x bundle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.*" />
  </ItemGroup>

</Project>
