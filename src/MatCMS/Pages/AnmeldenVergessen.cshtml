@page "/anmelden/vergessen"
@model MatCMS.Pages.AnmeldenVergessenModel
@{
    ViewData["Title"] = T["member.forgot.title"];
}
<partial name="_MemberAuthStyle" />
<section class="member-auth">
    <div class="member-auth-card">
        <h1>@T["member.forgot.title"]</h1>
        @if (Model.Sent)
        {
            <p class="member-auth-ok">@T["member.forgot.sent", MatCMS.Services.MemberService.TokenHours]</p>
        }
        else
        {
            <form method="post">
                <label class="member-auth-field">
                    <span>@T["member.forgot.email"]</span>
                    <input name="email" type="email" autocomplete="email" required autofocus />
                </label>
                <button type="submit" class="btn">@T["member.forgot.send"]</button>
            </form>
        }
        <p class="member-auth-links"><a href="/anmelden">@T["member.forgot.back"]</a></p>
    </div>
</section>
