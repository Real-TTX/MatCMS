<Project Sdk="Microsoft.NET.Sdk">

  <!-- Signs packages for the MatCMS Store (docs/official-store.md). Runs on the store operator's own machine, never on a server:
       the private key it creates and uses lives in %APPDATA%\MatCMS\store-signing, outside this repository. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StoreSign</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MatCMS.Shared\MatCMS.Shared.csproj" />
  </ItemGroup>

</Project>
