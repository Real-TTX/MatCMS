@page
@model MatCMS.Pages.Admin.Menus.IndexModel
@{
    ViewData["Title"] = "Menü";
}
<div class="page-head">
    <h1>Menü-Verwaltung</h1>
</div>

<div class="card">
    <h2>Hauptmenü (Header)</h2>
    <p class="help">Zum Umsortieren am Griff <span class="mono">⠿</span> ziehen.</p>
    @if (Model.Header.Count == 0)
    {
        <p class="muted">Noch keine Menüpunkte.</p>
    }
    <div class="block-list sortable" data-sortable data-reorder-form="reorder-header">
        @foreach (var it in Model.Header)
        {
            <div class="block-item sortable-item" data-item-id="@it.Id">
                <span class="drag-handle" title="Ziehen zum Sortieren" aria-hidden="true">⠿</span>
                <div class="b-info">
                    <div class="b-type">@it.Label</div>
                    <div class="b-sum">@it.Url@(it.OpenInNewTab ? " · neuer Tab" : "")</div>
                </div>
                <div class="actions">
                    <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@it.Id">Bearbeiten</a>
                    <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@it.Id" onsubmit="return confirm('Menüpunkt „@it.Label“ löschen?');">
                        <button type="submit" class="btn btn-sm btn-danger" title="Löschen">✕</button>
                    </form>
                </div>
            </div>
        }
    </div>
    <form id="reorder-header" method="post" asp-page-handler="Reorder" asp-route-menu="header" style="display:none;">
        <div data-order-inputs></div>
    </form>
    <div class="list-actions">
        <a class="btn" asp-page="Create" asp-route-menu="header">+ Menüpunkt hinzufügen</a>
    </div>
</div>

<div class="card">
    <h2>Footer-Menü</h2>
    <p class="help">Zum Umsortieren am Griff <span class="mono">⠿</span> ziehen.</p>
    @if (Model.Footer.Count == 0)
    {
        <p class="muted">Noch keine Menüpunkte.</p>
    }
    <div class="block-list sortable" data-sortable data-reorder-form="reorder-footer">
        @foreach (var it in Model.Footer)
        {
            <div class="block-item sortable-item" data-item-id="@it.Id">
                <span class="drag-handle" title="Ziehen zum Sortieren" aria-hidden="true">⠿</span>
                <div class="b-info">
                    <div class="b-type">@it.Label</div>
                    <div class="b-sum">@it.Url@(it.OpenInNewTab ? " · neuer Tab" : "")</div>
                </div>
                <div class="actions">
                    <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@it.Id">Bearbeiten</a>
                    <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@it.Id" onsubmit="return confirm('Menüpunkt „@it.Label“ löschen?');">
                        <button type="submit" class="btn btn-sm btn-danger" title="Löschen">✕</button>
                    </form>
                </div>
            </div>
        }
    </div>
    <form id="reorder-footer" method="post" asp-page-handler="Reorder" asp-route-menu="footer" style="display:none;">
        <div data-order-inputs></div>
    </form>
    <div class="list-actions">
        <a class="btn" asp-page="Create" asp-route-menu="footer">+ Menüpunkt hinzufügen</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-sortable.js" asp-append-version="true"></script>
}
