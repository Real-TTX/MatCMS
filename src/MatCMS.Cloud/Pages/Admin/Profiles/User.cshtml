@page "{profileId:int}/{id:int?}"
@model MatCMS.Cloud.Pages.Admin.Profiles.UserModel
@{
    ViewData["Title"] = Model.IsNew ? T["profiles.addUser"] : Model.Item.Username;
}
<div class="page-head">
    <h1>
        @(Model.IsNew ? T["profiles.addUser"] : Model.Item.Username)
        <span class="muted" style="font-size:14px;font-weight:400;"> — @Model.Owner.Name</span>
    </h1>
    <div class="list-toolbar">
        <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@Model.Owner.Id" asp-route-tab="users">@T["action.back"]</a>
    </div>
</div>

<form method="post" asp-route-profileId="@Model.Owner.Id" asp-route-id="@(Model.IsNew ? null : (int?)Model.Item.Id)">
    <div class="card">
        <h2>@T["profiles.tabUsers"]</h2>
        <p class="muted">@T["profiles.usersHint"]</p>
        <div class="form-grid">
            <div class="form-row">
                <div class="form-field">
                    <label for="username">@T["users.username"]</label>
                    <input id="username" name="username" value="@Model.Item.Username" autocomplete="off" required />
                </div>
                <div class="form-field">
                    <label for="password">@T["users.password"]</label>
                    <input id="password" name="password" type="password" autocomplete="new-password"
                           placeholder="@(Model.IsNew ? "" : T["users.passwordKeep"])" />
                    <div class="help">@T["profiles.userPasswordHint"]</div>
                </div>
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label for="email">@T["users.email"]</label>
                    <input id="email" name="email" type="email" value="@Model.Item.Email" />
                </div>
                <div class="form-field">
                    <label for="displayName">@T["users.displayName"]</label>
                    <input id="displayName" name="displayName" value="@Model.Item.DisplayName" />
                </div>
            </div>
        </div>
    </div>

    <div class="list-actions">
        <button type="submit" class="btn">@T["settings.save"]</button>
    </div>
</form>

@if (!Model.IsNew)
{
    <div class="card danger-zone">
        <h2>@T["instances.dangerZone"]</h2>
        <div class="actions">
            <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-profileId="@Model.Owner.Id" asp-route-id="@Model.Item.Id"
                  onsubmit="return confirm('@T["profiles.userDeleteConfirm"]');">
                <button type="submit" class="btn btn-sm btn-danger">@T["common.delete"]</button>
            </form>
        </div>
    </div>
}
