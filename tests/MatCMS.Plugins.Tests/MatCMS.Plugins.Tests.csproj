<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MatCMS\MatCMS.csproj" />
    <!-- Built before the tests so its output exists; the tests load the DLL from disk like the host does. -->
    <ProjectReference Include="..\Fixtures\RefPlugin\RefPlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- A real store plugin in both kinds (plugins/store-einblick + store-einblick-native): StoreEinblickTests run the two side by side. -->
    <ProjectReference Include="..\..\plugins\store-einblick-native\StoreEinblick.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- The forum (plugins/forum), a native plugin of its own: ForumTests run it inside the whole application. -->
    <ProjectReference Include="..\..\plugins\forum\Forum.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- The MatCMS Store server (plugins/matcms-store), native: MatcmsStoreTests run it inside the whole application. -->
    <ProjectReference Include="..\..\plugins\matcms-store\MatcmsStore.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- The club plugin (plugins/verein), native as well: VereinTests run it inside the whole application. -->
    <ProjectReference Include="..\..\plugins\verein\Verein.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- The guest area of a private event (plugins/moments), native: MomentsTests run it inside the whole application. -->
    <ProjectReference Include="..\..\plugins\moments\Moments.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- Holiday homes (plugins/booking), native: BookingTests run it inside the whole application. -->
    <ProjectReference Include="..\..\plugins\booking\Booking.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- The shop and the AI bot (plugins/shop, plugins/bot), native since they left the image: AppFactory installs both (signed with the test key, off)
         into every application, as a site that has them from the store. The tests ALSO compile against them — their store, model and pure rules —
         so the test assembly has its own copy next to the one the application loads; a seam a test sets must therefore not live in a static field
         of the plugin (StripeClient.HandlerFactory keeps it in AppContext). -->
    <ProjectReference Include="..\..\plugins\shop\Shop.csproj" />
    <ProjectReference Include="..\..\plugins\bot\Bot.csproj" />
    <!-- The blog (plugins/blog), native since it left the image: imported as a test-signed package (BlogFixture) into harness and application. -->
    <ProjectReference Include="..\..\plugins\blog\Blog.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Fixtures\ref-plugin.csx" Link="fixtures\ref-plugin.csx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugins\store-einblick\*.csx" Link="fixtures\store-einblick\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugins\coverage-map\*.csx" Link="fixtures\coverage-map\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugins\matmon-live\*.csx" Link="fixtures\matmon-live\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The native fixture lands in fixtures/refplugin/ next to the test assembly, exactly as a plugin's src/
       folder looks on an instance: the plugin DLL and nothing of the host. -->
  <Target Name="CopyRefPlugin" AfterTargets="Build">
    <ItemGroup>
      <RefPluginFiles Include="$(MSBuildProjectDirectory)\..\Fixtures\RefPlugin\bin\$(Configuration)\net10.0\RefPlugin.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RefPluginFiles)" DestinationFolder="$(OutDir)fixtures\refplugin" />
    <ItemGroup>
      <StoreEinblickFiles Include="$(MSBuildProjectDirectory)\..\..\plugins\store-einblick-native\bin\$(Configuration)\net10.0\StoreEinblick.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(StoreEinblickFiles)" DestinationFolder="$(OutDir)fixtures\store-einblick-native" />
    <ItemGroup>
      <ForumFiles Include="$(MSBuildProjectDirectory)\..\..\plugins\forum\bin\$(Configuration)\net10.0\Forum.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ForumFiles)" DestinationFolder="$(OutDir)fixtures\forum" />
    <ItemGroup>
      <MatcmsStoreFiles Include="$(MSBuildProjectDirectory)\..\..\plugins\matcms-store\bin\$(Configuration)\net10.0\MatcmsStore.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(MatcmsStoreFiles)" DestinationFolder="$(OutDir)fixtures\matcms-store" />
    <ItemGroup>
      <VereinFiles Include="$(MSBuildProjectDirectory)\..\..\plugins\verein\bin\$(Configuration)\net10.0\Verein.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VereinFiles)" DestinationFolder="$(OutDir)fixtures\verein" />
    <ItemGroup>
      <MomentsFiles Include="$(MSBuildProjectDirectory)\..\..\plugins\moments\bin\$(Configuration)\net10.0\Moments.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(MomentsFiles)" DestinationFolder="$(OutDir)fixtures\moments" />
    <ItemGroup>
      <BookingFiles Include="$(MSBuildProjectDirectory)\..\..\plugins\booking\bin\$(Configuration)\net10.0\Booking.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BookingFiles)" DestinationFolder="$(OutDir)fixtures\booking" />
    <ItemGroup>
      <ShopFiles Include="$(MSBuildProjectDirectory)\..\..\plugins\shop\bin\$(Configuration)\net10.0\Shop.dll" />
      <BotFiles Include="$(MSBuildProjectDirectory)\..\..\plugins\bot\bin\$(Configuration)\net10.0\Bot.dll" />
      <BotAssets Include="$(MSBuildProjectDirectory)\..\..\plugins\bot\assets\*" />
          <BlogFiles Include="$(MSBuildProjectDirectory)\..\..\plugins\blog\bin\$(Configuration)\net10.0\Blog.dll" />
      <BlogAssets Include="$(MSBuildProjectDirectory)\..\..\plugins\blog\assets\*" />
        </ItemGroup>
    <Copy SourceFiles="@(ShopFiles)" DestinationFolder="$(OutDir)fixtures\shop" />
    <Copy SourceFiles="@(BotFiles)" DestinationFolder="$(OutDir)fixtures\bot" />
    <Copy SourceFiles="@(BotAssets)" DestinationFolder="$(OutDir)fixtures\bot\assets" />
    <Copy SourceFiles="@(BlogFiles)" DestinationFolder="$(OutDir)fixtures\blog" />
    <Copy SourceFiles="@(BlogAssets)" DestinationFolder="$(OutDir)fixtures\blog\assets" />
  </Target>

</Project>
