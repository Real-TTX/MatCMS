@page
@using MatCMS.Services
@model MatCMS.Pages.Admin.Pages.IndexModel
@{
    ViewData["Title"] = T["pages.title"];
}
<div data-list data-list-page-size="25">
    <div class="page-head">
        <h1>@T["pages.title"]</h1>
        <div class="list-toolbar">
            <input type="search" class="list-search" data-list-search placeholder="Suchen…" aria-label="Suchen" autocomplete="off" />
            <a class="btn btn-sm" asp-page="Create">@T["pages.create"]</a>
        </div>
    </div>

    <table class="data" data-list-table>
        <thead>
            <tr>
                <th>@T["pages.colTitle"]</th>
                <th>@T["pages.colUrl"]</th>
                <th>@T["pages.colStatus"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Groups.Count == 0)
            {
                <tr><td colspan="4" class="muted" style="text-align:center;padding:22px;">@T["pages.none"]</td></tr>
            }
            @foreach (var g in Model.Groups)
            {
                var p = g.Primary;
                var multi = g.Versions.Count > 1;
                var search = p.Title + " " + g.Url + " " + string.Join(" ", g.Versions.Select(v => v.Locale));
                <tr data-search="@search">
                    <td>
                        <div class="pg-title">
                            @if (multi)
                            {
                                <button type="button" class="pg-toggle" data-pg-toggle aria-expanded="false" title="Sprachversionen"></button>
                            }
                            else
                            {
                                <span class="pg-toggle-spacer"></span>
                            }
                            <strong>@p.Title</strong>
                            @if (multi)
                            {
                                <span class="muted" style="font-size:12px;">· @g.Versions.Count Versionen</span>
                            }
                        </div>
                        @if (multi)
                        {
                            <div class="pg-versions" hidden>
                                @foreach (var v in g.Versions)
                                {
                                    var isDef = v.Locale == Localizer.DefaultCulture;
                                    <a class="pg-version" asp-page="Edit" asp-route-id="@v.Id">
                                        <span class="badge @(isDef ? "badge-on" : "badge-off") mono">@v.Locale.ToUpperInvariant()</span>
                                        <span>@Localizer.DisplayName(v.Locale)@(isDef ? " · Original" : "")</span>
                                        @if (!v.IsPublished)
                                        {
                                            <span class="muted" style="font-size:11px;">· @T["pages.draft"]</span>
                                        }
                                    </a>
                                }
                            </div>
                        }
                    </td>
                    <td><a class="mono" href="@g.Url" target="_blank">@g.Url</a></td>
                    <td>
                        @if (p.IsPublished)
                        {
                            <span class="badge badge-on">@T["pages.published"]</span>
                        }
                        else
                        {
                            <span class="badge badge-off">@T["pages.draft"]</span>
                        }
                    </td>
                    <td>
                        <div class="actions">
                            <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@p.Id">@T["action.edit"]</a>
                            <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@p.Id"
                                  onsubmit="return confirm('@T["pages.confirmDelete", p.Title]');">
                                <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="list-empty" data-list-empty hidden>Keine Treffer.</div>
    <nav class="list-pager" data-list-pager aria-label="Seiten"></nav>
</div>

<style>
    .pg-title { display: flex; align-items: center; gap: 8px; }
    .pg-toggle {
        width: 20px; height: 20px; flex: none; padding: 0; cursor: pointer; border: 0; background: none;
        color: var(--muted, #6b7078); border-radius: 5px; font-size: 11px; line-height: 1;
    }
    .pg-toggle::before { content: "\25B8"; display: inline-block; transition: transform .12s ease; }
    .pg-toggle[aria-expanded="true"]::before { transform: rotate(90deg); }
    .pg-toggle:hover { background: #eef1f6; color: var(--black, #111); }
    .pg-toggle-spacer { display: inline-block; width: 20px; flex: none; }
    .pg-versions { display: flex; flex-direction: column; gap: 2px; margin: 6px 0 2px 28px; }
    .pg-version {
        display: flex; align-items: center; gap: 8px; padding: 5px 8px; border-radius: 7px;
        text-decoration: none; color: var(--ink, #1a1a1a); border: 1px solid transparent;
    }
    .pg-version:hover { background: #f4f6f9; border-color: var(--line, #e2e4e8); }
</style>

@section Scripts {
    <script>
        document.querySelectorAll('[data-pg-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var cell = btn.closest('td');
                var box = cell ? cell.querySelector('.pg-versions') : null;
                if (!box) return;
                var open = box.hidden;
                box.hidden = !open;
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
        });
    </script>
}
