@page
@model MatCMS.Pages.Admin.Settings.IndexModel
@using MatCMS.Services
@{
    ViewData["Title"] = T["settings.title"];
    string V(string key) => Model.Values.TryGetValue(key, out var v) ? v : "";
}
<div class="page-head">
    <h1>@T["settings.title"]</h1>
</div>

<div class="tabs" role="tablist">
    <button type="button" class="tab active" data-tab="general">@T["settings.tabGeneral"]</button>
    <button type="button" class="tab" data-tab="smtp">@T["settings.tabSmtp"]</button>
    <button type="button" class="tab" data-tab="errors">@T["settings.tabErrors"]</button>
    <button type="button" class="tab" data-tab="code">@T["settings.tabCode"]</button>
    <button type="button" class="tab" data-tab="maintenance">@T["settings.maint.tab"]</button>
    <button type="button" class="tab" data-tab="languages">@T["settings.tabLanguages"]</button>
    <button type="button" class="tab" data-tab="cloud">@T["settings.tabCloud"]</button>
</div>

@* ============ CLOUD ============ *@
<div class="tab-panel" data-panel="cloud" hidden>
    <div class="card">
        <h2>@T["settings.cloudHeading"]</h2>
        <p class="muted">@T["settings.cloudIntro"]</p>

        @if (Model.Cloud.Configured)
        {
            <div class="kv">
                <div class="kv-label">@T["settings.cloudStatus"]</div>
                <div class="kv-value">
                    @if (Model.CloudState.Connected && Model.CloudState.IsPending)
                    {
                        <span class="badge badge-off">@T["settings.cloudAwaitingApproval"]</span>
                        <span class="muted">@T["settings.cloudAwaitingApprovalHint"]</span>
                    }
                    else if (Model.CloudState.Connected)
                    {
                        <span class="badge badge-on">@T["settings.cloudConnected"]</span>
                    }
                    else if (Model.CloudState.LastAttemptUtc is null)
                    {
                        <span class="badge badge-off">@T["settings.cloudPending"]</span>
                    }
                    else
                    {
                        <span class="badge badge-err">@T["settings.cloudFailed"]</span>
                        <span class="muted">@Model.CloudState.LastError</span>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.CloudState.DisplayName))
            {
                <div class="kv">
                    <div class="kv-label">@T["settings.cloudName"]</div>
                    <div class="kv-value">@Model.CloudState.DisplayName</div>
                </div>
            }
            <div class="kv">
                <div class="kv-label">@T["settings.cloudLastBeat"]</div>
                <div class="kv-value">@(Model.CloudState.LastAttemptUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—") UTC</div>
            </div>
            <div class="kv">
                <div class="kv-label">@T["settings.cloudLatest"]</div>
                <div class="kv-value">
                    @(Model.CloudState.LatestVersion ?? "—")
                    @if (Model.CloudState.UpdateAvailable)
                    {
                        <span class="badge badge-new">@T["settings.cloudUpdateAvailable"]</span>
                    }
                </div>
            </div>
            <div class="kv">
                <div class="kv-label">@T["settings.cloudCanUpdate"]</div>
                <div class="kv-value">
                    @if (Model.CloudState.CloudCanUpdate)
                    {
                        <span class="badge badge-on">@T["settings.cloudLocal"]</span>
                        <span class="muted">@T["settings.cloudLocalHelp"]</span>
                    }
                    else
                    {
                        <span class="badge badge-off">@T["settings.cloudRemote"]</span>
                        <span class="muted">@T["settings.cloudRemoteHelp"]</span>
                    }
                </div>
            </div>
            <div class="kv">
                <div class="kv-label">@T["settings.cloudContainerId"]</div>
                <div class="kv-value mono">@(MatCMS.Services.ContainerIdentity.Current ?? T["settings.cloudNoContainer"])</div>
            </div>
            <div class="kv">
                <div class="kv-label">@T["settings.cloudProfile"]</div>
                <div class="kv-value">@(Model.CloudState.ProfileName ?? T["settings.cloudNoProfile"])</div>
            </div>
            <div class="kv">
                <div class="kv-label">@T["settings.cloudConfigState"]</div>
                <div class="kv-value">
                    @if (Model.CloudState.ConfigRevision == 0)
                    {
                        <span class="muted">@T["settings.cloudNoConfig"]</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.CloudState.SyncError))
                    {
                        <span class="badge badge-err">@T["settings.cloudSyncFailed"]</span>
                        <span class="muted">@Model.CloudState.SyncError</span>
                    }
                    else if (Model.CloudState.OutOfSync)
                    {
                        <span class="badge badge-off">@T["settings.cloudSyncPending"]</span>
                        <span class="muted">@T["settings.cloudSyncRevisions", Model.CloudState.AppliedRevision, Model.CloudState.ConfigRevision]</span>
                    }
                    else
                    {
                        <span class="badge badge-on">@T["settings.cloudSyncOk"]</span>
                        <span class="muted">@T["settings.cloudSyncRevision", Model.CloudState.AppliedRevision]</span>
                    }
                </div>
            </div>
            <div style="margin-top:14px;">
                <form method="post" asp-page-handler="CloudSync" style="margin:0;">
                    <button type="submit" class="btn btn-ghost">@T["settings.cloudSyncNow"]</button>
                </form>
            </div>
        }
    </div>

    <div class="card">
        <h2>@T["settings.cloudLink"]</h2>
        <p class="muted">@T["settings.cloudJoinHelp"]</p>
        <form method="post" asp-page-handler="CloudConnect">
            <div class="form-field">
                <label>@T["settings.cloudUrl"]</label>
                <input name="cloudUrl" value="@Model.Cloud.Url" placeholder="https://cloud.example.com" spellcheck="false" />
            </div>
            <div class="form-field">
                <label>@T["settings.cloudJoinCode"]</label>
                <input name="joinCode" placeholder="XXXX-XXXX-XXXX" spellcheck="false" autocomplete="off" />
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <button type="submit" class="btn">@T["settings.cloudConnect"]</button>
            </div>
        </form>

        <details style="margin-top:18px;">
            <summary class="muted">@T["settings.cloudManual"]</summary>
            <form method="post" asp-page-handler="CloudManual" style="margin-top:12px;">
                <div class="form-field">
                    <label>@T["settings.cloudUrl"]</label>
                    <input name="cloudUrl" value="@Model.Cloud.Url" placeholder="https://cloud.example.com" spellcheck="false" />
                </div>
                <div class="form-field">
                    <label>@T["settings.cloudInstanceId"]</label>
                    <input name="cloudInstanceId" value="@Model.Cloud.InstanceId" spellcheck="false" />
                </div>
                <div class="form-field">
                    <label>@T["settings.cloudToken"]</label>
                    <input name="cloudToken" type="password" autocomplete="new-password"
                           placeholder="@(Model.CloudHasToken ? T["settings.cloudTokenKeep"] : "")" />
                    <div class="help">@T["settings.cloudTokenHelp"]</div>
                </div>
                <button type="submit" class="btn btn-ghost">@T["settings.cloudConnect"]</button>
            </form>
        </details>
        @if (Model.Cloud.Configured)
        {
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;">
                <form method="post" asp-page-handler="CloudTest" style="margin:0;">
                    <button type="submit" class="btn btn-ghost">@T["settings.cloudTest"]</button>
                </form>
                <form method="post" asp-page-handler="CloudDisconnect" style="margin:0;"
                      onsubmit="return confirm('@T["settings.cloudDisconnectConfirm"]');">
                    <button type="submit" class="btn btn-ghost">@T["settings.cloudDisconnect"]</button>
                </form>
            </div>
        }
    </div>
</div>

@* ============ GENERAL ============ *@
<div class="tab-panel" data-panel="general">
    <form method="post">
        <div class="card">
            <h2>@T["settings.general"]</h2>
            <div class="form-field">
                <label>URL</label>
                <input name="Values[@SettingKeys.CanonicalUrl]" value="@V(SettingKeys.CanonicalUrl)" placeholder="@T["settings.canonicalPlaceholder"]" spellcheck="false" />
                <div class="help">@Html.Raw(T["settings.canonicalHelp"])</div>
            </div>
            <div class="form-field">
                <label>@T["settings.siteName"]</label>
                <input name="Values[@SettingKeys.SiteName]" value="@V(SettingKeys.SiteName)" />
            </div>
            <div class="form-field">
                <label>@T["settings.logo"]</label>
                <div class="image-field" data-upload>
                    <div class="preview" data-preview></div>
                    <div class="image-controls">
                        <input name="Values[@SettingKeys.LogoUrl]" value="@V(SettingKeys.LogoUrl)" placeholder="@T["settings.logoPlaceholder"]" data-url />
                        <div style="margin-top:8px;">
                            <button type="button" class="btn btn-ghost btn-sm" data-lib-btn>@T["settings.pickImage"]</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-field">
                <label>@T["settings.favicon"]</label>
                <div class="image-field" data-upload>
                    <div class="preview" data-preview></div>
                    <div class="image-controls">
                        <input name="Values[@SettingKeys.FaviconUrl]" value="@V(SettingKeys.FaviconUrl)" placeholder="@T["settings.faviconPlaceholder"]" data-url />
                        <div style="margin-top:8px;">
                            <button type="button" class="btn btn-ghost btn-sm" data-lib-btn>@T["settings.pickImage"]</button>
                        </div>
                        <div class="help">@T["settings.faviconHelp"]</div>
                    </div>
                </div>
            </div>
            <div class="form-field">
                <label>@T["settings.footerText"]</label>
                <input name="Values[@SettingKeys.FooterText]" value="@V(SettingKeys.FooterText)" />
            </div>
            <div class="form-field">
                <label>@T["settings.contactEmail"]</label>
                <input name="Values[@SettingKeys.ContactRecipient]" value="@V(SettingKeys.ContactRecipient)" />
                <div class="help">@T["settings.contactEmailHelp"]</div>
            </div>
            <div><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
</div>

@* ============ SMTP ============ *@
<div class="tab-panel" data-panel="smtp" hidden>
    <form method="post" asp-page-handler="Smtp">
        <div class="card">
            <h2>@T["settings.smtpHeading"]</h2>
            <p class="muted">@T["settings.smtpIntro"]</p>
            <div class="form-grid">
                <div class="form-field">
                    <label>@T["settings.smtpHost"]</label>
                    <input name="Values[@SettingKeys.SmtpHost]" value="@V(SettingKeys.SmtpHost)" placeholder="smtp.example.com" />
                </div>
                <div class="form-field">
                    <label>@T["settings.smtpPort"]</label>
                    <input name="Values[@SettingKeys.SmtpPort]" value="@V(SettingKeys.SmtpPort)" placeholder="587" inputmode="numeric" />
                </div>
                <div class="form-field">
                    <label>@T["settings.smtpUser"]</label>
                    <input name="Values[@SettingKeys.SmtpUser]" value="@V(SettingKeys.SmtpUser)" autocomplete="off" />
                </div>
                <div class="form-field">
                    <label>@T["settings.smtpPassword"]</label>
                    <input type="password" name="Values[@SettingKeys.SmtpPassword]" value="@V(SettingKeys.SmtpPassword)" autocomplete="new-password" />
                </div>
                <div class="form-field">
                    <label>@T["settings.smtpFromEmail"]</label>
                    <input name="Values[@SettingKeys.SmtpFromEmail]" value="@V(SettingKeys.SmtpFromEmail)" placeholder="noreply@example.com" />
                </div>
                <div class="form-field">
                    <label>@T["settings.smtpFromName"]</label>
                    <input name="Values[@SettingKeys.SmtpFromName]" value="@V(SettingKeys.SmtpFromName)" placeholder="@V(SettingKeys.SiteName)" />
                </div>
                <div class="form-field">
                    <label>@T["settings.smtpSsl"]</label>
                    <select name="Values[@SettingKeys.SmtpSsl]">
                        <option value="true" selected="@(V(SettingKeys.SmtpSsl) == "true")">@T["settings.smtpSslOn"]</option>
                        <option value="false" selected="@(V(SettingKeys.SmtpSsl) != "true")">@T["settings.smtpSslOff"]</option>
                    </select>
                    <div class="help">@T["settings.smtpSslHelp"]</div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">@T["settings.save"]</button>
                <button type="submit" class="btn btn-ghost" formaction="?handler=TestSmtp">@T["settings.smtpTest"]</button>
            </div>
            <p class="help">@T["settings.smtpTestHelp"]</p>
        </div>
    </form>
</div>

@* ============ FEHLERHANDLING ============ *@
<div class="tab-panel" data-panel="errors" hidden>
    <form method="post" asp-page-handler="Errors">
        <div class="card">
            <h2>@T["settings.errorsHeading"]</h2>
            <p class="muted">@T["settings.errorsIntro"]</p>
            <div class="form-field">
                <label>@T["settings.error404"]</label>
                <select name="Values[@SettingKeys.NotFoundPage]">
                    <option value="">@T["settings.errorDefault"]</option>
                    @foreach (var p in Model.AllPages)
                    {
                        <option value="@p.Slug" selected="@(V(SettingKeys.NotFoundPage) == p.Slug)">@p.Title (/@p.Slug)</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>@T["settings.error500"]</label>
                <select name="Values[@SettingKeys.ErrorPage]">
                    <option value="">@T["settings.errorDefault"]</option>
                    @foreach (var p in Model.AllPages)
                    {
                        <option value="@p.Slug" selected="@(V(SettingKeys.ErrorPage) == p.Slug)">@p.Title (/@p.Slug)</option>
                    }
                </select>
            </div>
            <div><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
</div>

@* ============ CODE / TRACKING ============ *@
<div class="tab-panel" data-panel="code" hidden>
    <form method="post" asp-page-handler="Code">
        <div class="card">
            <h2>@T["settings.codeHeading"]</h2>
            <p class="muted">@T["settings.codeIntro"]</p>

            <div class="form-field">
                <label>XML-Sitemap</label>
                <select name="Values[@SettingKeys.SitemapEnabled]">
                    <option value="true" selected="@(V(SettingKeys.SitemapEnabled) != "false")">@T["settings.sitemapOn"]</option>
                    <option value="false" selected="@(V(SettingKeys.SitemapEnabled) == "false")">@T["settings.sitemapOff"]</option>
                </select>
                <div class="help">@Html.Raw(T["settings.sitemapHelp"])</div>
            </div>

            <div class="form-field">
                <label>@T["settings.ga4Label"]</label>
                <input name="Values[@SettingKeys.AnalyticsGa4]" value="@V(SettingKeys.AnalyticsGa4)" placeholder="G-XXXXXXXXXX" spellcheck="false" />
                <div class="help">@Html.Raw(T["settings.ga4Help"])</div>
            </div>

            <div class="form-field">
                <label>@T["settings.codeHeadLabel"]</label>
                <textarea name="Values[@SettingKeys.CodeHead]" rows="5" spellcheck="false" class="code-area" placeholder="@T["settings.codeHeadPlaceholder"]">@V(SettingKeys.CodeHead)</textarea>
                <div class="help">@Html.Raw(T["settings.codeHeadHelp"])</div>
            </div>

            <div class="form-field">
                <label>@T["settings.codeBodyStartLabel"]</label>
                <textarea name="Values[@SettingKeys.CodeBodyStart]" rows="4" spellcheck="false" class="code-area" placeholder="@T["settings.codeBodyStartPlaceholder"]">@V(SettingKeys.CodeBodyStart)</textarea>
                <div class="help">@Html.Raw(T["settings.codeBodyStartHelp"])</div>
            </div>

            <div class="form-field">
                <label>@T["settings.codeBodyEndLabel"]</label>
                <textarea name="Values[@SettingKeys.CodeBodyEnd]" rows="4" spellcheck="false" class="code-area" placeholder="@T["settings.codeBodyEndPlaceholder"]">@V(SettingKeys.CodeBodyEnd)</textarea>
                <div class="help">@Html.Raw(T["settings.codeBodyEndHelp"])</div>
            </div>

            <div><button type="submit" class="btn">@T["action.save"]</button></div>
        </div>
    </form>
</div>

@* ============ WARTUNG (Maintenance mode) ============ *@
<div class="tab-panel" data-panel="maintenance" hidden>
    <form method="post" asp-page-handler="Maintenance">
        <div class="card">
            <h2>@T["settings.maint.heading"]</h2>
            <p class="muted">@T["settings.maint.intro"]</p>

            <div class="form-field">
                <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-weight:600;">
                    <input type="checkbox" name="Values[@SettingKeys.MaintenanceEnabled]" value="1" checked="@(V(SettingKeys.MaintenanceEnabled) == "1")" />
                    <span>@T["settings.maint.enabledLabel"]</span>
                </label>
                <div class="help">@T["settings.maint.enabledHelp"]</div>
            </div>

            <div class="form-field">
                <label>@T["settings.maint.titleLabel"]</label>
                <input name="Values[@SettingKeys.MaintenanceTitle]" value="@V(SettingKeys.MaintenanceTitle)" placeholder="@T["maintenance.defaultTitle"]" />
            </div>

            <div class="form-field">
                <label>@T["settings.maint.messageLabel"]</label>
                <textarea name="Values[@SettingKeys.MaintenanceMessage]" rows="3" placeholder="@T["maintenance.defaultMessage"]">@V(SettingKeys.MaintenanceMessage)</textarea>
            </div>

            <div class="help">@Html.Raw(T["settings.maint.overrideHelp"])</div>

            <div class="form-actions" style="margin-top:14px;">
                <button type="submit" class="btn">@T["settings.save"]</button>
                <a class="btn btn-ghost" href="/admin/maintenance/preview" target="_blank" rel="noopener">@T["settings.maint.preview"]</a>
            </div>
        </div>
    </form>
</div>

<div class="tab-panel" data-panel="languages" hidden>
    @{
        var routableNames = Model.RoutableLanguages.ToDictionary(c => c, c => MatCMS.Services.Localizer.DisplayName(c));
        var activeList = Model.RoutableLanguages.Where(c => Model.CurrentActive.Contains(c)).ToList();
    }
    <form method="post" asp-page-handler="Languages" id="lang-form">
        <div class="card">
            <div class="page-head" style="margin-bottom:14px;">
                <h2 style="margin:0;">@T["settings.langHeading"]</h2>
                <div class="list-toolbar">
                    <button type="button" class="btn btn-sm" id="lang-add">@T["settings.langAdd"]</button>
                </div>
            </div>
            <table class="data">
                <thead><tr><th>@T["editor.language"]</th><th>@T["settings.langCode"]</th><th>@T["pages.colUrl"]</th><th></th></tr></thead>
                <tbody id="lang-rows"></tbody>
            </table>
            <div id="lang-hidden"></div>
            <p class="help" style="margin-top:12px;">@Html.Raw(T["settings.langHelp"])</p>
            <div style="margin-top:8px;"><button type="submit" class="btn">@T["action.save"]</button></div>
        </div>
    </form>

    @* ---- Maschinelle Übersetzung (für den ⚡-Button im Seiten-Editor) ---- *@
    <form method="post" asp-page-handler="Translate">
        <div class="card" style="margin-top:18px;">
            <h2>@T["settings.translate.heading"]</h2>
            <p class="muted">@T["settings.translate.intro"]</p>
            <div class="form-grid">
                <div class="form-field">
                    <label>@T["settings.translate.provider"]</label>
                    <select name="Values[@SettingKeys.TranslateProvider]" id="tr-provider">
                        <option value="" selected="@(V(SettingKeys.TranslateProvider) == "")">@T["settings.translate.off"]</option>
                        <option value="deepl" selected="@(V(SettingKeys.TranslateProvider) == "deepl")">DeepL</option>
                        <option value="libretranslate" selected="@(V(SettingKeys.TranslateProvider) == "libretranslate")">LibreTranslate</option>
                    </select>
                </div>
                <div class="form-field">
                    <label>@T["settings.translate.apiKey"]</label>
                    <input type="password" name="Values[@SettingKeys.TranslateApiKey]" value="@V(SettingKeys.TranslateApiKey)" autocomplete="new-password" spellcheck="false" />
                    <div class="help">@T["settings.translate.apiKeyHelp"]</div>
                </div>
                <div class="form-field">
                    <label>@T["settings.translate.url"]</label>
                    <input name="Values[@SettingKeys.TranslateUrl]" value="@V(SettingKeys.TranslateUrl)" placeholder="http://libretranslate:5000" spellcheck="false" />
                    <div class="help">@T["settings.translate.urlHelp"]</div>
                </div>
            </div>
            <div><button type="submit" class="btn">@T["action.save"]</button></div>
        </div>
    </form>

    <dialog id="lang-dialog" class="mat-dialog">
        <form method="dialog">
            <h3 style="margin:0 0 12px;">@T["settings.langDialogTitle"]</h3>
            <select id="lang-dialog-select" style="width:100%;"></select>
            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px;">
                <button class="btn btn-ghost btn-sm" value="cancel">@T["action.cancel"]</button>
                <button class="btn btn-sm" value="add" id="lang-dialog-ok">@T["action.add"]</button>
            </div>
        </form>
    </dialog>

    <script>
        (function () {
            var NAMES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(routableNames));
            var active = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(activeList));
            var def = "@Model.CurrentDefaultLanguage";
            var rows = document.getElementById("lang-rows");
            var hidden = document.getElementById("lang-hidden");
            var dialog = document.getElementById("lang-dialog");
            var dsel = document.getElementById("lang-dialog-select");

            function render() {
                rows.innerHTML = ""; hidden.innerHTML = "";
                if (!active.includes(def)) def = active[0];
                active.forEach(function (code) {
                    var tr = document.createElement("tr");
                    var isDef = code === def;
                    var url = isDef ? "/" : "/" + code + "/";
                    tr.innerHTML =
                        '<td><strong>' + NAMES[code] + '</strong>' + (isDef ? ' <span class="badge badge-on">@T["settings.langDefaultBadge"]</span>' : '') + '</td>' +
                        '<td><span class="mono">' + code + '</span></td>' +
                        '<td><span class="mono muted">' + url + '</span></td>' +
                        '<td><div class="actions"></div></td>';
                    var act = tr.querySelector(".actions");
                    if (!isDef) {
                        var mk = document.createElement("button");
                        mk.type = "button"; mk.className = "btn btn-sm btn-ghost"; mk.textContent = "@T["settings.langSetDefault"]";
                        mk.onclick = function () { def = code; render(); };
                        act.appendChild(mk);
                        var rm = document.createElement("button");
                        rm.type = "button"; rm.className = "btn btn-sm btn-danger btn-icon"; rm.title = "@T["settings.langRemove"]"; rm.textContent = "✕";
                        rm.onclick = function () { active = active.filter(function (c) { return c !== code; }); render(); };
                        act.appendChild(rm);
                    }
                    rows.appendChild(tr);
                    var h = document.createElement("input");
                    h.type = "hidden"; h.name = "ActiveLanguages"; h.value = code; hidden.appendChild(h);
                });
                var hd = document.createElement("input");
                hd.type = "hidden"; hd.name = "DefaultLanguage"; hd.value = def; hidden.appendChild(hd);
            }

            document.getElementById("lang-add").onclick = function () {
                dsel.innerHTML = "";
                Object.keys(NAMES).forEach(function (code) {
                    if (active.includes(code)) return;
                    var o = document.createElement("option"); o.value = code; o.textContent = NAMES[code] + " (" + code + ")"; dsel.appendChild(o);
                });
                if (!dsel.options.length) { alert("@T["settings.langAllActive"]"); return; }
                if (typeof dialog.showModal === "function") dialog.showModal(); else dialog.setAttribute("open", "");
            };
            document.getElementById("lang-dialog-ok").onclick = function () {
                if (dsel.value && !active.includes(dsel.value)) { active.push(dsel.value); render(); }
            };
            render();
        })();
    </script>
</div>

@section Scripts {
    <script>
        (function () {
            // Tabs
            var tabs = document.querySelectorAll('.tab');
            var panels = document.querySelectorAll('.tab-panel');
            function show(name) {
                tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.tab === name); });
                panels.forEach(function (p) { p.hidden = p.dataset.panel !== name; });
            }
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
            var want = new URLSearchParams(location.search).get('tab');
            if (want) show(want);
        })();

        // Wire every [data-upload] image field (logo, favicon, …) to the shared media dialog, which
        // now handles uploading itself — so a single "Bild wählen" button is enough.
        document.querySelectorAll('.image-field[data-upload]').forEach(function (field) {
            var input = field.querySelector('[data-url]');
            var prev = field.querySelector('[data-preview]');
            var libBtn = field.querySelector('[data-lib-btn]');
            if (!input) return;
            function setPrev(u) { if (prev) prev.style.backgroundImage = u ? "url('" + u + "')" : ''; }
            setPrev(input.value);
            input.addEventListener('input', function () { setPrev(input.value); });
            if (libBtn) libBtn.addEventListener('click', function () {
                if (window.openMediaPicker) window.openMediaPicker(function (u) { input.value = u; setPrev(u); });
            });
        });
    </script>
}
