@page "{id:int}"
@model MatCMS.Pages.Admin.Blocks.EditModel
@{
    ViewData["Title"] = T["blocks.editTitle"];
}
<div class="page-head">
    <h1 class="with-icon">
        <span class="head-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(Model.Definition.Svg)</svg>
        </span>
        @Model.Definition.Name
    </h1>
</div>
<p class="muted">@Model.Definition.Description</p>

<div class="card">
    <form id="block-form" method="post">
        <input type="hidden" name="DataJson" id="DataJson" />
        <div id="block-editor"></div>
        @* Speichern, dann Zurück — dieselbe Ordnung wie in Plugins/Edit. Oben in der Kopfzeile stand
           derselbe Weg schon einmal, nur als "Zurück zu …" statt "Abbrechen": ein Ziel, zwei
           Beschriftungen, an zwei Orten. Geblieben ist die genauere von beiden, unten. *@
        <div class="editor-actions">
            <button type="submit" class="btn">@T["action.save"]</button>
            <a class="btn btn-ghost" asp-page="/Admin/Pages/Edit" asp-route-id="@Model.PageId">@T["blocks.backToPage", Model.PageTitle]</a>
        </div>
    </form>
</div>

<script id="block-schema" type="application/json">@Html.Raw(Model.SchemaJson.Replace("</", "<\\/"))</script>
<script id="block-data" type="application/json">@Html.Raw(Model.CurrentJson.Replace("</", "<\\/"))</script>

@section Scripts {
    <script src="~/js/admin-blocks.js" asp-append-version="true"></script>
}
