@inject MatCMS.Services.SiteContext Site
@{
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrWhiteSpace(title) ? Site.SiteName : $"{title} – {Site.SiteName}";
    var metaDescription = ViewData["MetaDescription"] as string;

    // ---- Active template (theme) ----
    var tpl = Site.ActiveTemplate;

    // Build the Google Fonts URL from the template's font families (dedup, weights 400-700).
    string FontQuery(string family) =>
        Uri.EscapeDataString(family.Trim()).Replace("%20", "+") + ":wght@400;500;600;700";
    var families = new List<string>();
    if (!string.IsNullOrWhiteSpace(tpl.HeadingFont)) families.Add(tpl.HeadingFont.Trim());
    if (!string.IsNullOrWhiteSpace(tpl.BodyFont) &&
        !string.Equals(tpl.BodyFont.Trim(), tpl.HeadingFont?.Trim(), StringComparison.OrdinalIgnoreCase))
        families.Add(tpl.BodyFont.Trim());
    if (families.Count == 0) families.Add("Inter");
    var fontsHref = "https://fonts.googleapis.com/css2?" +
        string.Join("&", families.Select(f => "family=" + FontQuery(f))) + "&display=swap";

    // Accent + a slightly darker shade for --accent-dark.
    var accent = string.IsNullOrWhiteSpace(tpl.AccentColor) ? "#de7e11" : tpl.AccentColor.Trim();
    string Darken(string hex)
    {
        var h = hex.TrimStart('#');
        if (h.Length == 3)
            h = string.Concat(h[0], h[0], h[1], h[1], h[2], h[2]);
        if (h.Length != 6 ||
            !int.TryParse(h.Substring(0, 2), System.Globalization.NumberStyles.HexNumber, null, out var r) ||
            !int.TryParse(h.Substring(2, 2), System.Globalization.NumberStyles.HexNumber, null, out var g) ||
            !int.TryParse(h.Substring(4, 2), System.Globalization.NumberStyles.HexNumber, null, out var b))
            return hex;
        r = (int)(r * 0.85); g = (int)(g * 0.85); b = (int)(b * 0.85);
        return $"#{r:x2}{g:x2}{b:x2}";
    }
    var accentDark = Darken(accent);

    var headFamily = string.IsNullOrWhiteSpace(tpl.HeadingFont) ? "Geologica" : tpl.HeadingFont.Trim();
    var bodyFamily = string.IsNullOrWhiteSpace(tpl.BodyFont) ? "Inter" : tpl.BodyFont.Trim();
    var outlineButtons = string.Equals(tpl.ButtonStyle?.Trim(), "outline", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="@fontsHref" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --accent: @accent;
            --accent-dark: @accentDark;
            --font-head: "@headFamily", "Inter", sans-serif;
            --font-body: "@bodyFamily", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        @if (outlineButtons)
        {
            @Html.Raw(".btn { background: transparent; color: var(--accent); border: 2px solid var(--accent); }")
            @Html.Raw(".btn:hover { background: var(--accent); color: #fff; }")
        }
    </style>
    <link rel="icon" href="@Site.LogoUrl" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" href="/">
                <img src="@Site.LogoUrl" alt="@Site.SiteName" />
            </a>
            <div class="header-icons">
                @if (!string.IsNullOrWhiteSpace(Site.TopBarLink1Url))
                {
                    <a class="hicon" href="@Site.TopBarLink1Url" target="_blank" rel="noopener"
                       title="@Site.TopBarLink1Text" aria-label="@Site.TopBarLink1Text">
                        <svg viewBox="0 0 512 512" role="img" aria-hidden="true">
                            <path fill="currentColor" d="M30.7 72.3C37.6 48.4 59.5 32 84.4 32l344 0c24.9 0 46.8 16.4 53.8 40.3l23.4 80.2c12.8 43.7-20.1 87.5-65.6 87.5-26.3 0-49.4-14.9-60.8-37.1-11.6 21.9-34.6 37.1-61.4 37.1-26.6 0-49.7-15-61.3-37-11.6 22-34.7 37-61.3 37-26.8 0-49.8-15.1-61.4-37.1-11.4 22.1-34.5 37.1-60.8 37.1-45.6 0-78.4-43.7-65.6-87.5L30.7 72.3zM96.4 352l320 0 0-66.4c7.6 1.6 15.5 2.4 23.5 2.4 14.3 0 28-2.6 40.5-7.2l0 151.2c0 26.5-21.5 48-48 48l-352 0c-26.5 0-48-21.5-48-48l0-151.2c12.5 4.6 26.1 7.2 40.5 7.2 8.1 0 15.9-.8 23.5-2.4l0 66.4z" />
                        </svg>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Site.TopBarLink2Url))
                {
                    <a class="hicon" href="@Site.TopBarLink2Url" target="_blank" rel="noopener"
                       title="@Site.TopBarLink2Text" aria-label="@Site.TopBarLink2Text">
                        <svg viewBox="0 0 512 512" role="img" aria-hidden="true">
                            <path fill="currentColor" d="M192 56l0 40 128 0 0-40c0-4.4-3.6-8-8-8L200 48c-4.4 0-8 3.6-8 8zm-48 8l0-8c0-30.9 25.1-56 56-56L312 0c30.9 0 56 25.1 56 56l0 424-224 0 0-416zM96 176l0 304-32 0c-35.3 0-64-28.7-64-64L0 160c0-35.3 28.7-64 64-64l32 0 0 80zM416 480l0-384 32 0c35.3 0 64 28.7 64 64l0 256c0 35.3-28.7 64-64 64l-32 0zM244 208c-8.8 0-16 7.2-16 16l0 36-36 0c-8.8 0-16 7.2-16 16l0 24c0 8.8 7.2 16 16 16l36 0 0 36c0 8.8 7.2 16 16 16l24 0c8.8 0 16-7.2 16-16l0-36 36 0c8.8 0 16-7.2 16-16l0-24c0-8.8-7.2-16-16-16l-36 0 0-36c0-8.8-7.2-16-16-16l-24 0z" />
                        </svg>
                    </a>
                }
            </div>
            <input type="checkbox" id="nav-toggle" class="nav-toggle" />
            <label for="nav-toggle" class="nav-toggle-label" aria-label="Menü">
                <span></span><span></span><span></span>
            </label>
            <nav class="main-nav">
                @foreach (var m in Site.HeaderMenu)
                {
                    <a href="@m.Url" target="@(m.OpenInNewTab ? "_blank" : null)" rel="@(m.OpenInNewTab ? "noopener" : null)">@m.Label</a>
                }
                @{
                    var langLinks = Site.LanguageLinks();
                }
                @if (langLinks.Count > 1)
                {
                    <span class="lang-switch" aria-label="@T["nav.language"]">
                        @foreach (var l in langLinks)
                        {
                            <a href="@l.Url" hreflang="@l.Locale" class="@(l.IsCurrent ? "lang-current" : null)"
                               aria-current="@(l.IsCurrent ? "true" : null)">@l.Locale.ToUpperInvariant()</a>
                        }
                    </span>
                }
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <nav class="footer-nav">
                @foreach (var m in Site.FooterMenu)
                {
                    <a href="@m.Url" target="@(m.OpenInNewTab ? "_blank" : null)" rel="@(m.OpenInNewTab ? "noopener" : null)">@m.Label</a>
                }
            </nav>
            <div class="footer-brand">
                <img src="@Site.LogoUrl" alt="@Site.SiteName" />
            </div>
            @if (!string.IsNullOrWhiteSpace(Site.FooterText))
            {
                <p class="footer-text">@Site.FooterText</p>
            }
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
