@using MatCMS.Content
@using Microsoft.AspNetCore.Html
@inject MatCMS.Services.Localizer T
@model MatCMS.Content.FormRenderModel
@{
    var containerId = "form-" + Model.Slug;

    // Localized labels for the shared custom datepicker (single + range). Set via a global window var
    // so the JS file needs no C#/@T awareness. The "||=" guard keeps multiple forms on one page safe.
    var dpI18nJson = System.Text.Json.JsonSerializer.Serialize(new
    {
        today = T["dp.today"].ToString(),
        clear = T["dp.clear"].ToString(),
        cancel = T["dp.cancel"].ToString(),
        ok = T["dp.ok"].ToString(),
        prev = T["dp.prevMonth"].ToString(),
        next = T["dp.nextMonth"].ToString(),
        to = T["dp.to"].ToString(),
        placeholder = T["dp.placeholder"].ToString(),
        placeholderRange = T["dp.placeholderRange"].ToString(),
        startLabel = T["dp.startLabel"].ToString(),
        endLabel = T["dp.endLabel"].ToString()
    });

    // Renders a single input element (text/date/number/phone/email/select).
    Func<FormElement, IHtmlContent> renderInput = null!;
    renderInput = el =>
    {
        var htmlType = el.Type switch
        {
            "email" => "email",
            "number" => "number",
            "date" => "date",
            "phone" => "tel",
            _ => "text"
        };
        var val = Model.Values.TryGetValue(el.Id, out var v) ? v : "";
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"form-field\" data-el=\"").Append(el.Id).Append('"');
        if (el.Condition is not null && el.Condition.IsSet)
        {
            sb.Append(" data-cond-field=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Field)).Append('"');
            sb.Append(" data-cond-op=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Op)).Append('"');
            sb.Append(" data-cond-value=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Value ?? "")).Append('"');
        }
        sb.Append('>');

        if (!string.IsNullOrWhiteSpace(el.Label))
        {
            sb.Append("<label for=\"fld_").Append(el.Id).Append("\">").Append(System.Net.WebUtility.HtmlEncode(el.Label));
            if (el.Required) sb.Append(" <span class=\"req\">*</span>");
            sb.Append("</label>");
        }

        var reqAttr = el.Required ? " required data-required=\"1\"" : "";
        var disAttr = Model.Preview ? " disabled" : "";
        if (el.Type == "textarea")
        {
            sb.Append("<textarea class=\"mat-input\" id=\"fld_").Append(el.Id).Append("\" name=\"").Append(el.Id).Append("\" rows=\"5\"");
            if (!string.IsNullOrWhiteSpace(el.Placeholder))
                sb.Append(" placeholder=\"").Append(System.Net.WebUtility.HtmlEncode(el.Placeholder)).Append('"');
            sb.Append(reqAttr).Append(disAttr).Append('>');
            sb.Append(System.Net.WebUtility.HtmlEncode(val));
            sb.Append("</textarea>");
        }
        else if (el.Type == "date" || el.Type == "daterange")
        {
            // Custom picker: value stays ISO ("YYYY-MM-DD" or "YYYY-MM-DD..YYYY-MM-DD") on the hidden
            // input so server-side validation/notification is unchanged; the visible button carries the
            // locale-formatted display, populated by mat-datepicker.js (open + close = single dialog).
            var isRange = el.Type == "daterange";
            var placeholder = !string.IsNullOrWhiteSpace(el.Placeholder)
                ? el.Placeholder
                : (isRange ? T["dp.placeholderRange"].ToString() : T["dp.placeholder"].ToString());
            var mode = isRange ? "range" : "single";
            sb.Append("<div class=\"mat-dp\" data-dp-mode=\"").Append(mode).Append("\">");
            sb.Append("<button type=\"button\" class=\"mat-input mat-dp-btn-trigger\" data-dp-btn").Append(disAttr).Append(">");
            sb.Append("<span class=\"mat-dp-display mat-dp-placeholder\" data-dp-display data-placeholder=\"")
              .Append(System.Net.WebUtility.HtmlEncode(placeholder)).Append("\">")
              .Append(System.Net.WebUtility.HtmlEncode(placeholder))
              .Append("</span>");
            sb.Append("<span class=\"mat-dp-icon\" aria-hidden=\"true\">")
              .Append("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">")
              .Append("<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 9h18\"/><path d=\"M8 3v4\"/><path d=\"M16 3v4\"/>")
              .Append("</svg></span>");
            sb.Append("</button>");
            sb.Append("<input type=\"hidden\" id=\"fld_").Append(el.Id).Append("\" name=\"").Append(el.Id).Append("\" value=\"")
              .Append(System.Net.WebUtility.HtmlEncode(val)).Append("\" data-dp-input");
            if (el.Required) sb.Append(" data-required=\"1\"");
            sb.Append(" />");
            sb.Append("</div>");
        }
        else if (el.Type == "richselect")
        {
            System.Func<string, string> E = s => System.Net.WebUtility.HtmlEncode(s ?? "");
            var selOpt = el.Options.FirstOrDefault(o => string.Equals(o.Value, val, StringComparison.Ordinal));
            var ph = string.IsNullOrWhiteSpace(el.Placeholder) ? "– Bitte auswählen –" : el.Placeholder;
            sb.Append("<div class=\"mat-rs\" data-rs>");
            sb.Append("<button type=\"button\" class=\"mat-input mat-rs-trigger\" data-rs-btn").Append(disAttr).Append(">");
            sb.Append("<span class=\"mat-rs-current").Append(selOpt == null ? " mat-rs-placeholder" : "").Append("\" data-rs-current>");
            if (selOpt != null)
            {
                if (!string.IsNullOrWhiteSpace(selOpt.Image)) sb.Append("<span class=\"mat-rs-cur-img\" style=\"background-image:url('").Append(E(selOpt.Image)).Append("')\"></span>");
                sb.Append("<span class=\"mat-rs-cur-title\">").Append(E(selOpt.Label)).Append("</span>");
            }
            else { sb.Append(E(ph)); }
            sb.Append("</span><span class=\"mat-rs-chev\" aria-hidden=\"true\">▾</span></button>");
            sb.Append("<input type=\"hidden\" id=\"fld_").Append(el.Id).Append("\" name=\"").Append(el.Id).Append("\" value=\"").Append(E(val)).Append("\" data-rs-input");
            if (el.Required) sb.Append(" data-required=\"1\"");
            sb.Append(" data-placeholder=\"").Append(E(ph)).Append("\">");
            sb.Append("<div class=\"mat-rs-menu\" data-rs-menu hidden>");
            foreach (var o in el.Options)
            {
                var isSel = selOpt != null && ReferenceEquals(o, selOpt);
                sb.Append("<button type=\"button\" class=\"mat-rs-opt\" data-rs-opt data-value=\"").Append(E(o.Value)).Append("\"").Append(isSel ? " aria-selected=\"true\"" : "").Append(">");
                if (!string.IsNullOrWhiteSpace(o.Image)) sb.Append("<span class=\"mat-rs-opt-img\" style=\"background-image:url('").Append(E(o.Image)).Append("')\"></span>");
                sb.Append("<span class=\"mat-rs-opt-body\"><span class=\"mat-rs-opt-title\">").Append(E(string.IsNullOrWhiteSpace(o.Label) ? o.Value : o.Label)).Append("</span>");
                if (!string.IsNullOrWhiteSpace(o.Description)) sb.Append("<span class=\"mat-rs-opt-desc\">").Append(E(o.Description)).Append("</span>");
                if (o.Tags != null && o.Tags.Any(tg => !string.IsNullOrWhiteSpace(tg)))
                {
                    sb.Append("<span class=\"mat-rs-opt-tags\">");
                    foreach (var tg in o.Tags) if (!string.IsNullOrWhiteSpace(tg)) sb.Append("<span class=\"mat-rs-tag\">").Append(E(tg)).Append("</span>");
                    sb.Append("</span>");
                }
                sb.Append("</span></button>");
            }
            sb.Append("</div></div>");
        }
        else if (el.Type == "select")
        {
            sb.Append("<select class=\"mat-input\" id=\"fld_").Append(el.Id).Append("\" name=\"").Append(el.Id).Append('"').Append(reqAttr).Append(disAttr).Append('>');
            sb.Append("<option value=\"\">– Bitte auswählen –</option>");
            foreach (var o in el.Options)
            {
                var sel = string.Equals(o.Value, val, StringComparison.Ordinal) ? " selected" : "";
                sb.Append("<option value=\"").Append(System.Net.WebUtility.HtmlEncode(o.Value)).Append('"').Append(sel).Append('>')
                  .Append(System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(o.Label) ? o.Value : o.Label)).Append("</option>");
            }
            sb.Append("</select>");
        }
        else
        {
            sb.Append("<input class=\"mat-input\" type=\"").Append(htmlType).Append("\" id=\"fld_").Append(el.Id).Append("\" name=\"").Append(el.Id).Append('"');
            sb.Append(" value=\"").Append(System.Net.WebUtility.HtmlEncode(val)).Append('"');
            if (!string.IsNullOrWhiteSpace(el.Placeholder))
                sb.Append(" placeholder=\"").Append(System.Net.WebUtility.HtmlEncode(el.Placeholder)).Append('"');
            if (!string.IsNullOrWhiteSpace(el.Regex))
                sb.Append(" pattern=\"").Append(System.Net.WebUtility.HtmlEncode(el.Regex)).Append('"');
            sb.Append(reqAttr).Append(disAttr).Append('>');
        }

        if (!string.IsNullOrWhiteSpace(el.Help))
            sb.Append("<div class=\"field-help\">").Append(System.Net.WebUtility.HtmlEncode(el.Help)).Append("</div>");
        sb.Append("</div>");
        return new HtmlString(sb.ToString());
    };

    Func<FormElement, IHtmlContent> renderElement = null!;
    renderElement = el =>
    {
        switch (el.Type)
        {
            case "title":
                return new HtmlString("<h3 class=\"form-el-title\">" + System.Net.WebUtility.HtmlEncode(el.Label) + "</h3>");
            case "description":
                return new HtmlString("<p class=\"form-el-desc\">" + System.Net.WebUtility.HtmlEncode(el.Label) + "</p>");
            case "group":
            {
                var sb = new System.Text.StringBuilder();
                sb.Append("<fieldset class=\"form-group\" data-el=\"").Append(el.Id).Append('"');
                if (el.Condition is not null && el.Condition.IsSet)
                {
                    sb.Append(" data-cond-field=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Field)).Append('"');
                    sb.Append(" data-cond-op=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Op)).Append('"');
                    sb.Append(" data-cond-value=\"").Append(System.Net.WebUtility.HtmlEncode(el.Condition.Value ?? "")).Append('"');
                }
                sb.Append('>');
                if (!string.IsNullOrWhiteSpace(el.Label))
                    sb.Append("<legend>").Append(System.Net.WebUtility.HtmlEncode(el.Label)).Append("</legend>");
                sb.Append("</fieldset>");
                // Build the fieldset content by concatenating children html, then inject.
                var inner = new System.Text.StringBuilder();
                foreach (var c in el.Fields)
                    inner.Append(FormDefinition.IsInput(c.Type) ? renderInput(c).ToString() : renderElement(c).ToString());
                var html = sb.ToString().Replace("</fieldset>", inner + "</fieldset>");
                return new HtmlString(html);
            }
            default:
                return renderInput(el);
        }
    };
}
<link rel="stylesheet" href="~/css/mat-datepicker.css" asp-append-version="true" />
<script>window.matDpI18n = window.matDpI18n || @Html.Raw(dpI18nJson);</script>
<script src="~/js/mat-datepicker.js" asp-append-version="true" defer></script>
<link rel="stylesheet" href="~/css/mat-richselect.css" asp-append-version="true" />
<script src="~/js/mat-richselect.js" asp-append-version="true" defer></script>
<section class="contact-block form-block" id="@containerId" data-form-slug="@Model.Slug">
    <div class="container">
        <div class="contact-wrap">
            @if (!string.IsNullOrWhiteSpace(Model.Heading))
            {
                <h2>@Model.Heading</h2>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Intro))
            {
                <p class="text-center">@Model.Intro</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Success))
            {
                <div class="alert alert-success">@Model.Success</div>
            }
            @if (Model.Errors.Count > 0)
            {
                <div class="alert alert-error">@string.Join(" ", Model.Errors)</div>
            }

            @if (Model.Elements.Count == 0)
            {
                <p class="muted text-center">Dieses Formular hat noch keine Felder.</p>
            }
            else if (Model.Preview)
            {
                <form onsubmit="return false;" class="form-fields">
                    @foreach (var el in Model.Elements)
                    {
                        @renderElement(el)
                    }
                    <button type="submit" class="btn" disabled>Absenden</button>
                </form>
            }
            else
            {
                @* Explicit action: the content page uses custom routing (/{slug?}), where the
                   asp-page-handler tag helper can't resolve the ambient page and renders an empty
                   action. Post to the current path with ?handler=Form so OnPostFormAsync runs. A plain
                   <form> gets no auto antiforgery token, so add it explicitly. *@
                <form method="post" action="@(ViewContext.HttpContext.Request.Path)?handler=Form" class="form-fields">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="__formSlug" value="@Model.Slug" />
                    @foreach (var el in Model.Elements)
                    {
                        @renderElement(el)
                    }
                    <button type="submit" class="btn">Absenden</button>
                </form>
            }
        </div>
    </div>
</section>
<script>
    (function () {
        var root = document.getElementById("@containerId");
        if (!root) return;
        var conds = Array.prototype.slice.call(root.querySelectorAll("[data-cond-field]"));

        function valueOf(name) {
            var el = root.querySelector("[name='" + (window.CSS && CSS.escape ? CSS.escape(name) : name) + "']");
            if (!el) return "";
            return (el.value || "").trim();
        }
        function apply() {
            conds.forEach(function (w) {
                var f = w.getAttribute("data-cond-field");
                var op = w.getAttribute("data-cond-op");
                var target = w.getAttribute("data-cond-value") || "";
                var v = valueOf(f);
                var show;
                switch (op) {
                    case "neq": show = v.toLowerCase() !== target.toLowerCase(); break;
                    case "contains": show = v.toLowerCase().indexOf(target.toLowerCase()) >= 0; break;
                    case "filled": show = v !== ""; break;
                    default: show = v.toLowerCase() === target.toLowerCase();
                }
                w.style.display = show ? "" : "none";
                Array.prototype.slice.call(w.querySelectorAll("input,select,textarea")).forEach(function (inp) {
                    if (show) {
                        if (inp.getAttribute("data-required") === "1") inp.required = true;
                        inp.disabled = @(Model.Preview ? "true" : "false");
                    } else {
                        inp.required = false;
                        inp.disabled = true;
                    }
                });
            });
        }
        root.addEventListener("input", apply);
        root.addEventListener("change", apply);
        apply();

        // Enter must not submit the form from a single-line field (that surprised users). A textarea
        // keeps Enter = newline; buttons still work; the form is submitted only via "Absenden".
        root.addEventListener("keydown", function (e) {
            if (e.key !== "Enter" && e.keyCode !== 13) return;
            var t = e.target;
            if (!t || !t.tagName) return;
            var tag = t.tagName.toLowerCase();
            if (tag === "textarea") return;
            if (tag === "input") {
                var type = (t.getAttribute("type") || "text").toLowerCase();
                if (type === "submit" || type === "button") return;
                e.preventDefault();
            }
        });

        @if (Model.Builder)
        {
            <text>
            // Builder bridge: clicking an element selects it in the parent editor.
            function post(msg) { if (window.parent && window.parent !== window) window.parent.postMessage(msg, "*"); }
            document.addEventListener("click", function (e) {
                var host = e.target.closest("[data-el]");
                if (host) { e.preventDefault(); e.stopPropagation(); post({ type: "mat-select-element", id: host.getAttribute("data-el") }); }
            }, true);
            window.addEventListener("message", function (e) {
                var d = e.data || {};
                // Live preview: swap in freshly-rendered draft HTML. The click bridge above is bound to
                // document (delegated), so it keeps working on the new content without re-running.
                if (d.type === "mat-render" && typeof d.html === "string") { document.body.innerHTML = d.html; return; }
                if (d.type === "mat-scroll-element" && d.id) {
                    var el = root.querySelector("[data-el='" + d.id + "']");
                    if (el) el.scrollIntoView({ behavior: "smooth", block: "center" });
                }
            });
            post({ type: "mat-preview-ready" });
            </text>
        }
    })();
</script>
