@model MatCMS.Content.BlockListModel
@{
    var allBlocks = Model.Blocks;
    var editor = Model.Editor;
    var registry = Model.Registry;
}
@foreach (var block in allBlocks.Where(b => b.ParentId == null).OrderBy(b => b.SortOrder))
{
    var def = registry.Get(block.BlockType);
    if (def is null || string.IsNullOrWhiteSpace(def.Partial))
    {
        continue;
    }
    var data = new MatCMS.Content.BlockData(block.DataJson);

    // Container blocks need their children resolved. A child that is itself a container gets its own
    // sub-model built recursively (so e.g. a cards block inside a section renders its own cards).
    MatCMS.Content.ContainerBlockModel? containerModel = null;
    if (def.IsContainer)
    {
        containerModel = BuildContainer(block.Id, data, registry, allBlocks, 0);
    }

    // Global layout options (width + top/bottom spacing) — one wrapper for both preview and live.
    var _lw = data.Str("_width");
    var _lst = data.Str("_spaceTop");
    var _lsb = data.Str("_spaceBottom");
    var _css = data.Str("_css");
    var layoutCls = "";
    if (_lw == "narrow") { layoutCls += " bw-narrow"; } else if (_lw == "full") { layoutCls += " bw-full"; }
    if (_lst.Length > 0) { layoutCls += " bst-" + _lst; }
    if (_lsb.Length > 0) { layoutCls += " bsb-" + _lsb; }
    // Per-block custom CSS scopes under this stable class (nesting keeps it from leaking).
    var blkCls = " blk-" + block.Id;
    var wrapCls = (editor ? "mat-ed-block" : "block-wrap") + blkCls + layoutCls;
    var edAttrs = editor
        ? new Microsoft.AspNetCore.Html.HtmlString($" id=\"block-{block.Id}\" data-block-id=\"{block.Id}\" data-block-name=\"{System.Net.WebUtility.HtmlEncode(T[def.Name])}\"")
        : Microsoft.AspNetCore.Html.HtmlString.Empty;

    <div class="@wrapCls"@edAttrs>
        @if (!string.IsNullOrWhiteSpace(_css))
        {
            <style>@Html.Raw(ScopeCss(block.Id, _css))</style>
        }
        @if (def.IsPluginBlock)
        {
            @Html.Raw(RenderPluginBlock(def, block.DataJson))
        }
        else if (def.IsComponent)
        {
            @Html.Raw(MatCMS.Content.ComponentDefinition.Render(def, data))
        }
        else if (def.IsContainer)
        {
            @await Html.PartialAsync(def.Partial, containerModel)
        }
        else
        {
            @await Html.PartialAsync(def.Partial, data)
        }
    </div>
}
@functions {
    // Wraps a block's custom CSS under its own `.blk-<id>` scope (native CSS nesting), so bare
    // declarations and `&`-nested selectors both work without leaking to other blocks. The `</style`
    // guard prevents an early tag close from breaking out into arbitrary HTML.
    static string ScopeCss(int id, string css)
    {
        var clean = System.Text.RegularExpressions.Regex.Replace(
            css, "</\\s*style", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return ".blk-" + id + "{" + clean + "}";
    }

    // Resolves a container's children into (partial, data) pairs; a child that is itself a container
    // gets its own sub-model built recursively (depth-guarded) so arbitrary nesting renders.
    static MatCMS.Content.ContainerBlockModel BuildContainer(int parentId, MatCMS.Content.BlockData data,
        MatCMS.Content.BlockRegistry reg, IReadOnlyList<MatCMS.Models.ContentBlock> all, int depth)
    {
        var kids = new List<MatCMS.Content.ContainerBlockModel.ChildBlock>();
        if (depth <= 6)
        {
            foreach (var cb in all.Where(b => b.ParentId == parentId).OrderBy(b => b.SortOrder))
            {
                var cdef = reg.Get(cb.BlockType);
                if (cdef is null || string.IsNullOrWhiteSpace(cdef.Partial)) continue;
                var cdata = new MatCMS.Content.BlockData(cb.DataJson);
                var sub = cdef.IsContainer ? BuildContainer(cb.Id, cdata, reg, all, depth + 1) : null;
                kids.Add(new MatCMS.Content.ContainerBlockModel.ChildBlock(cdef.Partial, cdata, sub));
            }
        }
        return new MatCMS.Content.ContainerBlockModel(data, kids);
    }

    string RenderPluginBlock(MatCMS.Content.BlockDefinition def, string dataJson)
    {
        var http = ViewContext.HttpContext;
        var svc = http.RequestServices;
        var reg = svc.GetService(typeof(MatCMS.Services.PluginRegistry)) as MatCMS.Services.PluginRegistry;
        // Make the block render request-aware (e.g. read a ?flag=... success marker, build a return URL).
        var query = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var kv in http.Request.Query) query[kv.Key] = kv.Value.ToString();
        var pr = new MatCMS.Services.PluginRequest
        {
            Services = svc,
            Registry = reg!,
            Data = dataJson,
            Method = http.Request.Method,
            Path = http.Request.Path.Value ?? "",
            Query = query
        };
        try { return def.PluginRender!(pr); }
        catch (Exception ex) { return "<!-- plugin block error: " + System.Net.WebUtility.HtmlEncode(ex.Message) + " -->"; }
    }
}
