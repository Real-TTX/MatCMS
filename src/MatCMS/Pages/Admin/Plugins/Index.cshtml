@page
@model MatCMS.Pages.Admin.Plugins.IndexModel
@{
    ViewData["Title"] = T["plugins.title"];
}
<div class="page-head">
    <h1>@T["plugins.title"]</h1>
</div>

<div class="card">
    <form method="post" asp-page-handler="AllowNative" class="check" style="margin:0 0 4px;">
        <label class="check">
            <input type="checkbox" name="allow" value="true" @(Model.NativeAllowed ? "checked" : "") onchange="this.form.requestSubmit()" /> @T["plugins.native.allowTitle"]
        </label>
    </form>
    <div class="help" style="margin-bottom:12px;">@T["plugins.native.allowHelp"]</div>
    @if (Model.StoreAccess.CloudDecides)
    {
        <div class="help" style="margin-bottom:12px;">@T[Model.StoreAccess.Allowed ? "plugins.matcms.cloudAllows" : "plugins.matcms.cloudDenies"]</div>
    }
    else
    {
        <form method="post" asp-page-handler="MatcmsStore" class="check" style="margin:0 0 4px;">
            <label class="check">
                <input type="checkbox" name="allow" value="true" @(Model.StoreAccess.OwnSwitch ? "checked" : "") onchange="this.form.requestSubmit()" /> @T["plugins.matcms.allowTitle"]
            </label>
        </form>
        <div class="help" style="margin-bottom:12px;">@T["plugins.matcms.allowHelp"]</div>
    }
    @if (Model.Items.Count == 0)
    {
        <p class="muted">@T["plugins.empty"]</p>
    }
    else
    {
    <div class="block-list">
        @foreach (var p in Model.Items)
        {
            var err = Model.Errors.TryGetValue(p.Id, out var e) ? e : null;
            var kind = MatCMS.Models.PluginKind.Normalize(p.Kind);
            <div class="block-item">
                <div class="b-info">
                    <div class="b-type">
                        @p.Name
                        @if (!string.IsNullOrWhiteSpace(p.Version))
                        {
                            <span class="muted">v@(p.Version)</span>
                        }
                        @* what it is: one pill tone for all three kinds; whether it runs: green / grey; what needs doing: amber / red *@
                        @if (kind == MatCMS.Models.PluginKind.BuiltIn)
                        {
                            <span class="badge badge-new">@T["plugins.kind.builtin"]</span>
                        }
                        else if (kind == MatCMS.Models.PluginKind.Native)
                        {
                            <span class="badge badge-new">@T["plugins.kind.native"]</span>
                            @if (Model.Lingering(p.Key)) { <span class="badge badge-warn">@T["plugins.native.restart"]</span> }
                        }
                        else
                        {
                            <span class="badge badge-new">@T["plugins.kind.script"]</span>
                        }
                        @if (p.Enabled)
                        {
                            <span class="badge badge-on">@T["plugins.enabled"]</span>
                        }
                        else
                        {
                            <span class="badge badge-off">@T["plugins.disabled"]</span>
                        }
                        @if (p.Enabled && err is not null)
                        {
                            <span class="badge badge-err">@T["plugins.error"]</span>
                        }
                    </div>
                    <div class="b-sum">@(string.IsNullOrWhiteSpace(p.Description) ? (err ?? "") : p.Description)</div>
                </div>
                @* Fixed slots, so the buttons line up from row to row: the toggle (its width changes with the word) on the left, then edit,
                   then settings and delete as icons — a plugin without one keeps an invisible stand-in of the same size. *@
                <div class="actions">
                    <form class="inline-form" method="post" asp-page-handler="Toggle" asp-route-id="@p.Id">
                        <button type="submit" class="btn btn-sm btn-ghost">@(p.Enabled ? T["plugins.disable"] : T["plugins.enable"])</button>
                    </form>
                    <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@p.Id" title="@T["action.edit"]"><i class="ti ti-pencil" aria-hidden="true"></i> <span class="btn-label">@T["action.edit"]</span></a>
                    @if (Model.WithSettings.Contains(p.Key))
                    {
                        <a class="btn btn-sm btn-ghost btn-icon" href="/admin/p/@p.Key/_settings" title="@T["plugins.settings.tab"]" aria-label="@T["plugins.settings.tab"]"><i class="ti ti-adjustments" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <span class="btn btn-sm btn-ghost btn-icon" aria-hidden="true" style="visibility:hidden"><i class="ti ti-adjustments"></i></span>
                    }
                    @if (kind != MatCMS.Models.PluginKind.BuiltIn)
                    {
                        <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@p.Id" data-confirm="@Model.DeleteConfirm.GetValueOrDefault(p.Key, T["plugins.confirmDelete"].ToString())">
                            <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                        </form>
                    }
                    else
                    {
                        <span class="btn btn-sm btn-danger btn-icon" aria-hidden="true" style="visibility:hidden"><partial name="_IconTrash" /></span>
                    }
                </div>
            </div>
        }
    </div>
    }
    <partial name="_AddMenu" model='AddMenus.Payload(T, "plugins", Url.Page("Create")!, "plugins.new", Model.BrowseUrl, "import-plugin")' />
</div>

@if (Model.Jobs.Count > 0)
{
    <div class="card">
        <h2>@T["plugins.jobs.title"]</h2>
        <table class="data">
            <thead><tr><th>@T["plugins.jobs.plugin"]</th><th>@T["plugins.jobs.job"]</th><th>@T["plugins.jobs.schedule"]</th><th>@T["plugins.jobs.last"]</th><th>@T["plugins.jobs.state"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var j in Model.Jobs)
                {
                    @* the plugin by the name the list above shows, not by its key ("booking" → "Buchungen") *@
                    <tr>
                        <td>@(Model.Items.FirstOrDefault(i => i.Key == j.Owner)?.Name ?? j.Owner)</td>
                        <td>@j.Name</td>
                        <td>@j.Schedule</td>
                        <td class="muted nowrap">@(j.LastRunUtc is { } lr ? lr.ToLocalTime().ToString("dd.MM. HH:mm") : "—")</td>
                        <td>
                            @if (j.Running) { <span class="badge badge-new">@T["plugins.jobs.running"]</span> }
                            else if (j.LastError is not null) { <span class="badge badge-err" title="@j.LastError">@T["plugins.jobs.failed"]</span> }
                            else if (j.LastRunUtc is not null) { <span class="badge badge-on">@T["plugins.jobs.ok"]</span> }
                            else { <span class="badge badge-off">@T["plugins.jobs.waiting"]</span> }
                        </td>
                        <td>
                            <div class="actions">
                                <form class="inline-form" method="post" asp-page-handler="RunJob">
                                    <input type="hidden" name="owner" value="@j.Owner" /><input type="hidden" name="job" value="@j.Name" />
                                    <button type="submit" class="btn btn-sm btn-ghost btn-icon" disabled="@j.Running" title="@T["plugins.jobs.runNow"]" aria-label="@T["plugins.jobs.runNow"]"><i class="ti ti-player-play" aria-hidden="true"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="card" id="import-plugin" hidden>
    <h2>@T["plugins.importZip"]</h2>
    <p class="muted">@T["plugins.importZipHint"]</p>
    <form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="asset-upload">
        <input type="file" name="file" accept=".zip" required />
        <div class="form-actions"><button type="submit" class="btn">@T["plugins.importZipBtn"]</button></div>
    </form>
</div>

@* The cloud catalogue opens as a store dialog, not as a card under the list — see _StoreDialog. *@
@if (Model.Browsing is not null)
{
    <partial name="_StoreDialog" model="Model.StoreDialog" />
}
