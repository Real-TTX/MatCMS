@page "{id:int}"
@model MatCMS.Pages.Admin.Components.EditModel
@{
    ViewData["Title"] = T["components.edit"];
}
@* Nur die Überschrift: alle Aktionen dieser Seite stehen unten in EINER Reihe — dieselbe Ordnung
   wie im Plugin-Editor. Zwei Orte für Knöpfe, die dasselbe Formular betreffen, ließen einen oben
   nach dem suchen, was unten liegt. *@
<div class="page-head">
    <h1>@T["components.edit"]</h1>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" class="form-grid" id="component-form">
        <div class="form-row">
            <div class="form-field">
                <label for="Name">@T["components.name"]</label>
                <input id="Name" name="Name" value="@Model.Name" required />
            </div>
            <div class="form-field">
                <label>@T["components.type"]</label>
                <input value="@Model.Current.Type" class="mono" readonly />
            </div>
        </div>
        <div class="form-field">
            <label for="Description">@T["components.description"]</label>
            <input id="Description" name="Description" value="@Model.Description" />
        </div>
        @{
            var iconVm = new MatCMS.Pages.Shared.IconPickVm(
                Model.Icon, LabelKey: "components.icon", HelpKey: "components.iconHelp");
        }
        <partial name="_IconPicker" model="iconVm" />

        <h3 class="form-section">@T["components.fields"]</h3>
        <div id="field-rows" data-fields="@Model.FieldsJson"></div>
        <div><button type="button" class="btn btn-sm btn-ghost" id="add-field">＋ @T["components.addField"]</button></div>
        <input type="hidden" name="FieldsJson" id="FieldsJson" />

        <h3 class="form-section">@T["components.template"]</h3>
        <div class="form-field">
            <label for="TemplateHtml">@T["components.templateHtml"]</label>
            <textarea id="TemplateHtml" name="TemplateHtml" rows="10" class="code" spellcheck="false">@Model.TemplateHtml</textarea>
            <div class="help">@T["components.templateHelp"] <span id="placeholder-hint" class="mono"></span></div>
        </div>

        @* Von positiv nach negativ, wie in Plugins/Edit: Speichern (gefüllt), dann Exportieren,
           dann Zurück — beide als .btn-ghost. Die Reihe bleibt IM Formular, weil hier keine
           zerstörende Aktion dazukommt, die ein eigenes Formular bräuchte. *@
        <div class="form-actions">
            <button type="submit" class="btn">@T["action.save"]</button>
            <a class="btn btn-ghost" asp-page="Edit" asp-page-handler="ExportJson" asp-route-id="@Model.Current.Id">
                <i class="ti ti-download" aria-hidden="true"></i> @T["components.exportJson"]
            </a>
            <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
        </div>
    </form>
</div>

<div class="card component-preview" id="cp-card">
    <div class="cp-head">
        <h2>@T["components.preview"]</h2>
        <button type="button" class="btn btn-sm btn-ghost" id="cp-debug-toggle">@T["components.debug"]</button>
    </div>
    <div class="help">@T["components.sampleData"]</div>
    <div class="cp-sample" id="cp-sample"></div>
    <div class="cp-frame-wrap">
        <iframe id="cp-frame" class="cp-frame" title="@T["components.preview"]"></iframe>
    </div>
    <div class="cp-debug" id="cp-debug" hidden></div>
</div>

@section Scripts {
    <script>
        window.MATCMS_CP = {
            debug: "@T["components.debug"]",
            dbgPlaceholders: "@T["components.dbgPlaceholders"]",
            dbgUnknown: "@T["components.dbgUnknown"]",
            dbgUnused: "@T["components.dbgUnused"]",
            dbgOutput: "@T["components.dbgOutput"]",
            dbgOk: "@T["components.dbgOk"]",
            dbgEmpty: "@T["components.dbgEmpty"]"
        };
    </script>
    <script>
        window.MATCMS_FIELD_TYPES = [
            ["text", "@T["components.type.text"]"],
            ["textarea", "@T["components.type.textarea"]"],
            ["richtext", "@T["components.type.richtext"]"],
            ["image", "@T["components.type.image"]"],
            ["url", "@T["components.type.url"]"]
        ];
        window.MATCMS_REMOVE = "@T["action.delete"]";
    </script>
    <script src="~/js/admin-component-editor.js" asp-append-version="true"></script>
}
