@page "{id:int}"
@model MatCMS.Cloud.Pages.Admin.Instances.SiteModel
@{
    ViewData["Title"] = Model.Item.Name;
    // No sidebar: the site gets the window, and this page carries its own bar.
    ViewData["NoSidebar"] = true;
    // The switcher lives in the layout now; these two tell it WHICH instance is current and that
    // the page title comes from the frame rather than from here.
    ViewData["InstanceId"] = Model.Item.Id;
    ViewData["FrameTitle"] = true;
}

@section TopbarActions {
    <div class="site-embed-actions">
        <a class="btn btn-sm btn-ghost" asp-page="Details" asp-route-id="@Model.Item.Id">
            <i class="ti ti-pencil" aria-hidden="true"></i> @T["action.edit"]
        </a>
        @if (!string.IsNullOrWhiteSpace(Model.Item.PreviewUrl))
        {
            <button type="button" class="btn btn-sm btn-ghost" data-site-reload title="@T["instances.reload"]" aria-label="@T["instances.reload"]">
                <i class="ti ti-refresh" aria-hidden="true"></i>
            </button>
            @* Into the site's OWN admin, in THIS frame. Looking at a customer's page and then wanting
               to change something is the next move often enough that hunting for the address is a
               waste — and the address is derivable, it is the site's URL plus /Admin.
               A toggle and not a one-way trip, because "look at the page, change something, look
               again" is one task, and staying inside this view is the whole point of the page.
               The instance's admin sends no X-Frame-Options, so it may be framed — if a site ever does
               send one the frame stays blank, which is why the plain link to the site is still here. *@
            <button type="button" class="btn btn-sm btn-ghost" data-site-admin
                    data-admin-url="@Model.AdminUrl" data-site-url="@Model.Item.PreviewUrl"
                    data-label-admin="@T["instances.admin"]" data-label-site="@T["instances.site"]"
                    title="@T["instances.openAdmin"]">
                <i class="ti ti-settings" aria-hidden="true"></i> <span data-site-admin-label>@T["instances.admin"]</span>
            </button>
            <a class="btn btn-sm btn-ghost" href="@Model.Item.PreviewUrl" target="_blank" rel="noopener"
               title="@T["instances.openSite"]" aria-label="@T["instances.openSite"]">
                <i class="ti ti-external-link" aria-hidden="true"></i>
            </a>
        }
        @* Back to the list, narrowed to this instance's profile — closing a view should return you
           near where you came from, not to an unfiltered start. *@
        <a class="btn btn-sm btn-ghost inst-close" asp-page="Index" asp-route-profile="@Model.Item.ProfileId"
           title="@T["action.close"]" aria-label="@T["action.close"]">
            <i class="ti ti-x" aria-hidden="true"></i>
        </a>
    </div>
}

@if (string.IsNullOrWhiteSpace(Model.Item.PreviewUrl))
{
    <div class="site-embed-note">
        <div class="alert alert-info">@T["instances.previewNoUrl"]</div>
    </div>
}
else
{
    @if (Model.Item.PreviewIsGuessed)
    {
        <div class="site-embed-hint muted">
            <i class="ti ti-info-circle" aria-hidden="true"></i>
            @T["instances.previewGuessedHint"] <span class="mono">@Model.Item.PreviewUrl</span>
        </div>
    }
    @* A site may refuse to be framed (X-Frame-Options / frame-ancestors). Cross-origin there is no
       honest way to detect that, so instead of pretending to, the bar simply always offers the tab —
       and this line says what an empty frame means. *@
    <div class="site-embed">
        @if (MatCMS.Cloud.Services.MixedContent.IsBlocked(Model.Request.IsHttps, Model.Item.PreviewUrl))
        {
            @* No frame at all: this one is not "the site might refuse", it is certain. Rendering it
               anyway would put the general "could not be embedded" note under a blank rectangle and
               send the operator looking for a fault in their site. *@
            <div class="site-embed-fallback muted">
                @T["instances.previewInsecure"]
                <a href="@Model.Item.PreviewUrl" target="_blank" rel="noopener">@T["instances.openSite"]</a>
            </div>
        }
        else
        {
            <iframe class="site-embed-frame" data-site-frame src="@Model.Item.PreviewUrl" title="@Model.Item.Name"
                    referrerpolicy="no-referrer" sandbox="allow-same-origin allow-scripts allow-forms allow-popups"></iframe>
            <div class="site-embed-fallback muted">
                @T["instances.embedBlocked"]
                <a href="@Model.Item.PreviewUrl" target="_blank" rel="noopener">@T["instances.openSite"]</a>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        (function () {
            var picker = document.querySelector('[data-inst-picker]');
            var toggle = picker && picker.querySelector('[data-inst-toggle]');
            var menu = picker && picker.querySelector('[data-inst-menu]');
            var loaded = false;
            function open(on) {
                if (!menu) return;
                menu.hidden = !on;
                toggle.setAttribute('aria-expanded', on ? 'true' : 'false');
                // First open fills the thumbnails. Doing it on page load would fetch every customer
                // site just to draw a menu nobody may open.
                if (on && !loaded) {
                    loaded = true;
                    menu.querySelectorAll('iframe[data-src]').forEach(function (fr) {
                        fr.src = fr.getAttribute('data-src');
                    });
                }
            }
            if (toggle) toggle.addEventListener('click', function () { open(menu.hidden); });
            document.addEventListener('click', function (e) {
                if (picker && !picker.contains(e.target)) open(false);
            });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') open(false); });

            var frame = document.querySelector('[data-site-frame]');
            var reload = document.querySelector('[data-site-reload]');
            // Re-assigning src rather than calling contentWindow.location.reload(): the frame is
            // cross-origin, so reaching into it throws.
            if (frame && reload) reload.addEventListener('click', function () { frame.src = frame.src; });

            // Admin ⇄ Website in the same frame.
            var adminBtn = document.querySelector('[data-site-admin]');
            if (frame && adminBtn) {
                var label = adminBtn.querySelector('[data-site-admin-label]');
                var onAdmin = false;
                adminBtn.addEventListener('click', function () {
                    onAdmin = !onAdmin;
                    frame.src = onAdmin ? adminBtn.getAttribute('data-admin-url') : adminBtn.getAttribute('data-site-url');
                    // The label says where the button LEADS, not where you are — a button captioned
                    // with the current state reads as if pressing it would keep you there.
                    label.textContent = adminBtn.getAttribute(onAdmin ? 'data-label-site' : 'data-label-admin');
                    adminBtn.classList.toggle('is-active', onAdmin);
                    // Cleared on every switch: the old page's title must not sit next to the new page
                    // until that one gets round to announcing itself.
                    if (crumb) { crumb.hidden = true; crumb.textContent = ''; }
                });
            }

            // The framed admin hides its own bar and posts its page title here instead.
            var crumb = document.querySelector('[data-frame-title]');
            window.addEventListener('message', function (e) {
                var d = e.data || {};
                if (d.type !== 'mat-admin-title' || !crumb) return;
                // Only from the frame on this page. The listener is on window, so anything embedded
                // anywhere could otherwise write into this bar.
                if (!frame || e.source !== frame.contentWindow) return;
                var txt = String(d.title || '').slice(0, 80);
                crumb.textContent = txt;
                crumb.hidden = txt.length === 0;
            });
        })();
    </script>
}
