@page "{id:int?}"
@model MatCMS.Cloud.Pages.Admin.Store.SettingModel
@{
    ViewData["Title"] = Model.IsNew ? T["profiles.addSetting"] : Model.Item.Key;
}
<div class="page-head">
    <h1>
        @(Model.IsNew ? T["profiles.addSetting"] : Model.Item.Key)
        <span class="muted" style="font-size:14px;font-weight:400;"> — @T["store.title"]</span>
    </h1>
    <div class="list-toolbar">
        <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
    </div>
</div>

@if (!Model.IsNew && Model.UsedBy.Count > 0)
{
    <div class="alert alert-info">
        @T["store.usedByWarning"] <strong>@string.Join(", ", Model.UsedBy)</strong>
    </div>
}

<form method="post" asp-route-id="@(Model.IsNew ? null : (int?)Model.Item.Id)">
    <div class="card">
        <h2>@T["profiles.tabSettings"]</h2>
        <p class="muted">@T["profiles.otherSettingsHint"]</p>
        <div class="form-field">
            <label for="key">@T["profiles.settingKey"]</label>
            <input id="key" name="key" value="@Model.Item.Key" placeholder="site.canonicalUrl" spellcheck="false" required />
            <div class="help">@T["profiles.settingKeyHint"]</div>
        </div>
        <div class="form-field">
            <label for="value">@T["profiles.settingValue"]</label>
            @if (Model.Item.IsSecret && !Model.IsNew)
            {
                @* A stored secret is never rendered back: the field stays blank and an empty submit
                   keeps the value. *@
                <input id="value" name="value" type="password" autocomplete="new-password" placeholder="@T["settings.smtpPasswordKeep"]" />
            }
            else
            {
                <textarea id="value" name="value" rows="3" spellcheck="false">@Model.Item.Value</textarea>
            }
        </div>
        <label class="checkbox-row">
            <input type="checkbox" name="isSecret" value="true" checked="@(Model.Item.IsSecret ? "checked" : null)" />
            @T["store.settingIsSecret"]
        </label>
        <div class="help">@T["store.settingIsSecretHint"]</div>
    </div>

    <div class="list-actions">
        <button type="submit" class="btn">@T["settings.save"]</button>
    </div>
</form>

@if (!Model.IsNew)
{
    <div class="card danger-zone">
        <h2>@T["instances.dangerZone"]</h2>
        <div class="actions">
            <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@Model.Item.Id"
                  onsubmit="return confirm('@T["store.settingDeleteConfirm"]');">
                <button type="submit" class="btn btn-sm btn-danger">@T["common.delete"]</button>
            </form>
        </div>
    </div>
}
