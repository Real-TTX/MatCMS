@page
@model MatCMS.Pages.Admin.Setup.IndexModel
@using MatCMS.Services
@{
    ViewData["Title"] = T["setup.title"];
    string SmtpV(string k) => Model.Smtp.TryGetValue(k, out var v) ? v : "";
}
<div class="page-head">
    <h1>@T["setup.heading"]</h1>
    <a class="btn btn-sm btn-ghost" asp-page="/Admin/Index">@T["setup.skip"]</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-error">@Model.Error</div>
}

<div class="card">
    <ol class="wiz-steps" id="wiz-steps">
        <li class="active">@T["setup.stepAccount"]</li>
        <li>Theme</li>
        <li>SMTP</li>
        <li>@T["setup.stepFirstPage"]</li>
    </ol>

    <form method="post" id="wiz-form">
        <div class="wiz-panel" data-panel="0">
            <h2>@T["setup.account"]</h2>
            <p class="muted">@T["setup.accountIntro"]</p>
            <div class="form-field">
                <label for="AdminEmail">@T["login.username"]</label>
                <input id="AdminEmail" name="AdminEmail" type="email" value="@Model.AdminEmail" placeholder="name@example.com" required />
            </div>
            <div class="form-field">
                <label for="AdminName">@T["users.displayName"]</label>
                <input id="AdminName" name="AdminName" value="@Model.AdminName" placeholder="@T["setup.namePlaceholder"]" />
            </div>
            <div class="form-field">
                <label for="AdminPassword">@T["users.newPassword"]</label>
                <input id="AdminPassword" name="AdminPassword" type="password" placeholder="@T["setup.passUnchanged"]" />
            </div>
        </div>

        <div class="wiz-panel" data-panel="1" hidden>
            <h2>@T["setup.theme"]</h2>
            <p class="muted">@T["setup.themeIntro"]</p>
            <div class="wiz-themes">
                @foreach (var t in Model.Themes)
                {
                    <label class="wiz-theme">
                        <input type="radio" name="ThemeName" value="@t.Name" checked="@(t.Name == Model.ThemeName)" />
                        <span class="wiz-theme-card">
                            <span class="wiz-swatch" style="background:@t.AccentColor"></span>
                            <span class="wiz-swatch" style="background:@(string.IsNullOrWhiteSpace(t.SecondaryColor) ? t.AccentColor : t.SecondaryColor)"></span>
                            <span class="wiz-swatch" style="background:@t.BackgroundColor; border:1px solid #ddd;"></span>
                            <strong>@t.Name</strong>
                        </span>
                    </label>
                }
            </div>
        </div>

        <div class="wiz-panel" data-panel="2" hidden>
            <h2>@T["setup.smtp"]</h2>
            <p class="muted">@T["setup.smtpIntro"]</p>
            <div class="form-grid">
                <div class="form-field"><label>@T["settings.smtpHost"]</label><input name="Smtp[@SettingKeys.SmtpHost]" value="@SmtpV(SettingKeys.SmtpHost)" placeholder="smtp.example.com" /></div>
                <div class="form-field"><label>@T["settings.smtpPort"]</label><input name="Smtp[@SettingKeys.SmtpPort]" value="@SmtpV(SettingKeys.SmtpPort)" placeholder="587" inputmode="numeric" /></div>
                <div class="form-field"><label>@T["settings.smtpUser"]</label><input name="Smtp[@SettingKeys.SmtpUser]" value="@SmtpV(SettingKeys.SmtpUser)" autocomplete="off" /></div>
                <div class="form-field"><label>@T["settings.smtpPassword"]</label><input type="password" name="Smtp[@SettingKeys.SmtpPassword]" value="@SmtpV(SettingKeys.SmtpPassword)" autocomplete="new-password" /></div>
                <div class="form-field"><label>@T["settings.smtpFromEmail"]</label><input name="Smtp[@SettingKeys.SmtpFromEmail]" value="@SmtpV(SettingKeys.SmtpFromEmail)" placeholder="noreply@example.com" /></div>
                <div class="form-field"><label>@T["settings.smtpFromName"]</label><input name="Smtp[@SettingKeys.SmtpFromName]" value="@SmtpV(SettingKeys.SmtpFromName)" /></div>
            </div>
        </div>

        <div class="wiz-panel" data-panel="3" hidden>
            <h2>@T["setup.firstPage"]</h2>
            <p class="muted">@T["setup.firstPageIntro"]</p>
            <div class="form-field">
                <label for="PageTitle">@T["setup.pageTitle"]</label>
                <input id="PageTitle" name="PageTitle" value="@Model.PageTitle" placeholder="@T["setup.pageTitlePlaceholder"]" />
            </div>
        </div>

        <div class="wiz-actions">
            <button type="button" class="btn btn-ghost" id="wiz-back" hidden>@T["action.back"]</button>
            <button type="button" class="btn" id="wiz-next">@T["setup.next"]</button>
            <button type="submit" class="btn" id="wiz-finish" hidden>@T["setup.finish"]</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var panels = Array.prototype.slice.call(document.querySelectorAll(".wiz-panel"));
            var steps = Array.prototype.slice.call(document.querySelectorAll("#wiz-steps li"));
            var back = document.getElementById("wiz-back");
            var next = document.getElementById("wiz-next");
            var finish = document.getElementById("wiz-finish");
            var email = document.getElementById("AdminEmail");
            var cur = 0;
            function show(i) {
                cur = Math.max(0, Math.min(panels.length - 1, i));
                panels.forEach(function (p, idx) { p.hidden = idx !== cur; });
                steps.forEach(function (s, idx) { s.classList.toggle("active", idx <= cur); });
                back.hidden = cur === 0;
                next.hidden = cur === panels.length - 1;
                finish.hidden = cur !== panels.length - 1;
            }
            next.addEventListener("click", function () {
                // basic required check on step 1 (admin e-mail)
                if (cur === 0 && email && !email.checkValidity()) { email.reportValidity(); return; }
                show(cur + 1);
            });
            back.addEventListener("click", function () { show(cur - 1); });
            show(0);
        })();
    </script>
}
