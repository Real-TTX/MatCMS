@page
@model MatCMS.Pages.Admin.Media.IndexModel
@{
    ViewData["Title"] = T["media.title"];
    // id → url of everything in the library, so a cropped image can point the cropper at its ORIGINAL.
    var urlById = Model.Items.GroupBy(x => x.Id).ToDictionary(g => g.Key, g => g.First().Url);
}
<link rel="stylesheet" href="~/lib/cropper/cropper.min.css" asp-append-version="true" />
<div data-list data-list-key="media" class="list-view-tiles">
    <div class="page-head">
        <h1>@T["media.title"]</h1>
        <div class="list-toolbar">
            <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
            <div class="view-toggle" data-list-viewtoggle>
                <button type="button" class="vt-btn" data-view="tiles" title="@T["media.viewTiles"]" aria-label="@T["media.viewTiles"]"><i class="ti ti-layout-grid" aria-hidden="true"></i></button>
                <button type="button" class="vt-btn" data-view="table" title="@T["media.viewTable"]" aria-label="@T["media.viewTable"]"><i class="ti ti-list" aria-hidden="true"></i></button>
            </div>
            <button type="button" id="media-upload-btn" class="btn btn-sm">@T["media.upload"]</button>
            <input type="file" id="media-file" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip" multiple style="display:none;" />
        </div>
    </div>
<style>
    /* Non-image media (PDF/Doc/…) show an extension badge instead of a thumbnail. */
    .media-thumb-file { display: flex; align-items: center; justify-content: center; background: var(--bg-alt, #f1efe9); }
    .media-fileext { font: 700 13px/1 var(--font-head, sans-serif); letter-spacing: .06em; color: #6b6257;
        border: 2px solid currentColor; border-radius: 6px; padding: 8px 11px; }
    /* Crop controls inside the media preview */
    .mm-crop-start { margin-top: 8px; }
    .crop-tools { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; margin-top: 8px; }
    .crop-ratios, .crop-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .crop-note { margin-top: 6px; font-size: 12px; color: #6b6257; }
</style>

@if (Model.AllTags.Count > 0)
{
    <div class="tag-filter">
        <a class="tag-chip @(Model.ActiveTag is null ? "active" : "")" asp-page="Index">@T["media.allTags"]</a>
        @foreach (var t in Model.AllTags)
        {
            <a class="tag-chip @(string.Equals(Model.ActiveTag, t, StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="Index" asp-route-tag="@t">@t</a>
        }
    </div>
}

@if (Model.Items.Count == 0)
{
    <div class="card"><p class="muted">@T["media.empty"]</p></div>
}

<div class="media-grid" id="media-grid" data-list-tiles>
    @foreach (var m in Model.Items)
    {
        var tagList = MatCMS.Content.TagUtil.Split(m.Tags).ToList();
        var mext = System.IO.Path.GetExtension(m.FileName ?? m.Url ?? "").ToLowerInvariant();
        var mIsImg = mext is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".svg";
        <button type="button" class="media-card"
                data-search="@(m.FileName + " " + m.Tags)"
                data-id="@m.Id"
                data-url="@m.Url"
                data-name="@m.FileName"
                data-tags="@m.Tags"
                data-alt="@m.Alt"
                data-type="@m.ContentType"
                data-size="@m.SizeBytes"
                data-source-id="@(m.SourceMediaId?.ToString() ?? "")"
                data-source-url="@(m.SourceMediaId is int sid && urlById.TryGetValue(sid, out var su) ? su : "")"
                data-cropjson="@m.CropJson"
                data-isimg="@(mIsImg && mext != ".gif" && mext != ".svg" ? "1" : "")"
                title="@T["media.clickHint"]">
            @if (mIsImg)
            {
                <div class="media-thumb" style="background-image:url('@m.Url')"></div>
            }
            else
            {
                <div class="media-thumb media-thumb-file"><span class="media-fileext">@(string.IsNullOrEmpty(mext) ? "FILE" : mext.TrimStart('.').ToUpperInvariant())</span></div>
            }
            <div class="media-meta">
                <div class="media-name" title="@m.FileName">@m.FileName</div>
                @if (tagList.Count > 0)
                {
                    <div class="media-card-tags">
                        @foreach (var t in tagList.Take(4))
                        {
                            <span class="mini-chip">@t</span>
                        }
                    </div>
                }
            </div>
        </button>
    }
</div>

    <table class="data" data-list-table>
        <thead><tr><th>@T["media.colFile"]</th><th>@T["media.colType"]</th><th>@T["media.colSize"]</th><th>@T["media.tags"]</th></tr></thead>
        <tbody>
            @foreach (var m in Model.Items)
            {
                var rTags = MatCMS.Content.TagUtil.Split(m.Tags).ToList();
                var sizeStr = m.SizeBytes < 1048576 ? (m.SizeBytes / 1024.0).ToString("0.#") + " KB" : (m.SizeBytes / 1048576.0).ToString("0.#") + " MB";
                var rext = System.IO.Path.GetExtension(m.FileName ?? m.Url ?? "").ToLowerInvariant();
                var rIsImg = rext is ".png" or ".jpg" or ".jpeg" or ".webp";
                <tr class="media-row" data-search="@(m.FileName + " " + m.Tags)"
                    data-id="@m.Id" data-url="@m.Url" data-name="@m.FileName" data-tags="@m.Tags"
                    data-alt="@m.Alt" data-type="@m.ContentType" data-size="@m.SizeBytes"
                    data-source-id="@(m.SourceMediaId?.ToString() ?? "")"
                    data-source-url="@(m.SourceMediaId is int rsid && urlById.TryGetValue(rsid, out var rsu) ? rsu : "")"
                    data-cropjson="@m.CropJson"
                    data-isimg="@(rIsImg ? "1" : "")" style="cursor:pointer;">
                    <td><strong>@m.FileName</strong></td>
                    <td class="mono">@m.ContentType</td>
                    <td class="muted">@sizeStr</td>
                    <td>@foreach (var t in rTags) { <span class="mini-chip">@t</span> }</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
</div>

@* ---- Detail dialog ---- *@
<div class="modal-overlay" id="media-modal">
    <div class="modal modal-media" role="dialog" aria-modal="true" aria-labelledby="mm-title">
        <div class="modal-head">
            <h2 id="mm-title">@T["media.detail"]</h2>
            <button type="button" class="modal-close" id="mm-close" aria-label="@T["action.close"]">✕</button>
        </div>
        <div class="modal-body media-modal-body">
            <div class="media-preview">
                <img id="mm-img" src="" alt="" />
                <button type="button" class="btn btn-sm mm-crop-start" id="mm-crop-start" hidden>
                    <i class="ti ti-crop" aria-hidden="true"></i> @T["media.crop"]
                </button>
                <div class="crop-tools" id="mm-crop-tools" hidden>
                    <div class="crop-ratios">
                        <button type="button" class="btn btn-sm btn-ghost" data-ratio="0">@T["media.cropFree"]</button>
                        <button type="button" class="btn btn-sm btn-ghost" data-ratio="1">1:1</button>
                        <button type="button" class="btn btn-sm btn-ghost" data-ratio="1.7777">16:9</button>
                        <button type="button" class="btn btn-sm btn-ghost" data-ratio="1.3333">4:3</button>
                    </div>
                    <div class="crop-actions">
                        <button type="button" class="btn btn-sm" id="mm-crop-save">@T["media.cropSave"]</button>
                        <button type="button" class="btn btn-sm btn-ghost" id="mm-crop-cancel">@T["action.cancel"]</button>
                    </div>
                </div>
                <div class="crop-note" id="mm-crop-note" hidden>@T["media.cropFromOriginal"]</div>
            </div>
            <div class="media-detail">
                <div class="media-detail-name" id="mm-name"></div>

                <div class="form-field">
                    <label for="mm-url">@T["media.url"]</label>
                    <div class="copy-row">
                        <input id="mm-url" readonly />
                        <button type="button" class="btn btn-sm btn-ghost" id="mm-copy">@T["media.copy"]</button>
                    </div>
                </div>

                <form id="mm-save-form" method="post" asp-page-handler="Save" asp-route-tag="@Model.ActiveTag" class="media-detail-form">
                    <input type="hidden" name="id" id="mm-id" />

                    <div class="form-field">
                        <label for="mm-alt">@T["media.alt"]</label>
                        <input id="mm-alt" name="alt" placeholder="@T["media.altPlaceholder"]" />
                    </div>

                    <div class="form-field">
                        <label for="mm-tag-entry">@T["media.tags"]</label>
                        <div class="tag-input" id="mm-tag-input">
                            <input type="text" id="mm-tag-entry" class="tag-entry" placeholder="@T["media.tagAdd"]"
                                   autocomplete="off" list="mm-tag-list" hidden />
                            <button type="button" class="tag-add-chip" id="mm-tag-add" title="@T["media.tagAdd"]" aria-label="@T["media.tagAdd"]">+</button>
                        </div>
                        <input type="hidden" name="tags" id="mm-tags" />
                        @if (Model.AllTags.Count > 0)
                        {
                            <datalist id="mm-tag-list">
                                @foreach (var t in Model.AllTags)
                                {
                                    <option value="@t"></option>
                                }
                            </datalist>
                            <div class="tag-suggest" id="mm-suggest">
                                @foreach (var t in Model.AllTags)
                                {
                                    <button type="button" class="mini-chip mini-chip-add" data-tag="@t">+ @t</button>
                                }
                            </div>
                            <div class="help">@T["media.suggestHint"]</div>
                        }
                    </div>

                    <div class="media-detail-info" id="mm-info"></div>
                </form>
            </div>

            @* Full-width action bar spanning both columns: positive → negative, destructive set apart. *@
            <div class="modal-foot action-bar">
                <button type="submit" form="mm-save-form" class="btn">@T["action.save"]</button>
                <button type="button" class="btn btn-ghost" id="mm-cancel">@T["action.cancel"]</button>
                <form method="post" asp-page-handler="Delete" asp-route-tag="@Model.ActiveTag" class="media-delete-form act-danger"
                      onsubmit="return confirm('@T["media.confirmDelete"]');">
                    <input type="hidden" name="id" id="mm-del-id" />
                    <button type="submit" class="btn btn-danger">@T["action.delete"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/cropper/cropper.min.js" asp-append-version="true"></script>
    <script>
        (function () {
            // ---- Upload ----
            var btn = document.getElementById('media-upload-btn');
            var file = document.getElementById('media-file');
            btn.addEventListener('click', function () { file.click(); });
            file.addEventListener('change', function () {
                if (!file.files || !file.files.length) return;
                btn.disabled = true; btn.textContent = '@T["action.uploading"]';
                var files = Array.prototype.slice.call(file.files);
                var chain = Promise.resolve();
                files.forEach(function (f) {
                    chain = chain.then(function () {
                        var fd = new FormData(); fd.append('file', f);
                        return fetch('/admin/api/upload', { method: 'POST', body: fd })
                            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
                            .then(function (r) { if (!r.ok) alert(r.j.error || '@T["media.uploadFailed"]'); });
                    });
                });
                chain.then(function () { window.location.reload(); });
            });

            // ---- Detail dialog ----
            var modal = document.getElementById('media-modal');
            var img = document.getElementById('mm-img');
            var nameEl = document.getElementById('mm-name');
            var urlEl = document.getElementById('mm-url');
            var altEl = document.getElementById('mm-alt');
            var infoEl = document.getElementById('mm-info');
            var idEl = document.getElementById('mm-id');
            var delIdEl = document.getElementById('mm-del-id');

            // ---- Tag chip picker ----
            var tagsHidden = document.getElementById('mm-tags');
            var tagBox = document.getElementById('mm-tag-input');
            var tagEntry = document.getElementById('mm-tag-entry');
            var tagAdd = document.getElementById('mm-tag-add');
            var chips = [];
            // The entry is hidden behind a "+" chip; clicking it reveals an inline input.
            function showEntry() { tagAdd.hidden = true; tagEntry.hidden = false; tagEntry.focus(); }
            function hideEntry() { tagEntry.hidden = true; tagAdd.hidden = false; }
            tagAdd.addEventListener('click', showEntry);
            function renderChips() {
                Array.prototype.slice.call(tagBox.querySelectorAll('.tag-chip-item')).forEach(function (el) { el.remove(); });
                chips.forEach(function (tag) {
                    var el = document.createElement('span');
                    el.className = 'tag-chip-item';
                    el.textContent = tag;
                    var x = document.createElement('button');
                    x.type = 'button'; x.className = 'tag-x'; x.setAttribute('aria-label', '@T["posts.tagRemove"]'); x.textContent = '×';
                    x.addEventListener('click', function () { removeTag(tag); tagEntry.focus(); });
                    el.appendChild(x);
                    tagBox.insertBefore(el, tagEntry);
                });
                tagsHidden.value = chips.join(', ');
            }
            function addTag(raw) {
                var t = (raw || '').replace(/,/g, ' ').trim();
                if (!t) return;
                if (chips.some(function (c) { return c.toLowerCase() === t.toLowerCase(); })) return;
                chips.push(t); renderChips();
            }
            function removeTag(tag) { chips = chips.filter(function (c) { return c !== tag; }); renderChips(); }
            function setTags(str) {
                var seen = {};
                chips = (str || '').split(',').map(function (s) { return s.trim(); }).filter(function (c) {
                    if (!c) return false; var k = c.toLowerCase(); if (seen[k]) return false; seen[k] = 1; return true;
                });
                renderChips();
            }
            tagEntry.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addTag(tagEntry.value); tagEntry.value = ''; }
                else if (e.key === 'Escape') { e.preventDefault(); tagEntry.value = ''; hideEntry(); }
                else if (e.key === 'Backspace' && !tagEntry.value && chips.length) { removeTag(chips[chips.length - 1]); }
            });
            tagEntry.addEventListener('blur', function () {
                if (tagEntry.value.trim()) { addTag(tagEntry.value); tagEntry.value = ''; }
                hideEntry();
            });
            tagBox.addEventListener('click', function (e) { if (e.target === tagBox) tagEntry.focus(); });
            document.getElementById('mm-save-form').addEventListener('submit', function () {
                if (tagEntry.value.trim()) { addTag(tagEntry.value); tagEntry.value = ''; }
            });

            function fmtBytes(n) {
                n = parseInt(n, 10) || 0;
                if (n < 1024) return n + ' B';
                if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
                return (n / 1024 / 1024).toFixed(1) + ' MB';
            }
            function open(card) {
                var d = card.dataset;
                img.src = d.url; img.alt = d.alt || d.name || '';
                nameEl.textContent = d.name || '';
                urlEl.value = d.url || '';
                altEl.value = d.alt || '';
                setTags(d.tags || ''); tagEntry.value = ''; hideEntry();
                idEl.value = d.id; delIdEl.value = d.id;
                infoEl.textContent = [d.type, fmtBytes(d.size)].filter(Boolean).join('  ·  ');
                setupCrop(d);
                modal.classList.add('open');
            }
            function close() { resetCrop(); modal.classList.remove('open'); }

            // ---- Crop (Cropper.js) ----
            // Crop makes a NEW file; the original is never touched. For an image that IS already a crop we
            // load its ORIGINAL into the cropper (so cropped-away area can be recovered) and pre-set the box.
            var cropStartBtn = document.getElementById('mm-crop-start');
            var cropTools = document.getElementById('mm-crop-tools');
            var cropNote = document.getElementById('mm-crop-note');
            var cropSaveBtn = document.getElementById('mm-crop-save');
            var cropper = null;
            var cropCtx = null;

            function resetCrop() {
                if (cropper) { try { cropper.destroy(); } catch (e) {} cropper = null; }
                if (cropTools) cropTools.hidden = true;
                if (cropStartBtn) cropStartBtn.hidden = !(cropCtx && cropCtx.isImg);
                if (cropSaveBtn) cropSaveBtn.disabled = false;
            }
            function setupCrop(d) {
                cropCtx = {
                    isImg: d.isimg === '1',
                    id: parseInt(d.id, 10),
                    sourceId: d.sourceId ? parseInt(d.sourceId, 10) : parseInt(d.id, 10),
                    displayUrl: d.url,
                    sourceUrl: d.sourceUrl || d.url,
                    cropjson: d.cropjson || ''
                };
                resetCrop();
                if (cropNote) cropNote.hidden = !(cropCtx.isImg && d.sourceId);
            }
            function beginCrop() {
                if (!cropCtx || !cropCtx.isImg || typeof Cropper === 'undefined') return;
                cropStartBtn.hidden = true;
                cropTools.hidden = false;
                var base = cropCtx.sourceUrl;               // crop FROM the original
                var init = function () {
                    if (cropper) { try { cropper.destroy(); } catch (e) {} }
                    cropper = new Cropper(img, {
                        viewMode: 1, autoCropArea: 1, background: false, movable: false, zoomable: false, rotatable: false,
                        ready: function () {
                            if (!cropCtx.cropjson) return;
                            try { var r = JSON.parse(cropCtx.cropjson); cropper.setData({ x: r.x, y: r.y, width: r.width, height: r.height }); } catch (e) {}
                        }
                    });
                };
                if (img.getAttribute('src') === base && img.complete) { init(); }
                else { img.onload = function () { img.onload = null; init(); }; img.src = base; }
            }

            if (cropStartBtn) cropStartBtn.addEventListener('click', beginCrop);
            document.getElementById('mm-crop-cancel').addEventListener('click', function () {
                var url = cropCtx ? cropCtx.displayUrl : img.src;
                resetCrop();
                img.src = url; // back to the shown image
            });
            cropTools.querySelectorAll('[data-ratio]').forEach(function (b) {
                b.addEventListener('click', function () {
                    if (!cropper) return;
                    var r = parseFloat(b.dataset.ratio);
                    cropper.setAspectRatio(r > 0 ? r : NaN);
                });
            });
            cropSaveBtn.addEventListener('click', function () {
                if (!cropper || !cropCtx) return;
                var data = cropper.getData(true); // rounded px, relative to the ORIGINAL we loaded
                cropSaveBtn.disabled = true;
                fetch('/admin/api/crop', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sourceId: cropCtx.sourceId, x: data.x, y: data.y, w: data.width, h: data.height })
                }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
                  .then(function (res) {
                      if (!res.ok) { alert(res.j.error || '@T["media.cropFailed"]'); cropSaveBtn.disabled = false; return; }
                      window.location.reload();
                  }).catch(function () { alert('@T["media.cropFailed"]'); cropSaveBtn.disabled = false; });
            });

            document.querySelectorAll('.media-card, .media-row').forEach(function (c) {
                c.addEventListener('click', function () { open(c); });
            });
            document.getElementById('mm-close').addEventListener('click', close);
            document.getElementById('mm-cancel').addEventListener('click', close);
            modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('open')) close(); });

            // Tag suggestion chips → add as a chip.
            var suggest = document.getElementById('mm-suggest');
            if (suggest) {
                suggest.addEventListener('click', function (e) {
                    var chip = e.target.closest('.mini-chip-add');
                    if (!chip) return;
                    addTag(chip.getAttribute('data-tag'));
                    tagEntry.focus();
                });
            }

            // Copy URL.
            document.getElementById('mm-copy').addEventListener('click', function () {
                var b = this, u = urlEl.value;
                (navigator.clipboard ? navigator.clipboard.writeText(u) : Promise.reject())
                    .then(function () { var t = b.textContent; b.textContent = '@T["media.copied"]'; setTimeout(function () { b.textContent = t; }, 1200); })
                    .catch(function () { urlEl.select(); document.execCommand('copy'); });
            });
        })();
    </script>
}
