@page
@model MatCMS.Pages.Admin.Components.IndexModel
@{
    ViewData["Title"] = T["components.title"];
}
<div class="page-head">
    <h1>@T["components.title"]</h1>
</div>

<div class="tabs" role="tablist">
    <button type="button" class="tab active" data-tab="custom">@T["components.tabCustom"]</button>
    <button type="button" class="tab" data-tab="system">@T["components.tabSystem"]</button>
</div>

@* ============ EIGENE KOMPONENTEN ============ *@
<div class="tab-panel" data-panel="custom">
    <div class="card">
        <p class="help">@T["components.intro"]</p>
        @if (Model.Items.Count == 0)
        {
            <p class="muted">@T["components.empty"]</p>
        }
        else
        {
            <div class="block-list">
                @foreach (var c in Model.Items)
                {
                    <div class="block-item">
                        <span class="b-icon">
                            @if (!string.IsNullOrEmpty(c.Icon))
                            {
                                <i class="ti ti-@c.Icon" aria-hidden="true"></i>
                            }
                            else
                            {
                                <i class="ti ti-puzzle" aria-hidden="true"></i>
                            }
                        </span>
                        <div class="b-info">
                            <div class="b-type">@c.Name</div>
                            <div class="b-sum mono">@c.Type</div>
                        </div>
                        <div class="actions">
                            <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@c.Id">@T["action.edit"]</a>
                            <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@c.Id" onsubmit="return confirm('@T["components.confirmDelete"]');">
                                <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        <div class="list-actions">
            <a class="btn" asp-page="Create">@T["components.new"]</a>
            @if (Model.CloudConnected)
            {
                <a class="btn btn-ghost" asp-page="Index" asp-route-browse="true">@T["plugins.browseCloud"]</a>
            }
        </div>
    </div>
</div>

@* ============ SYSTEMKOMPONENTEN (readonly) ============ *@
<div class="tab-panel" data-panel="system" hidden>
    <div class="card components-system">
        <p class="help">@T["components.systemIntro"]</p>
        <div class="block-list">
            @foreach (var def in Model.System)
            {
                <div class="block-item">
                    <span class="b-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(def.Svg)</svg>
                    </span>
                    <div class="b-info">
                        <div class="b-type">@T[def.Name]</div>
                        <div class="sys-desc">@T[def.Description]</div>
                    </div>
                    <div class="sys-meta">
                        @if (def.IsContainer)
                        {
                            <span class="badge badge-on">@T["components.systemContainer"]</span>
                        }
                        @if (def.ChildOnly)
                        {
                            <span class="badge badge-off">@T["components.systemChildOnly"]</span>
                        }
                        <code class="mono">@def.Type</code>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var tabs = document.querySelectorAll('.tab');
            var panels = document.querySelectorAll('.tab-panel');
            function show(name) {
                tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.tab === name); });
                panels.forEach(function (p) { p.hidden = p.dataset.panel !== name; });
            }
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
            var want = new URLSearchParams(location.search).get('tab');
            if (want) show(want);
        })();
    </script>
}

@* Katalog der verbundenen Cloud — nur auf Anforderung geladen (?browse=true). *@
@if (Model.Catalog is not null || Model.CatalogError is not null)
{
    <div class="card">
        <h2>@T["plugins.cloudCatalog"]</h2>
        @if (Model.CatalogError is not null)
        {
            <div class="alert alert-error">@Model.CatalogError</div>
        }
        else if (Model.Catalog!.Components.Count == 0)
        {
            <p class="muted">@T["components.cloudEmpty"]</p>
        }
        else
        {
            <p class="muted">@T["components.cloudIntro"]</p>
            <table class="data">
                <tbody>
                    @foreach (var c in Model.Catalog.Components)
                    {
                        var installed = Model.Items.Any(i => i.Type == c.Type);
                        <tr>
                            <td>
                                <strong>@c.Name</strong>
                                <div class="muted">@c.Description</div>
                            </td>
                            <td class="mono">@c.Type</td>
                            <td>
                                <div class="actions">
                                    <form class="inline-form" method="post" asp-page-handler="InstallFromCloud" asp-route-type="@c.Type">
                                        <button type="submit" class="btn btn-sm">@(installed ? T["plugins.cloudUpdate"] : T["plugins.cloudInstall"])</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
