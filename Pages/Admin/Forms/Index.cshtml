@page
@model MatCMS.Pages.Admin.Forms.IndexModel
@{
    ViewData["Title"] = T["forms.title"];
}
<div data-list data-list-page-size="25">
    <div class="page-head">
        <h1>@T["forms.title"]</h1>
        <div class="list-toolbar">
            <input type="search" class="list-search" data-list-search placeholder="Suchen…" aria-label="Suchen" autocomplete="off" />
            <a class="btn btn-sm" asp-page="Create">@T["forms.create"]</a>
        </div>
    </div>

    <table class="data" data-list-table>
        <thead>
            <tr>
                <th>@T["forms.colName"]</th>
                <th>@T["forms.colSlug"]</th>
                <th>@T["forms.colSubmissions"]</th>
                <th></th>
            </tr>
        </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="4" class="muted" style="text-align:center;padding:22px;">@T["forms.none"]</td></tr>
                }
                @foreach (var r in Model.Items)
                {
                    <tr data-search="@(r.Form.Name + " " + r.Form.Slug)">
                        <td><strong>@r.Form.Name</strong></td>
                        <td><span class="mono">@r.Form.Slug</span></td>
                        <td>
                            <a asp-page="Submissions" asp-route-id="@r.Form.Id">@r.Total</a>
                            @if (r.Unread > 0)
                            {
                                <span class="badge badge-new">@r.Unread @T["forms.unreadLabel"]</span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <a class="btn btn-sm btn-ghost" asp-page="Submissions" asp-route-id="@r.Form.Id">@T["forms.submissions"]</a>
                                <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@r.Form.Id">@T["action.edit"]</a>
                                <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@r.Form.Id"
                                      onsubmit="return confirm('@T["forms.confirmDelete", r.Form.Name]');">
                                    <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="list-empty" data-list-empty hidden>Keine Treffer.</div>
        <nav class="list-pager" data-list-pager aria-label="Seiten"></nav>
</div>
