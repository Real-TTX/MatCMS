@page "{id:int}"
@model MatCMS.Pages.Admin.Components.EditModel
@{
    ViewData["Title"] = T["components.edit"];

    // Der Adapter. Der Editor selbst steht EINMAL in MatCMS.Shared.Web/Pages/Shared/_ComponentEditor
    // und wird von der Cloud genauso benutzt — hier bleibt nur, was eine geteilte Ansicht nicht
    // kann: die Übersetzungen nachschlagen (sie kennt keinen der beiden Localizer) und sagen, wie
    // DIESE Seite ihre Felder nennt.
    var editor = new MatCMS.Shared.Web.ComponentEditor(
        Names: new MatCMS.Shared.Web.ComponentEditorNames(
            Name: "Name", Type: "Type", Description: "Description",
            FieldsJson: "FieldsJson", TemplateHtml: "TemplateHtml"),
        Labels: new MatCMS.Shared.Web.ComponentEditorLabels(
            TabGeneral: T["components.tabGeneral"],
            TabFields: T["components.fields"],
            TabTemplate: T["components.template"],
            Name: T["components.name"],
            Type: T["components.type"],
            TypeHelp: T["components.typeHelp"],
            Description: T["components.description"],
            FieldsHelp: T["components.fieldsHelp"],
            AddField: T["components.addField"],
            TemplateLabel: T["components.templateHtml"],
            TemplateHelp: T["components.templateHelp"],
            SampleData: T["components.sampleData"],
            Preview: T["components.preview"],
            PreviewNote: T["components.previewNote"],
            Debug: T["components.debug"],
            // Die Wörter, die das SKRIPT schreibt: die Feldzeilen und der Debug-Bereich entstehen in
            // JavaScript, können also nicht im Markup stehen. Sie kommen denselben Weg wie alle
            // anderen — nachgeschlagen hier, weitergereicht als Zeichenkette.
            Remove: T["action.delete"],
            DbgPlaceholders: T["components.dbgPlaceholders"],
            DbgUnknown: T["components.dbgUnknown"],
            DbgUnused: T["components.dbgUnused"],
            DbgOutput: T["components.dbgOutput"],
            DbgOk: T["components.dbgOk"],
            DbgEmpty: T["components.dbgEmpty"]),
        NameValue: Model.Name,
        TypeValue: Model.Current.Type,
        DescriptionValue: Model.Description,
        FieldsJson: Model.FieldsJson,
        TemplateHtml: Model.TemplateHtml,
        IconPicker: new MatCMS.Pages.Shared.IconPickVm(
            Model.Icon, LabelKey: "components.icon", HelpKey: "components.iconHelp"),
        // Die Kennung einer bestehenden Komponente steht fest: an ihr hängt jeder bereits gesetzte
        // Block. Sie wird gezeigt, aber nicht abgeschickt.
        TypeReadOnly: true,
        // Kein CodeMirror auf dieser Seite — das Bündel wird hier nicht geladen, und ein
        // data-code-Feld ohne das Bündel ist nur ein Textfeld.
        CodeMirror: false,
        FieldTypes: [
            new MatCMS.Shared.Web.ComponentFieldType("text", T["components.type.text"]),
            new MatCMS.Shared.Web.ComponentFieldType("textarea", T["components.type.textarea"]),
            new MatCMS.Shared.Web.ComponentFieldType("richtext", T["components.type.richtext"]),
            new MatCMS.Shared.Web.ComponentFieldType("image", T["components.type.image"]),
            new MatCMS.Shared.Web.ComponentFieldType("url", T["components.type.url"])
        ],
        // Die Vorschau des CMS zeichnet in den Farben des Admin. Sie standen bis zum Zusammenlegen
        // fest im Skript — jetzt stehen sie hier, weil genau das der Unterschied zur Cloud ist: die
        // borgt sich das Design des Templates, das ihr Profil aktiviert. Ein Schalter im Skript
        // wäre der falsche Ort für eine Entscheidung, die der Seite gehört.
        PreviewTheme: new MatCMS.Shared.Web.ComponentPreviewTheme(
            Accent: "#de7e11", AccentDark: "#bc6b0e", Accent2: "#22d3ee",
            Heading: "#111", Text: "#333",
            Background: "#fff", AltBackground: "#f6f7f9",
            ContainerWidth: "1180", ButtonRadius: "0",
            HeadingFont: "Inter", BodyFont: "Inter"));
}
@* Nur die Überschrift: alle Aktionen dieser Seite stehen unten in EINER Reihe — dieselbe Ordnung
   wie im Plugin-Editor. Zwei Orte für Knöpfe, die dasselbe Formular betreffen, ließen einen oben
   nach dem suchen, was unten liegt. *@
<div class="page-head">
    <h1>@T["components.edit"]</h1>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    @* Reiter wie im Plugin-Editor, mit denselben Klassen (.tabs/.tab/.tab-panel) — und was hier
       BEWUSST FEHLT, ist der Dateibaum: eine Komponente hat keine Dateien. Sie ist eine Zeile mit
       Name, Typ, Beschreibung und Symbol, einer Feldliste und EINER HTML-Vorlage. Ein Baum mit einer
       Wurzel und einer einzigen „Datei“ darunter wäre Zierrat, der so tut, als gäbe es mehr zu
       ordnen. Ebenso fehlen Knotenmenü, Blaupausen und Rollen — nichts davon hat hier ein Ziel.

       ACHTUNG, DIE FALLE AUS Plugins/Edit: alle Reiterfelder MÜSSEN innerhalb dieses <form>
       bleiben. Ein ausgeblendetes Reiterfeld wird trotzdem mit abgeschickt — ein Feld AUSSERHALB
       des Formulars dagegen gar nicht, und dann kämen Name, Symbol oder Vorlage beim Speichern aus
       einem anderen Reiter LEER an und überschrieben den Bestand. Der geteilte Editor rendert
       deshalb ALLES innerhalb dieses <form> und nichts darum herum. *@
    <form method="post" class="form-grid" id="component-form">
        <partial name="_ComponentEditor" model="editor" />

        @* EINE Aktionsreihe unten, von positiv nach negativ, wie in Plugins/Edit: Speichern
           (gefüllt), dann Exportieren, dann Zurück — beide als .btn-ghost. Sie steht AUSSERHALB der
           Reiter und damit unter jedem von ihnen: ein Speichern-Knopf in einem Reiter verspräche,
           dass die anderen dabei unberührt bleiben, und das stimmt nicht.
           Was hier BEWUSST FEHLT, ist die zerstörende Aktion: das Löschen einer Komponente steht in
           der Liste, wo es schon immer stand und wo sein Rückfragetext hängt. Es hierher zu holen
           hieße, einen zweiten Löschweg zu bauen — und zwei Wege, eine Komponente loszuwerden, sind
           einer zu viel. *@
        <div class="form-actions">
            <button type="submit" class="btn">@T["action.save"]</button>
            <a class="btn btn-ghost" asp-page="Edit" asp-page-handler="ExportJson" asp-route-id="@Model.Current.Id">
                <i class="ti ti-download" aria-hidden="true"></i> @T["components.exportJson"]
            </a>
            <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
        </div>
    </form>
</div>

@section Scripts {
    @* Dieselben drei Zeilen wie auf jeder anderen Reiterseite des Admin (Einstellungen, Backup,
       Templates): Klick schaltet um, ?tab=<name> verlinkt einen. *@
    <script>
        (function () {
            var tabs = document.querySelectorAll('.tab');
            var panels = document.querySelectorAll('.tab-panel');
            function show(name) {
                tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.tab === name); });
                panels.forEach(function (p) { p.hidden = p.dataset.panel !== name; });
            }
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
            var want = new URLSearchParams(location.search).get('tab');
            if (want) show(want);
        })();
    </script>
    @* Das Skript des Editors liegt EINMAL in der geteilten Bibliothek — die Cloud lädt dasselbe.
       Was diese Seite unterscheidet (Feldarten, die Wörter des Skripts, die Farben der Vorschau),
       hängt als data-Merkmal am #field-rows des geteilten Editors und braucht deshalb keinen
       window.*-Block mehr davor. *@
    <script src="~/_content/MatCMS.Shared.Web/js/component-editor.js" asp-append-version="true"></script>
}
