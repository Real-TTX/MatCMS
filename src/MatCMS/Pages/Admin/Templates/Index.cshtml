@page
@model MatCMS.Pages.Admin.Templates.IndexModel
@{
    ViewData["Title"] = T["templates.title"];
}
<div class="page-head">
    <h1>@T["templates.title"]</h1>
</div>

<div class="tpl-grid">
    @foreach (var t in Model.Items)
    {
        <div class="tpl-card @(t.IsActive ? "is-active" : "")">
            <a class="tpl-preview" asp-page="Edit" asp-route-id="@t.Id" title="@t.Name" aria-label="@t.Name">
                <iframe class="tpl-iframe" src="~/?previewTemplate=@t.Id" title="@t.Name" loading="lazy" tabindex="-1" scrolling="no" aria-hidden="true"></iframe>
            </a>
            <div class="tpl-card-foot">
                <div class="tpl-name">
                    <span>@t.Name</span>
                    @if (t.IsActive)
                    {
                        <span class="badge badge-on">@T["templates.active"]</span>
                    }
                </div>
                <div class="actions">
                    <a class="btn btn-sm btn-ghost btn-icon" asp-page="Edit" asp-route-id="@t.Id" title="@T["templates.designerTitle"]" aria-label="@T["templates.tabDesigner"]"><i class="ti ti-palette" aria-hidden="true"></i></a>
                    <a class="btn btn-sm btn-ghost btn-icon" asp-page="Customize" asp-route-id="@t.Id" title="@T["templates.customizeTitle"]" aria-label="@T["templates.customizeHeading"]"><i class="ti ti-pencil" aria-hidden="true"></i></a>
                    @if (!t.IsActive)
                    {
                        <form class="inline-form" method="post" asp-page-handler="Activate" asp-route-id="@t.Id">
                            <button type="submit" class="btn btn-sm btn-ghost btn-icon" title="@T["templates.activate"]" aria-label="@T["templates.activate"]"><i class="ti ti-check" aria-hidden="true"></i></button>
                        </form>
                        <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@t.Id" onsubmit="return confirm('@T["templates.confirmDelete", t.Name]');">
                            <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><i class="ti ti-trash" aria-hidden="true"></i></button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

<partial name="_AddMenu" model='AddMenus.Payload(T, "templates", Url.Page("Create")!, "templates.create", Model.CloudConnected ? Url.Page("Index", new { browse = true }) : null, "import-template")' />

<div class="card" id="import-template" hidden>
    <h2>@T["templates.importJson"]</h2>
    <p class="muted">@T["templates.importJsonHint"]</p>
    <form method="post" asp-page-handler="Import">
        <div class="form-field">
            <textarea name="templateJson" rows="6" spellcheck="false" placeholder='{ "Name": "..." }'></textarea>
        </div>
        <div class="form-actions"><button type="submit" class="btn">@T["templates.importBtn"]</button></div>
    </form>
</div>

@* The cloud catalogue opens as a store dialog, not as a card under the list — see _StoreDialog. *@
@if (Model.Catalog is not null || Model.CatalogError is not null)
{
    <partial name="_StoreDialog" model="Model.StoreDialog" />
}
