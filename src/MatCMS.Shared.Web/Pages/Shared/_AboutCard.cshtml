@model MatCMS.Shared.Web.AboutCard
@*
    The About card (see AboutCard): logo, version tag, channel pill; foot with the website and the copyright.
    MatUi classes only — mat-brandmark--light/--dark swap the logo with the user's theme. No tag helpers here
    (the RCL has no _ViewImports) — plain HTML + Razor only.
*@
<section class="mat-card about-card">
    <div class="mat-card__body">
        <div class="mat-row mat-gap-4 about-card__head">
            <img class="mat-brandmark mat-brandmark--light about-card__logo" src="@Model.Logo" alt="" width="@Model.LogoWidth" height="44" />
            <img class="mat-brandmark mat-brandmark--dark about-card__logo" src="@Model.LogoDark" alt="" width="@Model.LogoWidth" height="44" />
            <div class="mat-stack mat-stack--sm">
                <h2 class="mat-sr-only">@Model.Product</h2>
                <div class="mat-row">
                    <span class="mat-tag mat-mono">@Model.Version</span>
                    <span class="@Model.PillClass">@Model.ChannelLabel</span>
                </div>
            </div>
        </div>
    </div>
    <div class="mat-card__foot mat-row mat-row--between">
        <a class="mat-btn mat-btn--ghost mat-btn--sm" href="@Model.WebsiteUrl" target="_blank" rel="noopener"><i class="ti ti-world" aria-hidden="true"></i><span>@Model.WebsiteLabel</span></a>
        <span class="mat-text-muted">@Model.Copyright</span>
    </div>
</section>
