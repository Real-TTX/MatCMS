@page
@model MatCMS.Pages.Admin.Account.IndexModel
@{
    ViewData["Title"] = T["account.title"];
}
<div class="page-head">
    <h1>@T["account.title"]</h1>
</div>

@* Identität — nur Anzeige. Login-E-Mail/Benutzername ändert ein Admin unter Benutzer. *@
<div class="card">
    <h2>@T["account.identity"]</h2>
    <div class="kv"><div class="kv-label">@T["account.username"]</div><div class="kv-value">@Model.Account.Username</div></div>
    @if (!string.IsNullOrWhiteSpace(Model.Account.Email))
    {
        <div class="kv"><div class="kv-label">@T["account.email"]</div><div class="kv-value">@Model.Account.Email</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Account.DisplayName))
    {
        <div class="kv"><div class="kv-label">@T["account.displayName"]</div><div class="kv-value">@Model.Account.DisplayName</div></div>
    }
    <div class="kv"><div class="kv-label">@T["account.role"]</div><div class="kv-value">@Model.Account.Role</div></div>
</div>

@* Darstellung — persönliche Wahl: Farbschema der Verwaltung und die Admin-Leiste über der Website. *@
<div class="card">
    <h2>@T["account.appearanceTitle"]</h2>
    <form method="post" asp-page-handler="Appearance" class="form-grid">
        <div class="form-field">
            <label for="theme">@T["account.theme"]</label>
            <select id="theme" name="theme">
                <option value="light" selected="@(Model.Account.Theme is not ("dark" or "system") ? "selected" : null)">@T["account.themeLight"]</option>
                <option value="dark" selected="@(Model.Account.Theme == "dark" ? "selected" : null)">@T["account.themeDark"]</option>
                <option value="system" selected="@(Model.Account.Theme == "system" ? "selected" : null)">@T["account.themeSystem"]</option>
            </select>
        </div>
        <div class="form-field">
            <label for="adminBar">@T["account.adminBarTitle"]</label>
            <select id="adminBar" name="adminBar">
                <option value="" selected="@(Model.Account.AdminBar is null ? "selected" : null)">@T["account.adminBarSite"]</option>
                <option value="on" selected="@(Model.Account.AdminBar == "on" ? "selected" : null)">@T["account.adminBarOn"]</option>
                <option value="off" selected="@(Model.Account.AdminBar == "off" ? "selected" : null)">@T["account.adminBarOff"]</option>
            </select>
            <div class="help">@T["account.adminBarHelp"]</div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">@T["action.save"]</button>
        </div>
    </form>
</div>

@* Passwort ändern — verlangt das aktuelle Passwort. *@
<div class="card">
    <h2>@T["account.passwordTitle"]</h2>
    <p class="help">@T["account.passwordHelp"]</p>
    <form method="post" asp-page-handler="Password" class="form-grid" autocomplete="off">
        <div class="form-field">
            <label for="CurrentPassword">@T["account.currentPassword"]</label>
            <input id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required />
        </div>
        <div class="form-field">
            <label for="NewPassword">@T["account.newPassword"]</label>
            <input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" minlength="8" required />
            <div class="help">@T["account.passwordRule"]</div>
        </div>
        <div class="form-field">
            <label for="ConfirmPassword">@T["account.confirmPassword"]</label>
            <input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" required />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">@T["account.changePassword"]</button>
        </div>
    </form>
</div>

@* Zwei-Faktor — Status + Sprung zur Einrichtungsseite. *@
<div class="card">
    <h2>@T["account.twoFactorTitle"]</h2>
    <div class="kv">
        <div class="kv-label">@T["twofactor.status"]</div>
        <div class="kv-value">
            @if (Model.TwoFactorEnabled)
            {
                <span class="badge badge-on">@T["account.twoFactorOn"]</span>
            }
            else
            {
                <span class="badge badge-off">@T["account.twoFactorOff"]</span>
            }
        </div>
    </div>
    <div class="form-actions" style="margin-top:14px;">
        <a class="btn btn-ghost" asp-page="/Admin/Account/TwoFactor">@(Model.TwoFactorEnabled ? T["account.manage2fa"] : T["account.setup2fa"])</a>
    </div>
</div>
