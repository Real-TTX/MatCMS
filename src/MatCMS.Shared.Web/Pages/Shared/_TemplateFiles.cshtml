@model MatCMS.Shared.Web.TemplateFiles
@*
    The template editor's file tab — same build as the plugin editor (MatCMS/Pages/Admin/Plugins/Edit):
    EIN Baum links mit einer Wurzel (dem Template) und seinen Dateien darunter, rechts die offene
    Datei mit einer schmalen Menüleiste darüber, Aktionen am Knoten per Rechtsklick / "…" /
    Kontextmenü-Taste. Es sind die Klassen des Admin (.pf-tree, .pf-side, .pf-list, .pf-file,
    .pf-menu, .pf-ctx) — ein zweiter, nachgebauter Satz hätte dasselbe zweimal zu pflegen bedeutet.

    WAS SICH GEÄNDERT HAT UND WARUM: vorher war das hier eine Liste von Karten plus ein
    CodeMirror-DIALOG. Getippt wurde im Dialog, und erst "Übernehmen" schrieb den Text in das Feld,
    das das Formular abschickt. Jeder andere Weg aus dem Dialog heraus — Abbrechen, Escape, Klick
    auf den Schleier, Reiterwechsel, ein Klick auf Speichern bei offenem Dialog — verlor die Arbeit
    ohne Rückfrage. Jetzt schreibt der Editor bei JEDEM Tastendruck in genau dieses Feld, und das
    Feld selbst bleibt über "Rohform" erreichbar. Ein Editor, der seinen Inhalt erst beim Absenden
    (oder beim Übernehmen) erzeugt, verliert ihn beim ersten Fall, an den niemand gedacht hat.

    Templates haben andere Dateien als Plugins: keine echten Ordner, keine Systemdatei, kein
    Systemordner — es sind genau die Pseudo-Dateien, die die Seite übergibt, und es wird keine
    erfunden. Ihre Reihenfolge kommt von der Seite und wird NICHT sortiert: body.html steht vorn,
    weil dort angefangen wird.

    Was der Baum unbedingt behalten muss, ist die Besonderheit der Templates: dass zu sehen ist,
    WELCHE Datei angepasst ist und welche leer aus dem Theme kommt. Das Abzeichen (.tpl-file-badge)
    hängt deshalb an jeder Zeile des Baums und wird bei jedem Tastendruck neu bestimmt — ein
    hübscherer Baum, der diese Auskunft verliert, wäre ein Rückschritt.

    Von der CMS und der Cloud gemeinsam benutzt; die Seiten unterscheiden sich nur darin, als was
    ihre Dateien abgeschickt werden (LayoutHtml, Parts[post], …) — darum steht FieldName am Modell.
    Braucht CodeMirror auf der Seite (siehe _CodeEditorAssets). Fehlt es oder fällt das Skript aus,
    stehen die Rohfelder mit Beschriftung da und alles ist trotzdem bearbeitbar.
*@
@{
    var files = Model.Files;
    var meta = files.Select(f => new
    {
        name = f.Name,
        ext = f.Ext,
        desc = f.Description,
        mode = f.Mode,
        insertDefault = f.InsertDefault,
        baseline = f.Baseline,
        tokens = f.Tokens.Select(t => new { t = t.T, l = t.L })
    }).ToArray();
    var metaJson = System.Text.Json.JsonSerializer.Serialize(meta);

    // Die Texte des Baums gehen als EIN Stück ins Skript: es kann darin kein T[...] aufrufen, und
    // einzeln in den Code gestreute Übersetzungen sind der Weg, auf dem eine davon irgendwann
    // Deutsch bleibt.
    var textJson = System.Text.Json.JsonSerializer.Serialize(new
    {
        edit = Model.Labels.Edit,
        insertDefault = Model.Labels.InsertDefault,
        insertConfirm = Model.Labels.InsertDefaultConfirm,
        custom = Model.Labels.BadgeCustom,
        empty = Model.Labels.BadgeEmpty,
        pick = Model.Labels.Pick,
        menu = Model.Labels.Menu,
        toggle = Model.Labels.Toggle,
        raw = Model.Labels.Raw,
        copy = Model.Labels.Copy,
        copied = Model.Labels.Copied,
        root = string.IsNullOrWhiteSpace(Model.RootLabel) ? Model.Labels.Root : Model.RootLabel
    });

    // The optional "assets" folder (uploaded, real files). Null → the branch and its panels never render,
    // so an editor without asset storage (the cloud's template views) is unchanged.
    var ap = Model.Assets;
    var assetsJson = ap is null ? "null" : System.Text.Json.JsonSerializer.Serialize(new
    {
        folder = ap.FolderLabel,
        uploadForm = ap.UploadFormId,
        delForm = ap.DeleteFormId,
        delInput = ap.DeleteInputName,
        uploadLabel = ap.UploadLabel,
        deleteLabel = ap.DeleteLabel,
        urlLabel = ap.UrlLabel,
        tokenLabel = ap.TokenLabel,
        empty = ap.EmptyLabel,
        confirm = ap.DeleteConfirm,
        help = ap.Help,
        files = ap.Files.Select(f => new { id = f.Id, name = f.Name, url = f.Url, kind = f.Kind, size = f.SizeText, token = f.Token })
    });
}

<div class="help">@Html.Raw(Model.Intro)</div>
@* Flex-Layout NUR über die Klasse (nicht inline): ein inline display:flex überschriebe das
   hidden-Attribut, und die Panels blieben offen, obwohl eine Skriptdatei gewählt ist. *@
<style>
    .pf-asset:not([hidden]), .pf-upload:not([hidden]) { display:flex; flex-direction:column; gap:10px; padding:12px; }
    /* admin.css setzt .cm-modal-tokens{display:flex}, was das hidden-Attribut übersteuert — beim
       Öffnen einer Asset-/Upload-Ansicht (dort gibt es keine Platzhalter) blitzte die Leiste sonst auf.
       Der attributgenaue Selektor ist spezifischer und gewinnt, ohne die normale Anzeige zu stören. */
    .cm-modal-tokens[hidden] { display:none; }
</style>

@* .tpl-tree ist derselbe Baum, nur mit breiterer linker Spalte: an jeder Zeile hängt hier zusätzlich
   das Abzeichen "angepasst / leer", und in 230 Pixeln lag es über dem Dateinamen. *@
<div class="pf-tree tpl-tree" data-tf>
    @* Links: der Baum. Vollständig vom Skript gezeichnet, weil die Zeilen ihren Zustand
       (angepasst / leer) beim Tippen ändern müssen, ohne dass die Seite neu lädt. *@
    <aside class="pf-side">
        <div class="pf-list" data-tf-list></div>
    </aside>
    <div class="pf-main">
        @* Die Menüleiste sagt, WELCHE Datei offen ist, und trägt nur Befehle für sie. *@
        <div class="pf-menu">
            <span class="pf-menu-file mono" data-tf-current></span>
            <span style="flex:1;"></span>
            <button type="button" class="pf-menu-item" data-tf-insert hidden>@Model.Labels.InsertDefault</button>
            <button type="button" class="pf-menu-item" data-tf-raw aria-pressed="false">@Model.Labels.Raw</button>
        </div>
        @* Der Editor. Die Rohfelder stehen MIT DARIN und nicht in einem zweiten Kasten irgendwo
           sonst: ohne Skript sind sie samt Beschriftung sichtbar und bearbeitbar, mit Skript zeigt
           "Rohform" genau das Feld der offenen Datei — dasselbe Feld, kein zweiter Stand, der beim
           Umschalten gewinnen oder verlorengehen könnte. *@
        <div class="pf-editor" data-tf-editor>
            @* CodeMirror-Fläche. .cm-modal-editor bringt genau das mit, was sie braucht (flex,
               min-height:0, .CodeMirror{height:100%}) — der Name stammt noch vom Dialog, eine
               zweite Klasse mit demselben Inhalt wäre die schlechtere Wahl. *@
            <div class="cm-modal-editor" data-tf-host hidden></div>
            @for (var i = 0; i < files.Count; i++)
            {
                @* Die id ist so wichtig wie der name: die Live-Vorschau der Cloud liest das Formular
                   über die Element-id (val("layoutHtml"), val("customCss") …). Ohne sie fällt sie
                   stillschweigend auf die Beispielseite zurück und zeigt das Layout nie. *@
                @* Die Beschriftung ist NUR für den Fall ohne Skript da: dann stehen alle Rohfelder
                   offen, und fünf unbeschriftete Textflächen sagten nichts. Sobald das Skript läuft,
                   wird sie ausgeblendet — welche Datei offen ist, sagt die Menüleiste ÜBER dem
                   Editor, und dieselbe Auskunft ein zweites Mal darunter las sich wie eine zweite
                   Dateileiste neben dem Baum. Das aria-label trägt den Namen weiter, wenn die
                   Beschriftung verborgen ist: eine verborgene <label> steht auch dem Vorleser nicht
                   mehr zur Verfügung. *@
                <label class="pf-editor-head" data-tf-store-head="@i" for="@files[i].FieldName"
                       title="@files[i].Description">@files[i].Name</label>
                <textarea class="tpl-file-store code" data-idx="@i" id="@files[i].FieldName"
                          name="@files[i].FieldName" aria-label="@files[i].Name"
                          spellcheck="false" rows="14">@files[i].Value</textarea>
            }
        </div>
        @* Kein leerer Kasten, sondern der Hinweis, was zu tun ist. *@
        <div class="pf-empty" data-tf-empty hidden>@Model.Labels.Pick</div>
        @* Ansicht einer hochgeladenen Datei (assets-Ordner). Kein Textfeld: der Inhalt liegt in der
           Datenbank und wird NICHT über das Speichern-Formular geschrieben — genau wie im Plugin-Editor.
           Nur sichtbar, wenn eine Asset-Zeile gewählt ist. *@
        <div class="pf-asset" data-tf-asset hidden>
            <div>
                <strong class="mono" data-tf-asset-name></strong>
                <span class="badge" data-tf-asset-kind></span>
                <span class="muted" data-tf-asset-size></span>
            </div>
            <img data-tf-asset-img hidden alt="" style="max-width:320px;max-height:200px;border:1px solid var(--line,#eceef1);" />
            <div class="form-field">
                <label data-tf-asset-tokenlabel></label>
                <input class="mono" readonly onclick="this.select()" data-tf-asset-token />
            </div>
            <div class="form-field">
                <label data-tf-asset-urllabel></label>
                <input class="mono" readonly onclick="this.select()" data-tf-asset-url />
            </div>
            <div><button type="button" class="btn btn-sm btn-danger" data-tf-asset-del></button></div>
        </div>
        @* Datei hochladen. Datei-Feld und Knopf gehören per form=-Attribut zu einem Multipart-Formular,
           das AUSSERHALB des Speichern-Formulars steht (die Seite rendert es) — ein <form> im <form>
           gibt es in HTML nicht, aber ein Bedienelement darf seinem Formular per Attribut zugeordnet sein. *@
        <div class="pf-upload" data-tf-upload hidden>
            <div class="help" data-tf-upload-help></div>
            <div class="form-row" style="align-items:flex-end;gap:12px;">
                <div class="form-field" style="flex:1;">
                    <label data-tf-upload-label></label>
                    <input type="file" name="file" required data-tf-upload-file />
                </div>
                <button type="submit" class="btn" data-tf-upload-btn></button>
            </div>
        </div>
        @* Die Platzhalter der offenen Datei. Kein Befehl, sondern Material — deshalb unter dem
           Editor und nicht in der Menüleiste. *@
        <div class="cm-modal-tokens" data-tf-tokens hidden>
            <span class="cm-tokens-label">@Model.Labels.Tokens</span>
            <span data-tf-token-list></span>
        </div>
        <div class="help" data-tf-desc></div>
    </div>
</div>

<script>
    (function () {
        var FILES = @Html.Raw(metaJson);
        var TXT = @Html.Raw(textJson);
        var ASSETS = @Html.Raw(assetsJson);   // null = kein assets-Ordner (Cloud-Ansichten)

        // CodeMirror kommt auf beiden Seiten erst im Skript-Abschnitt am Seitenende (_CodeEditorAssets).
        // Dieses Stück steht mitten im Formular — es darf den Editor also nicht sofort bauen, sonst
        // ist CodeMirror noch nicht definiert und der Baum bliebe ein leeres Feld.
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();

        function init() {
            var box = document.querySelector('[data-tf]');
            if (!box) return;
            var list = box.querySelector('[data-tf-list]');
            var stores = Array.prototype.slice.call(box.querySelectorAll('.tpl-file-store'));
            var heads = Array.prototype.slice.call(box.querySelectorAll('[data-tf-store-head]'));
            var host = box.querySelector('[data-tf-host]');
            var empty = box.querySelector('[data-tf-empty]');
            var curEl = box.querySelector('[data-tf-current]');
            var insBtn = box.querySelector('[data-tf-insert]');
            var rawBtn = box.querySelector('[data-tf-raw]');
            var tokBox = box.querySelector('[data-tf-tokens]');
            var tokList = box.querySelector('[data-tf-token-list]');
            var descEl = box.querySelector('[data-tf-desc]');
            if (!list || stores.length === 0) return;

            // Panels for uploaded assets (only present when ASSETS is set).
            var assetView = box.querySelector('[data-tf-asset]');
            var uploadView = box.querySelector('[data-tf-upload]');

            var HAS_CM = typeof CodeMirror !== 'undefined';
            var cm = null, cur = -1, raw = !HAS_CM, loading = false, collapsed = false;
            // The assets folder collapses independently of the root, and an asset/upload selection is
            // tracked apart from `cur` (a pseudo-file index) so only one thing is ever highlighted.
            var assetsCollapsed = false, curAsset = null, uploadOpen = false;

            // Wire the upload controls to the page's external multipart form (form owner via attribute).
            if (ASSETS && uploadView) {
                var uf = uploadView.querySelector('[data-tf-upload-file]');
                var ub = uploadView.querySelector('[data-tf-upload-btn]');
                if (uf) uf.setAttribute('form', ASSETS.uploadForm);
                if (ub) { ub.setAttribute('form', ASSETS.uploadForm); ub.textContent = ASSETS.uploadLabel; }
                var ul = uploadView.querySelector('[data-tf-upload-label]'); if (ul) ul.textContent = ASSETS.uploadLabel;
                var uh = uploadView.querySelector('[data-tf-upload-help]'); if (uh) uh.innerHTML = ASSETS.help || '';
            }

            function norm(s) { return (s || '').replace(/\r\n/g, '\n').replace(/\r/g, '\n'); }
            // Angepasst oder leer: leer heißt, die Datei kommt unverändert aus dem Theme. Genau
            // dieselbe Rechnung wie serverseitig beim ersten Zeichnen — zwei Rechnungen für eine
            // Auskunft würden irgendwann verschiedene Antworten geben.
            function isCustom(i) {
                var v = norm(stores[i].value).trim();
                return v !== '' && v !== norm(FILES[i].baseline).trim();
            }

            // ---- Schreiben ------------------------------------------------------------------
            // Bei JEDEM Tastendruck ins Feld, das abgeschickt wird. Nichts wird gesammelt und beim
            // Übernehmen oder Absenden erzeugt: was man sieht, steht schon im Formular.
            function push(i, text) {
                if (i < 0 || stores[i].value === text) return;
                stores[i].value = text;
                // .value setzen löst kein Ereignis aus — die Live-Vorschau der Cloud hört am
                // Formular zu und erfuhr sonst nie, dass eine Datei sich geändert hat.
                stores[i].dispatchEvent(new Event('input', { bubbles: true }));
                badges();
            }

            // ---- Der Baum -------------------------------------------------------------------
            function icon(name) {
                var i = document.createElement('i');
                i.className = 'ti ' + name;
                i.setAttribute('aria-hidden', 'true');
                return i;
            }
            function iconFor(ext) {
                if (ext === 'css') return 'ti-palette';
                if (ext === 'js') return 'ti-braces';
                return 'ti-file-code';
            }

            // Eine Zeile des Baums. Was sie tut, hängt an DIESEM Knoten: der Index steht in o.idx
            // und wird nicht aus Beschriftungen oder Nachbarzeilen erraten.
            function rowFor(o) {
                var row = document.createElement('div');
                row.className = 'pf-file' + (o.isOpen ? ' is-open' : '');
                row.style.paddingLeft = (4 + o.depth * 14) + 'px';

                var twist = document.createElement('button');
                twist.type = 'button';
                twist.className = 'pf-twist';
                if (o.expandable) {
                    // Each expandable node carries its own open state and toggle, so the assets folder
                    // collapses independently of the root (the old single `collapsed` toggled both).
                    var isExp = (o.expanded !== undefined) ? o.expanded : !collapsed;
                    twist.appendChild(icon(isExp ? 'ti-chevron-down' : 'ti-chevron-right'));
                    twist.title = TXT.toggle;
                    twist.setAttribute('aria-label', TXT.toggle + ': ' + o.label);
                    twist.setAttribute('aria-expanded', isExp ? 'true' : 'false');
                    twist.addEventListener('click', function (ev) {
                        ev.stopPropagation();
                        if (o.onToggle) o.onToggle(); else collapsed = !collapsed;
                        render();
                    });
                } else {
                    twist.tabIndex = -1;
                    twist.setAttribute('aria-hidden', 'true');
                }
                row.appendChild(twist);

                var name = document.createElement('button');
                name.type = 'button';
                name.className = 'pf-file-name' + (o.mono ? ' mono' : '');
                name.appendChild(icon(o.icon));
                name.appendChild(document.createTextNode(o.label));
                if (o.title) name.title = o.title;
                name.addEventListener('click', o.activate);
                row.appendChild(name);

                // Das Abzeichen der Templates: angepasst oder leer. Es hängt an der Zeile, damit
                // ein Blick auf den Baum sagt, welche Datei überschrieben ist und welche vom Theme
                // kommt — dieselbe Auskunft wie in der alten Kartenliste, an derselben Stelle wie
                // der Name.
                if (o.kind === 'file') {
                    var badge = document.createElement('span');
                    badge.className = 'tpl-file-badge';
                    badge.setAttribute('data-tf-node-badge', o.idx);
                    row.appendChild(badge);
                }

                var items = menuFor(o);
                if (items.length) {
                    var more = document.createElement('button');
                    more.type = 'button';
                    more.className = 'pf-more';
                    more.title = TXT.menu;
                    more.setAttribute('aria-label', TXT.menu + ': ' + o.label);
                    more.appendChild(icon('ti-dots'));
                    more.addEventListener('click', function (ev) {
                        ev.stopPropagation();
                        var r = more.getBoundingClientRect();
                        showMenu(r.left, r.bottom, items);
                    });
                    row.appendChild(more);
                    // Rechtsklick auf die ganze Zeile — und, weil nicht jedes Gerät eine rechte
                    // Maustaste hat, derselbe Inhalt über den Knopf und die Kontextmenü-Taste.
                    row.addEventListener('contextmenu', function (ev) {
                        ev.preventDefault();
                        showMenu(ev.clientX, ev.clientY, items);
                    });
                    name.addEventListener('keydown', function (ev) {
                        if (ev.key !== 'ContextMenu' && !(ev.shiftKey && ev.key === 'F10')) return;
                        ev.preventDefault();
                        var r = name.getBoundingClientRect();
                        showMenu(r.left, r.bottom, items);
                    });
                }
                return row;
            }

            // Die Wurzel ist das Template selbst: sie macht sichtbar, dass diese Dateien IHM
            // gehören. Darunter seine Dateien in der Reihenfolge der Seite — nicht alphabetisch,
            // denn body.html ist der Anfang. Ordner gibt es hier keine, also wird auch keiner
            // erfunden.
            function assetIcon(kind) {
                if (kind === 'image') return 'ti-photo';
                if (kind === 'css') return 'ti-palette';
                if (kind === 'js') return 'ti-braces';
                if (kind === 'font') return 'ti-typography';
                return 'ti-file';
            }

            function render() {
                list.innerHTML = '';
                list.appendChild(rowFor({
                    kind: 'root', depth: 0, label: TXT.root, icon: 'ti-brush', expandable: true,
                    expanded: !collapsed, onToggle: function () { collapsed = !collapsed; },
                    activate: function () { collapsed = !collapsed; render(); }
                }));
                if (collapsed) { return; }
                FILES.forEach(function (m, i) {
                    list.appendChild(rowFor({
                        kind: 'file', depth: 1, idx: i, label: m.name, icon: iconFor(m.ext),
                        mono: true, title: m.desc, isOpen: cur === i,
                        activate: function () { open(i, true); }
                    }));
                });
                // The uploaded files live in their own "assets" folder — a real folder of real files,
                // like the plugin editor. Selecting the folder opens the upload panel; selecting a file
                // opens its info/delete view. Absent (ASSETS null) → nothing here, as on the cloud.
                if (ASSETS) {
                    list.appendChild(rowFor({
                        kind: 'assetsfolder', depth: 1, label: ASSETS.folder,
                        icon: assetsCollapsed ? 'ti-folder' : 'ti-folder-open',
                        expandable: true, expanded: !assetsCollapsed, isOpen: uploadOpen,
                        onToggle: function () { assetsCollapsed = !assetsCollapsed; },
                        activate: function () { openUpload(); }
                    }));
                    if (!assetsCollapsed) {
                        ASSETS.files.forEach(function (a) {
                            list.appendChild(rowFor({
                                kind: 'asset', depth: 2, assetId: a.id, label: a.name, icon: assetIcon(a.kind),
                                mono: true, title: a.url, isOpen: curAsset === a.id,
                                activate: function () { openAsset(a); }
                            }));
                        });
                        if (ASSETS.files.length === 0)
                            list.appendChild(rowFor({
                                kind: 'note', depth: 2, label: ASSETS.empty, icon: 'ti-point',
                                activate: function () { openUpload(); }
                            }));
                    }
                }
                badges();
            }

            function badges() {
                FILES.forEach(function (m, i) {
                    var b = list.querySelector('[data-tf-node-badge="' + i + '"]');
                    if (!b) return;
                    var on = isCustom(i);
                    b.classList.toggle('on', on);
                    b.textContent = on ? TXT.custom : TXT.empty;
                });
            }

            // ---- Kontextmenü ----------------------------------------------------------------
            var menuEl = null;
            function closeMenu() { if (menuEl) { menuEl.remove(); menuEl = null; } }
            function showMenu(x, y, items) {
                closeMenu();                                   // nie zwei gleichzeitig
                var m = document.createElement('div');
                m.className = 'pf-ctx';
                m.setAttribute('role', 'menu');
                items.forEach(function (it) {
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'pf-ctx-item';
                    b.setAttribute('role', 'menuitem');
                    b.textContent = it.label;
                    b.addEventListener('click', function () { closeMenu(); it.run(); });
                    m.appendChild(b);
                });
                document.body.appendChild(m);
                // Am Zeiger, aber im Fenster: sonst steht das Menü der letzten Zeile zur Hälfte
                // außerhalb und die Hälfte, die man braucht, fehlt.
                m.style.left = Math.max(4, Math.min(x, window.innerWidth - m.offsetWidth - 6)) + 'px';
                m.style.top = Math.max(4, Math.min(y, window.innerHeight - m.offsetHeight - 6)) + 'px';
                menuEl = m;
                var first = m.querySelector('.pf-ctx-item');
                if (first) first.focus();
            }
            document.addEventListener('click', function (ev) {
                if (menuEl && !menuEl.contains(ev.target)) closeMenu();
            });
            document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape') closeMenu(); });
            window.addEventListener('resize', closeMenu);
            list.addEventListener('scroll', closeMenu);

            // Nur was es hier wirklich gibt: öffnen, den Inhalt kopieren, und den Standard
            // einsetzen, wo die Seite einen mitgibt. Anlegen, löschen, umbenennen, verschieben,
            // duplizieren und einfügen kann man in einem Template NICHT — seine Dateien sind
            // Spalten des Datensatzes, nicht Einträge in einem Ordner: es gibt keinen Pfad, den man
            // ändern, und keinen Ordner, in den man etwas legen könnte. Ein Menüeintrag dafür würde
            // etwas versprechen, was der Server nicht kennt. Kopieren dagegen betrifft nur den
            // INHALT — das gibt es hier genauso wie im Plugin-Editor.
            function menuFor(o) {
                var items = [];
                // An uploaded asset can be deleted (it is a real file); its content isn't editable here.
                if (o.kind === 'asset' && ASSETS) {
                    items.push({ label: ASSETS.deleteLabel, run: function () { deleteAsset(o.assetId); } });
                    return items;
                }
                if (o.kind !== 'file') return items;
                items.push({ label: TXT.edit, run: function () { open(o.idx, true); } });
                items.push({ label: TXT.copy, run: function () { copyContent(o.idx); } });
                if (FILES[o.idx].insertDefault) items.push({ label: TXT.insertDefault, run: function () { insertDefault(o.idx); } });
                return items;
            }

            // Kopiert wird aus dem FELD, das abgeschickt wird — nicht aus CodeMirror: bei jedem
            // Tastendruck steht dort ohnehin dasselbe, und im Rohmodus gibt es gar keinen Editor.
            // Ohne Zwischenablage (kein sicherer Kontext, altes Gerät) der alte Weg über eine
            // Auswahl; ein Knopf, der stillschweigend nichts tut, wäre schlimmer als keiner.
            function copyContent(i) {
                var text = stores[i].value || '';
                var done = function () { alert(TXT.copied); };
                var fallback = function () {
                    var ta = document.createElement('textarea');
                    ta.value = text;
                    ta.style.position = 'fixed';
                    ta.style.left = '-9999px';
                    document.body.appendChild(ta);
                    ta.select();
                    var ok = false;
                    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
                    ta.remove();
                    if (ok) done();
                    else { open(i, true); showRaw(true); stores[i].select(); }
                };
                if (navigator.clipboard && navigator.clipboard.writeText)
                    navigator.clipboard.writeText(text).then(done, fallback);
                else fallback();
            }

            // ---- Der Editor ------------------------------------------------------------------
            var lastH = 0;
            function refresh() {
                if (!cm || !host || host.hidden || !host.offsetHeight) return;
                lastH = host.offsetHeight;
                cm.refresh();
            }
            function ensureCm() {
                if (cm || !HAS_CM) return cm;
                cm = CodeMirror(host, {
                    lineNumbers: true, autoCloseBrackets: true, matchBrackets: true, styleActiveLine: true,
                    indentUnit: 2, tabSize: 2, lineWrapping: false,
                    extraKeys: { Tab: function (c) { c.replaceSelection('  '); } }
                });
                // DAS ist der Punkt der ganzen Umstellung: jede Änderung geht sofort ins Feld,
                // nicht erst beim Übernehmen. loading deckt nur das programmgesteuerte Laden ab —
                // sonst schriebe das Öffnen einer Datei sich selbst zurück.
                cm.on('change', function () { if (!loading) push(cur, cm.getValue()); });
                return cm;
            }
            // Die Fläche misst sich verborgen als 0 hoch: der Dateireiter ist beim Laden nicht der
            // offene. Statt an fremden Reiterknöpfen zu hängen, wird auf die Größe selbst gehört —
            // das gilt auch fürs Fenster und für jede Seite, die diesen Baum je einbaut.
            if (window.ResizeObserver && host) {
                new ResizeObserver(function () {
                    if (host.offsetHeight && host.offsetHeight !== lastH) refresh();
                }).observe(host);
            }

            // Rohform: dasselbe Feld, unverkleidet. Beim Zurückschalten liest der Editor neu aus
            // dem Feld — wer von Hand daran gearbeitet hat, sieht es auch im Editor, statt beim
            // nächsten Tastendruck von altem Text überschrieben zu werden.
            function showRaw(on) {
                raw = on || !HAS_CM;
                if (rawBtn) rawBtn.setAttribute('aria-pressed', raw ? 'true' : 'false');
                if (host) host.hidden = raw || cur < 0;
                stores.forEach(function (s, i) { s.hidden = !(raw && i === cur); });
                // Die Beschriftungen bleiben weg, sobald das Skript läuft — auch in der Rohform:
                // den Namen der offenen Datei sagt die Menüleiste darüber schon, und unter dem
                // Inhalt gehören nur der Inhalt und die Platzhalter hin.
                heads.forEach(function (h) { h.hidden = true; });
                if (!raw && cur >= 0 && ensureCm()) {
                    loading = true;
                    cm.setValue(stores[cur].value || '');
                    loading = false;
                    refresh();
                }
            }
            if (rawBtn) rawBtn.addEventListener('click', function () {
                showRaw(!raw);
                if (raw && cur >= 0) stores[cur].focus();
                else if (cm) cm.focus();
            });

            // ---- Hochgeladene Dateien (assets-Ordner) ---------------------------------------
            // Blendet alles vom Code-Editor aus, damit an derselben Stelle die Asset- bzw. Upload-
            // Ansicht stehen kann. Der Editor-Zustand (cur, CodeMirror) bleibt unberührt.
            function hideCodeViews() {
                if (host) host.hidden = true;
                stores.forEach(function (s) { s.hidden = true; });
                heads.forEach(function (h) { h.hidden = true; });
                if (empty) empty.hidden = true;
                if (tokBox) tokBox.hidden = true;
                if (insBtn) insBtn.hidden = true;
                if (rawBtn) rawBtn.hidden = true;
                descEl.textContent = '';
            }
            function openAsset(a) {
                if (!assetView) return;
                cur = -1; curAsset = a.id; uploadOpen = false;
                hideCodeViews();
                if (uploadView) uploadView.hidden = true;
                assetView.hidden = false;
                assetView.querySelector('[data-tf-asset-name]').textContent = a.name;
                assetView.querySelector('[data-tf-asset-kind]').textContent = a.kind;
                assetView.querySelector('[data-tf-asset-size]').textContent = a.size || '';
                var img = assetView.querySelector('[data-tf-asset-img]');
                if (a.kind === 'image') { img.src = a.url; img.hidden = false; }
                else { img.hidden = true; img.removeAttribute('src'); }
                assetView.querySelector('[data-tf-asset-tokenlabel]').textContent = ASSETS.tokenLabel;
                assetView.querySelector('[data-tf-asset-token]').value = a.token;
                assetView.querySelector('[data-tf-asset-urllabel]').textContent = ASSETS.urlLabel;
                assetView.querySelector('[data-tf-asset-url]').value = a.url;
                var del = assetView.querySelector('[data-tf-asset-del]');
                del.textContent = ASSETS.deleteLabel;
                del.onclick = function () { deleteAsset(a.id); };
                curEl.textContent = a.name;
                render();
            }
            function openUpload() {
                if (!uploadView) return;
                cur = -1; curAsset = null; uploadOpen = true;
                hideCodeViews();
                if (assetView) assetView.hidden = true;
                uploadView.hidden = false;
                curEl.textContent = ASSETS.folder;
                render();
            }
            // Löschen läuft über das seiteneigene Formular (außerhalb des Speichern-Formulars): die
            // Asset-Id in das versteckte Feld, dann absenden. form.submit() umgeht onsubmit, darum wird
            // hier vorher gefragt.
            function deleteAsset(id) {
                if (!ASSETS || !confirm(ASSETS.confirm)) return;
                var f = document.getElementById(ASSETS.delForm);
                if (!f) return;
                var inp = f.querySelector('[name="' + ASSETS.delInput + '"]') || f.querySelector('input');
                if (inp) inp.value = id;
                f.submit();
            }

            function open(i, focus) {
                cur = i; curAsset = null; uploadOpen = false;
                if (assetView) assetView.hidden = true;
                if (uploadView) uploadView.hidden = true;
                if (rawBtn) rawBtn.hidden = false;
                var m = FILES[i];
                curEl.textContent = m.name;
                descEl.textContent = m.desc || '';
                if (empty) empty.hidden = true;

                tokList.innerHTML = '';
                (m.tokens || []).forEach(function (tk) {
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'cm-token';
                    b.textContent = tk.t;
                    b.title = tk.l;
                    b.addEventListener('click', function () { insertToken(tk.t); });
                    tokList.appendChild(b);
                });
                tokBox.hidden = !(m.tokens && m.tokens.length);
                insBtn.hidden = !m.insertDefault;

                if (!raw && ensureCm()) {
                    loading = true;
                    cm.setOption('mode', m.mode);
                    cm.setValue(stores[i].value || '');
                    cm.clearHistory();
                    loading = false;
                }
                showRaw(raw);
                render();
                if (focus) {
                    if (raw) stores[i].focus();
                    else if (cm) { refresh(); cm.focus(); }
                }
            }

            // Ein Platzhalter landet dort, wo der Cursor steht — im Editor wie im Rohfeld. Ein Knopf,
            // der im Rohfeld nichts täte, wäre schlimmer als keiner.
            function insertToken(text) {
                if (cur < 0) return;
                if (!raw && cm) { cm.replaceSelection(text); cm.focus(); return; }
                var el = stores[cur];
                var a = el.selectionStart, b = el.selectionEnd;
                el.value = el.value.slice(0, a) + text + el.value.slice(b);
                el.selectionStart = el.selectionEnd = a + text.length;
                el.dispatchEvent(new Event('input', { bubbles: true }));
                el.focus();
                badges();
            }

            // Der Standard ersetzt, was da ist — deshalb wird gefragt, sobald etwas Eigenes darin
            // steht. Im Dialog war das noch durch "Abbrechen" zurückzuholen; ohne Dialog muss die
            // Frage vorher kommen.
            function insertDefault(i) {
                var m = FILES[i];
                if (!m.insertDefault) return;
                var v = norm(stores[i].value).trim();
                if (v !== '' && v !== norm(m.insertDefault).trim()
                    && !confirm(TXT.insertConfirm + '\n\n' + m.name)) return;
                if (cur !== i) open(i, true);
                if (!raw && cm) cm.setValue(m.insertDefault);
                else push(i, m.insertDefault);
            }
            if (insBtn) insBtn.addEventListener('click', function () { if (cur >= 0) insertDefault(cur); });

            // Von Hand im Rohfeld getippt: das Abzeichen im Baum zieht mit. Geschrieben wird nichts
            // — das Feld IST der Stand.
            stores.forEach(function (s) { s.addEventListener('input', badges); });

            // Ohne Skript stehen alle Rohfelder offen; mit Skript zeigt der Baum eine Datei. Erst
            // hier verstecken, nicht im Markup: fällt das Skript aus, bleibt alles erreichbar.
            showRaw(raw);
            render();
            // Die erste Datei ist offen, aber ohne Fokus: der Reiter ist beim Laden womöglich gar
            // nicht der sichtbare, und ein Editor, der sich den Fokus nimmt, reißt die Seite dorthin.
            open(0, false);
        }
    })();
</script>
