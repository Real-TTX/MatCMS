@page "/anmelden"
@model MatCMS.Pages.AnmeldenModel
@{
    ViewData["Title"] = "Anmelden";
    if (Model.HasCustom) { Layout = null; }
}
@if (Model.HasCustom)
{
    @* The template defines its own login page: render it standalone, no site header/nav. The form
       replaces {{login_form}}; the template's CSS/JS are injected so styling and scripts (e.g. a
       counter) work here too. *@
    <!DOCTYPE html>
    <html lang="de">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Anmelden – @Model.SiteName</title>
        <style>@Html.Raw(MatCMS.Shared.Web.LocalFonts.Rewrite(Model.CustomCss))</style>
    </head>
    <body>
        @Html.Raw(MatCMS.Shared.Web.LocalFonts.Rewrite(Model.CustomBefore))
        <form class="login-form" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <input class="login-user" name="username" placeholder="Benutzername eingeben…" autocomplete="username" required />
            <input class="login-pass" name="password" type="password" placeholder="Kennwort eingeben…" autocomplete="current-password" required />
            <button class="login-submit" type="submit">Anmelden</button>
        </form>
        @Html.Raw(MatCMS.Shared.Web.LocalFonts.Rewrite(Model.CustomAfter))
        <script>
            (function () {
                if (window.__cuInit) return; window.__cuInit = true;
                function pad2(n) { return (n < 10 ? '0' : '') + n; }
                function cards(str) { var h = ''; for (var i = 0; i < str.length; i++) h += '<span class="fc-d">' + str[i] + '</span>'; return h; }
                function tick() {
                    document.querySelectorAll('[data-countup]').forEach(function (el) {
                        var t = new Date((el.getAttribute('data-date') || '').trim().replace(' ', 'T')).getTime();
                        if (isNaN(t)) return;
                        var diff = el.getAttribute('data-mode') === 'down' ? (t - Date.now()) : (Date.now() - t);
                        if (diff < 0) diff = 0;
                        var s = Math.floor(diff / 1000), d = Math.floor(s / 86400); s -= d * 86400;
                        var h = Math.floor(s / 3600); s -= h * 3600; var m = Math.floor(s / 60); s -= m * 60;
                        var sep = '<span class="fc-c">:</span>';
                        el.innerHTML = cards(String(d)) + sep + cards(pad2(h)) + sep + cards(pad2(m)) + sep + cards(pad2(s));
                    });
                }
                tick(); setInterval(tick, 1000);
            })();
        </script>
        <script>@Html.Raw(Model.CustomJs)</script>
    </body>
    </html>
}
else
{
    <partial name="_MemberAuthStyle" />
    <section class="member-auth">
        <div class="member-auth-card">
            <h1>Anmelden</h1>
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <p class="member-auth-error">@Model.Error</p>
            }
            @if (Model.LoggedIn)
            {
                <p>Angemeldet als <strong>@Model.MemberName</strong>.</p>
                <form method="post" asp-page-handler="Logout">
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn">Abmelden</button>
                    <a class="btn btn-ghost" href="/">Zur Startseite</a>
                </form>
            }
            else
            {
                <form method="post">
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <label class="member-auth-field">
                        <span>Benutzername oder E-Mail-Adresse</span>
                        <input name="username" autocomplete="username" required autofocus />
                    </label>
                    <label class="member-auth-field">
                        <span>Passwort</span>
                        <input name="password" type="password" autocomplete="current-password" required />
                    </label>
                    <label class="member-auth-remember">
                        <input type="checkbox" name="remember" value="true" /> Angemeldet bleiben
                    </label>
                    <button type="submit" class="btn">Anmelden</button>
                </form>
                <p class="member-auth-links">
                    <a href="/anmelden/vergessen">Passwort vergessen?</a>
                    @if (Model.CanRegister)
                    {
                        <a href="/registrieren@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : "?returnUrl=" + System.Net.WebUtility.UrlEncode(Model.ReturnUrl))">Konto anlegen</a>
                    }
                </p>
            }
        </div>
    </section>
}
