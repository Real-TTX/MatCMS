@page
@model MatCMS.Cloud.Pages.Admin.Settings.IndexModel
@using MatCMS.Cloud.Services
@{
    ViewData["Title"] = T["settings.title"];
}
<div class="page-head">
    <h1>@T["settings.title"]</h1>
</div>

<div class="tabs" role="tablist">
    <button type="button" class="tab active" data-tab="general">@T["settings.tabGeneral"]</button>
    <button type="button" class="tab" data-tab="smtp">@T["settings.tabSmtp"]</button>
    <button type="button" class="tab" data-tab="ai">@T["settings.tabAi"]</button>
    <button type="button" class="tab" data-tab="api">@T["settings.tabApi"]</button>
    <button type="button" class="tab" data-tab="logs">@T["logs.title"]</button>
    <button type="button" class="tab" data-tab="config">@T["cfgbackup.tab"]</button>
</div>

@* ============ PROTOKOLL ============ *@
@* The log page only SHOWS; what the cloud records and how long it keeps it is configured here. *@
<div class="tab-panel" data-panel="logs" hidden>
    <form method="post" asp-page-handler="Logs">
        <div class="card">
            <h2>@T["logs.title"]</h2>
            <label class="checkbox-row">
                <input type="checkbox" name="requestsOn" value="true" checked="@(Model.Get(SettingKeys.LogRequests) == "on" ? "checked" : null)" />
                @T["logs.cfg.requests"]
            </label>
            <div class="help">@T["logs.cfg.requests.help"]</div>
            <div class="form-grid">
                <div class="form-row">
                    <div class="form-field">
                        <label for="errorsDays">@T["logs.cfg.retentionErrors"]</label>
                        <input type="number" id="errorsDays" name="errorsDays" min="0" max="3650" value="@Model.Days(SettingKeys.LogRetentionErrorsDays, 90)" />
                    </div>
                    <div class="form-field">
                        <label for="requestsDays">@T["logs.cfg.retentionRequests"]</label>
                        <input type="number" id="requestsDays" name="requestsDays" min="0" max="3650" value="@Model.Days(SettingKeys.LogRetentionRequestsDays, 14)" />
                    </div>
                </div>
            </div>
            <div class="help">@T["logs.cfg.retention.help"]</div>
            <div style="margin-top:14px;"><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
</div>

@* ============ GENERAL ============ *@
<div class="tab-panel" data-panel="general">
    <form method="post" asp-page-handler="General">
        <div class="card">
            <h2>@T["settings.general"]</h2>
            <div class="form-field">
                <label>@T["settings.cloudName"]</label>
                <input name="cloudName" value="@Model.Get(SettingKeys.CloudName)" />
            </div>
            <div class="form-field">
                <label>URL</label>
                <input name="canonicalUrl" value="@Model.Get(SettingKeys.CanonicalUrl)" placeholder="https://cloud.beispiel.de" spellcheck="false" />
                <div class="help">@T["settings.canonicalUrlHint"]</div>
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="forceHttps" value="true" checked="@(Model.Flag(SettingKeys.ForceHttpsUrls) ? "checked" : null)" />
                @T["settings.forceHttps"]
            </label>
            <div class="help">@T["settings.forceHttpsHint"]</div>
            <div><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>

    @* Sicherheit gehört zum Allgemeinen — eigene Karte, eigenes Formular, damit ein Speichern hier nie die
       übrigen Schlüssel anfasst. *@
    <form method="post" asp-page-handler="Security">
        <div class="card">
            <h2>@T["settings.securityHeading"]</h2>
            <label class="checkbox-row">
                <input type="checkbox" name="require2fa" value="true" checked="@(Model.Flag(SettingKeys.Require2fa) ? "checked" : null)" />
                @T["settings.require2fa"]
            </label>
            <div class="help">@T["settings.require2faHelp"]</div>
            <div style="margin-top:14px;"><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
</div>

@* ============ API ============ *@
<div class="tab-panel" data-panel="api" hidden>
    <partial name="_ApiKeyList" model="Model.ApiKeys" />

    @* ChatGPT (or another client) connecting TO this cloud through the OAuth connector — access to the cloud, like the keys above;
       the opposite direction of the KI tab, where the cloud calls a provider. *@
    <div class="card">
        <h2>@T["settings.connectHeading"]</h2>
        <div class="actions" style="margin:8px 0 4px;">
            <a class="btn" asp-page="/Admin/OAuthClients/Index">@T["settings.connectClientsBtn"]</a>
        </div>
    </div>
</div>

@* ============ SMTP ============ *@
<div class="tab-panel" data-panel="smtp" hidden>
    <form method="post" asp-page-handler="Smtp">
        <div class="card">
            <h2>@T["settings.smtpHeading"]</h2>
            <div class="form-grid">
                <div class="form-row">
                    <div class="form-field">
                        <label>@T["settings.smtpHost"]</label>
                        <input name="host" value="@Model.Get(SettingKeys.SmtpHost)" spellcheck="false" />
                    </div>
                    <div class="form-field">
                        <label>@T["settings.smtpPort"]</label>
                        <input name="port" value="@Model.Get(SettingKeys.SmtpPort)" placeholder="587" inputmode="numeric" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label>@T["settings.smtpUser"]</label>
                        <input name="user" value="@Model.Get(SettingKeys.SmtpUser)" spellcheck="false" />
                    </div>
                    <div class="form-field">
                        <label>@T["settings.smtpPassword"]</label>
                        <input name="password" type="password" autocomplete="new-password" placeholder="@T["settings.smtpPasswordKeep"]" />
                        @* An empty field means "keep", so without this there is no way to get rid of a
                           stored password at all — the operator could only ever replace it. *@
                        @if (!string.IsNullOrEmpty(Model.Get(SettingKeys.SmtpPassword)))
                        {
                            <label class="checkbox-row">
                                <input type="checkbox" name="clearPassword" value="true" />
                                @T["settings.smtpPasswordClear"]
                            </label>
                        }
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label>@T["settings.smtpFromEmail"]</label>
                        <input name="fromEmail" value="@Model.Get(SettingKeys.SmtpFromEmail)" spellcheck="false" />
                    </div>
                    <div class="form-field">
                        <label>@T["settings.smtpFromName"]</label>
                        <input name="fromName" value="@Model.Get(SettingKeys.SmtpFromName)" />
                    </div>
                </div>
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="ssl" value="true" checked="@(Model.Flag(SettingKeys.SmtpSsl) ? "checked" : null)" />
                @T["settings.smtpSsl"]
            </label>
            <div><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>

    <div class="card">
        <h2>@T["settings.smtpTest"]</h2>
        <form method="post" asp-page-handler="SmtpTest">
            <div class="form-field">
                <label>@T["settings.smtpTestTo"]</label>
                <input name="testTo" type="email" placeholder="test@@beispiel.de" spellcheck="false" />
                <div class="help">@T["settings.smtpTestHint"]</div>
            </div>
            <div><button type="submit" class="btn btn-ghost">@T["settings.smtpTestSend"]</button></div>
        </form>
    </div>
</div>

@* ============ KI (AI) ============ *@
<div class="tab-panel" data-panel="ai" hidden>
    @{ var aiActive = Model.AiProfiles.Active; }
    <div class="card">
        <h2>@T["aiprof.live"]</h2>
        <div class="kv">
            <div class="kv-label">@T["aiprof.profile"]</div>
            <div class="kv-value">
                @if (aiActive is not null) { <span class="badge @(Model.AiLive.IsConfigured ? "badge-on" : "badge-err")">@aiActive.Name</span> }
                else if (Model.AiLive.IsConfigured) { <span class="badge badge-on">@T["aiprof.ownLive"]</span> }
                else { <span class="badge badge-err">@T["aiprof.none"]</span> }
            </div>
        </div>
        @if (Model.AiLive.IsConfigured)
        {
            <div class="kv">
                <div class="kv-label">@T["settings.aiModel"]</div>
                <div class="kv-value"><span class="mono">@Model.AiLive.Model</span> <span class="muted">· @(Model.AiLive.IsChatGpt ? T["settings.aiProviderChatGpt"] : new Uri(Model.AiLive.BaseUrl).Host)</span></div>
            </div>
        }
        <form method="post" asp-page-handler="AiTest" class="form-actions">
            <button type="submit" class="btn btn-ghost btn-sm">@T["settings.aiTest"]</button>
            <span class="help">@T["settings.aiTestHint"]</span>
        </form>
    </div>

    <div class="card">
        <h2>@T["aiprof.title"]</h2>
        <div class="help">@T["aiprof.help"]</div>
        <table class="data">
            <thead><tr><th>@T["aiprof.name"]</th><th>@T["aiprof.kind"]</th><th>@T["settings.aiModel"]</th><th style="width:240px;"></th></tr></thead>
            <tbody>
                @if (Model.AiProfiles.Profiles.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["aiprof.empty"]' />
                }
                @foreach (var pr in Model.AiProfiles.Profiles)
                {
                    var isActive = pr.Id == Model.AiProfiles.ActiveId;
                    <tr>
                        <td><a asp-page="AiProfile" asp-route-id="@pr.Id"><strong>@pr.Name</strong></a></td>
                        <td>@(pr.Kind == "chatgpt" ? T["aiprof.kindChatGpt"] : T["aiprof.kindKey"])</td>
                        <td><span class="mono">@pr.Model</span>@if (pr.Kind == "chatgpt") { <div class="muted">@(Model.AiAccounts.TryGetValue(pr.Id, out var acc) ? T["aiprof.signedInAs", acc] : T["aiprof.notSignedIn"])</div> }</td>
                        <td>
                            <div class="actions">
                                @if (isActive)
                                {
                                    <span class="badge badge-on">@T["aiprof.active"]</span>
                                }
                                else
                                {
                                    <form class="inline-form" method="post" asp-page-handler="AiActivate" asp-route-id="@pr.Id" data-confirm="@T["aiprof.activateConfirm", pr.Name]">
                                        <button type="submit" class="btn btn-sm">@T["aiprof.activate"]</button>
                                    </form>
                                }
                                <a class="btn btn-sm btn-ghost" asp-page="AiProfile" asp-route-id="@pr.Id">@T["action.edit"]</a>
                                @if (!isActive)
                                {
                                    <form class="inline-form" method="post" asp-page-handler="AiDelete" asp-route-id="@pr.Id" data-confirm="@T["aiprof.deleteConfirm", pr.Name]">
                                        <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="list-actions">
            <a class="btn" asp-page="AiProfile">@T["aiprof.new"]</a>
        </div>
    </div>

    @* Verbrauch: cloud-weit + pro Instanz, laufender Monat (aus dem AiUsage-Ledger). *@
    <div class="card">
        <h2>@T["settings.aiUsage"] · @Model.AiPeriod</h2>
        <div class="kv">
            <div class="kv-label">@T["settings.aiUsageTotal"]</div>
            <div class="kv-value">@Model.AiTokensTotal.ToString("N0") @T["settings.aiUsageTokens"] · @Model.AiCallsTotal @T["settings.aiUsageCalls"]</div>
        </div>
        @if (Model.AiUsage.Count > 0)
        {
            <table class="data" style="margin-top:10px;">
                <thead><tr><th>@T["common.instance"]</th><th>@T["settings.aiUsageTokens"]</th><th>@T["settings.aiUsageCalls"]</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.AiUsage)
                    {
                        <tr><td>@r.Instance</td><td class="mono">@r.Tokens.ToString("N0")</td><td class="mono">@r.Calls</td></tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="muted">@T["settings.aiUsageEmpty"]</p>
        }
    </div>

</div>

@* ============ SICHERUNG ============ *@
@* Backups of the cloud's OWN configuration (not of the sites): download here, upload on another cloud, restore. The
   same service as /api/v1/cloud/config-backups and the MCP tools. *@
@{
    var cfgSections = MatCMS.Cloud.Services.CloudConfigBackupService.AllSections;
    var cfgDefault = MatCMS.Cloud.Services.CloudConfigBackupService.DefaultRestoreSections;
}
<div class="tab-panel" data-panel="config" hidden>
    @if (Model.ConfigReportTitle is { } rt)
    {
        <div class="card">
            <h2>@rt</h2>
            <ul style="margin:0;padding-left:1.2rem;">
                @foreach (var line in Model.ConfigReport) { <li>@line</li> }
            </ul>
        </div>
    }

    <form method="post" asp-page-handler="ConfigCreate">
        <div class="card">
            <h2>@T["cfgbackup.create"]</h2>
            <div class="help">@T["cfgbackup.createHint"]</div>
            <div class="form-field">
                <label>@T["cfgbackup.sections"]</label>
                @foreach (var s in cfgSections)
                {
                    <label class="checkbox-row"><input type="checkbox" name="sections" value="@s" checked /> @T["cfgbackup.section." + s]</label>
                }
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label for="cfgPass">@T["cfgbackup.passphrase"]</label>
                    <input id="cfgPass" name="passphrase" type="password" autocomplete="new-password" minlength="8" />
                    <div class="help">@T["cfgbackup.passphraseHint"]</div>
                </div>
                <div class="form-field">
                    <label for="cfgNote">@T["cfgbackup.note"]</label>
                    <input id="cfgNote" name="note" placeholder="@T["cfgbackup.notePlaceholder"]" />
                </div>
            </div>
            <div class="list-actions"><button type="submit" class="btn">@T["cfgbackup.createBtn"]</button></div>
        </div>
    </form>

    <div class="card">
        <h2>@T["cfgbackup.list"]</h2>
        <table class="data">
            <thead><tr><th>@T["cfgbackup.file"]</th><th>@T["cfgbackup.source"]</th><th>@T["cfgbackup.sections"]</th><th style="width:230px;"></th></tr></thead>
            <tbody>
                @if (Model.ConfigBackups.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["cfgbackup.none"]' />
                }
                @foreach (var b in Model.ConfigBackups)
                {
                    <tr>
                        <td>
                            <span class="mono">@b.Id</span>
                            <div class="muted">@b.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @((b.Size / 1024.0).ToString("0")) KB</div>
                            @if (b.Note is { } note) { <div class="muted">@note</div> }
                        </td>
                        <td>@b.Source <div class="muted mono">@b.Version</div></td>
                        <td>
                            @string.Join(", ", b.Sections.Select(s => T["cfgbackup.short." + s].ToString()))
                            <div><span class="badge @(b.HasSecrets ? "badge-on" : "badge-off")">@(b.HasSecrets ? T["cfgbackup.withSecrets"] : T["cfgbackup.withoutSecrets"])</span></div>
                        </td>
                        <td>
                            <div class="actions">
                                <a class="btn btn-sm btn-ghost" href="@Url.Page("/Admin/Settings/Index", "ConfigDownload", new { id = b.Id })">@T["cfgbackup.download"]</a>
                                <button type="button" class="btn btn-sm btn-ghost" data-cfg-restore="@b.Id" data-cfg-sections="@string.Join(",", b.Sections)" data-cfg-secrets="@(b.HasSecrets ? "1" : "0")">@T["cfgbackup.restore"]</button>
                                <form class="inline-form" method="post" asp-page-handler="ConfigDelete" asp-route-id="@b.Id" data-confirm="@T["cfgbackup.deleteConfirm", b.Id]">
                                    <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <form method="post" asp-page-handler="ConfigUpload" enctype="multipart/form-data" style="margin-top:12px;">
            <div class="form-field">
                <label for="cfgFile">@T["cfgbackup.upload"]</label>
                <input id="cfgFile" type="file" name="file" accept=".zip,application/zip" required />
                <div class="help">@T["cfgbackup.uploadHint"]</div>
            </div>
            <div class="list-actions"><button type="submit" class="btn btn-ghost">@T["cfgbackup.uploadBtn"]</button></div>
        </form>
    </div>

    @* Restore: one form for preview and apply — the preview changes nothing; apply asks first. *@
    <form method="post" asp-page-handler="ConfigRestore" data-cfg-form hidden>
        <input type="hidden" name="id" value="" />
        <div class="card">
            <h2>@T["cfgbackup.restoreTitle"] <span class="mono" data-cfg-name></span></h2>
            <div class="help">@T["cfgbackup.restoreHint"]</div>
            <div class="form-field">
                <label>@T["cfgbackup.sections"]</label>
                @foreach (var s in cfgSections)
                {
                    <label class="checkbox-row" data-cfg-section="@s"><input type="checkbox" name="sections" value="@s" checked="@(cfgDefault.Contains(s) ? "checked" : null)" /> @T["cfgbackup.section." + s]@(s == "hosting" ? " – " + T["cfgbackup.hostingWarn"] : "")</label>
                }
            </div>
            <div class="form-field" data-cfg-pass>
                <label for="cfgRestorePass">@T["cfgbackup.passphrase"]</label>
                <input id="cfgRestorePass" name="passphrase" type="password" autocomplete="off" />
                <div class="help">@T["cfgbackup.restorePassHint"]</div>
            </div>
            <div class="list-actions">
                <button type="submit" class="btn btn-ghost" name="apply" value="false">@T["cfgbackup.preview"]</button>
                <button type="submit" class="btn" name="apply" value="true" data-confirm="@T["cfgbackup.applyConfirm"]">@T["cfgbackup.apply"]</button>
                <button type="button" class="btn btn-ghost" data-cfg-cancel>@T["action.cancel"]</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Tabs — identical to MatCMS's settings page, including the ?tab=<name> deep link that every
        // handler redirects back to.
        (function () {
            var tabs = document.querySelectorAll('.tab');
            var panels = document.querySelectorAll('.tab-panel');
            function show(name) {
                tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.tab === name); });
                panels.forEach(function (p) { p.hidden = p.dataset.panel !== name; });
            }
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
            var want = new URLSearchParams(location.search).get('tab');
            if (want) show(want);

            // Sicherung: "Wiederherstellen" opens the restore form for that backup — only its sections are offered, the
            // passphrase only when it holds secrets.
            var cfgForm = document.querySelector('[data-cfg-form]');
            document.addEventListener('click', function (e) {
                var b = e.target.closest('[data-cfg-restore],[data-cfg-cancel]');
                if (!b || !cfgForm) return;
                if (b.hasAttribute('data-cfg-cancel')) { cfgForm.hidden = true; return; }
                var has = (b.getAttribute('data-cfg-sections') || '').split(',');
                cfgForm.querySelector('[name=id]').value = b.getAttribute('data-cfg-restore');
                cfgForm.querySelector('[data-cfg-name]').textContent = b.getAttribute('data-cfg-restore');
                cfgForm.querySelectorAll('[data-cfg-section]').forEach(function (row) {
                    var on = has.indexOf(row.getAttribute('data-cfg-section')) >= 0;
                    // .checkbox-row sets display, which beats the hidden attribute — hide it explicitly.
                    row.style.display = on ? '' : 'none';
                    row.querySelector('input').disabled = !on;
                });
                cfgForm.querySelector('[data-cfg-pass]').hidden = b.getAttribute('data-cfg-secrets') !== '1';
                cfgForm.hidden = false;
                cfgForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        })();
    </script>
}
