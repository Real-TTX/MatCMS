@inject MatCMS.Services.SiteContext Site
@{
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrWhiteSpace(title) ? Site.SiteName : $"{title} – {Site.SiteName}";
    var metaDescription = ViewData["MetaDescription"] as string;

    // ---- Active template (theme) ----
    var tpl = Site.ActiveTemplate;

    // Build the Google Fonts URL from the template's font families (dedup, weights 400-700).
    string FontQuery(string family) =>
        Uri.EscapeDataString(family.Trim()).Replace("%20", "+") + ":wght@400;500;600;700";
    var families = new List<string>();
    if (!string.IsNullOrWhiteSpace(tpl.HeadingFont)) families.Add(tpl.HeadingFont.Trim());
    if (!string.IsNullOrWhiteSpace(tpl.BodyFont) &&
        !string.Equals(tpl.BodyFont.Trim(), tpl.HeadingFont?.Trim(), StringComparison.OrdinalIgnoreCase))
        families.Add(tpl.BodyFont.Trim());
    if (families.Count == 0) families.Add("Inter");
    var fontsHref = "https://fonts.googleapis.com/css2?" +
        string.Join("&", families.Select(f => "family=" + FontQuery(f))) + "&display=swap";

    // Accent + a slightly darker shade for --accent-dark.
    var accent = string.IsNullOrWhiteSpace(tpl.AccentColor) ? "#de7e11" : tpl.AccentColor.Trim();
    string Darken(string hex)
    {
        var h = hex.TrimStart('#');
        if (h.Length == 3)
            h = string.Concat(h[0], h[0], h[1], h[1], h[2], h[2]);
        if (h.Length != 6 ||
            !int.TryParse(h.Substring(0, 2), System.Globalization.NumberStyles.HexNumber, null, out var r) ||
            !int.TryParse(h.Substring(2, 2), System.Globalization.NumberStyles.HexNumber, null, out var g) ||
            !int.TryParse(h.Substring(4, 2), System.Globalization.NumberStyles.HexNumber, null, out var b))
            return hex;
        r = (int)(r * 0.85); g = (int)(g * 0.85); b = (int)(b * 0.85);
        return $"#{r:x2}{g:x2}{b:x2}";
    }
    var accentDark = Darken(accent);

    var headFamily = string.IsNullOrWhiteSpace(tpl.HeadingFont) ? "Geologica" : tpl.HeadingFont.Trim();
    var bodyFamily = string.IsNullOrWhiteSpace(tpl.BodyFont) ? "Inter" : tpl.BodyFont.Trim();
    var outlineButtons = string.Equals(tpl.ButtonStyle?.Trim(), "outline", StringComparison.OrdinalIgnoreCase);

    // Extended theme values (defaults match the built-in look → unset = no visual change).
    string ColorOr(string? v, string fb) => string.IsNullOrWhiteSpace(v) ? fb : v.Trim();
    string Px(string? v, string fb) => System.Text.RegularExpressions.Regex.IsMatch((v ?? "").Trim(), @"^\d+$") ? v!.Trim() + "px" : fb;
    var headingColor = ColorOr(tpl.HeadingColor, "#010101");
    var textColor = ColorOr(tpl.TextColor, "#1a1a1a");
    var bgColor = ColorOr(tpl.BackgroundColor, "#ffffff");
    var altBg = ColorOr(tpl.AltBackground, "#f6f7f9");
    var accent2 = ColorOr(tpl.SecondaryColor, accent);
    var containerW = Px(tpl.ContainerWidth, "1180px");
    var btnRadius = Px(tpl.ButtonRadius, "0px");
    var headerBg = (tpl.HeaderBackground ?? "").Trim();
    var headerText = (tpl.HeaderTextColor ?? "").Trim();
    var headerPad = Px(tpl.HeaderPadding, "16px");

    // Capture the page body once, so it can go into either the default or a custom body layout.
    var bodyWriter = new System.IO.StringWriter();
    RenderBody().WriteTo(bodyWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
    var contentHtml = bodyWriter.ToString();

    // Advanced: a custom HTML body layout (only used when it actually contains {{content}}).
    var useCustomLayout = !string.IsNullOrWhiteSpace(tpl.LayoutHtml) && tpl.LayoutHtml.Contains("{{content}}");
    var customBody = "";
    if (useCustomLayout)
    {
        string Enc(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");
        string Link(MatCMS.Models.MenuItem mi) =>
            $"<a href=\"{Enc(mi.Url)}\"{(mi.OpenInNewTab ? " target=\"_blank\" rel=\"noopener\"" : "")}>{Enc(mi.Label)}</a>";
        var globals = new Dictionary<string, string>
        {
            ["content"] = contentHtml,
            ["logo"] = $"<img src=\"{Enc(Site.LogoUrl)}\" alt=\"{Enc(Site.SiteName)}\" />",
            ["site_name"] = Enc(Site.SiteName),
            ["footer_text"] = Enc(Site.FooterText),
            ["year"] = DateTime.UtcNow.Year.ToString(),
            // Back-compat whole-menu placeholders.
            ["nav"] = string.Concat(Site.HeaderMenu.Select(Link)),
            ["footer_nav"] = string.Concat(Site.FooterMenu.Select(Link)),
            ["toolbar"] = string.Concat(Site.ToolbarMenu.Select(t =>
                $"<a class=\"hicon\" href=\"{Enc(t.Url)}\"{(t.OpenInNewTab ? " target=\"_blank\" rel=\"noopener\"" : "")} title=\"{Enc(t.Label)}\">{MatCMS.Content.MenuIcons.IconMarkup(t.Icon)}</a>")),
        };
        var menuMap = MatCMS.Content.LayoutRenderer.ParseMap(tpl.MenuMapJson);
        customBody = MatCMS.Content.LayoutRenderer.Render(tpl.LayoutHtml, globals, menuMap, key => Site.MenuItems(key));
    }
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="@fontsHref" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/tabler-icons/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --accent: @accent;
            --accent-dark: @accentDark;
            --accent-2: @accent2;
            --black: @headingColor;
            --ink: @textColor;
            --bg: @bgColor;
            --bg-alt: @altBg;
            --max: @containerW;
            --btn-radius: @btnRadius;
            --font-head: "@headFamily", "Inter", sans-serif;
            --font-body: "@bodyFamily", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        body { background: var(--bg); color: var(--ink); }
        .btn { border-radius: var(--btn-radius); }
        .header-inner { padding-top: @headerPad; padding-bottom: @headerPad; }
        @if (!string.IsNullOrEmpty(headerBg))
        {
            @Html.Raw($".site-header {{ background: {headerBg}; backdrop-filter: none; -webkit-backdrop-filter: none; }}")
        }
        @if (!string.IsNullOrEmpty(headerText))
        {
            @Html.Raw($".main-nav a {{ color: {headerText}; }}")
        }
        @if (outlineButtons)
        {
            @Html.Raw(".btn { background: transparent; color: var(--accent); border: 2px solid var(--accent); }")
            @Html.Raw(".btn:hover { background: var(--accent); color: #fff; }")
        }
    </style>
    @if (!string.IsNullOrWhiteSpace(tpl.CustomCss))
    {
        <style>@Html.Raw(tpl.CustomCss)</style>
    }
    <link rel="icon" href="@Site.FaviconUrl" />
    @{
        // GA4: derive a safe measurement id (letters/digits/-/_ only) and emit the standard snippet.
        var gaId = new string((Site.AnalyticsGa4 ?? "").Trim().Where(ch => char.IsLetterOrDigit(ch) || ch is '-' or '_').ToArray());
    }
    @if (!string.IsNullOrEmpty(gaId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){ dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', '@Html.Raw(gaId)');
        </script>
    }
    @foreach (var f in Site.PluginAutoIncludes.Where(f => f.EndsWith(".css", StringComparison.OrdinalIgnoreCase)))
    {
        <link rel="stylesheet" href="/plugin-assets/@f" />
    }
    @if (!string.IsNullOrWhiteSpace(Site.HeadCode))
    {
        @Html.Raw(Site.HeadCode)
    }
</head>
<body>
@if (!string.IsNullOrWhiteSpace(Site.BodyStartCode))
{
    @Html.Raw(Site.BodyStartCode)
}
@if (useCustomLayout)
{
    @Html.Raw(customBody)
}
else
{
    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" href="/">
                <img src="@Site.LogoUrl" alt="@Site.SiteName" />
            </a>
            <div class="header-icons">
                @foreach (var t in Site.ToolbarMenu)
                {
                    <a class="hicon" href="@t.Url" target="@(t.OpenInNewTab ? "_blank" : null)" rel="@(t.OpenInNewTab ? "noopener" : null)"
                       title="@t.Label" aria-label="@t.Label">
                        <i class="ti ti-@MatCMS.Content.MenuIcons.Resolve(t.Icon)" aria-hidden="true"></i>
                    </a>
                }
            </div>
            <input type="checkbox" id="nav-toggle" class="nav-toggle" />
            <label for="nav-toggle" class="nav-toggle-label" aria-label="Menü">
                <span></span><span></span><span></span>
            </label>
            <nav class="main-nav">
                @foreach (var m in Site.HeaderMenu)
                {
                    <a href="@m.Url" target="@(m.OpenInNewTab ? "_blank" : null)" rel="@(m.OpenInNewTab ? "noopener" : null)">@m.Label</a>
                }
                @{
                    var langLinks = Site.LanguageLinks();
                }
                @if (langLinks.Count > 1)
                {
                    <span class="lang-switch" aria-label="@T["nav.language"]">
                        @foreach (var l in langLinks)
                        {
                            <a href="@l.Url" hreflang="@l.Locale" class="@(l.IsCurrent ? "lang-current" : null)"
                               aria-current="@(l.IsCurrent ? "true" : null)">@l.Locale.ToUpperInvariant()</a>
                        }
                    </span>
                }
            </nav>
        </div>
    </header>

    <main>
        @Html.Raw(contentHtml)
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <nav class="footer-nav">
                @foreach (var m in Site.FooterMenu)
                {
                    <a href="@m.Url" target="@(m.OpenInNewTab ? "_blank" : null)" rel="@(m.OpenInNewTab ? "noopener" : null)">@m.Label</a>
                }
            </nav>
            <div class="footer-brand">
                <img src="@Site.LogoUrl" alt="@Site.SiteName" />
            </div>
            @if (!string.IsNullOrWhiteSpace(Site.FooterText))
            {
                <p class="footer-text">@Site.FooterText</p>
            }
        </div>
    </footer>
}

    <script src="~/js/gallery.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (!string.IsNullOrWhiteSpace(tpl.CustomJs))
    {
        <script>@Html.Raw(tpl.CustomJs)</script>
    }
    @foreach (var f in Site.PluginAutoIncludes.Where(f => f.EndsWith(".js", StringComparison.OrdinalIgnoreCase)))
    {
        <script src="/plugin-assets/@f" defer></script>
    }
    @if (!string.IsNullOrWhiteSpace(Site.BodyEndCode))
    {
        @Html.Raw(Site.BodyEndCode)
    }
</body>
</html>
