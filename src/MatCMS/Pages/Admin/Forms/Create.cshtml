@page
@model MatCMS.Pages.Admin.Forms.CreateModel
@{
    ViewData["Title"] = T["forms.new"];
}
@* Nur die Überschrift: der Weg zurück steht unten neben dem Anlegen-Knopf, wie im Plugin-Editor. *@
<div class="page-head">
    <h1>@T["forms.new"]</h1>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" class="form-grid">
        <div class="form-row">
            <div class="form-field">
                <label for="Name">@T["forms.nameField"]</label>
                <input id="Name" name="Name" value="@Model.Name" required autofocus />
            </div>
            <div class="form-field">
                <label for="Slug">@T["forms.slugOptional"]</label>
                <input id="Slug" name="Slug" value="@Model.Slug" placeholder="@T["forms.slugPlaceholder"]" />
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">@T["forms.createAndEdit"]</button>
            <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
        </div>
    </form>
</div>
