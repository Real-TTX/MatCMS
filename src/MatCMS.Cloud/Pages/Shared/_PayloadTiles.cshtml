@model MatCMS.Cloud.Pages.Shared.PayloadTileList
@inject MatCMS.Cloud.Services.Localizer T
@*
    Tile view for a payload list. Sits next to the [data-list-table] inside the same [data-list];
    admin-list.js shows exactly one of the two and remembers the choice per data-list-key.
*@
<div class="payload-tiles" data-list-tiles>
    @if (Model.Items.Count == 0)
    {
        <div class="list-empty payload-tiles-empty">@T[Model.EmptyKey]</div>
    }
    @foreach (var tile in Model.Items)
    {
        <a class="payload-tile" href="@tile.Href" data-search="@tile.Search">
            @* A rendered thumbnail where there is one; the colour strip is the fallback. *@
            @if (!string.IsNullOrWhiteSpace(tile.PreviewUrl))
            {
                <span class="payload-tile-shot">
                    <iframe src="@tile.PreviewUrl" title="@tile.Title" loading="lazy" tabindex="-1" scrolling="no"></iframe>
                </span>
            }
            else if (!string.IsNullOrWhiteSpace(tile.Accent))
            {
                <span class="payload-tile-strip" style="background:@tile.Accent;"></span>
            }
            <span class="payload-tile-head">
                <strong>@tile.Title</strong>
                @if (tile.IsGlobal)
                {
                    <span class="badge badge-off">@T["profiles.fromStore"]</span>
                }
                @if (!string.IsNullOrWhiteSpace(tile.NoteKey))
                {
                    <span class="badge badge-new">@T[tile.NoteKey]</span>
                }
            </span>
            @if (!string.IsNullOrWhiteSpace(tile.Sub))
            {
                <span class="payload-tile-sub muted">@tile.Sub</span>
            }
        </a>
    }
</div>
