@page
@model MatCMS.Cloud.Pages.Admin.Hosting.DockerModel
@using MatCMS.Cloud.Services
@{
    ViewData["Title"] = T["hosting.title"];
    var prunable = Model.Prunable;
}
<partial name="_HostingTabs" model='"docker"' />

<div class="card">
    <h2>@T["nodes.thisHost"]</h2>
    <div class="kv">
        <div class="kv-label">@T["common.status"]</div>
        <div class="kv-value">
            @if (!Model.DockerConfigured)
            {
                <span class="badge badge-off">@T["settings.dockerOff"]</span>
            }
            else if (Model.DockerReachable)
            {
                <span class="badge badge-on">@T["settings.dockerOk"]</span>
            }
            else
            {
                <span class="badge badge-err">@T["settings.dockerUnreachable"]</span>
            }
        </div>
    </div>
    @if (Model.Daemon is { } d)
    {
        <div class="kv"><div class="kv-label">@T["nodes.docker"]</div><div class="kv-value mono">@d.Version</div></div>
        <div class="kv"><div class="kv-label">@T["nodes.host"]</div><div class="kv-value mono">@d.HostName</div></div>
    }
    @if (Model.Resources is { } r)
    {
        <div class="kv"><div class="kv-label">@T["docker.resources"]</div><div class="kv-value">@r.Cpus CPU · @HostFmt.Bytes(r.MemTotal) RAM <span class="muted">@r.Os</span></div></div>
    }
    <div class="kv">
        <div class="kv-label">@T["settings.dockerEndpoint"]</div>
        <div class="kv-value mono">@(Model.Endpoint ?? "—")</div>
    </div>
    <div class="kv">
        <div class="kv-label">@T["settings.dockerLocalCount"]</div>
        <div class="kv-value">@Model.LocalCount</div>
    </div>
    @if (!Model.DockerConfigured)
    {
        <div class="help">@T["settings.dockerConfigHint"]</div>
    }
</div>

@if (Model.Images is { } images)
{
    @* Images: what an update leaves behind piles up here. Only MatCMS images are listed and only unused, untagged
       ones are removed — never another app's layers, never an image a container still runs on. *@
    <div class="card">
        <h2>@T["docker.images"]</h2>
        <div class="kv">
            <div class="kv-label">@T["docker.imagesTotal"]</div>
            <div class="kv-value">@images.Count · @HostFmt.Bytes(images.Sum(i => i.Size))</div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["docker.imagesPrunable"]</div>
            <div class="kv-value">
                @if (prunable.Count == 0) { <span class="badge badge-on">@T["docker.imagesClean"]</span> }
                else { <span class="badge badge-new">@prunable.Count · ~@HostFmt.Bytes(prunable.Sum(i => i.Size))</span> }
            </div>
        </div>
        <table class="data" style="margin-top:12px;">
            <thead><tr><th>@T["docker.image"]</th><th>@T["hosting.version"]</th><th>@T["docker.size"]</th><th>@T["docker.created"]</th><th>@T["docker.inUse"]</th></tr></thead>
            <tbody>
                @if (images.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["docker.noImages"]' />
                }
                @foreach (var i in images)
                {
                    <tr>
                        <td>
                            <span class="mono">@i.Repo</span>
                            <div>
                                @foreach (var t in i.Tags) { <span class="badge badge-off mono">@(t.Contains(':') ? t[(t.LastIndexOf(':') + 1)..] : t)</span> }
                                @if (i.Tags.Count == 0) { <span class="badge badge-off">@T["docker.untagged"]</span> }
                                @if (i.Dangling && i.InUse == 0) { <span class="badge badge-new">@T["docker.old"]</span> }
                                <span class="mono muted">@(i.Id.Replace("sha256:", "")[..12])</span>
                            </div>
                        </td>
                        <td class="mono">
                            @if (i.Version is { } v) { @v }
                            else if (Model.RegistryVersion.TryGetValue(i.Id, out var gv)) { @gv }
                            else if (Model.ReportedVersion.TryGetValue(i.Id, out var rv)) { @rv <div class="muted" style="font-family:inherit;">@T["docker.versionReported"]</div> }
                            else if (i.LocalBuild) { <span class="muted">@T["docker.localBuild"]</span> }
                            else { <span class="muted">@T["common.unknown"]</span> }
                        </td>
                        <td class="mono">@HostFmt.Bytes(i.Size)</td>
                        <td class="mono muted">@i.Created.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@if (i.InUse > 0) { <span class="badge badge-on">@T["docker.containers", i.InUse]</span> } else { <span class="muted">—</span> }</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (prunable.Count > 0)
        {
            <form method="post" asp-page-handler="PruneImages" class="list-actions">
                <button type="submit" class="btn">@T["settings.dockerPrune"]</button>
            </form>
        }
    </div>
}
