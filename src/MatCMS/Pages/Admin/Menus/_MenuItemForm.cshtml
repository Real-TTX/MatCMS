@model MatCMS.Pages.Admin.Menus.MenuItemFormVm
<form method="post" class="form-grid">
    @if (!string.IsNullOrEmpty(Model.Locale))
    {
        <input type="hidden" name="Locale" value="@Model.Locale" />
    }
    <div class="form-row">
        <div class="form-field">
            <label for="Menu">@T["menus.menu"]</label>
            <select id="Menu" name="Menu">
                @foreach (var m in Model.Menus)
                {
                    <option value="@m.Key" selected="@(Model.Menu == m.Key ? "selected" : null)">@m.Name</option>
                }
            </select>
        </div>
        <div class="form-field">
            <label for="mi-label">@T["menus.label"]</label>
            <input id="mi-label" name="Label" value="@Model.Label" required autofocus="@(Model.AutofocusLabel ? "autofocus" : null)" />
        </div>
    </div>
    <div class="form-field">
        <label for="mi-url">@T["menus.target"]</label>
        <div class="link-field">
            <input id="mi-url" name="Url" value="@Model.Url" placeholder="@T["menus.targetPlaceholder"]" required />
            <button type="button" class="link-field-btn" data-link-btn data-target="#mi-url" data-label="#mi-label" title="@T["menus.pickPage"]" aria-label="@T["menus.pickPage"]"><i class="ti ti-link" aria-hidden="true"></i></button>
        </div>
        <div class="help">@T[Model.QuickPickHelpKey]</div>
    </div>
    @if (Model.ParentOptions.Count > 0)
    {
        <div class="form-field">
            <label for="mi-parent">@T["menus.parentLabel"]</label>
            <select id="mi-parent" name="ParentId">
                <option value="">@T["menus.parentTop"]</option>
                @foreach (var p in Model.ParentOptions)
                {
                    <option value="@p.Id" selected="@(Model.ParentId == p.Id ? "selected" : null)">@p.Label</option>
                }
            </select>
            <div class="help">@T["menus.parentHelp"]</div>
        </div>
    }
    <partial name="_IconPicker" model="Model.Icon" />
    <label class="check">
        <input type="checkbox" name="OpenInNewTab" value="true" @(Model.OpenInNewTab ? "checked" : "") /> @T["menus.openNewTab"]
    </label>
    @* Speichern, dann Zurück — dieselbe Ordnung und dieselben Klassen wie in Plugins/Edit. Der Weg
       zurück steht hier unten neben dem Knopf, der dieses Formular abschickt, und nicht mehr oben
       in der Kopfzeile. *@
    <div class="form-actions">
        <button type="submit" class="btn">@T[Model.SubmitLabelKey]</button>
        <a class="btn btn-ghost" href="@Model.BackUrl">@T["action.back"]</a>
    </div>
</form>
