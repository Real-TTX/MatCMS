@page "{id:int}"
@model MatCMS.Pages.Admin.Templates.CustomizeModel
@{
    ViewData["Title"] = T["templates.edit"];
    string V(string id) => Model.Values.TryGetValue(id, out var v) ? v : "";
}
@* Nur die Überschrift: alle Aktionen dieser Seite stehen unten in EINER Reihe — dieselbe Ordnung
   wie im Plugin-Editor. *@
<div class="page-head">
    <h1>@T["templates.customizeHeading"] – @Model.Current.Name</h1>
</div>

<div class="card">
    <p class="help">@T["templates.customizeHelp"]</p>
    @if (Model.Params.Count == 0)
    {
        <p class="muted">@T["templates.customizeEmpty"]</p>
    }
    else
    {
        <form method="post" class="form-grid" id="customize-form">
            @foreach (var p in Model.Params)
            {
                <div class="form-field">
                    <label>@p.Label</label>
                    @switch (p.Type)
                    {
                        case "select":
                            <select name="Val[@p.Id]">
                                @foreach (var o in p.OptionList())
                                {
                                    <option value="@o" selected="@(V(p.Id) == o)">@o</option>
                                }
                            </select>
                            break;
                        case "color":
                            <input type="color" name="Val[@p.Id]" value="@(string.IsNullOrWhiteSpace(V(p.Id)) ? "#000000" : V(p.Id))" />
                            break;
                        case "number":
                            <input type="number" name="Val[@p.Id]" value="@V(p.Id)" />
                            break;
                        case "bool":
                            <label class="check"><input type="checkbox" name="Val[@p.Id]" value="true" @(V(p.Id) == "true" ? "checked" : "") /> @T["templates.paramActive"]</label>
                            break;
                        default:
                            <input type="text" name="Val[@p.Id]" value="@V(p.Id)" />
                            break;
                    }
                    <div class="help mono">{{param:@p.Id}}</div>
                </div>
            }
        </form>
    }
</div>

@* Speichern, dann Zurück — dieselbe Ordnung und dieselben Klassen wie in Plugins/Edit. Die Reihe
   steht AUSSERHALB der Karte, weil es ohne veröffentlichte Parameter gar kein Formular gibt: der
   Weg zurück muss auch dann da sein, und der Speichern-Knopf erreicht sein Formular über
   form="customize-form". *@
<div class="form-actions">
    @if (Model.Params.Count > 0)
    {
        <button type="submit" class="btn" form="customize-form">@T["action.save"]</button>
        @if (Model.AiEnabled)
        {
            <button type="button" id="ai-theme-btn" class="btn btn-ghost"
                    title="@T["templates.aiButton"]"
                    data-ai-url="@Url.Page(null, "AiTheme", new { id = Model.Current.Id })">
                <i class="ti ti-sparkles" aria-hidden="true"></i> @T["templates.aiButton"]
            </button>
        }
    }
    <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
</div>

@if (Model.AiEnabled && Model.Params.Count > 0)
{
    @* Design-KI: Vorschlag neuer Parameterwerte → Vorher/Nachher je Parameter → „Übernehmen" schreibt
       die Werte in die echten Formularfelder und speichert über den normalen Save (PRG). Reuse der
       geteilten .ai-dialog/.ai-change-Styles aus admin.css. *@
    <dialog id="ai-theme-dialog" class="ai-dialog"
            data-lbl-before="@T["templates.aiBefore"]" data-lbl-after="@T["templates.aiAfter"]"
            data-lbl-working="@T["templates.aiWorking"]">
        <h3>@T["templates.aiDialogTitle"]</h3>
        <label class="ai-instr-label" for="ai-theme-instruction">@T["templates.aiInstruction"]</label>
        <textarea id="ai-theme-instruction" rows="2" placeholder="@T["templates.aiInstructionPlaceholder"]"></textarea>
        <div class="ai-dialog-actions">
            <button type="button" id="ai-theme-propose" class="btn btn-sm">@T["templates.aiPropose"]</button>
            <span id="ai-theme-status" class="ai-status muted"></span>
        </div>
        <div id="ai-theme-diff" class="ai-diff"></div>
        <div class="ai-dialog-foot">
            <button type="button" id="ai-theme-apply" class="btn btn-sm" disabled>@T["templates.aiApply"]</button>
            <button type="button" id="ai-theme-cancel" class="btn btn-sm btn-ghost">@T["templates.aiCancel"]</button>
        </div>
    </dialog>
    <script src="~/js/ai-theme-edit.js" asp-append-version="true"></script>
}
