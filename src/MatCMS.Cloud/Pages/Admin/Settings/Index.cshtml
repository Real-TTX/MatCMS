@page
@model MatCMS.Cloud.Pages.Admin.Settings.IndexModel
@using MatCMS.Cloud.Services
@{
    ViewData["Title"] = T["settings.title"];
}
<div class="page-head">
    <h1>@T["settings.title"]</h1>
</div>

<div class="tabs" role="tablist">
    <button type="button" class="tab active" data-tab="general">@T["settings.tabGeneral"]</button>
    <button type="button" class="tab" data-tab="smtp">@T["settings.tabSmtp"]</button>
    <button type="button" class="tab" data-tab="ai">@T["settings.tabAi"]</button>
    <button type="button" class="tab" data-tab="backup">@T["backups.title"]</button>
    <button type="button" class="tab" data-tab="api">@T["settings.tabApi"]</button>
    <button type="button" class="tab" data-tab="hosting">@T["settings.tabHosting"]</button>
    <button type="button" class="tab" data-tab="docker">@T["settings.tabDocker"]</button>
</div>

@* ============ GENERAL ============ *@
<div class="tab-panel" data-panel="general">
    <form method="post" asp-page-handler="General">
        <div class="card">
            <h2>@T["settings.general"]</h2>
            <div class="form-field">
                <label>@T["settings.cloudName"]</label>
                <input name="cloudName" value="@Model.Get(SettingKeys.CloudName)" />
            </div>
            <div class="form-field">
                <label>URL</label>
                <input name="canonicalUrl" value="@Model.Get(SettingKeys.CanonicalUrl)" placeholder="https://cloud.beispiel.de" spellcheck="false" />
                <div class="help">@T["settings.canonicalUrlHint"]</div>
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="forceHttps" value="true" checked="@(Model.Flag(SettingKeys.ForceHttpsUrls) ? "checked" : null)" />
                @T["settings.forceHttps"]
            </label>
            <div class="help">@T["settings.forceHttpsHint"]</div>
            <div><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>

    @* Sicherheit gehört zum Allgemeinen — eigene Karte, eigenes Formular, damit ein Speichern hier nie die
       übrigen Schlüssel anfasst. *@
    <form method="post" asp-page-handler="Security">
        <div class="card">
            <h2>@T["settings.securityHeading"]</h2>
            <p class="muted">@T["settings.securityIntro"]</p>
            <label class="checkbox-row">
                <input type="checkbox" name="require2fa" value="true" checked="@(Model.Flag(SettingKeys.Require2fa) ? "checked" : null)" />
                @T["settings.require2fa"]
            </label>
            <div class="help">@T["settings.require2faHelp"]</div>
            <div style="margin-top:14px;"><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
    @* Automatisches Update ist eine Betriebsregel, keine Benachrichtigung — deshalb hier und nicht in der
       Benachrichtigungs-Matrix. Pro Profil lässt es sich abweichend setzen. *@
    <form method="post" asp-page-handler="Updates">
        <div class="card">
            <h2>@T["settings.updatesHeading"]</h2>
            <label class="checkbox-row">
                <input type="checkbox" name="autoUpdateLocal" value="true" checked="@(Model.Flag(SettingKeys.AutoUpdateLocal) ? "checked" : null)" />
                @T["settings.autoUpdateLocal"]
            </label>
            <div class="help">@T["settings.autoUpdateLocalHint"]</div>
            <div style="margin-top:14px;"><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
</div>

@* ============ API ============ *@
@* Die API-Schlüssel (Operator-API + MCP) leben hier und nicht als eigener Menüpunkt: sie sind Konfiguration der
   Cloud. Anlegen bleibt eine eigene Seite, die hierher zurückführt. *@
<div class="tab-panel" data-panel="api" hidden>
    <partial name="_ApiKeyList" model="Model.ApiKeys" />
</div>

@* ============ SMTP ============ *@
<div class="tab-panel" data-panel="smtp" hidden>
    <form method="post" asp-page-handler="Smtp">
        <div class="card">
            <h2>@T["settings.smtpHeading"]</h2>
            <div class="form-grid">
                <div class="form-row">
                    <div class="form-field">
                        <label>@T["settings.smtpHost"]</label>
                        <input name="host" value="@Model.Get(SettingKeys.SmtpHost)" spellcheck="false" />
                    </div>
                    <div class="form-field">
                        <label>@T["settings.smtpPort"]</label>
                        <input name="port" value="@Model.Get(SettingKeys.SmtpPort)" placeholder="587" inputmode="numeric" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label>@T["settings.smtpUser"]</label>
                        <input name="user" value="@Model.Get(SettingKeys.SmtpUser)" spellcheck="false" />
                    </div>
                    <div class="form-field">
                        <label>@T["settings.smtpPassword"]</label>
                        <input name="password" type="password" autocomplete="new-password" placeholder="@T["settings.smtpPasswordKeep"]" />
                        @* An empty field means "keep", so without this there is no way to get rid of a
                           stored password at all — the operator could only ever replace it. *@
                        @if (!string.IsNullOrEmpty(Model.Get(SettingKeys.SmtpPassword)))
                        {
                            <label class="checkbox-row">
                                <input type="checkbox" name="clearPassword" value="true" />
                                @T["settings.smtpPasswordClear"]
                            </label>
                        }
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label>@T["settings.smtpFromEmail"]</label>
                        <input name="fromEmail" value="@Model.Get(SettingKeys.SmtpFromEmail)" spellcheck="false" />
                    </div>
                    <div class="form-field">
                        <label>@T["settings.smtpFromName"]</label>
                        <input name="fromName" value="@Model.Get(SettingKeys.SmtpFromName)" />
                    </div>
                </div>
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="ssl" value="true" checked="@(Model.Flag(SettingKeys.SmtpSsl) ? "checked" : null)" />
                @T["settings.smtpSsl"]
            </label>
            <div><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>

    <div class="card">
        <h2>@T["settings.smtpTest"]</h2>
        <form method="post" asp-page-handler="SmtpTest">
            <div class="form-field">
                <label>@T["settings.smtpTestTo"]</label>
                <input name="testTo" type="email" placeholder="test@@beispiel.de" spellcheck="false" />
                <div class="help">@T["settings.smtpTestHint"]</div>
            </div>
            <div><button type="submit" class="btn btn-ghost">@T["settings.smtpTestSend"]</button></div>
        </form>
    </div>
</div>

@* ============ KI (AI) ============ *@
<div class="tab-panel" data-panel="ai" hidden>
    <form method="post" asp-page-handler="Ai">
        <div class="card">
            <h2>@T["settings.aiHeading"]</h2>
            <p class="muted">@T["settings.aiIntro"]</p>
            <div class="form-grid">
                <div class="form-row">
                    <div class="form-field">
                        <label>@T["settings.aiProvider"]</label>
                        <select name="provider">
                            <option value="openai" selected>OpenAI / ChatGPT</option>
                        </select>
                        <div class="help">@T["settings.aiProviderHint"]</div>
                    </div>
                    <div class="form-field">
                        <label>@T["settings.aiModel"]</label>
                        <input name="model" value="@Model.Get(SettingKeys.AiModel)" placeholder="gpt-4o-mini" spellcheck="false" />
                    </div>
                </div>
                <div class="form-field">
                    <label>@T["settings.aiApiKey"]</label>
                    <input name="apiKey" type="password" autocomplete="new-password"
                           placeholder="@(string.IsNullOrEmpty(Model.Get(SettingKeys.AiApiKey)) ? "sk-…" : T["settings.aiApiKeyKeep"])" spellcheck="false" />
                    @if (!string.IsNullOrEmpty(Model.Get(SettingKeys.AiApiKey)))
                    {
                        <label class="checkbox-row">
                            <input type="checkbox" name="clearKey" value="true" />
                            @T["settings.aiApiKeyClear"]
                        </label>
                    }
                    <div class="help">@T["settings.aiApiKeyHint"]</div>
                </div>
                <div class="form-field">
                    <label>@T["settings.aiBaseUrl"]</label>
                    <input name="baseUrl" value="@Model.Get(SettingKeys.AiBaseUrl)" placeholder="https://api.openai.com/v1" spellcheck="false" />
                    <div class="help">@T["settings.aiBaseUrlHint"]</div>
                </div>
            </div>
            <div style="margin-top:14px;"><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>

    @* Verbrauch: cloud-weit + pro Instanz, laufender Monat (aus dem AiUsage-Ledger). *@
    <div class="card">
        <h2>@T["settings.aiUsage"] · @Model.AiPeriod</h2>
        <div class="kv">
            <div class="kv-label">@T["settings.aiUsageTotal"]</div>
            <div class="kv-value">@Model.AiTokensTotal.ToString("N0") @T["settings.aiUsageTokens"] · @Model.AiCallsTotal @T["settings.aiUsageCalls"]</div>
        </div>
        @if (Model.AiUsage.Count > 0)
        {
            <table class="data" style="margin-top:10px;">
                <thead><tr><th>@T["common.instance"]</th><th>@T["settings.aiUsageTokens"]</th><th>@T["settings.aiUsageCalls"]</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.AiUsage)
                    {
                        <tr><td>@r.Instance</td><td class="mono">@r.Tokens.ToString("N0")</td><td class="mono">@r.Calls</td></tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="muted">@T["settings.aiUsageEmpty"]</p>
        }
    </div>

    @* Connect ChatGPT (or an MCP client) to THIS cloud via the native OAuth connector. Separate from the
       relay above: that key lets the cloud call OpenAI; this grants a client access to /api/v1 + /mcp. *@
    <div class="card">
        <h2>@T["settings.connectHeading"]</h2>
        <p class="muted">@T["settings.connectIntro"]</p>
        <div class="actions" style="margin:8px 0 4px;">
            <a class="btn" asp-page="/Admin/OAuthClients/Index">@T["settings.connectClientsBtn"]</a>
        </div>
        <div class="help">@T["settings.connectSteps"]</div>
        <p class="muted" style="margin-top:12px;">@T["settings.connectManage"] <a asp-page="/Admin/ApiKeys/Index">@T["nav.apikeys"]</a>.</p>
    </div>
</div>

@* ============ BACKUP ============ *@
@* Eigener Reiter: Backups sind ein Bereich mit eigener Seite, eigener Belegung und eigenem
   Kontingent — als eine Zeile unter "Allgemein" war das die einzige Einstellung, die man dort
   suchen musste, obwohl sie zu etwas anderem gehört. *@
<div class="tab-panel" data-panel="backup" hidden>
    <form method="post" asp-page-handler="Backup">
        <div class="card">
            <h2>@T["backups.title"]</h2>
            <div class="form-field">
                <label>@T["settings.backupQuota"]</label>
                <input name="backupQuotaGb" value="@Model.Get(SettingKeys.BackupQuotaGb)"
                       placeholder="@MatCMS.Cloud.Services.BackupStore.DefaultQuotaGb" inputmode="decimal" />
                <div class="help">@T["settings.backupQuotaHint"] Nachkommastellen erlaubt (0,1 = 100 MB).</div>
            </div>
            <div class="form-field">
                <label>Aufbewahrung automatischer Backups (Standard)</label>
                <div class="form-row">
                    <div class="form-field"><label>Täglich</label><input name="backupKeepDaily" value="@Model.Get(SettingKeys.BackupKeepDaily)" placeholder="aus" inputmode="numeric" /></div>
                    <div class="form-field"><label>Wöchentlich</label><input name="backupKeepWeekly" value="@Model.Get(SettingKeys.BackupKeepWeekly)" placeholder="aus" inputmode="numeric" /></div>
                    <div class="form-field"><label>Monatlich</label><input name="backupKeepMonthly" value="@Model.Get(SettingKeys.BackupKeepMonthly)" placeholder="aus" inputmode="numeric" /></div>
                    <div class="form-field"><label>Max. Anzahl</label><input name="backupMaxCount" value="@Model.Get(SettingKeys.BackupMaxCount)" placeholder="aus" inputmode="numeric" /></div>
                </div>
                <div class="help">Je Tag/Woche/Monat wird das neueste Backup behalten (klassisches Großvater-Vater-Sohn). Leer/0 = aus. Betrifft nur die von den Instanzen selbst erstellten Backups — manuell oder über die API hochgeladene werden nie automatisch gelöscht. Pro Profil überschreibbar.</div>
            </div>
            <div><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
</div>

@* ============ HOSTING ============ *@
@* Eigener Reiter, weil hier mehr hinkommt als ein Haken: das Anlegen neuer Instanzen und was daran
   hängt (Adressvergabe, Image, Volumes). Der Haken ist das Tor davor. *@
<div class="tab-panel" data-panel="hosting" hidden>
    <form method="post" asp-page-handler="Hosting">
        <div class="card">
            <h2>@T["settings.tabHosting"]</h2>
            <label class="checkbox-row">
                <input type="checkbox" name="hostingEnabled" value="true" checked="@(Model.Flag(SettingKeys.HostingEnabled) ? "checked" : null)" />
                @T["settings.hostingEnabled"]
            </label>
            <div class="help">@T["settings.hostingEnabledHint"]</div>
            @* Hosting ist ein optionales Modul: hier wird es nur eingeschaltet. Alles Weitere — Proxy, Ports,
               Nodes, Domains — steht in seiner eigenen Menügruppe. *@
            <div class="help">@T["settings.hostingMoved"] <a asp-page="/Admin/Hosting/Settings">@T["hosting.title"] → @T["hosting.navSettings"]</a></div>
            <div style="margin-top:14px;"><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
</div>

@* ============ DOCKER ============ *@
<div class="tab-panel" data-panel="docker" hidden>
    <div class="card">
        <h2>@T["settings.docker"]</h2>
        <p class="muted">@T["settings.dockerHint"]</p>
        <div class="kv">
            <div class="kv-label">@T["common.status"]</div>
            <div class="kv-value">
                @if (!Model.DockerConfigured)
                {
                    <span class="badge badge-off">@T["settings.dockerOff"]</span>
                }
                else if (Model.DockerReachable)
                {
                    <span class="badge badge-on">@T["settings.dockerOk"]</span>
                }
                else
                {
                    <span class="badge badge-err">@T["settings.dockerUnreachable"]</span>
                }
            </div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["settings.dockerEndpoint"]</div>
            <div class="kv-value mono">MatCmsCloud__Docker__Endpoint</div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["settings.dockerLocalCount"]</div>
            <div class="kv-value">@Model.LocalCount</div>
        </div>
        <div class="help">@T["settings.dockerConfigHint"]</div>

        @if (Model.DockerConfigured && Model.DockerReachable)
        {
            @* Remove OLD MatCMS images left dangling by updates. Only MatCMS, only untagged, only if unused
               (the service refuses images a container still needs) — never another app's layers. *@
            <div class="list-actions" style="margin-top:14px;">
                <form method="post" asp-page-handler="PruneImages">
                    <button type="submit" class="btn btn-ghost"><i class="ti ti-trash" aria-hidden="true"></i> @T["settings.dockerPrune"]</button>
                </form>
            </div>
            <div class="help">@T["settings.dockerPruneHint"]</div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Tabs — identical to MatCMS's settings page, including the ?tab=<name> deep link that every
        // handler redirects back to.
        (function () {
            var tabs = document.querySelectorAll('.tab');
            var panels = document.querySelectorAll('.tab-panel');
            function show(name) {
                tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.tab === name); });
                panels.forEach(function (p) { p.hidden = p.dataset.panel !== name; });
            }
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
            var want = new URLSearchParams(location.search).get('tab');
            if (want) show(want);
        })();
    </script>
}
