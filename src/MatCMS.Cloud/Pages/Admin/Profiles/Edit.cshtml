@page "{id:int}"
@model MatCMS.Cloud.Pages.Admin.Profiles.EditModel
@{
    ViewData["Title"] = Model.Item.Name;
}
<div class="page-head">
    <h1>@Model.Item.Name</h1>
    <div class="list-toolbar">
        <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
    </div>
</div>

<div class="tabs" role="tablist">
    <button type="button" class="tab active" data-tab="general">@T["profiles.tabGeneral"]</button>
    <button type="button" class="tab" data-tab="settings">@T["profiles.tabSettings"]</button>
    <button type="button" class="tab" data-tab="backup">@T["profiles.tabBackup"]</button>
    <button type="button" class="tab" data-tab="users">@T["profiles.tabUsers"]</button>
    <button type="button" class="tab" data-tab="plugins">@T["profiles.tabPlugins"]</button>
    <button type="button" class="tab" data-tab="components">@T["profiles.tabComponents"]</button>
    <button type="button" class="tab" data-tab="templates">@T["profiles.tabTemplates"]</button>
    <button type="button" class="tab" data-tab="mailtemplates">@T["profiles.tabMailTemplates"]</button>
</div>


@* ============ GENERAL ============ *@
<div class="tab-panel" data-panel="general">
    <div class="card">
        <h2>@T["profiles.enrollment"]</h2>
        <div class="kv">
            <div class="kv-label">@T["profiles.joinCode"]</div>
            @* The action sits on the value it acts on, like "Instanzen anzeigen" does on the count —
               a row of buttons under the card makes you look for what each one belongs to. *@
            <div class="kv-value">
                <span class="mono is-secret">@Model.Item.JoinCode</span>
                <form class="inline-form" method="post" asp-page-handler="RotateCode" asp-route-id="@Model.Item.Id"
                      onsubmit="return confirm('@T["profiles.rotateConfirm"]');">
                    <button type="submit" class="btn btn-sm btn-ghost">@T["profiles.rotateCode"]</button>
                </form>
            </div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["profiles.revision"]</div>
            <div class="kv-value"><span class="mono">@Model.Item.Revision</span></div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["profiles.instances"]</div>
            @* Only the count plus a way in: a profile with twenty instances would otherwise turn this
               row into a wall of buttons, and the instance list already knows how to show them. *@
            <div class="kv-value">
                @if (Model.Instances.Count == 0)
                {
                    <span class="mono">0</span>
                }
                else
                {
                    @* The number itself leads to the filtered list too — clicking the count is the
                       first thing anyone tries. *@
                    <a class="mono" asp-page="/Admin/Instances/Index" asp-route-profile="@Model.Item.Id">@Model.Instances.Count</a>
                    <a class="btn btn-sm btn-ghost" asp-page="/Admin/Instances/Index" asp-route-profile="@Model.Item.Id">@T["profiles.showInstances"]</a>
                }
            </div>
        </div>
    </div>

    <form method="post" asp-page-handler="General" asp-route-id="@Model.Item.Id">
        <div class="card">
            <h2>@T["profiles.tabGeneral"]</h2>
            <div class="form-field">
                <label for="name">@T["common.name"]</label>
                <input id="name" name="name" value="@Model.Item.Name" required />
            </div>
            <div class="form-field">
                <label for="description">@T["profiles.description"]</label>
                <textarea id="description" name="description" rows="2">@Model.Item.Description</textarea>
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="autoApprove" value="true" checked="@(Model.Item.AutoApprove ? "checked" : null)" />
                @T["profiles.autoApproveLabel"]
            </label>
            <div class="help">@T["profiles.autoApproveHint"]</div>
            <label class="checkbox-row">
                <input type="checkbox" name="isDefault" value="true" checked="@(Model.Item.IsDefault ? "checked" : null)"
                       disabled="@(Model.Item.IsDefault ? "disabled" : null)" />
                @T["profiles.isDefaultLabel"]
            </label>
            <div class="help">@T["profiles.isDefaultHint"]</div>
        </div>

        <div class="card">
            <h2>@T["profiles.policy"]</h2>
            <label class="checkbox-row">
                <input type="checkbox" name="notifyOffline" value="true" checked="@(Model.Item.NotifyOffline ? "checked" : null)" />
                @T["settings.notifyOffline"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="notifyUpdate" value="true" checked="@(Model.Item.NotifyUpdate ? "checked" : null)" />
                @T["settings.notifyUpdate"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="autoUpdateLocal" value="true" checked="@(Model.Item.AutoUpdateLocal ? "checked" : null)" />
                @T["settings.autoUpdateLocal"]
            </label>
            <div class="form-field">
                <label for="backupQuotaGb">@T["profiles.backupQuota"]</label>
                <input id="backupQuotaGb" name="backupQuotaGb" value="@(Model.Item.BackupQuotaGb?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                       placeholder="@Model.GlobalQuotaGb" inputmode="decimal" />
                <div class="help">@T["profiles.backupQuotaHint", Model.GlobalQuotaGb] Nachkommastellen erlaubt (0,1 = 100 MB).</div>
            </div>
            <div class="form-field">
                <label>Backup-Aufbewahrung (automatische Backups)</label>
                <div class="form-row">
                    <div class="form-field"><label for="bkd">Täglich</label><input id="bkd" name="backupKeepDaily" value="@(Model.Item.BackupKeepDaily?.ToString() ?? "")" placeholder="Standard" inputmode="numeric" /></div>
                    <div class="form-field"><label for="bkw">Wöchentlich</label><input id="bkw" name="backupKeepWeekly" value="@(Model.Item.BackupKeepWeekly?.ToString() ?? "")" placeholder="Standard" inputmode="numeric" /></div>
                    <div class="form-field"><label for="bkm">Monatlich</label><input id="bkm" name="backupKeepMonthly" value="@(Model.Item.BackupKeepMonthly?.ToString() ?? "")" placeholder="Standard" inputmode="numeric" /></div>
                    <div class="form-field"><label for="bmc">Max. Anzahl</label><input id="bmc" name="backupMaxCount" value="@(Model.Item.BackupMaxCount?.ToString() ?? "")" placeholder="Standard" inputmode="numeric" /></div>
                </div>
                <div class="help">Wie viele der EIGENEN (automatischen) Backups die Cloud behält: je Tag/Woche/Monat das neueste, höchstens „Max. Anzahl". Leer = Cloud-Standard, 0 = aus. Manuell/über API hochgeladene Backups werden nie automatisch gelöscht.</div>
            </div>
            <div class="form-field">
                <label for="notifyRecipients">@T["settings.recipients"]</label>
                <input id="notifyRecipients" name="notifyRecipients" value="@Model.Item.NotifyRecipients" placeholder="@T["profiles.recipientsFallback"]" />
            </div>
        </div>

        <div class="card">
            <h2>@T["profiles.payloads"]</h2>
            <label class="checkbox-row">
                <input type="checkbox" name="syncSettings" value="true" checked="@(Model.Item.SyncSettings ? "checked" : null)" />
                @T["profiles.payloadSettings"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="syncUsers" value="true" checked="@(Model.Item.SyncUsers ? "checked" : null)" />
                @T["profiles.payloadUsers"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="syncPlugins" value="true" checked="@(Model.Item.SyncPlugins ? "checked" : null)" />
                @T["profiles.payloadPlugins"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="syncComponents" value="true" checked="@(Model.Item.SyncComponents ? "checked" : null)" />
                @T["profiles.payloadComponents"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="syncTemplates" value="true" checked="@(Model.Item.SyncTemplates ? "checked" : null)" />
                @T["profiles.payloadTemplates"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="syncMailTemplates" value="true" checked="@(Model.Item.SyncMailTemplates ? "checked" : null)" />
                @T["profiles.payloadMailTemplates"]
            </label>

            <div class="form-field" style="margin-top:12px;">
                <label for="activateTemplateName">@T["profiles.activateTemplate"]</label>
                <select id="activateTemplateName" name="activateTemplateName">
                    <option value="">@T["profiles.activateNone"]</option>
                    @foreach (var t in Model.Templates)
                    {
                        <option value="@t.Name" selected="@(Model.Item.ActivateTemplateName == t.Name ? "selected" : null)">@t.Name</option>
                    }
                </select>
                <div class="help">@T["profiles.activateTemplateHint"]</div>
            </div>

            <h3 class="form-section">@T["profiles.strategy"]</h3>
            @* One mode per payload instead of a single "overwrite" switch: "einmalig" is a third
               answer that a checkbox cannot give — roll it out now, then let the site own it. *@
            @foreach (var m in Model.Modes)
            {
                <div class="form-field">
                    <label for="@m.Field">@T[m.LabelKey]</label>
                    <select id="@m.Field" name="@m.Field">
                        @foreach (var option in m.Options)
                        {
                            <option value="@option" selected="@(m.Value == option ? "selected" : null)">@T[$"profiles.mode.{option}"]</option>
                        }
                    </select>
                    <div class="help">@T[$"profiles.mode.{m.Value}.hint"]</div>
                </div>
            }
            <div class="help">@T["profiles.usersAddOnly"]</div>
        </div>

        <div class="list-actions">
            <button type="submit" class="btn">@T["settings.save"]</button>
        </div>
    </form>
</div>

@* ============ SETTINGS ============ *@
<div class="tab-panel" data-panel="settings" hidden>
    <div data-list>
        <div class="page-head">
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
            </div>
        </div>
        <table class="data" data-list-table>
            <thead>
                <tr><th>@T["profiles.settingKey"]</th><th>@T["profiles.settingValue"]</th><th></th></tr>
            </thead>
            <tbody>
                @* SMTP is a payload like any other, so it is a row here rather than a form
                   permanently open above the list. Its value column says where the values come
                   from, because that is what an operator scanning this list wants to know. *@
                @if (Model.Item.SyncSmtp)
                {
                    <tr data-search="smtp mail e-mail">
                        <td><a asp-page="Smtp" asp-route-profileId="@Model.Item.Id"><span class="mono">smtp.*</span></a></td>
                        <td class="muted">@T[Model.Item.MailSource switch {
                            MailSources.Global => "profiles.smtpFromGlobal",
                            MailSources.Cloud => "profiles.smtpViaCloud",
                            _ => "profiles.smtpOwn" }]</td>
                        <td>
                            <div class="actions">
                                <form class="inline-form" method="post" asp-page="Smtp" asp-page-handler="Remove" asp-route-profileId="@Model.Item.Id"
                                      onsubmit="return confirm('@T["profiles.smtpRemoveConfirm"]');">
                                    <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["profiles.removeFromProfile"]" aria-label="@T["profiles.removeFromProfile"]"><partial name="_IconTrash" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @* The translation credentials, as one row for the same reason SMTP is one: three values
                   that only make sense together. *@
                @if (Model.Item.SyncTranslation)
                {
                    <tr data-search="translate übersetzung deepl">
                        <td><a asp-page="Translation" asp-route-profileId="@Model.Item.Id"><span class="mono">translate.*</span></a></td>
                        <td class="muted">@T["profiles.translationValue"]</td>
                        <td>
                            <div class="actions">
                                <form class="inline-form" method="post" asp-page="Translation" asp-page-handler="Remove" asp-route-profileId="@Model.Item.Id"
                                      onsubmit="return confirm('@T["profiles.translationRemoveConfirm"]');">
                                    <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["profiles.removeFromProfile"]" aria-label="@T["profiles.removeFromProfile"]"><partial name="_IconTrash" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @* The backup policy, one row for the same reason: schedule, contents and the upload
                   only mean anything together. *@
                @if (Model.Item.SyncBackup)
                {
                    <tr data-search="backup sicherung zeitplan">
                        <td><a asp-page="Edit" asp-route-id="@Model.Item.Id" asp-route-tab="backup"><span class="mono">backup.*</span></a></td>
                        <td class="muted">@T["profiles.backupValue"]</td>
                        <td>
                            <div class="actions">
                                <form class="inline-form" method="post" asp-page-handler="BackupRemove" asp-route-id="@Model.Item.Id"
                                      onsubmit="return confirm('@T["profiles.backupRemoveConfirm"]');">
                                    <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["profiles.removeFromProfile"]" aria-label="@T["profiles.removeFromProfile"]"><partial name="_IconTrash" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.OtherSettings.Count == 0 && !Model.Item.SyncSmtp && !Model.Item.SyncTranslation && !Model.Item.SyncBackup)
                {
                    <partial name="_EmptyRow" model='@T["profiles.noSettings"]' />
                }
                else
                {
                    @foreach (var s in Model.OtherSettings)
                    {
                        <tr data-search="@(s.IsSecret ? s.Key : s.Key + " " + s.Value)">
                            <td><a asp-page="Setting" asp-route-profileId="@Model.Item.Id" asp-route-id="@s.Id"><span class="mono">@s.Key</span></a></td>
                            <td class="muted">@s.Value</td>
                            <td>
                                <div class="actions">
                                    <form class="inline-form" method="post" asp-page-handler="DeleteSetting" asp-route-id="@Model.Item.Id" asp-route-settingId="@s.Id">
                                        <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        @* Two steps, because "which setting" and "where from" are two questions. Only SMTP has a
           global side to take from — free key/value settings exist nowhere but in the profile, so
           asking them the second question would offer an option that cannot be answered. *@
        <partial name="_AddMenu" model='AddMenus.Settings(T, Url.Page("Setting", new { profileId = Model.Item.Id })!, Model.Item.SyncSmtp, Model.Item.SyncTranslation ? null : Url.Page("Translation", new { profileId = Model.Item.Id }), Model.Item.SyncBackup ? null : Url.Page("Edit", new { id = Model.Item.Id, tab = "backup" }))' />
    </div>
    <partial name="_AddMenu" model='AddMenus.SmtpSource(T, Url.Page("Smtp", new { profileId = Model.Item.Id, source = "global" })!, Url.Page("Smtp", new { profileId = Model.Item.Id, source = "own" })!, Url.Page("Smtp", new { profileId = Model.Item.Id, source = "cloud" })!)' />
</div>

@* ============ BACKUP ============ *@
@* Eigener Reiter statt eigener Seite: Backup ist ein Bereich mit Zeitplan, Inhalt und Übertragung —
   in den Cloud-Einstellungen steht er längst als Reiter, im Profil musste man ihn über eine Zeile in
   der Einstellungsliste suchen.
   Alles, was gespeichert werden soll, steht INNERHALB dieses Formulars. Ein Feld daneben würde gar
   nicht mitgeschickt und käme beim Speichern leer an — genau deshalb hing der Speichern-Knopf früher
   per `form="editor-form"` an einem Formular, in dem er nicht stand. Als Reiter sind das Editor- und
   das Entfernen-Formular schlichte Geschwister, und der Knopf steht dort, wo er hingehört. *@
<div class="tab-panel" data-panel="backup" hidden>
    <form method="post" asp-page-handler="Backup" asp-route-id="@Model.Item.Id">
        <div class="card">
            <h2>@T["profiles.backupSchedule"]</h2>
            @if (!Model.Item.SyncBackup)
            {
                <div class="help">@T["profiles.backupInactiveHint"]</div>
            }
            <label class="checkbox-row">
                <input type="checkbox" name="enabled" value="true" checked="@(Model.BackupPolicy.Enabled ? "checked" : null)" />
                @T["profiles.backupEnabled"]
            </label>
            <div class="form-grid">
                <div class="form-row">
                    <div class="form-field">
                        <label for="intervalHours">@T["profiles.backupInterval"]</label>
                        <input id="intervalHours" name="intervalHours" value="@Model.BackupPolicy.IntervalHours" inputmode="numeric" />
                        <div class="help">@T["profiles.backupIntervalHint"]</div>
                    </div>
                    <div class="form-field">
                        <label for="retain">@T["profiles.backupRetain"]</label>
                        <input id="retain" name="retain" value="@Model.BackupPolicy.Retain" inputmode="numeric" />
                        <div class="help">@T["profiles.backupRetainHint"]</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>@T["profiles.backupContent"]</h2>
            <label class="checkbox-row">
                <input type="checkbox" name="templates" value="true" checked="@(Model.BackupPolicy.Templates ? "checked" : null)" />
                @T["backup.templates"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="pages" value="true" checked="@(Model.BackupPolicy.Pages ? "checked" : null)" />
                @T["backup.pagesSection"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="menus" value="true" checked="@(Model.BackupPolicy.Menus ? "checked" : null)" />
                @T["backup.menus"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="settings" value="true" checked="@(Model.BackupPolicy.Settings ? "checked" : null)" />
                @T["backup.settings"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="submissions" value="true" checked="@(Model.BackupPolicy.Submissions ? "checked" : null)" />
                @T["backup.submissions"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="forms" value="true" checked="@(Model.BackupPolicy.Forms ? "checked" : null)" />
                @T["backup.formsSection"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="assets" value="true" checked="@(Model.BackupPolicy.Assets ? "checked" : null)" />
                @T["backup.assets"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="plugins" value="true" checked="@(Model.BackupPolicy.Plugins ? "checked" : null)" />
                @T["backup.plugins"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="pluginAssets" value="true" checked="@(Model.BackupPolicy.PluginAssets ? "checked" : null)" />
                @T["backup.pluginAssets"]
            </label>
            <div class="help">@T["profiles.backupContentHint"]</div>
        </div>

        <div class="card">
            <h2>@T["profiles.backupCloud"]</h2>
            <label class="checkbox-row">
                <input type="checkbox" name="toCloud" value="true" checked="@(Model.BackupToCloud ? "checked" : null)" />
                @T["profiles.backupToCloud"]
            </label>
            <div class="help">@T["profiles.backupToCloudHint"]</div>
        </div>

        <div class="list-actions">
            <button type="submit" class="btn">@T["settings.save"]</button>
        </div>
    </form>

    @* Geschwister-Formular, kein verschachteltes: ein Formular im Formular gibt es im Browser nicht,
       und die Felder oben stehen deshalb weiterhin vollständig in ihrem eigenen. *@
    @if (Model.Item.SyncBackup)
    {
        <div class="list-actions">
            <form class="inline-form" method="post" asp-page-handler="BackupRemove" asp-route-id="@Model.Item.Id"
                  onsubmit="return confirm('@T["profiles.backupRemoveConfirm"]');">
                <button type="submit" class="btn btn-danger">@T["profiles.removeFromProfile"]</button>
            </form>
        </div>
    }
</div>

@* ============ USERS ============ *@
<div class="tab-panel" data-panel="users" hidden>
    <div data-list data-list-key="profile-users" class="list-view-table">
        <div class="page-head">
            <h2>@T["profiles.tabUsers"]</h2>
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
                <partial name="_ViewToggle" />
            </div>
        </div>
        <table class="data" data-list-table>
            <thead>
                <tr><th>@T["users.username"]</th><th>@T["common.origin"]</th><th>@T["users.email"]</th><th>@T["users.displayName"]</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Users.Count == 0 && Model.ChosenGlobalUsers.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["profiles.noUsers"]' />
                }
                else
                {
                    @* Global accounts the profile also rolls out — the cloud's own users, taken by
                       reference so a password change in the store reaches every profile. *@
                    @foreach (var u in Model.ChosenGlobalUsers)
                    {
                        <tr data-search="@(u.Username + " " + u.Email + " " + u.DisplayName)">
                            <td>
                                <a asp-page="/Admin/Users/Edit" asp-route-id="@u.Id"><strong>@u.Username</strong></a>
                                @if (Model.UserOverridden(u.Username))
                                {
                                    <span class="badge badge-new">@T["profiles.overriddenLocally"]</span>
                                }
                            </td>
                            <td><span class="badge badge-off">@T["profiles.fromStore"]</span></td>
                            <td class="muted">@(u.Email ?? "—")</td>
                            <td class="muted">@(u.DisplayName ?? "—")</td>
                            <td>
                                <div class="actions">
                                    <form method="post" asp-page-handler="RemoveFromStore" asp-route-id="@Model.Item.Id" asp-route-kind="users" class="inline-form">
                                        <input type="hidden" name="storeId" value="@u.Id" />
                                        <button type="submit" class="btn btn-sm btn-ghost">@T["profiles.removeFromProfile"]</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var u in Model.Users)
                    {
                        <tr data-search="@(u.Username + " " + u.Email + " " + u.DisplayName)">
                            <td><a asp-page="User" asp-route-profileId="@Model.Item.Id" asp-route-id="@u.Id"><strong>@u.Username</strong></a></td>
                            <td><span class="muted">@T["profiles.ownItem"]</span></td>
                            <td class="muted">@(u.Email ?? "—")</td>
                            <td class="muted">@(u.DisplayName ?? "—")</td>
                            <td>
                                <div class="actions">
                                    <form class="inline-form" method="post" asp-page-handler="DeleteUser" asp-route-id="@Model.Item.Id" asp-route-userId="@u.Id">
                                        <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <partial name="_PayloadTiles" model="Model.UserTiles" />
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        <partial name="_AddMenu" model='AddMenus.Payload(T, "users", Url.Page("User", new { profileId = Model.Item.Id })!, "add.createUser", "users", "import-user")' />
    </div>
    <partial name="_StorePicker" model="Model.UserPicker" />

    <div class="card" id="import-user" hidden>
        <h2>@T["import.userTitle"]</h2>
        <p class="muted">@T["import.userHint"]</p>
        <form method="post" asp-page-handler="ImportUser" asp-route-id="@Model.Item.Id">
            <div class="form-field">
                <textarea name="userJson" rows="6" spellcheck="false" data-code="json" placeholder='{ "Username": "..." }'></textarea>
            </div>
            <div><button type="submit" class="btn btn-ghost">@T["import.btn"]</button></div>
        </form>
    </div>
</div>

@* ============ PLUGINS ============ *@
