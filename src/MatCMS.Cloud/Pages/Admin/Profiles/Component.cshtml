@page "{profileId:int}/{id:int?}"
@model MatCMS.Cloud.Pages.Admin.Profiles.ComponentModel
@{
    ViewData["Title"] = Model.IsNew ? T["profiles.addComponent"] : Model.Item.Name;
    var ec = Model.Item;
}
@* Heading only: every action on this page sits in ONE row at the bottom, in the CMS's order
   (save, export, back, destructive last). Two places for buttons that act on the same form had
   you looking up for what lives down. *@
<div class="page-head">
    <h1>
        @(Model.IsNew ? T["profiles.addComponent"] : Model.Item.Name)
        <span class="muted" style="font-size:14px;font-weight:400;"> — @Model.Owner.Name</span>
    </h1>
</div>

<form method="post" asp-route-profileId="@Model.Owner.Id" asp-route-id="@(Model.IsNew ? null : (int?)ec.Id)" id="component-form">
    @* Reiter mit den gewöhnlichen Klassen des Admin (.tabs/.tab/.tab-panel), genau wie im CMS —
       eine Komponente sieht hier aus wie dort. Was BEWUSST FEHLT, ist der Dateibaum des
       Plugin-Editors: eine Komponente hat keine Dateien, sondern eine Feldliste und EINE Vorlage.
       ACHTUNG: alle Reiterfelder bleiben INNERHALB des Formulars. Ein ausgeblendetes Feld wird
       mit abgeschickt, ein Feld außerhalb des Formulars gar nicht — und käme beim Speichern leer an. *@
    <div class="card">
        <div class="tabs" role="tablist">
            <button type="button" class="tab active" data-tab="general">@T["profiles.tabGeneral"]</button>
            <button type="button" class="tab" data-tab="fields">@T["profiles.componentFields"]</button>
            <button type="button" class="tab" data-tab="template">@T["profiles.componentTemplate"]</button>
        </div>

        <div class="tab-panel form-grid" data-panel="general">
            <div class="form-row">
                <div class="form-field">
                    <label for="ctype">@T["profiles.componentType"]</label>
                    <input id="ctype" name="type" value="@ec.Type" placeholder="hero-cta" spellcheck="false" required />
                    <div class="help">@T["profiles.componentTypeHint"]</div>
                </div>
                <div class="form-field">
                    <label for="cname">@T["common.name"]</label>
                    <input id="cname" name="name" value="@ec.Name" required />
                </div>
            </div>
            <div class="form-row">
                @{
                    var iconVm = new MatCMS.Cloud.Pages.Shared.IconPickVm(
                        ec.Icon, HelpKey: "profiles.componentIconHelp");
                }
                <partial name="_IconPicker" model="iconVm" />
                <div class="form-field">
                    <label for="cdesc">@T["profiles.description"]</label>
                    <input id="cdesc" name="description" value="@ec.Description" />
                </div>
            </div>
        </div>

        <div class="tab-panel form-grid" data-panel="fields" hidden>
            <div class="help">@T["profiles.componentFieldsHelp"]</div>
            <div id="field-rows" data-fields="@(string.IsNullOrWhiteSpace(ec.FieldsJson) ? "[]" : ec.FieldsJson)"></div>
            <div><button type="button" class="btn btn-sm btn-ghost" id="add-field">＋ @T["profiles.addField"]</button></div>
            <input type="hidden" name="fieldsJson" id="FieldsJson" />
        </div>

        @* Vorlage UND Vorschau in einem Reiter: sie standen als zwei Kästen untereinander, die
           Vorschau also außerhalb des Sichtfelds, sobald die Vorlage länger war. Hier wird blind
           gebaut, ohne die Website, auf der der Block landet — die Vorschau ist deshalb nicht
           Beiwerk, sondern das, worauf man beim Schreiben schaut. *@
        <div class="tab-panel form-grid" data-panel="template" hidden>
            <div class="form-field">
                <textarea id="TemplateHtml" name="templateHtml" rows="14" spellcheck="false" data-code="html">@ec.TemplateHtml</textarea>
                <div class="help">@T["profiles.placeholderHelp"] <span id="placeholder-hint" class="mono"></span></div>
            </div>

            <div class="component-preview" id="cp-card">
                <div class="cp-head">
                    <h2>@T["profiles.livePreview"]</h2>
                    <button type="button" class="btn btn-sm btn-ghost" id="cp-debug-toggle">@T["profiles.debug"]</button>
                </div>
                <div class="help">@T["profiles.sampleData"]</div>
                <div class="cp-sample" id="cp-sample"></div>
                <div class="cp-frame-wrap">
                    <iframe id="cp-frame" class="cp-frame" title="@T["profiles.livePreview"]"></iframe>
                </div>
                <div class="cp-debug" id="cp-debug" hidden></div>
            </div>
        </div>
    </div>

</form>

@* Save and delete on one line, positive before negative: what to do with this record is
   one decision, and burying the destructive half in a card further down made it read as a separate
   page. The delete keeps its confirm, which is what actually guards it. *@
<div class="form-actions">
    <button type="submit" class="btn" form="component-form">@T["settings.save"]</button>
    @if (!Model.IsNew)
    {
        <a class="btn btn-ghost" asp-page="Component" asp-page-handler="Export"
           asp-route-profileId="@Model.Owner.Id" asp-route-id="@ec.Id">
            <i class="ti ti-download" aria-hidden="true"></i> @T["components.exportJson"]
        </a>
    }
    <a class="btn btn-ghost" asp-page="Edit" asp-route-id="@Model.Owner.Id" asp-route-tab="components">@T["action.back"]</a>
    @if (!Model.IsNew)
    {
        <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-profileId="@Model.Owner.Id" asp-route-id="@ec.Id"
            onsubmit="return confirm('@T["profiles.componentDeleteConfirm"]');">
            <button type="submit" class="btn btn-danger">@T["common.delete"]</button>
        </form>
    }
</div>


@section Scripts {
    <partial name="_CodeEditorAssets" />
    <partial name="_TabsScript" />
    <script>
        window.CLOUD_FIELD_TYPES = [
            ["text", "@T["profiles.fieldText"]"],
            ["textarea", "@T["profiles.fieldTextarea"]"],
            ["richtext", "@T["profiles.fieldRichtext"]"],
            ["image", "@T["profiles.fieldImage"]"],
            ["url", "@T["profiles.fieldUrl"]"]
        ];
        window.CLOUD_CP = {
            remove: "@T["common.delete"]",
            dbgPlaceholders: "@T["profiles.dbgPlaceholders"]",
            dbgUnknown: "@T["profiles.dbgUnknown"]",
            dbgUnused: "@T["profiles.dbgUnused"]",
            dbgOutput: "@T["profiles.dbgOutput"]",
            dbgOk: "@T["profiles.dbgOk"]",
            dbgEmpty: "@T["profiles.dbgEmpty"]"
        };
        window.CLOUD_PREVIEW_THEME = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            accent = Model.PreviewTheme?.AccentColor,
            heading = Model.PreviewTheme?.HeadingColor,
            text = Model.PreviewTheme?.TextColor,
            background = Model.PreviewTheme?.BackgroundColor,
            altBackground = Model.PreviewTheme?.AltBackground,
            containerWidth = Model.PreviewTheme?.ContainerWidth,
            buttonRadius = Model.PreviewTheme?.ButtonRadius,
            headingFont = Model.PreviewTheme?.HeadingFont,
            bodyFont = Model.PreviewTheme?.BodyFont
        }));
    </script>
    <script src="~/js/component-editor.js" asp-append-version="true"></script>
}
