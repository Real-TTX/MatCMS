@page
@model MatCMS.Pages.Admin.Menus.IndexModel
@{
    ViewData["Title"] = T["menus.title"];
}
<div class="page-head">
    <h1>@T["menus.heading"]</h1>
</div>

<div class="card">
    <h2>@T["menus.headerMenu"]</h2>
    <p class="help">@Html.Raw(T["menus.dragHint"])</p>
    @if (Model.Header.Count == 0)
    {
        <p class="muted">@T["menus.noItems"]</p>
    }
    <div class="block-list sortable" data-sortable data-reorder-form="reorder-header">
        @foreach (var it in Model.Header)
        {
            <div class="block-item sortable-item" data-item-id="@it.Id">
                <span class="drag-handle" title="@T["editor.dragToSort"]" aria-hidden="true">⠿</span>
                <div class="b-info">
                    <div class="b-type">@it.Label</div>
                    <div class="b-sum">@it.Url@(it.OpenInNewTab ? " · " + T["menus.newTab"] : "")</div>
                </div>
                <div class="actions">
                    <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@it.Id">@T["action.edit"]</a>
                    <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@it.Id" onsubmit="return confirm('@T["menus.confirmDelete", it.Label]');">
                        <button type="submit" class="btn btn-sm btn-danger" title="@T["action.delete"]">✕</button>
                    </form>
                </div>
            </div>
        }
    </div>
    <form id="reorder-header" method="post" asp-page-handler="Reorder" asp-route-menu="header" style="display:none;">
        <div data-order-inputs></div>
    </form>
    <div class="list-actions">
        <a class="btn" asp-page="Create" asp-route-menu="header">@T["menus.addItem"]</a>
    </div>
</div>

<div class="card">
    <h2>@T["menus.footerMenu"]</h2>
    <p class="help">@Html.Raw(T["menus.dragHint"])</p>
    @if (Model.Footer.Count == 0)
    {
        <p class="muted">@T["menus.noItems"]</p>
    }
    <div class="block-list sortable" data-sortable data-reorder-form="reorder-footer">
        @foreach (var it in Model.Footer)
        {
            <div class="block-item sortable-item" data-item-id="@it.Id">
                <span class="drag-handle" title="@T["editor.dragToSort"]" aria-hidden="true">⠿</span>
                <div class="b-info">
                    <div class="b-type">@it.Label</div>
                    <div class="b-sum">@it.Url@(it.OpenInNewTab ? " · " + T["menus.newTab"] : "")</div>
                </div>
                <div class="actions">
                    <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@it.Id">@T["action.edit"]</a>
                    <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@it.Id" onsubmit="return confirm('@T["menus.confirmDelete", it.Label]');">
                        <button type="submit" class="btn btn-sm btn-danger" title="@T["action.delete"]">✕</button>
                    </form>
                </div>
            </div>
        }
    </div>
    <form id="reorder-footer" method="post" asp-page-handler="Reorder" asp-route-menu="footer" style="display:none;">
        <div data-order-inputs></div>
    </form>
    <div class="list-actions">
        <a class="btn" asp-page="Create" asp-route-menu="footer">@T["menus.addItem"]</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-sortable.js" asp-append-version="true"></script>
}
