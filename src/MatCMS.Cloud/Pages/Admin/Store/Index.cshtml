@page
@model MatCMS.Cloud.Pages.Admin.Store.IndexModel
@{
    ViewData["Title"] = T["store.title"];
}
<div class="page-head">
    <h1>@T["store.title"]</h1>
</div>


<div class="tabs" role="tablist">
    <button type="button" class="tab active" data-tab="plugins">@T["profiles.tabPlugins"]</button>
    <button type="button" class="tab" data-tab="templates">@T["profiles.tabTemplates"]</button>
    <button type="button" class="tab" data-tab="components">@T["profiles.tabComponents"]</button>
    <button type="button" class="tab" data-tab="mailtemplates">@T["profiles.tabMailTemplates"]</button>
    <button type="button" class="tab" data-tab="matcms">@T["store.matcms.tab"]</button>
</div>

@* ============ MATCMS STORE (matcms.de) ============
   What the store server on matcms.de offers and where this cloud stands with each entry. Taking over checks the signature against the
   store keys in this image; nothing is mirrored by itself. *@
<div class="tab-panel" data-panel="matcms" hidden>
    <div data-list data-list-key="store-matcms">
        <div class="page-head">
            <h2>@T["store.matcms.tab"]</h2>
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
                <a class="btn btn-ghost btn-sm" href="?tab=matcms&amp;refresh=1">@T["store.matcms.refresh"]</a>
            </div>
        </div>
        @if (Model.MatcmsError is not null)
        {
            <div class="alert alert-error">@Model.MatcmsError</div>
        }
        <table class="data" data-list-table>
            <thead>
                <tr><th>@T["common.name"]</th><th>@T["store.publisher"]</th><th>@T["instances.version"]</th><th>@T["store.matcms.here"]</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Matcms.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["store.matcms.empty"]' />
                }
                @foreach (var e in Model.Matcms)
                {
                    <tr data-search="@(e.Name + " " + e.Key + " " + e.Publisher + " " + e.Summary)">
                        <td>
                            <strong>@e.Name</strong> <span class="badge badge-off">@(e.Kind == "native" ? "Native" : T["store.matcms.script"])</span>
                            <div class="muted">@(e.Summary.Length > 0 ? e.Summary : e.Description)</div>
                            <div class="muted mono">@e.Key</div>
                        </td>
                        <td>@e.Publisher@(e.PublisherVerified ? " ✓" : "")</td>
                        <td class="mono">@e.Version</td>
                        <td>
                            @switch (e.State)
                            {
                                case "current": <span class="badge badge-on">@T["store.matcms.current"]</span> break;
                                case "update": <span class="badge badge-new">@T["store.matcms.update", e.LocalVersion]</span> break;
                                case "own": <span class="badge badge-err">@T["store.matcms.own", e.LocalVersion]</span> break;
                                default: <span class="badge badge-off">@T["store.matcms.notHere"]</span> break;
                            }
                        </td>
                        <td>
                            <div class="actions">
                                @if (e.Page.StartsWith("https://") || e.Page.StartsWith("http://"))
                                {
                                    <a class="btn btn-sm btn-ghost" href="@e.Page" target="_blank" rel="noopener" title="@T["store.matcms.page"]"><i class="ti ti-external-link" aria-hidden="true"></i> <span class="btn-label">@T["store.matcms.page"]</span></a>
                                }
                                @if (e.State is "new" or "update")
                                {
                                    <form method="post" asp-page-handler="TakeOver" class="inline-form">
                                        <input type="hidden" name="key" value="@e.Key" />
                                        <button type="submit" class="btn btn-sm">@(e.State == "new" ? T["store.matcms.take"] : T["store.matcms.takeUpdate"])</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        <div class="help">@T["store.matcms.help", Model.MatcmsUrl]</div>
    </div>
</div>

@* ============ PLUGINS ============ *@
<div class="tab-panel" data-panel="plugins">
    <div data-list data-list-key="store-plugins" class="list-view-table">
        <div class="page-head">
            <h2>@T["profiles.tabPlugins"]</h2>
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
                <partial name="_ViewToggle" />
            </div>
        </div>
        <table class="data" data-list-table>
            <thead>
                <tr><th>@T["common.name"]</th><th>@T["profiles.pluginKey"]</th><th>@T["instances.version"]</th><th>@T["store.usedBy"]</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Plugins.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["store.noPlugins"]' />
                }
                else
                {
                    @foreach (var p in Model.Plugins)
                    {
                        <tr data-search="@(p.Name + " " + p.Key + " " + p.Description)">
                            <td>
                                <a asp-page="Plugin" asp-route-id="@p.Id"><strong>@p.Name</strong></a>
                                <div class="muted">@p.Description</div>
                            </td>
                            <td class="mono">@p.Key</td>
                            <td class="mono">@p.Version</td>
                            <td><span class="badge badge-off">@T["store.profileCount", Model.Uses(Model.PluginUse, p.Id)]</span></td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-sm btn-ghost" asp-page="Plugin" asp-route-id="@p.Id" title="@T["action.edit"]"><i class="ti ti-pencil" aria-hidden="true"></i> <span class="btn-label">@T["action.edit"]</span></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <partial name="_PayloadTiles" model="Model.PluginTiles" />
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        @* Same dialog as a profile's, minus "Aus Global" — this IS the global side. No import for a
           plugin either: its create page is the bundle upload. *@
        <partial name="_AddMenu" model='AddMenus.Payload(T, "store-plugins", Url.Page("Plugin")!, "add.createPlugin")' />
    </div>
</div>

@* ============ TEMPLATES ============ *@
<div class="tab-panel" data-panel="templates" hidden>
    <div data-list data-list-key="store-templates" class="list-view-table">
        <div class="page-head">
            <h2>@T["profiles.tabTemplates"]</h2>
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
                <partial name="_ViewToggle" />
            </div>
        </div>
        <table class="data" data-list-table>
            <thead>
                <tr><th>@T["common.name"]</th><th>@T["profiles.templateColors"]</th><th>@T["profiles.templateFonts"]</th><th>@T["store.usedBy"]</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Templates.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["store.noTemplates"]' />
                }
                else
                {
                    @foreach (var t in Model.Templates)
                    {
                        <tr data-search="@(t.Name + " " + t.Description)">
                            <td>
                                <a asp-page="Template" asp-route-id="@t.Id"><strong>@t.Name</strong></a>
                                <div class="muted">@t.Description</div>
                            </td>
                            <td><span class="token-chip" style="background:@t.AccentColor;color:#fff;border-color:@t.AccentColor;">@t.AccentColor</span></td>
                            <td class="muted">@t.HeadingFont / @t.BodyFont</td>
                            <td><span class="badge badge-off">@T["store.profileCount", Model.Uses(Model.TemplateUse, t.Id)]</span></td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-sm btn-ghost" asp-page="Template" asp-route-id="@t.Id" title="@T["action.edit"]"><i class="ti ti-pencil" aria-hidden="true"></i> <span class="btn-label">@T["action.edit"]</span></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <partial name="_PayloadTiles" model="Model.TemplateTiles" />
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        <partial name="_AddMenu" model='AddMenus.Payload(T, "store-templates", Url.Page("Template")!, "add.createTemplate", null, "import-store-template")' />
    </div>

    @* Posts to the Template page's own Import handler rather than a copy of it here — one parser for
       the store's templates, and it lands the operator on the imported template afterwards. *@
    <div class="card" id="import-store-template" hidden>
        <h2>@T["profiles.templateImport"]</h2>
        <p class="muted">@T["profiles.templateImportHint"]</p>
        <form method="post" asp-page="Template" asp-page-handler="Import">
            <div class="form-field">
                <textarea name="templateJson" rows="6" spellcheck="false" data-code="json" placeholder='{ "Name": "..." }'></textarea>
            </div>
            <div><button type="submit" class="btn btn-ghost">@T["import.btn"]</button></div>
        </form>
    </div>
</div>

@* ============ COMPONENTS ============ *@
<div class="tab-panel" data-panel="components" hidden>
    <div data-list data-list-key="store-components" class="list-view-table">
        <div class="page-head">
            <h2>@T["profiles.tabComponents"]</h2>
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
                <partial name="_ViewToggle" />
            </div>
        </div>
        <table class="data" data-list-table>
            <thead>
                <tr><th>@T["common.name"]</th><th>@T["profiles.componentType"]</th><th>@T["store.usedBy"]</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Components.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["store.noComponents"]' />
                }
                else
                {
                    @foreach (var c in Model.Components)
                    {
                        <tr data-search="@(c.Name + " " + c.Type + " " + c.Description)">
                            <td>
                                <a asp-page="Component" asp-route-id="@c.Id"><strong>@c.Name</strong></a>
                                <div class="muted">@c.Description</div>
                            </td>
                            <td class="mono">@c.Type</td>
                            <td><span class="badge badge-off">@T["store.profileCount", Model.Uses(Model.ComponentUse, c.Id)]</span></td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-sm btn-ghost" asp-page="Component" asp-route-id="@c.Id" title="@T["action.edit"]"><i class="ti ti-pencil" aria-hidden="true"></i> <span class="btn-label">@T["action.edit"]</span></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <partial name="_PayloadTiles" model="Model.ComponentTiles" />
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        <partial name="_AddMenu" model='AddMenus.Payload(T, "store-components", Url.Page("Component")!, "add.createComponent", null, "import-store-component")' />
    </div>

    <div class="card" id="import-store-component" hidden>
        <h2>@T["import.componentTitle"]</h2>
        <p class="muted">@T["import.componentHint"]</p>
        <form method="post" asp-page-handler="ImportComponent">
            <div class="form-field">
                <textarea name="componentJson" rows="6" spellcheck="false" data-code="json" placeholder='{ "Type": "..." }'></textarea>
            </div>
            <div><button type="submit" class="btn btn-ghost">@T["import.btn"]</button></div>
        </form>
    </div>
</div>


@* ============ MAIL-VORLAGEN ============ *@
<div class="tab-panel" data-panel="mailtemplates" hidden>
    <div data-list>
        <div class="page-head">
            <h2>@T["profiles.tabMailTemplates"]</h2>
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
            </div>
        </div>
        <table class="data" data-list-table>
            <thead>
                <tr><th>@T["common.name"]</th><th>@T["mailtpl.key"]</th><th>@T["mailtpl.subject"]</th><th>@T["store.usedBy"]</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.MailTemplates.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["store.noMailTemplates"]' />
                }
                else
                {
                    @foreach (var m in Model.MailTemplates)
                    {
                        <tr data-search="@(m.Name + " " + m.Key + " " + m.Subject)">
                            <td>
                                <a asp-page="MailTemplate" asp-route-id="@m.Id"><strong>@m.Name</strong></a>
                                <div class="muted">@m.Description</div>
                            </td>
                            <td class="mono">@m.Key</td>
                            <td class="muted">@m.Subject</td>
                            <td><span class="badge badge-off">@T["store.profileCount", Model.Uses(Model.MailTemplateUse, m.Id)]</span></td>
                            <td>
                                <div class="actions">
                                    @if (!m.Enabled)
                                    {
                                        <span class="badge badge-off">@T["mailtpl.disabled"]</span>
                                    }
                                    <a class="btn btn-sm btn-ghost" asp-page="MailTemplate" asp-route-id="@m.Id" title="@T["action.edit"]"><i class="ti ti-pencil" aria-hidden="true"></i> <span class="btn-label">@T["action.edit"]</span></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        <partial name="_AddMenu" model='AddMenus.Payload(T, "store-mailtemplates", Url.Page("MailTemplate")!, "mailtpl.add", null, "import-store-mail")' />
    </div>

    <div class="card" id="import-store-mail" hidden>
        <h2>@T["mailtpl.import"]</h2>
        <p class="muted">@T["mailtpl.importHint"]</p>
        <form method="post" asp-page-handler="ImportMailTemplate">
            <div class="form-field">
                <textarea name="mailJson" rows="6" spellcheck="false" data-code="json" placeholder='{ "Key": "form.submission" }'></textarea>
            </div>
            <div><button type="submit" class="btn btn-ghost">@T["import.btn"]</button></div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_CodeEditorAssets" />
    <partial name="_TabsScript" />
}
