@page
@model MatCMS.Pages.Admin.IndexModel
@{
    ViewData["Title"] = T["dashboard.title"];
    var dashUser = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Admin";
}
<div class="page-head">
    <h1>@T["dashboard.title"]</h1>
    @* Only the greeting: "Website" and "Abmelden" are in the topbar already (the view switch and the logout icon). *@
    <span class="muted">@T["dashboard.welcome"] <strong>@dashUser</strong></span>
    <button type="button" class="btn btn-ghost btn-sm" data-dash-cfg-open aria-controls="dash-cfg">@T["dashboard.customize"]</button>
</div>

@if (!Model.SetupComplete)
{
    <div class="alert alert-info setup-banner">
        <div>
            @Html.Raw(T["dashboard.setupBanner"])
        </div>
        <a class="btn btn-sm" asp-page="/Admin/Setup/Index">@T["dashboard.setupStart"]</a>
    </div>
}

@* ---- Customise: what to show and in which order — per user; an admin may make it the default for everybody. ---- *@
<div class="card dash-cfg" id="dash-cfg" hidden>
    <h2>@T["dashboard.cfg.title"]</h2>
    <p class="muted">@T["dashboard.cfg.help"]</p>
    <form method="post" asp-page-handler="Layout">
        <ul class="dash-cfg-list">
            @foreach (var w in Model.AllWidgets)
            {
                <li class="dash-cfg-row">
                    <input type="hidden" name="id" value="@w.Id" />
                    <label class="check"><input type="checkbox" name="show" value="@w.Id" checked="@(!Model.HiddenWidgets.Contains(w.Id))" /> @w.Label @if (w.Note is not null) { <span class="muted">· @w.Note</span> }</label>
                    <span class="dash-cfg-move">
                        <button type="button" class="btn btn-ghost btn-sm btn-icon" data-dash-up title="@T["dashboard.cfg.up"]" aria-label="@T["dashboard.cfg.up"]"><i class="ti ti-arrow-up" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-ghost btn-sm btn-icon" data-dash-down title="@T["dashboard.cfg.down"]" aria-label="@T["dashboard.cfg.down"]"><i class="ti ti-arrow-down" aria-hidden="true"></i></button>
                    </span>
                </li>
            }
        </ul>
        @if (Model.IsAdmin)
        {
            <label class="check"><input type="checkbox" name="asDefault" value="true" /> @T["dashboard.cfg.default"]</label>
        }
        <div class="form-actions">
            <button type="submit" class="btn">@T["dashboard.cfg.save"]</button>
            @if (Model.OwnLayout || (Model.IsAdmin && Model.SiteDefault))
            {
                <button type="submit" class="btn btn-ghost" formaction="@Url.Page("/Admin/Index", "ResetLayout")">@T["dashboard.cfg.reset"]</button>
            }
            @if (Model.IsAdmin && Model.SiteDefault)
            {
                <button type="submit" class="btn btn-ghost" formaction="@Url.Page("/Admin/Index", "ResetLayout", new { everybody = true })" data-confirm="@T["dashboard.cfg.resetAllConfirm"]">@T["dashboard.cfg.resetAll"]</button>
            }
            <button type="button" class="btn btn-ghost" data-dash-cfg-close>@T["action.cancel"]</button>
        </div>
    </form>
</div>

@* ---- The widgets in the user's order. One column of rows with one gap between them: a wide widget is a row, cards share a grid row. ---- *@
<div class="dash-stack">
    @foreach (var row in Model.Rows)
    {
        if (row[0].Wide)
        {
            @await Html.PartialAsync(row[0].Partial, row[0].Model ?? Model)
        }
        else
        {
            <div class="dash-grid">
                @foreach (var w in row)
                {
                    @await Html.PartialAsync(w.Partial, w.Model ?? Model)
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/dash-customize.js" asp-append-version="true"></script>
}
