@page
@model MatCMS.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = T["users.title"];
    var me = User.Identity?.Name;
}
<div class="page-head">
    <h1>@T["users.title"]</h1>
</div>

<table class="data">
    <thead>
        <tr>
            <th>@T["users.colUsername"]</th>
            <th>@T["users.colDisplayName"]</th>
            <th>@T["users.colRole"]</th>
            <th>@T["users.colCreated"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Items)
        {
            <tr>
                <td><strong>@u.Username</strong> @(u.Username == me ? T["users.you"] : "")</td>
                <td>@(string.IsNullOrWhiteSpace(u.DisplayName) ? "—" : u.DisplayName)</td>
                <td>@u.Role</td>
                <td class="muted">@u.CreatedAt.ToString("dd.MM.yyyy")</td>
                <td>
                    <div class="actions">
                        <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@u.Id">@T["action.edit"]</a>
                        <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@u.Id" onsubmit="return confirm('@T["users.confirmDelete", u.Username]');">
                            <button type="submit" class="btn btn-sm btn-danger">@T["action.delete"]</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="list-actions">
    <a class="btn" asp-page="Create">@T["users.create"]</a>
</div>
