@page "/login/2fa"
@model MatCMS.Cloud.Pages.Login2faModel
@inject MatCMS.Cloud.Services.CloudContext Cloud
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de" data-app="matcms" data-theme="light" data-density="compact">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@T["login.2fa.pageTitle"] – @Cloud.CloudName</title>
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/lib/matui/matui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cloud.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin-matui.css" asp-append-version="true" />
    <link rel="icon" href="@Cloud.LogoUrl" />
</head>
<body class="login-page login-matui">
    <div class="login-card">
        <img class="login-logo" src="@Cloud.LogoUrl" alt="@Cloud.CloudName" />
        <h1>@T["login.2fa.heading"]</h1>
        <p class="help" style="text-align:center;">@T["login.2fa.intro"]</p>
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert-error">@Model.Error</div>
        }
        <form method="post">
            <div class="form-field">
                <label for="Code">@T["login.2fa.code"]</label>
                <input id="Code" name="Code" inputmode="numeric" autocomplete="one-time-code"
                       autofocus required value="" />
                <div class="help">@T["login.2fa.recoveryHint"]</div>
            </div>
            <button type="submit" class="btn btn-block">@T["login.2fa.submit"]</button>
        </form>
        <a class="login-back" href="/login">@T["login.2fa.cancel"]</a>
    </div>
</body>
</html>
