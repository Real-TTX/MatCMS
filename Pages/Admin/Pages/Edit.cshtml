@page "{id:int}"
@model MatCMS.Pages.Admin.Pages.EditModel
@{
    ViewData["Title"] = T["editor.title"];
    var blocks = Model.Current.Blocks.Where(b => b.ParentId == null).OrderBy(b => b.SortOrder).ToList();
    // Preview must load the page IN ITS OWN LOCALE (…/en/slug), not the prefix-less default URL —
    // otherwise switching the version selector shows the editor for the right page but the German
    // preview. LocalizedUrl adds the "/{locale}" prefix for non-default locales (default = root URLs).
    var url = MatCMS.Services.SiteContext.LocalizedUrl(Model.Current.Locale, Model.Current.Slug);
    var previewUrl = url + (url.Contains('?') ? "&" : "?") + "editor=1";
    var editing = Model.SelectedBlock is not null && Model.SelectedDef is not null;
}

<div class="live-editor" data-page-id="@Model.Current.Id" data-selected-block="@(Model.SelectedBlock?.Id)">
    @Html.AntiForgeryToken()
    <script id="page-blocks" type="application/json">@Html.Raw(Model.BlocksJson.Replace("</", "<\\/"))</script>
    <aside class="le-sidebar">
        @if (editing)
        {
            <div class="le-head">
                <a class="le-back" asp-page="Edit" asp-route-id="@Model.Current.Id">@T["editor.allBlocks"]</a>
            </div>
            <div class="le-panel">
                <div class="le-panel-head">
                    <span class="head-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(Model.SelectedDef!.Svg)</svg>
                    </span>
                    <span class="le-panel-title">@T[Model.SelectedDef!.Name]</span>
                </div>
                @{
                    var _sel = Model.SelectedBlock!;
                    var _all = Model.Current.Blocks;
                    MatCMS.Models.ContentBlock? _root = _sel.ParentId != null
                        ? _all.FirstOrDefault(b => b.Id == _sel.ParentId)
                        : (Model.SelectedDef!.IsContainer ? _sel : null);
                    var _kids = _root != null
                        ? _all.Where(b => b.ParentId == _root.Id).OrderBy(b => b.SortOrder).ToList()
                        : new List<MatCMS.Models.ContentBlock>();
                }
                @if (_root != null && _kids.Count > 0)
                {
                    var _rdef = Model.Registry.Get(_root.BlockType);
                    <div class="le-family">
                        <div class="le-section-label">@T["editor.blockTree"]</div>
                        <div class="block-list">
                            <div class="block-group">
                                <div class="block-item@(_root.Id == _sel.Id ? " active" : "")" data-block-id="@_root.Id">
                                    <a class="b-open" asp-page="Edit" asp-route-id="@Model.Current.Id" asp-route-block="@_root.Id">
                                        <span class="b-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(_rdef?.Svg)</svg></span>
                                        <span class="b-info"><span class="b-type">@(_rdef is not null ? T[_rdef.Name] : _root.BlockType)</span></span>
                                    </a>
                                </div>
                                <div class="block-children sortable" data-sortable data-reorder-form="child-reorder-form">
                                    @foreach (var _k in _kids)
                                    {
                                        var _kdef = Model.Registry.Get(_k.BlockType);
                                        <div class="block-item block-child sortable-item@(_k.Id == _sel.Id ? " active" : "")" data-item-id="@_k.Id" data-block-id="@_k.Id">
                                            <span class="drag-handle" title="@T["editor.dragToSort"]" aria-hidden="true">⠿</span>
                                            <a class="b-open" asp-page="Edit" asp-route-id="@Model.Current.Id" asp-route-block="@_k.Id">
                                                <span class="b-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(_kdef?.Svg)</svg></span>
                                                <span class="b-info"><span class="b-type">@(_kdef is not null ? T[_kdef.Name] : _k.BlockType)</span></span>
                                            </a>
                                        </div>
                                    }
                                </div>
                                <form id="child-reorder-form" method="post" asp-page-handler="Reorder" asp-route-id="@Model.Current.Id" style="display:none;">
                                    <div data-order-inputs></div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                <form id="block-form" method="post" asp-page-handler="SaveBlock" asp-route-id="@Model.Current.Id" asp-route-blockId="@Model.SelectedBlock!.Id">
                    <input type="hidden" name="DataJson" id="DataJson" />
                    <div id="block-editor"></div>
                </form>
                @* Compact icon-only action row: delete flush-left, save + done on the right — never wraps. *@
                <div class="le-panel-actions">
                    <form class="inline-form le-delete" method="post" asp-page-handler="DeleteBlock" asp-route-id="@Model.Current.Id" asp-route-blockId="@Model.SelectedBlock!.Id" onsubmit="return confirm('@T["editor.confirmDeleteBlock"]');">
                        <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["editor.blockDelete"]" aria-label="@T["editor.blockDelete"]"><i class="ti ti-trash" aria-hidden="true"></i></button>
                    </form>
                    <button type="submit" form="block-form" class="btn btn-sm btn-icon le-save" title="@T["action.save"]" aria-label="@T["action.save"]"><i class="ti ti-device-floppy" aria-hidden="true"></i></button>
                    <a class="btn btn-sm btn-ghost btn-icon" asp-page="Edit" asp-route-id="@Model.Current.Id" title="@T["editor.done"]" aria-label="@T["editor.done"]"><i class="ti ti-check" aria-hidden="true"></i></a>
                </div>
            </div>
            <script id="block-schema" type="application/json">@Html.Raw(Model.SchemaJson.Replace("</", "<\\/"))</script>
            <script id="block-data" type="application/json">@Html.Raw(Model.CurrentJson.Replace("</", "<\\/"))</script>
        }
        else
        {
            <div class="le-head">
                <a class="le-back" asp-page="Index">@T["editor.backToPages"]</a>
                <div class="le-title">@Model.Current.Title</div>
            </div>

            <div class="le-scroll">
                @if (Model.SupportedLocales.Count > 1)
                {
                    @* Language versions of this page — placed above the block list (under the breadcrumb).
                       Model.Translations already includes the current page, so iterate it directly
                       (no Append → no duplicate current-locale entry). *@
                    var versions = Model.Translations
                        .OrderBy(p => Array.IndexOf(MatCMS.Services.Localizer.SupportedCultures.ToArray(), p.Locale)).ToList();
                    <div class="le-versions">
                        <select id="le-verselect" class="le-verselect" aria-label="@T["editor.language"]" onchange="if(this.value){window.location.href=this.value;}">
                            @foreach (var v in versions)
                            {
                                var isCur = v.Id == Model.Current.Id;
                                <option value="@Url.Page("Edit", new { id = v.Id })" selected="@(isCur ? "selected" : null)">@v.Locale.ToUpperInvariant() — @MatCMS.Services.Localizer.DisplayName(v.Locale)@(isCur ? " ✓" : "")</option>
                            }
                        </select>
                        @foreach (var loc in Model.MissingLocales)
                        {
                            <form method="post" asp-page-handler="CreateTranslation" asp-route-id="@Model.Current.Id" asp-route-locale="@loc" class="le-ver-addform">
                                <button type="submit" class="le-ver-add" title="@T["editor.addVersionTitle", MatCMS.Services.Localizer.DisplayName(loc)]">+ @loc.ToUpperInvariant()</button>
                            </form>
                        }
                        @if (Model.TranslatorConfigured && Model.Current.Locale != MatCMS.Services.Localizer.DefaultCulture)
                        {
                            <form method="post" asp-page-handler="AutoTranslate" asp-route-id="@Model.Current.Id" class="le-ver-addform"
                                  onsubmit="return confirm('@T["editor.autoTranslateConfirm"]');">
                                <button type="submit" class="le-ver-add" title="@T["editor.autoTranslateTitle"]">⚡ @T["editor.autoTranslate"]</button>
                            </form>
                        }
                    </div>
                }
                <div class="le-section-label">@T["editor.blocks"]</div>
                @if (blocks.Count == 0)
                {
                    <p class="muted" style="padding:0 4px;">@T["editor.noBlocks"]</p>
                }
                <div class="block-list sortable" id="block-list" data-sortable data-reorder-form="reorder-form">
                    @foreach (var b in blocks)
                    {
                        var def = Model.Registry.Get(b.BlockType);
                        var isContainer = def is not null && def.IsContainer;
                        <div class="block-group sortable-item" data-item-id="@b.Id">
                            <div class="block-item" data-block-id="@b.Id">
                                <span class="drag-handle" title="@T["editor.dragToSort"]" aria-hidden="true">⠿</span>
                                <a class="b-open" asp-page="Edit" asp-route-id="@Model.Current.Id" asp-route-block="@b.Id">
                                    <span class="b-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(def?.Svg)</svg>
                                    </span>
                                    <span class="b-info">
                                        <span class="b-type">@(def is not null ? T[def.Name] : b.BlockType)</span>
                                        <span class="b-sum">@Model.BlockSummary(b)</span>
                                    </span>
                                </a>
                                <form class="inline-form" method="post" asp-page-handler="DeleteBlock" asp-route-id="@Model.Current.Id" asp-route-blockId="@b.Id" onsubmit="return confirm('@T["editor.confirmDeleteBlock"]');">
                                    <button type="submit" class="icon-btn" title="@T["editor.delete"]">✕</button>
                                </form>
                            </div>
                            @if (isContainer)
                            {
                                var children = Model.Current.Blocks.Where(c => c.ParentId == b.Id).OrderBy(c => c.SortOrder).ToList();
                                <div class="block-children">
                                    @foreach (var c in children)
                                    {
                                        var cdef = Model.Registry.Get(c.BlockType);
                                        <div class="block-item block-child" data-block-id="@c.Id">
                                            <a class="b-open" asp-page="Edit" asp-route-id="@Model.Current.Id" asp-route-block="@c.Id">
                                                <span class="b-icon">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(cdef?.Svg)</svg>
                                                </span>
                                                <span class="b-info">
                                                    <span class="b-type">@(cdef is not null ? T[cdef.Name] : c.BlockType)</span>
                                                    <span class="b-sum">@Model.BlockSummary(c)</span>
                                                </span>
                                            </a>
                                            <form class="inline-form" method="post" asp-page-handler="DeleteBlock" asp-route-id="@Model.Current.Id" asp-route-blockId="@c.Id" onsubmit="return confirm('@T["editor.confirmDeleteBlock"]');">
                                                <button type="submit" class="icon-btn" title="@T["editor.delete"]">✕</button>
                                            </form>
                                        </div>
                                    }
                                    @foreach (var ct in def!.AllowedChildren)
                                    {
                                        var ctDef = Model.Registry.Get(ct);
                                        <form class="inline-form" method="post" asp-page-handler="AddBlock" asp-route-id="@Model.Current.Id" asp-route-type="@ct" asp-route-parentId="@b.Id">
                                            <button type="submit" class="btn btn-sm btn-ghost add-child">＋ @(ctDef is not null ? T[ctDef.Name] : ct)</button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                <form id="reorder-form" method="post" asp-page-handler="Reorder" asp-route-id="@Model.Current.Id" style="display:none;">
                    <div data-order-inputs></div>
                </form>

                <div class="le-add">
                    <button type="button" class="btn btn-block" id="add-block-btn">@T["editor.addBlock"]</button>
                </div>

                <details class="le-settings">
                    <summary>@T["editor.pageSettings"]</summary>
                    <form method="post" asp-page-handler="Meta" asp-route-id="@Model.Current.Id" class="form-grid">
                        <div class="form-field">
                            <label>@T["editor.metaTitle"]</label>
                            <input name="Meta.Title" value="@Model.Meta.Title" required />
                        </div>
                        <div class="form-field">
                            <label>@T["editor.slug"]</label>
                            <input name="Meta.Slug" value="@Model.Meta.Slug" required />
                        </div>
                        @if (Model.SupportedLocales.Count > 1)
                        {
                            <div class="form-field">
                                <label>@T["editor.locale"]</label>
                                <select name="Meta.Locale">
                                    @foreach (var loc in Model.SupportedLocales)
                                    {
                                        <option value="@loc" selected="@(loc == Model.Meta.Locale)">@T["lang." + loc]</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="Meta.Locale" value="@Model.Meta.Locale" />
                        }
                        <div class="form-field">
                            <label>@T["editor.metaDescription"]</label>
                            <input name="Meta.MetaDescription" value="@Model.Meta.MetaDescription" />
                        </div>
                        <label class="check">
                            <input type="checkbox" name="Meta.IsPublished" value="true" @(Model.Meta.IsPublished ? "checked" : "") /> @T["editor.published"]
                        </label>
                        <div><button type="submit" class="btn btn-sm">@T["action.save"]</button></div>
                    </form>
                </details>

                @if (Model.SupportedLocales.Count > 1)
                {
                    <details class="le-settings">
                        <summary>@T["editor.translations"]</summary>
                        <div class="form-grid">
                            <div class="le-section-label">@T["editor.translationsExisting"]</div>
                            @if (Model.Translations.Count > 1)
                            {
                                <a class="btn btn-sm btn-ghost" asp-page="Diff" asp-route-id="@Model.Current.Id" style="margin-bottom:8px;">⇄ @T["diff.title"]</a>
                            }
                            @foreach (var t in Model.Translations)
                            {
                                <div class="block-item">
                                    <span class="badge badge-on mono">@t.Locale</span>
                                    @if (t.Id == Model.Current.Id)
                                    {
                                        <span class="b-info"><span class="b-type">@t.Title @T["editor.translationCurrent"]</span></span>
                                    }
                                    else
                                    {
                                        <a class="b-open" asp-page="Edit" asp-route-id="@t.Id">
                                            <span class="b-info"><span class="b-type">@t.Title</span></span>
                                        </a>
                                    }
                                </div>
                            }

                            @foreach (var loc in Model.MissingLocales)
                            {
                                <form method="post" asp-page-handler="CreateTranslation" asp-route-id="@Model.Current.Id" asp-route-locale="@loc">
                                    <button type="submit" class="btn btn-sm btn-ghost">@T["editor.translationCreate", T["lang." + loc]]</button>
                                </form>
                            }

                            @if (Model.LinkCandidates.Count > 0)
                            {
                                <form method="post" asp-page-handler="LinkTranslation" asp-route-id="@Model.Current.Id" class="form-row">
                                    <div class="form-field">
                                        <label>@T["editor.translationLink"]</label>
                                        <select name="targetId">
                                            @foreach (var c in Model.LinkCandidates)
                                            {
                                                <option value="@c.Id">[@c.Locale] @c.Title</option>
                                            }
                                        </select>
                                    </div>
                                    <div><button type="submit" class="btn btn-sm">@T["editor.translationLinkSubmit"]</button></div>
                                </form>
                            }
                        </div>
                    </details>
                }
            </div>

            @* Add-block modal *@
            <div class="modal-overlay" id="add-block-modal">
                <div class="modal" role="dialog" aria-modal="true" aria-label="@T["editor.addBlockModal"]">
                    <div class="modal-head">
                        <h2>@T["editor.addBlockModal"]</h2>
                        <button type="button" class="modal-close" id="add-block-close" aria-label="@T["editor.close"]">✕</button>
                    </div>
                    <div class="modal-body bpick">
                        @{
                            var pdefs = Model.Registry.All.Where(d => !d.ChildOnly).ToList();
                            var catOrder = new[] { "layout", "text", "media", "design", "form", "embed", "plugins", "custom" };
                            var present = catOrder.Where(k => pdefs.Any(d => d.Category == k)).ToList();
                        }
                        <div class="bpick-search">
                            <svg class="bpick-sico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
                            <input type="search" id="bpick-search" placeholder="@T["editor.searchBlocks"]" autocomplete="off" />
                        </div>
                        <div class="bpick-layout">
                            <aside class="bpick-cats">
                                <button type="button" class="bpick-cat bpick-cat-fav" data-cat="fav"><span class="bpick-clabel"><span class="bpick-cico">★</span>@T["blockcat.fav"]</span><span class="bpick-n" data-count="fav">0</span></button>
                                <button type="button" class="bpick-cat bpick-cat-recent" data-cat="recent"><span class="bpick-clabel"><span class="bpick-cico">🕘</span>@T["blockcat.recent"]</span><span class="bpick-n" data-count="recent">0</span></button>
                                <div class="bpick-sep"></div>
                                <button type="button" class="bpick-cat is-active" data-cat="all"><span class="bpick-clabel">@T["blockcat.all"]</span><span class="bpick-n">@pdefs.Count</span></button>
                                @foreach (var k in present)
                                {
                                    <button type="button" class="bpick-cat" data-cat="@k"><span class="bpick-clabel">@T["blockcat." + k]</span><span class="bpick-n">@pdefs.Count(d => d.Category == k)</span></button>
                                }
                            </aside>
                            <div class="bpick-main">
                                @foreach (var k in present)
                                {
                                    <section class="bpick-group" data-group="@k">
                                        <div class="bpick-grouphead">@T["blockcat." + k]</div>
                                        <div class="bpick-grid">
                                            @foreach (var def in pdefs.Where(d => d.Category == k))
                                            {
                                                <form method="post" asp-page-handler="AddBlock" asp-route-id="@Model.Current.Id" asp-route-type="@def.Type">
                                                    <input type="hidden" name="position" class="add-position" value="" />
                                                    <button type="button" class="tile-fav" data-type="@def.Type" aria-label="@T["editor.favToggle"]" title="@T["editor.favToggle"]">★</button>
                                                    <button type="submit" class="tile" data-cat="@def.Category" data-type="@def.Type"
                                                            title="@T[def.Description]"
                                                            data-name="@(((string)T[def.Name]).ToLowerInvariant())"
                                                            data-desc="@(((string)T[def.Description]).ToLowerInvariant())">
                                                        <span class="t-icon">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(def.Svg)</svg>
                                                        </span>
                                                        <span class="t-name">@T[def.Name]</span>
                                                        <span class="t-desc">@T[def.Description]</span>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </section>
                                }
                                <p class="bpick-empty" hidden>@T["editor.noBlocksFound"]</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </aside>

    <main class="le-preview">
        <div class="le-toolbar">
            <span class="le-url mono">@url</span>
            <a class="btn btn-sm btn-ghost" href="@url" target="_blank">@T["editor.openNewTab"]</a>
        </div>
        <div class="le-frame-wrap">
            <iframe id="preview-frame" src="@previewUrl" title="@T["editor.livePreview"]"></iframe>
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/admin-sortable.js" asp-append-version="true"></script>
    <script src="~/js/admin-blocks.js" asp-append-version="true"></script>
    <script src="~/js/admin-page-editor.js" asp-append-version="true"></script>
    <style>
        /* Categorised block picker */
        #add-block-modal .modal { width: min(1040px, 94vw); max-width: 94vw; }
        .bpick { display: flex; flex-direction: column; gap: 14px; }
        .bpick-search { position: relative; }
        .bpick-search input { width: 100%; padding: 11px 14px 11px 40px; border-radius: 10px;
            border: 1px solid rgba(128,128,128,.28); background: rgba(128,128,128,.08); color: inherit; font-size: 14px; }
        .bpick-search input:focus { outline: none; border-color: var(--accent, #2b6cff); }
        .bpick-sico { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; opacity: .5; }
        .bpick-layout { display: grid; grid-template-columns: 190px 1fr; gap: 16px; align-items: start; }
        @@media (max-width: 680px) { .bpick-layout { grid-template-columns: 1fr; } .bpick-cats { flex-direction: row; overflow-x: auto; border-right: none; } }
        .bpick-cats { display: flex; flex-direction: column; gap: 2px; border-right: 1px solid rgba(128,128,128,.2); padding-right: 8px; }
        .bpick-cat { display: flex; align-items: center; justify-content: space-between; gap: 8px; white-space: nowrap;
            text-align: left; padding: 9px 12px; border-radius: 8px; border: none; background: none; color: inherit; cursor: pointer; font-size: 13.5px; }
        .bpick-cat:hover { background: rgba(128,128,128,.14); }
        .bpick-cat.is-active { background: var(--accent, #2b6cff); color: #fff; }
        .bpick-clabel { display: inline-flex; align-items: center; gap: 7px; }
        .bpick-cico { font-size: 13px; line-height: 1; }
        .bpick-cat-fav .bpick-cico { color: #e6a700; }
        .bpick-cat.is-active .bpick-cico { color: #fff; }
        .bpick-sep { height: 1px; background: rgba(128,128,128,.22); margin: 8px 6px; }
        .bpick-n { font-size: 11.5px; opacity: .75; background: rgba(128,128,128,.22); padding: 1px 8px; border-radius: 999px; }
        .bpick-cat.is-active .bpick-n { background: rgba(255,255,255,.25); opacity: 1; color: #fff; }
        @@media (max-width: 680px) { .bpick-sep { width: 1px; height: auto; margin: 4px 6px; } }
        .bpick-main { max-height: 60vh; overflow-y: auto; padding-right: 4px; }
        .bpick-grouphead { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; opacity: .55; margin: 0 0 10px; }
        .bpick-group + .bpick-group { margin-top: 14px; }
        .bpick-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 10px; grid-auto-rows: 1fr; }
        .bpick-grid form { margin: 0; height: 100%; position: relative; }
        /* favourite star (per-tile, top-right) */
        .tile-fav { position: absolute; top: 6px; right: 6px; z-index: 2; width: 22px; height: 22px; padding: 0;
            border: none; background: none; cursor: pointer; border-radius: 6px; font-size: 14px; line-height: 1;
            color: rgba(128,128,128,.5); opacity: 0; transition: opacity .12s ease, color .12s ease; }
        .bpick-grid form:hover .tile-fav { opacity: 1; }
        .tile-fav:hover { color: #e6a700; background: rgba(128,128,128,.16); }
        .tile-fav.on { opacity: 1; color: #e6a700; }
        /* "Favoriten" / "Verwendet" view: no group headings, tiles as one flat list */
        .bpick-flat .bpick-grouphead { display: none; }
        .bpick-flat .bpick-group { margin-top: 0 !important; }
        /* uniform, app-styled tiles: icon on top, name below, description hidden (kept for search) */
        .bpick .tile { width: 100%; height: 116px; box-sizing: border-box;
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px;
            text-align: center; font-family: inherit; color: inherit; cursor: pointer;
            padding: 14px 8px; border-radius: 10px;
            background: rgba(128,128,128,.05); border: 1px solid rgba(128,128,128,.2);
            transition: border-color .15s ease, background .15s ease, transform .1s ease; }
        .bpick .tile:hover { border-color: var(--accent, #2b6cff); background: rgba(128,128,128,.1); transform: translateY(-1px); }
