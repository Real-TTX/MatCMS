@page "{id:int}"
@model MatCMS.Pages.Admin.Menus.EditMenuModel
@{
    ViewData["Title"] = Model.Current.Name;
}
<div class="page-head">
    <h1>@Model.Current.Name</h1>
    <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
</div>

<div class="card">
    <h2>@T["menus.entries"]</h2>

    @* First level = language: pick which language's items to view/edit (multi-language sites only). *@
    @if (Model.AvailableLocales.Count > 1)
    {
        <div class="menu-lang-bar" style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
            <label for="menu-lang" class="muted" style="margin:0;">@T["editor.language"]:</label>
            <select id="menu-lang" class="menu-lang-select" style="max-width:280px;" onchange="if(this.value)location.href=this.value;" aria-label="@T["editor.language"]">
                @foreach (var loc in Model.AvailableLocales)
                {
                    <option value="@Url.Page("EditMenu", new { id = Model.Current.Id, locale = loc })" selected="@(loc == Model.SelectedLocale ? "selected" : null)">@MatCMS.Services.Localizer.DisplayName(loc) (@loc.ToUpperInvariant())</option>
                }
            </select>
        </div>
    }

    @if (Model.Items.Count == 0)
    {
        <p class="muted">@T["menus.noItems"]</p>
    }
    <div class="block-list sortable" data-sortable data-reorder-form="reorder-items">
        @foreach (var (it, depth) in Model.Rows)
        {
            <div class="block-item sortable-item" data-item-id="@it.Id" style="@(depth > 0 ? $"margin-left:{depth * 28}px;" : null)">
                <span class="drag-handle" title="@T["editor.dragToSort"]" aria-hidden="true">⠿</span>
                @if (depth > 0)
                {
                    <span class="muted" aria-hidden="true" style="margin-right:2px;">↳</span>
                }
                @if (!string.IsNullOrEmpty(it.Icon))
                {
                    <span class="b-icon"><i class="ti ti-@MatCMS.Content.MenuIcons.Resolve(it.Icon)" aria-hidden="true"></i></span>
                }
                <div class="b-info">
                    <div class="b-type">@it.Label</div>
                    <div class="b-sum">@it.Url@(it.OpenInNewTab ? " · " + T["menus.newTab"] : "")</div>
                </div>
                <div class="actions">
                    <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@it.Id">@T["action.edit"]</a>
                    <form class="inline-form" method="post" asp-page-handler="DeleteItem" asp-route-id="@Model.Current.Id" asp-route-itemId="@it.Id" asp-route-locale="@Model.SelectedLocale" onsubmit="return confirm('@T["menus.confirmDelete", it.Label]');">
                        <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                    </form>
                </div>
            </div>
        }
    </div>
    <form id="reorder-items" method="post" asp-page-handler="Reorder" asp-route-id="@Model.Current.Id" asp-route-menu="@Model.Current.Key" asp-route-locale="@Model.SelectedLocale" style="display:none;">
        <div data-order-inputs></div>
    </form>
    <div class="list-actions">
        <a class="btn" asp-page="Create" asp-route-menu="@Model.Current.Key" asp-route-locale="@Model.SelectedLocale">@T["menus.addItem"]</a>
    </div>
</div>

<div class="card">
    <h2>@T["menus.menuSettings"]</h2>
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" class="form-grid" id="menu-form" asp-route-locale="@Model.SelectedLocale">
        <div class="form-row">
            <div class="form-field">
                <label for="Name">@T["menus.menuName"]</label>
                <input id="Name" name="Name" value="@Model.Name" required />
            </div>
            <div class="form-field">
                <label>@T["menus.menuKey"]</label>
                <input value="@Model.Current.Key" class="mono" readonly />
            </div>
        </div>
    </form>
</div>

@* Save and delete on one line, positive before negative. The save button sits outside its form and
   reaches it by id, because the delete is a form of its own and the two cannot nest. *@
<div class="form-actions">
    <button type="submit" class="btn" form="menu-form">@T["action.save"]</button>
    @if (!Model.Current.BuiltIn)
    {
        <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@Model.Current.Id"
              onsubmit="return confirm('@T["menus.confirmDeleteMenu"]');">
            <button type="submit" class="btn btn-danger">@T["menus.deleteMenu"]</button>
        </form>
    }
</div>
@if (Model.Current.BuiltIn)
{
    <p class="muted">@T["menus.builtinNote"]</p>
}

@section Scripts {
    <script src="~/js/admin-sortable.js" asp-append-version="true"></script>
}
