@page
@model MatCMS.Pages.Admin.Media.IndexModel
@{
    ViewData["Title"] = T["media.title"];
}
<div class="page-head">
    <h1>@T["media.title"]</h1>
</div>

@if (Model.AllTags.Count > 0)
{
    <div class="tag-filter">
        <a class="tag-chip @(Model.ActiveTag is null ? "active" : "")" asp-page="Index">@T["media.allTags"]</a>
        @foreach (var t in Model.AllTags)
        {
            <a class="tag-chip @(string.Equals(Model.ActiveTag, t, StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="Index" asp-route-tag="@t">@t</a>
        }
    </div>
}

@if (Model.Items.Count == 0)
{
    <div class="card"><p class="muted">@T["media.empty"]</p></div>
}

<div class="media-grid" id="media-grid">
    @foreach (var m in Model.Items)
    {
        var tagList = MatCMS.Content.TagUtil.Split(m.Tags).ToList();
        <button type="button" class="media-card"
                data-id="@m.Id"
                data-url="@m.Url"
                data-name="@m.FileName"
                data-tags="@m.Tags"
                data-alt="@m.Alt"
                data-type="@m.ContentType"
                data-size="@m.SizeBytes"
                title="@T["media.clickHint"]">
            <div class="media-thumb" style="background-image:url('@m.Url')"></div>
            <div class="media-meta">
                <div class="media-name" title="@m.FileName">@m.FileName</div>
                @if (tagList.Count > 0)
                {
                    <div class="media-card-tags">
                        @foreach (var t in tagList.Take(4))
                        {
                            <span class="mini-chip">@t</span>
                        }
                    </div>
                }
            </div>
        </button>
    }
</div>

<div class="list-actions">
    <button type="button" id="media-upload-btn" class="btn">@T["media.upload"]</button>
    <input type="file" id="media-file" accept="image/*" multiple style="display:none;" />
</div>

@* ---- Detail dialog ---- *@
<div class="modal-overlay" id="media-modal">
    <div class="modal modal-media" role="dialog" aria-modal="true" aria-labelledby="mm-title">
        <div class="modal-head">
            <h2 id="mm-title">@T["media.detail"]</h2>
            <button type="button" class="modal-close" id="mm-close" aria-label="@T["action.close"]">✕</button>
        </div>
        <div class="modal-body media-modal-body">
            <div class="media-preview">
                <img id="mm-img" src="" alt="" />
            </div>
            <div class="media-detail">
                <div class="media-detail-name" id="mm-name"></div>

                <div class="form-field">
                    <label for="mm-url">@T["media.url"]</label>
                    <div class="copy-row">
                        <input id="mm-url" readonly />
                        <button type="button" class="btn btn-sm btn-ghost" id="mm-copy">@T["media.copy"]</button>
                    </div>
                </div>

                <form id="mm-save-form" method="post" asp-page-handler="Save" asp-route-tag="@Model.ActiveTag" class="media-detail-form">
                    <input type="hidden" name="id" id="mm-id" />

                    <div class="form-field">
                        <label for="mm-alt">@T["media.alt"]</label>
                        <input id="mm-alt" name="alt" placeholder="@T["media.altPlaceholder"]" />
                    </div>

                    <div class="form-field">
                        <label for="mm-tag-entry">@T["media.tags"]</label>
                        <div class="tag-input" id="mm-tag-input">
                            <input type="text" id="mm-tag-entry" class="tag-entry" placeholder="@T["media.tagAdd"]"
                                   autocomplete="off" list="mm-tag-list" hidden />
                            <button type="button" class="tag-add-chip" id="mm-tag-add" title="@T["media.tagAdd"]" aria-label="@T["media.tagAdd"]">+</button>
                        </div>
                        <input type="hidden" name="tags" id="mm-tags" />
                        @if (Model.AllTags.Count > 0)
                        {
                            <datalist id="mm-tag-list">
                                @foreach (var t in Model.AllTags)
                                {
                                    <option value="@t"></option>
                                }
                            </datalist>
                            <div class="tag-suggest" id="mm-suggest">
                                @foreach (var t in Model.AllTags)
                                {
                                    <button type="button" class="mini-chip mini-chip-add" data-tag="@t">+ @t</button>
                                }
                            </div>
                            <div class="help">@T["media.suggestHint"]</div>
                        }
                    </div>

                    <div class="media-detail-info" id="mm-info"></div>
                </form>
            </div>

            @* Full-width action bar spanning both columns: positive → negative, destructive set apart. *@
            <div class="modal-foot action-bar">
                <button type="submit" form="mm-save-form" class="btn">@T["action.save"]</button>
                <button type="button" class="btn btn-ghost" id="mm-cancel">@T["action.cancel"]</button>
                <form method="post" asp-page-handler="Delete" asp-route-tag="@Model.ActiveTag" class="media-delete-form act-danger"
                      onsubmit="return confirm('@T["media.confirmDelete"]');">
                    <input type="hidden" name="id" id="mm-del-id" />
                    <button type="submit" class="btn btn-danger">@T["action.delete"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // ---- Upload ----
            var btn = document.getElementById('media-upload-btn');
            var file = document.getElementById('media-file');
            btn.addEventListener('click', function () { file.click(); });
            file.addEventListener('change', function () {
                if (!file.files || !file.files.length) return;
                btn.disabled = true; btn.textContent = '@T["action.uploading"]';
                var files = Array.prototype.slice.call(file.files);
                var chain = Promise.resolve();
                files.forEach(function (f) {
                    chain = chain.then(function () {
                        var fd = new FormData(); fd.append('file', f);
                        return fetch('/admin/api/upload', { method: 'POST', body: fd })
                            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
                            .then(function (r) { if (!r.ok) alert(r.j.error || '@T["media.uploadFailed"]'); });
                    });
                });
                chain.then(function () { window.location.reload(); });
            });

            // ---- Detail dialog ----
            var modal = document.getElementById('media-modal');
            var img = document.getElementById('mm-img');
            var nameEl = document.getElementById('mm-name');
            var urlEl = document.getElementById('mm-url');
            var altEl = document.getElementById('mm-alt');
            var infoEl = document.getElementById('mm-info');
            var idEl = document.getElementById('mm-id');
            var delIdEl = document.getElementById('mm-del-id');

            // ---- Tag chip picker ----
            var tagsHidden = document.getElementById('mm-tags');
            var tagBox = document.getElementById('mm-tag-input');
            var tagEntry = document.getElementById('mm-tag-entry');
            var tagAdd = document.getElementById('mm-tag-add');
            var chips = [];
            // The entry is hidden behind a "+" chip; clicking it reveals an inline input.
            function showEntry() { tagAdd.hidden = true; tagEntry.hidden = false; tagEntry.focus(); }
            function hideEntry() { tagEntry.hidden = true; tagAdd.hidden = false; }
            tagAdd.addEventListener('click', showEntry);
            function renderChips() {
                Array.prototype.slice.call(tagBox.querySelectorAll('.tag-chip-item')).forEach(function (el) { el.remove(); });
                chips.forEach(function (tag) {
                    var el = document.createElement('span');
                    el.className = 'tag-chip-item';
                    el.textContent = tag;
                    var x = document.createElement('button');
                    x.type = 'button'; x.className = 'tag-x'; x.setAttribute('aria-label', 'entfernen'); x.textContent = '×';
                    x.addEventListener('click', function () { removeTag(tag); tagEntry.focus(); });
                    el.appendChild(x);
                    tagBox.insertBefore(el, tagEntry);
                });
                tagsHidden.value = chips.join(', ');
            }
            function addTag(raw) {
                var t = (raw || '').replace(/,/g, ' ').trim();
                if (!t) return;
                if (chips.some(function (c) { return c.toLowerCase() === t.toLowerCase(); })) return;
                chips.push(t); renderChips();
            }
            function removeTag(tag) { chips = chips.filter(function (c) { return c !== tag; }); renderChips(); }
            function setTags(str) {
                var seen = {};
                chips = (str || '').split(',').map(function (s) { return s.trim(); }).filter(function (c) {
                    if (!c) return false; var k = c.toLowerCase(); if (seen[k]) return false; seen[k] = 1; return true;
                });
                renderChips();
            }
            tagEntry.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addTag(tagEntry.value); tagEntry.value = ''; }
                else if (e.key === 'Escape') { e.preventDefault(); tagEntry.value = ''; hideEntry(); }
                else if (e.key === 'Backspace' && !tagEntry.value && chips.length) { removeTag(chips[chips.length - 1]); }
            });
            tagEntry.addEventListener('blur', function () {
                if (tagEntry.value.trim()) { addTag(tagEntry.value); tagEntry.value = ''; }
                hideEntry();
            });
            tagBox.addEventListener('click', function (e) { if (e.target === tagBox) tagEntry.focus(); });
            document.getElementById('mm-save-form').addEventListener('submit', function () {
                if (tagEntry.value.trim()) { addTag(tagEntry.value); tagEntry.value = ''; }
            });

            function fmtBytes(n) {
                n = parseInt(n, 10) || 0;
                if (n < 1024) return n + ' B';
                if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
                return (n / 1024 / 1024).toFixed(1) + ' MB';
            }
            function open(card) {
                var d = card.dataset;
                img.src = d.url; img.alt = d.alt || d.name || '';
                nameEl.textContent = d.name || '';
                urlEl.value = d.url || '';
                altEl.value = d.alt || '';
                setTags(d.tags || ''); tagEntry.value = ''; hideEntry();
                idEl.value = d.id; delIdEl.value = d.id;
                infoEl.textContent = [d.type, fmtBytes(d.size)].filter(Boolean).join('  ·  ');
                modal.classList.add('open');
            }
            function close() { modal.classList.remove('open'); }

            document.querySelectorAll('.media-card').forEach(function (c) {
                c.addEventListener('click', function () { open(c); });
            });
            document.getElementById('mm-close').addEventListener('click', close);
            document.getElementById('mm-cancel').addEventListener('click', close);
            modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('open')) close(); });

            // Tag suggestion chips → add as a chip.
            var suggest = document.getElementById('mm-suggest');
            if (suggest) {
                suggest.addEventListener('click', function (e) {
                    var chip = e.target.closest('.mini-chip-add');
                    if (!chip) return;
                    addTag(chip.getAttribute('data-tag'));
                    tagEntry.focus();
                });
            }

            // Copy URL.
            document.getElementById('mm-copy').addEventListener('click', function () {
                var b = this, u = urlEl.value;
                (navigator.clipboard ? navigator.clipboard.writeText(u) : Promise.reject())
                    .then(function () { var t = b.textContent; b.textContent = '@T["media.copied"]'; setTimeout(function () { b.textContent = t; }, 1200); })
                    .catch(function () { urlEl.select(); document.execCommand('copy'); });
            });
        })();
    </script>
}
