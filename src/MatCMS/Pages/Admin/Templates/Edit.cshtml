@page "{id:int}"
@model MatCMS.Pages.Admin.Templates.EditModel
@using MatCMS.Content
@{
    ViewData["Title"] = T["templates.edit"];

    // ---- The template's editable "files" (unified list). Each maps to an existing backing field, so
    //      storage/rendering are unchanged — only the management is unified. Index order MUST match the
    //      hidden <textarea> order and the FILES JS array below. ----
    var postValue = Model.Parts.TryGetValue("post", out var pp) && !string.IsNullOrWhiteSpace(pp)
        ? pp : Model.DefaultPostPart;
    var maintenanceValue = Model.Parts.TryGetValue("maintenance", out var mp) && !string.IsNullOrWhiteSpace(mp)
        ? mp : Model.DefaultMaintenancePart;

    // Starter for body.html ("Standard einfügen"). body.html is EMPTY by default (built-in layout);
    // this is only inserted on demand.
    const string StarterBody =
        "<header class=\"site-header\">\n" +
        "  <div class=\"container header-inner\">\n" +
        "    <a class=\"logo\" href=\"/\">{{logo}}</a>\n" +
        "    <nav class=\"main-nav\">{{menu:primary}}</nav>\n" +
        "  </div>\n" +
        "</header>\n\n" +
        "<main>{{content}}</main>\n\n" +
        "<footer class=\"site-footer\">\n" +
        "  <div class=\"container footer-inner\">\n" +
        "    <nav class=\"footer-nav\">\n" +
        "      {{#menu:secondary}}<a href=\"{{url}}\"{{target}}>{{icon}}{{label}}</a>{{/menu:secondary}}\n" +
        "    </nav>\n" +
        "    <p class=\"footer-text\">© {{year}} {{site_name}}</p>\n" +
        "  </div>\n" +
        "</footer>";

    // Per-file metadata for the client editor (mode/insert-default/"baseline"=value counting as unset/tokens).
    // The pseudo-files this template is edited as. Shape and wording live in the shared partial;
    // only WHICH fields they post as is a property of this page.
    var bodyTokens = new[]
    {
        new TemplateToken("{{content}}", T["templates.tokContent"]),
        new TemplateToken("{{logo}}", T["templates.tokLogo"]),
        new TemplateToken("{{site_name}}", T["templates.tokSiteName"]),
        new TemplateToken("{{footer_text}}", T["templates.tokFooterText"]),
        new TemplateToken("{{year}}", T["templates.tokYear"]),
        new TemplateToken("{{menu:primary}}", T["templates.tokMenu"]),
        new TemplateToken("{{#menu:primary}}…{{/menu:primary}}", T["templates.tokMenuLoop"]),
        new TemplateToken("{{param:id}}", T["templates.tokParam"]),
        new TemplateToken("{{languages}}", T["templates.tokLanguages"]),
    };
    var postTokens = new[]
    {
        new TemplateToken("{{post_image}}", T["templates.tok.image"]),
        new TemplateToken("{{post_date}}", T["templates.tok.date"]),
        new TemplateToken("{{post_title}}", T["templates.tok.title"]),
        new TemplateToken("{{post_excerpt}}", T["templates.tok.excerpt"]),
        new TemplateToken("{{post_body}}", T["templates.tok.body"]),
        new TemplateToken("{{post_tags}}", T["templates.tok.tags"]),
        new TemplateToken("{{post_attachments}}", T["templates.tok.attachments"]),
    };
    var paramToken = new[] { new TemplateToken("{{param:id}}", T["templates.tokParam"]) };

    var templateFiles = new TemplateFiles(
        T["tplfiles.intro"],
        new[]
        {
            new TemplateFile("body.html", "html", T["tplfiles.body.desc"], "LayoutHtml", Model.LayoutHtml,
                "htmlmixed", bodyTokens, InsertDefault: StarterBody),
            new TemplateFile("article.html", "html", T["tplfiles.article.desc"], "Parts[post]", postValue,
                "htmlmixed", postTokens, InsertDefault: Model.DefaultPostPart, Baseline: Model.DefaultPostPart),
            new TemplateFile("styles.css", "css", T["tplfiles.styles.desc"], "CustomCss", Model.CustomCss,
                "css", paramToken),
            new TemplateFile("script.js", "js", T["tplfiles.script.desc"], "CustomJs", Model.CustomJs,
                "javascript", System.Array.Empty<TemplateToken>()),
            new TemplateFile("maintenance.html", "html", T["tplfiles.maintenance.desc"], "Parts[maintenance]", maintenanceValue,
                "htmlmixed", paramToken, InsertDefault: Model.DefaultMaintenancePart, Baseline: Model.DefaultMaintenancePart),
        },
        new TemplateFileLabels(
            T["tplfiles.edit"], T["tplfiles.tokens"], T["tplfiles.insertDefault"],
            T["tplfiles.insertDefaultConfirm"],
            T["tplfiles.badgeCustom"], T["tplfiles.badgeEmpty"],
            T["tplfiles.pick"], T["tplfiles.menu"], T["tplfiles.toggle"],
            T["tplfiles.raw"], T["tplfiles.root"],
            T["tplfiles.copy"], T["tplfiles.copied"]),
        // Die Wurzel des Baums ist dieses Template — mit seinem Namen, nicht mit dem Wort "Dateien".
        Model.Name ?? "");
}
<div class="page-head">
    <h1>
        @T["templates.edit"]
        <span class="badge" title="@T["templates.versionHint"]" style="margin-left:8px;vertical-align:middle;font-size:12px;">@T["templates.version"] V@(Model.SchemaVersion)</span>
    </h1>
    <div style="display:flex;gap:8px;align-items:center;">
        <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-page-handler="ExportJson" asp-route-id="@Model.Id">
            <i class="ti ti-download" aria-hidden="true"></i> @T["templates.exportJson"]
        </a>
        <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
    </div>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    @if (Model.IsActive)
    {
        <p class="muted">@Html.Raw(T["templates.activeNotice"])</p>
    }
    <form method="post" id="tpl-form">
        <input type="hidden" name="Id" value="@Model.Id" />

        @* Reiterbeschriftungen ohne Emoji — wie in jeder anderen Reiterleiste des Admin
           (Einstellungen, Backup, Komponenten, Plugins). Ein Bildzeichen vor dem Wort stand nur
           hier und ließ diese eine Leiste aus der Reihe fallen. *@
        <div class="tabs" role="tablist">
            <button type="button" class="tab active" data-tab="designer">@T["templates.tabDesigner"]</button>
            <button type="button" class="tab" data-tab="files">@T["tplfiles.tab"]</button>
            <button type="button" class="tab" data-tab="params">@T["templates.tabParameters"]</button>
        </div>
        <p class="help" data-group-hint></p>

        @* ============ DESIGN ============ *@
        <div class="tab-panel form-grid" data-panel="design" data-group="designer">
            <div class="form-field">
                <label for="Name">@T["templates.name"]</label>
                <input id="Name" name="Name" value="@Model.Name" required autofocus />
            </div>

            <h3 class="form-section">@T["templates.secColors"]</h3>
            @{
                var colorFields = new (string Name, string LabelKey, string Value, string Help)[]
                {
                    ("AccentColor", "templates.accentColor", Model.AccentColor ?? "#de7e11", ""),
                    ("SecondaryColor", "templates.secondaryColor", string.IsNullOrWhiteSpace(Model.SecondaryColor) ? (Model.AccentColor ?? "#de7e11") : Model.SecondaryColor!, T["templates.secondaryHelp"]),
                    ("HeadingColor", "templates.headingColor", Model.HeadingColor ?? "#010101", ""),
                    ("TextColor", "templates.textColor", Model.TextColor ?? "#1a1a1a", ""),
                    ("BackgroundColor", "templates.backgroundColor", Model.BackgroundColor ?? "#ffffff", ""),
                    ("AltBackground", "templates.altBackground", Model.AltBackground ?? "#f6f7f9", ""),
                };
            }
            <div class="color-grid">
                @foreach (var c in colorFields)
                {
                    <div class="form-field">
                        <label for="@c.Name">@T[c.LabelKey]</label>
                        <div class="color-field">
                            <input id="@c.Name" name="@c.Name" type="color" value="@c.Value" />
                            <input type="text" class="hex" value="@c.Value" aria-label="@T[c.LabelKey]" spellcheck="false" />
                        </div>
                        @if (!string.IsNullOrEmpty(c.Help))
                        {
                            <div class="help">@c.Help</div>
                        }
                    </div>
                }
            </div>

            <h3 class="form-section">@T["templates.secType"]</h3>
            <div class="form-row">
                <div class="form-field">
                    <label for="HeadingFont">@T["templates.headingFont"]</label>
                    <select id="HeadingFont" name="HeadingFont">
                        @foreach (var f in TemplateFonts.Families)
                        {
                            <option value="@f" selected="@(Model.HeadingFont == f)">@f</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="BodyFont">@T["templates.bodyFont"]</label>
                    <select id="BodyFont" name="BodyFont">
                        @foreach (var f in TemplateFonts.Families)
                        {
                            <option value="@f" selected="@(Model.BodyFont == f)">@f</option>
                        }
                    </select>
                </div>
            </div>

            <h3 class="form-section">@T["templates.secLayout"]</h3>
            <div class="form-row">
                <div class="form-field">
                    <label for="ButtonStyle">@T["templates.buttonStyle"]</label>
                    <select id="ButtonStyle" name="ButtonStyle">
                        <option value="solid" selected="@(Model.ButtonStyle != "outline")">@T["templates.buttonSolid"]</option>
                        <option value="outline" selected="@(Model.ButtonStyle == "outline")">@T["templates.buttonOutline"]</option>
                    </select>
                </div>
                <div class="form-field">
                    <label for="ButtonRadius">@T["templates.buttonRadius"]</label>
                    <input id="ButtonRadius" name="ButtonRadius" type="number" min="0" max="60" value="@Model.ButtonRadius" />
                </div>
                <div class="form-field">
                    <label for="ContainerWidth">@T["templates.containerWidth"]</label>
                    <input id="ContainerWidth" name="ContainerWidth" type="number" min="600" max="2000" value="@Model.ContainerWidth" />
                </div>
            </div>
        </div>

        @* ============ HEADER ============ *@
        <div class="tab-panel form-grid" data-panel="header" data-group="designer" hidden>
            <div class="form-row">
                <div class="form-field">
                    <label for="HeaderBackground">@T["templates.headerBg"]</label>
                    <div class="optcolor" data-optcolor>
                        <input type="color" class="optcolor-pick" value="@(string.IsNullOrWhiteSpace(Model.HeaderBackground) ? "#ffffff" : Model.HeaderBackground)" aria-label="@T["templates.headerBg"]" />
                        <input type="text" id="HeaderBackground" name="HeaderBackground" class="optcolor-hex" value="@Model.HeaderBackground" placeholder="@T["templates.optionalColor"]" spellcheck="false" />
                        <button type="button" class="optcolor-clear" title="@T["action.clear"]" aria-label="@T["action.clear"]">×</button>
                    </div>
                </div>
                <div class="form-field">
                    <label for="HeaderTextColor">@T["templates.headerText"]</label>
                    <div class="optcolor" data-optcolor>
                        <input type="color" class="optcolor-pick" value="@(string.IsNullOrWhiteSpace(Model.HeaderTextColor) ? "#111111" : Model.HeaderTextColor)" aria-label="@T["templates.headerText"]" />
                        <input type="text" id="HeaderTextColor" name="HeaderTextColor" class="optcolor-hex" value="@Model.HeaderTextColor" placeholder="@T["templates.optionalColor"]" spellcheck="false" />
                        <button type="button" class="optcolor-clear" title="@T["action.clear"]" aria-label="@T["action.clear"]">×</button>
                    </div>
                </div>
                <div class="form-field">
                    <label for="HeaderPadding">@T["templates.headerPadding"]</label>
                    <input id="HeaderPadding" name="HeaderPadding" type="number" min="4" max="60" value="@Model.HeaderPadding" />
                </div>
            </div>
        </div>

        @* ============ DATEIEN (unified template files) ============ *@
        <div class="tab-panel" data-panel="files" data-group="files" hidden>
            <partial name="_TemplateFiles" model="templateFiles" />
        </div>

        @* ============ MENÜS ============ *@
        <div class="tab-panel form-grid" data-panel="menus" data-group="params" hidden>
            <div class="help">@Html.Raw(T["templates.menusIntro"])</div>

            @if (Model.MenuSlots.Count > 0)
            {
                <div class="form-field">
                    <label>@T["templates.menuMapping"]</label>
                    <div class="help">@T["templates.menuMappingHelp"]</div>
                    <div class="menu-map">
                        @foreach (var slot in Model.MenuSlots)
                        {
                            <div class="menu-map-row">
                                <code class="mono">{{menu:@slot}}</code>
                                <span class="menu-map-arrow">→</span>
                                <select name="MenuMap[@slot]">
                                    <option value="">@T["templates.menuUnmapped"]</option>
                                    @foreach (var m in Model.AvailableMenus)
                                    {
                                        var sel = Model.MenuMap.TryGetValue(slot, out var mv) && mv == m.Key;
                                        <option value="@m.Key" selected="@(sel ? "selected" : null)">@m.Name</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">@Html.Raw(T["templates.menusNoSlots"])</div>
            }

            <div class="form-field">
                <label>@T["templates.internalMenus"]</label>
                <div class="help">@T["templates.internalMenusHelp"]</div>
                <ul class="menu-ref">
                    @foreach (var m in Model.AvailableMenus)
                    {
                        <li><code class="mono">@m.Key</code><span>@m.Name</span></li>
                    }
                </ul>
            </div>
        </div>

        @* ============ PARAMETER (designer-published) ============ *@
        <div class="tab-panel form-grid" data-panel="advanced" data-group="params" hidden>
            <h3 class="form-section">@T["templates.paramsUsers"]</h3>
            <div class="help">@Html.Raw(T["templates.paramsHelp"])</div>
            <div id="param-rows" data-params="@Model.ParametersJson"></div>
            <div style="margin-top:8px;"><button type="button" class="btn btn-sm btn-ghost" id="param-add">@T["templates.paramAddBtn"]</button></div>
            <input type="hidden" name="ParametersJson" id="ParametersJson" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">@T["action.save"]</button>
        </div>
    </form>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/lib/codemirror/codemirror.min.css" asp-append-version="true" />
    <style>
        /* File list */
    </style>
    <script src="~/_content/MatCMS.Shared.Web/lib/codemirror/codemirror.min.js" asp-append-version="true"></script>
    <script src="~/_content/MatCMS.Shared.Web/lib/codemirror/mode/xml.min.js" asp-append-version="true"></script>
    <script src="~/_content/MatCMS.Shared.Web/lib/codemirror/mode/javascript.min.js" asp-append-version="true"></script>
    <script src="~/_content/MatCMS.Shared.Web/lib/codemirror/mode/css.min.js" asp-append-version="true"></script>
    <script src="~/_content/MatCMS.Shared.Web/lib/codemirror/mode/htmlmixed.min.js" asp-append-version="true"></script>
    <script src="~/_content/MatCMS.Shared.Web/lib/codemirror/addon/closebrackets.min.js" asp-append-version="true"></script>
    <script src="~/_content/MatCMS.Shared.Web/lib/codemirror/addon/matchbrackets.min.js" asp-append-version="true"></script>
    <script src="~/_content/MatCMS.Shared.Web/lib/codemirror/addon/active-line.min.js" asp-append-version="true"></script>
    <script>
        // ---- Tabs: Designer (Aussehen) / Dateien (Layout-Dateien) / Parameter (Menü + Parameter) ----
        (function () {
            var tabs = document.querySelectorAll('.tab');
            var panels = document.querySelectorAll('.tab-panel');
            var hint = document.querySelector('[data-group-hint]');
            var HINTS = {
                designer: '@T["templates.tabHintDesigner"]',
                files: '@T["templates.tabHintFiles"]',
                params: '@T["templates.tabHintParams"]'
            };
            function show(name) {
                if (name !== 'params' && name !== 'files') name = 'designer';
                tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.tab === name); });
                panels.forEach(function (p) { p.hidden = p.dataset.group !== name; });
                if (hint) hint.textContent = HINTS[name] || '';
            }
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
            show(new URLSearchParams(location.search).get('tab'));
        })();

        // Keep each color swatch and its hex text field in sync.
        document.querySelectorAll('.color-field').forEach(function (cf) {
            var color = cf.querySelector('input[type=color]');
            var hex = cf.querySelector('.hex');
            if (!color || !hex) return;
            hex.value = color.value;
            color.addEventListener('input', function () { hex.value = color.value; });
            hex.addEventListener('input', function () {
                var v = hex.value.trim();
                if (/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(v)) color.value = v;
            });
        });

        // Optional color widget: a color swatch + a text field that may be empty ("" = no override).
        document.querySelectorAll('[data-optcolor]').forEach(function (oc) {
            var pick = oc.querySelector('.optcolor-pick');
            var hex = oc.querySelector('.optcolor-hex');
            var clear = oc.querySelector('.optcolor-clear');
            if (!pick || !hex) return;
            function reflectEmpty() { oc.classList.toggle('is-empty', hex.value.trim() === ''); }
            pick.addEventListener('input', function () { hex.value = pick.value; reflectEmpty(); });
            hex.addEventListener('input', function () {
                var v = hex.value.trim();
                if (/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(v)) pick.value = v;
                reflectEmpty();
            });
            if (clear) clear.addEventListener('click', function () { hex.value = ''; reflectEmpty(); hex.focus(); });
            reflectEmpty();
        });

        // Published parameter rows (designer declares) -> hidden ParametersJson on submit.
        (function () {
            var rows = document.getElementById('param-rows');
            var addBtn = document.getElementById('param-add');
            var hidden = document.getElementById('ParametersJson');
            if (!rows || !addBtn || !hidden) return;
            var form = hidden.closest('form');
            var TYPES = [['text', '@T["templates.ptype.text"]'], ['select', '@T["templates.ptype.select"]'], ['color', '@T["templates.ptype.color"]'], ['number', '@T["templates.ptype.number"]'], ['bool', '@T["templates.ptype.bool"]']];
            function slug(s) {
                return (s || '').trim().toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue')
                    .replace(/ß/g, 'ss').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
            }
            function addRow(p) {
                p = p || {};
                var row = document.createElement('div'); row.className = 'field-row param-row';
                var label = document.createElement('input'); label.type = 'text'; label.placeholder = 'Label'; label.className = 'pr-label fr-label'; label.value = p.label || '';
                var type = document.createElement('select'); type.className = 'pr-type';
                TYPES.forEach(function (t) { var o = document.createElement('option'); o.value = t[0]; o.textContent = t[1]; if ((p.type || 'text') === t[0]) o.selected = true; type.appendChild(o); });
                var opts = document.createElement('input'); opts.type = 'text'; opts.placeholder = '@T["templates.optionsPlaceholder"]'; opts.className = 'pr-options fr-label'; opts.value = p.options || '';
                var def = document.createElement('input'); def.type = 'text'; def.placeholder = '@T["templates.defaultPlaceholder"]'; def.className = 'pr-default fr-label'; def.value = p['default'] || '';
                var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'btn btn-sm btn-danger btn-icon'; rm.innerHTML = '<i class="ti ti-trash" aria-hidden="true"></i>';
                rm.addEventListener('click', function () { row.remove(); });
                function syncOpts() { opts.style.display = type.value === 'select' ? '' : 'none'; }
                type.addEventListener('change', syncOpts); syncOpts();
                row.appendChild(label); row.appendChild(type); row.appendChild(opts); row.appendChild(def); row.appendChild(rm);
                rows.appendChild(row);
            }
            var data = [];
            try { data = JSON.parse(rows.getAttribute('data-params') || '[]') || []; } catch (e) { }
            data.forEach(addRow);
            addBtn.addEventListener('click', function () { addRow({}); });
            form.addEventListener('submit', function () {
                var arr = [];
                Array.prototype.slice.call(rows.querySelectorAll('.param-row')).forEach(function (r) {
                    var label = r.querySelector('.pr-label').value.trim();
                    var id = slug(label);
                    if (!id) return;
                    arr.push({ id: id, label: label || id, type: r.querySelector('.pr-type').value, options: r.querySelector('.pr-options').value.trim(), 'default': r.querySelector('.pr-default').value });
                });
                hidden.value = JSON.stringify(arr);
            });
        })();
    </script>
}
