<Project Sdk="Microsoft.NET.Sdk">

  <!-- Holiday homes and apartments (houses, units, seasons, prices, availability, requests) as a NATIVE store plugin: it runs only where the
       operator allowed native plugins. Same settings as Verein and Forum so it stays loadable and unloadable (docs/plugin-system-v2.md, section 7).
       Design: docs/booking-plugin.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>MatCMS.Plugin.Booking</RootNamespace>
    <AssemblyName>Booking</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MatCMS.Plugin.Abstractions\MatCMS.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
