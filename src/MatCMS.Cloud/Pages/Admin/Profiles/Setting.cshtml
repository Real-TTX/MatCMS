@page "{profileId:int}/{id:int?}"
@model MatCMS.Cloud.Pages.Admin.Profiles.SettingModel
@{
    ViewData["Title"] = Model.IsNew ? T["profiles.addSetting"] : Model.Item.Key;
}
<div class="page-head">
    <h1>
        @(Model.IsNew ? T["profiles.addSetting"] : Model.Item.Key)
        <span class="muted" style="font-size:14px;font-weight:400;"> — @Model.Owner.Name</span>
    </h1>
    <div class="list-toolbar">
        <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@Model.Owner.Id" asp-route-tab="settings">@T["action.back"]</a>
    </div>
</div>

<form method="post" asp-route-profileId="@Model.Owner.Id" asp-route-id="@(Model.IsNew ? null : (int?)Model.Item.Id)" id="editor-form">
    <div class="card">
        <h2>@T["profiles.otherSettings"]</h2>
        <p class="muted">@T["profiles.otherSettingsHint"]</p>
        <div class="form-field">
            <label for="keyPick">@T["profiles.settingKey"]</label>
            @* The settings an instance understands are a known, fixed set — so this is a choice, not a
               spelling exercise. A typo used to produce a row that looked right here and did nothing on
               the site, because nothing on either side rejects an unknown key. *@
            <select id="keyPick" name="keyPick" data-key-pick>
                @foreach (var group in Model.Available)
                {
                    <optgroup label="@group.Name">
                        @foreach (var e in group.Entries)
                        {
                            <option value="@e.Key" selected="@(Model.Item.Key == e.Key ? "selected" : null)"
                                    title="@e.Hint">@e.Label — @e.Key</option>
                        }
                    </optgroup>
                }
                <option value="@MatCMS.Cloud.Pages.Admin.Profiles.SettingModel.CustomMarker"
                        selected="@(Model.IsCustomKey ? "selected" : null)">@T["profiles.settingKeyCustom"]</option>
            </select>
            <div class="help" data-key-hint>@Model.Available.SelectMany(g => g.Entries).FirstOrDefault(e => e.Key == Model.Item.Key)?.Hint</div>
        </div>
        @* Shown only for "own key". It stays a plain field rather than being disabled, so the form
           still works with no JavaScript — the server decides which of the two it reads. *@
        <div class="form-field" data-key-custom hidden="@(Model.IsCustomKey ? null : "hidden")">
            <label for="customKey">@T["profiles.settingKeyOwn"]</label>
            <input id="customKey" name="customKey" value="@(Model.IsCustomKey ? Model.Item.Key : "")" placeholder="eigener.schluessel" spellcheck="false" />
            <div class="help">@T["profiles.settingKeyHint"]</div>
        </div>
        <div class="form-field">
            <label for="value">@T["profiles.settingValue"]</label>
            <textarea id="value" name="value" rows="3" spellcheck="false">@Model.Item.Value</textarea>
        </div>
    </div>

</form>

@* Save and delete on one line, positive before negative: what to do with this record is
   one decision, and burying the destructive half in a card further down made it read as a separate
   page. The delete keeps its confirm, which is what actually guards it. *@
<div class="form-actions">
    <button type="submit" class="btn" form="editor-form">@T["settings.save"]</button>
    @if (!Model.IsNew)
    {
        <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-profileId="@Model.Owner.Id" asp-route-id="@Model.Item.Id"
            onsubmit="return confirm('@T["profiles.settingDeleteConfirm"]');">
            <button type="submit" class="btn btn-danger">@T["common.delete"]</button>
        </form>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var pick = document.querySelector('[data-key-pick]');
            var custom = document.querySelector('[data-key-custom]');
            var hint = document.querySelector('[data-key-hint]');
            if (!pick) return;
            pick.addEventListener('change', function () {
                var own = pick.value === '@MatCMS.Cloud.Pages.Admin.Profiles.SettingModel.CustomMarker';
                custom.hidden = !own;
                if (own) custom.querySelector('input').focus();
                // The hint belongs to the chosen key, so it travels with the selection instead of
                // describing whatever happened to be picked first.
                var opt = pick.options[pick.selectedIndex];
                hint.textContent = own ? '' : (opt.title || '');
            });
        })();
    </script>
}
