@page "{id:int}"
@model MatCMS.Cloud.Pages.Admin.Instances.DetailsModel
@using MatCMS.Cloud.Models
@using MatCMS.Cloud.Services
@{
    ViewData["Title"] = Model.Item.Name;
    // So the switcher in the bar shows THIS instance while its detail page is open, instead of
    // claiming you are looking at the cloud.
    ViewData["InstanceId"] = Model.Item.Id;
    // …and no title beside it: the switcher already says the instance name, the heading below says
    // it again, and a third copy in between was just a taller header.
    ViewData["NoTopbarTitle"] = true;
}
<div class="page-head">
    <h1>@Model.Item.Name</h1>
    <div class="list-toolbar">
        @if (!string.IsNullOrWhiteSpace(Model.Item.PreviewUrl))
        {
            @* Two ways, side by side: framed here for looking, a tab for working. *@
            <a class="btn btn-sm btn-ghost" asp-page="Site" asp-route-id="@Model.Item.Id">
                <i class="ti ti-browser" aria-hidden="true"></i> @T["instances.openEmbedded"]
            </a>
            <a class="btn btn-sm btn-ghost" href="@Model.Item.PreviewUrl" target="_blank" rel="noopener"
               title="@T["instances.openSite"]" aria-label="@T["instances.openSite"]">
                <i class="ti ti-external-link" aria-hidden="true"></i>
            </a>
        }
        <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
    </div>
</div>

@if (Model.Item.Status == InstanceStatus.Pending)
{
    <div class="alert alert-info">
        <strong>@T["instances.approvalTitle"]</strong> @T["instances.approvalHint"]
        <div style="margin-top:10px;display:flex;gap:8px;">
            <form class="inline-form" method="post" asp-page-handler="Approve" asp-route-id="@Model.Item.Id">
                <button type="submit" class="btn btn-sm">@T["instances.approve"]</button>
            </form>
            <form class="inline-form" method="post" asp-page-handler="Reject" asp-route-id="@Model.Item.Id">
                <button type="submit" class="btn btn-sm btn-ghost">@T["instances.reject"]</button>
            </form>
        </div>
    </div>
}

<div class="tabs" role="tablist">
    <button type="button" class="tab active" data-tab="overview">@T["instances.tabOverview"]</button>
    <button type="button" class="tab" data-tab="preview">@T["instances.tabPreview"]</button>
    <button type="button" class="tab" data-tab="config">@T["instances.tabConfig"]</button>
    <button type="button" class="tab" data-tab="events">@T["instances.tabEvents"]</button>
    <button type="button" class="tab" data-tab="mail">@T["spool.title"]</button>
    <button type="button" class="tab" data-tab="backup">@T["backups.title"]</button>
    <button type="button" class="tab" data-tab="settings">@T["instances.tabSettings"]</button>
</div>

@* ============ OVERVIEW ============ *@
<div class="tab-panel" data-panel="overview">
    @* Ein vorgemerktes Entfernen steht ÜBER dem Zustand, nicht darin: Die Instanz sieht sonst
       vollkommen normal aus, und dass sie beim nächsten eintreffenden Backup verschwindet, wäre
       nirgends zu sehen, wo man hinschaut. *@
    @if (Model.Item.RemovalPending)
    {
        <div class="card">
            <div class="kv">
                <div class="kv-label">@T["instances.removePending"]</div>
                <div class="kv-value">
                    <span class="badge badge-err">@T["instances.removeWaiting"]</span>
                </div>
            </div>
            <div class="help">@T["instances.removePendingHint"]</div>
            <div class="form-actions">
                <a class="btn btn-sm" asp-page="Delete" asp-route-id="@Model.Item.Id">@T["instances.removeTitle"]</a>
            </div>
        </div>
    }
    @if (Model.Item.BackupRequestId > 0)
    {
        <div class="card">
            <h2>@T["instances.backupRequest"]</h2>
            <div class="kv">
                <div class="kv-label">@T["instances.backupRequestedAt"]</div>
                <div class="kv-value">@(Model.Item.BackupRequestedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</div>
            </div>
            <div class="kv">
                <div class="kv-label">@T["instances.backupRequestState"]</div>
                <div class="kv-value">
                    @if (Model.RequestedBackup is not null)
                    {
                        <span class="badge badge-on">@T["instances.removeWaitingArrived"]</span>
                        <span class="mono">@Model.RequestedBackup.FileName</span>
                    }
                    else if (Model.Item.BackupRequestError is not null)
                    {
                        <span class="badge badge-err">@T["instances.backupRequestFailed"]</span>
                        <span class="muted">@Model.Item.BackupRequestError</span>
                    }
                    else
                    {
                        <span class="badge badge-new">@T["instances.removeWaitingOpen"]</span>
                    }
                </div>
            </div>
            <div class="help">@T["instances.backupRequestHint"]</div>
        </div>
    }
    <div class="card">
        <h2>@T["instances.state"]</h2>
        <div class="kv">
            <div class="kv-label">@T["common.status"]</div>
            <div class="kv-value">
                @if (!Model.Item.HasConnected)
                {
                    <span class="badge badge-off">@T["instances.pending"]</span>
                    <span class="muted">@T["instances.pendingHint"]</span>
                }
                else if (Model.Item.Status == InstanceStatus.Rejected)
                {
                    <span class="badge badge-err">@T["instances.rejected"]</span>
                }
                else if (Model.Online)
                {
                    <span class="badge badge-on">@T["instances.online"]</span>
                }
                else
                {
                    <span class="badge badge-err">@T["instances.offline"]</span>
                }
            </div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["instances.hosting"]</div>
            <div class="kv-value">
                @if (Model.Item.Hosting == InstanceHosting.Local)
                {
                    <span class="badge badge-on">@T["instances.local"]</span>
                    <span class="muted mono">@Model.Item.LocalContainerName</span>
                    @* The published host port is what the operator needs to reach the container
                       directly — shown here rather than buried in the preview tab. *@
                    @if (Model.Item.LocalPort is int localPort)
                    {
                        <span class="muted mono">· @T["instances.port"] @localPort</span>
                    }
                }
                else if (Model.Item.Hosting == InstanceHosting.Remote)
                {
                    <span class="badge badge-off">@T["instances.remote"]</span>
                    <span class="muted">@T["instances.remoteHint"]</span>
                }
                else
                {
                    <span class="muted">@T["common.unknown"]</span>
                }
            </div>
        </div>
        @* Backup usage belongs on the instance too: the overview answers "who is near their limit",
           this answers "what about this one", which is the question being asked on this page. *@
        <div class="kv">
            <div class="kv-label">@T["backups.title"]</div>
            <div class="kv-value">
                <a asp-page="/Admin/Backups/Index" asp-route-instance="@Model.Item.Id">@T["backups.usedOfQuota", Model.BackupUsed, Model.BackupQuota]</a>
                @if (Model.BackupQuotaFromProfile is string qp)
                {
                    <span class="muted"> · @T["backups.quotaFromProfile", qp]</span>
                }
            </div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["instances.version"]</div>
            <div class="kv-value">
                <span class="mono">@(Model.Item.Version ?? "—")</span>
                @if (Model.HasUpdate)
                {
                    <span class="badge badge-new">@T["instances.updateTo", Model.LatestVersion ?? "?"]</span>
                }
            </div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["instances.lastHeartbeat"]</div>
            <div class="kv-value muted">@(Model.Item.LastHeartbeatUtc?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—") UTC</div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["instances.host"]</div>
            <div class="kv-value muted mono">@(Model.Item.HostName ?? "—")</div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["instances.container"]</div>
            <div class="kv-value muted mono">@(Model.Item.ContainerId ?? "—")</div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["instances.image"]</div>
            <div class="kv-value muted mono">@(Model.Item.ImageRef ?? "—")</div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["instances.instanceId"]</div>
            <div class="kv-value muted mono">@Model.Item.PublicId</div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["instances.content"]</div>
            <div class="kv-value muted">@T["instances.contentCounts", Model.Item.PageCount, Model.Item.PluginCount, Model.Item.UserCount]</div>
        </div>

        @if (Model.HasUpdate && Model.CanCloudUpdate)
        {
            <div class="list-actions">
                <form class="inline-form" method="post" asp-page-handler="Update" asp-route-id="@Model.Item.Id"
                      onsubmit="return confirm('@T["instances.updateConfirm"]');">
                    <button type="submit" class="btn"><i class="ti ti-refresh" aria-hidden="true"></i> @T["instances.updateNow"]</button>
                </form>
            </div>
        }
        else if (Model.HasUpdate)
        {
            <div class="alert alert-info" style="margin-top:16px;">
                @T["instances.updateRemote"] <code>docker compose pull &amp;&amp; docker compose up -d</code>
            </div>
        }
    </div>
</div>

@* ============ PREVIEW ============ *@
<div class="tab-panel" data-panel="preview" hidden>
    <div class="card">
        <div class="cp-head">
            <h2>@T["instances.tabPreview"]</h2>
            @if (!string.IsNullOrWhiteSpace(Model.Item.PreviewUrl))
            {
                <span class="muted mono">@Model.Item.PreviewUrl</span>
                @if (Model.Item.PreviewIsGuessed)
                {
                    <span class="badge badge-off" title="@T["instances.previewGuessedHint"]">@T["instances.previewGuessed"]</span>
                }
            }
        </div>
        @if (string.IsNullOrWhiteSpace(Model.Item.PreviewUrl))
        {
            <p class="muted">@T["instances.previewNoUrl"]</p>
        }
        else if (MatCMS.Cloud.Services.MixedContent.IsBlocked(Model.Request.IsHttps, Model.Item.PreviewUrl))
        {
            @* Said out loud instead of framed. The browser would refuse an http page inside this
               https one and leave the frame blank, which reads as "the site is down". *@
            <p class="muted">@T["instances.previewInsecure"]</p>
            <div class="actions">
                <a class="btn btn-sm btn-ghost" href="@Model.Item.PreviewUrl" target="_blank" rel="noopener">@T["instances.openSite"]</a>
            </div>
        }
        else
        {
            @* The browser loads the site directly from the instance, so this only works where the
               operator can reach it. A site that refuses framing or is unreachable leaves the frame
               blank — hence the explicit hint and the "open in a tab" fallback. *@
            <div class="site-frame-wrap">
                <iframe class="site-frame" src="@Model.Item.PreviewUrl" title="@Model.Item.Name"
                        loading="lazy" referrerpolicy="no-referrer" sandbox="allow-same-origin allow-scripts"></iframe>
            </div>
            <div class="help">@T["instances.previewHint"]</div>
        }
    </div>
</div>

@* ============ CONFIG ============ *@
<div class="tab-panel" data-panel="config" hidden>
    <div class="card">
        <h2>@T["instances.configuration"]</h2>
        <form method="post" asp-page-handler="AssignProfile" asp-route-id="@Model.Item.Id">
            <div class="form-field">
                <label for="profileId">@T["profiles.title"]</label>
                <select id="profileId" name="profileId">
                    <option value="">@T["enroll.noProfile"]</option>
                    @foreach (var p in Model.Profiles)
                    {
                        <option value="@p.Id" selected="@(Model.Item.ProfileId == p.Id ? "selected" : null)">@p.Name</option>
                    }
                </select>
            </div>
            @* Straight into the profile that decides what this instance receives — otherwise it is
               "remember the name, go to Profile, find it in the list". *@
            <div class="actions">
                <button type="submit" class="btn">@T["instances.assignProfile"]</button>
                @if (Model.Item.Profile is not null)
                {
                    <a class="btn btn-ghost" asp-page="/Admin/Profiles/Edit" asp-route-id="@Model.Item.Profile.Id">@T["instances.manageProfile"]</a>
                }
            </div>
        </form>

        <div class="kv" style="margin-top:18px;">
            <div class="kv-label">@T["instances.syncState"]</div>
            <div class="kv-value">
                @if (Model.Item.Profile is null)
                {
                    <span class="muted">@T["instances.noProfileHint"]</span>
                }
                else if (Model.Item.LastSyncError is not null)
                {
                    <span class="badge badge-err">@T["instances.syncFailed"]</span>
                    <span class="muted">@Model.Item.LastSyncError</span>
                }
                else if (Model.Summary.Failed > 0)
                {
                    @* The revision matched and nothing threw, but items still did not make it —
                       "synchron" here would be a lie the operator only finds in the log below. *@
                    <span class="badge badge-err">@T["instances.syncFailedItems", Model.Summary.Failed]</span>
                    <span class="muted">@T["instances.syncRevision", Model.Item.AppliedRevision]</span>
                }
                else if (Model.OutOfSync)
                {
                    <span class="badge badge-off">@T["instances.syncPending"]</span>
                    <span class="muted">@T["instances.syncRevisions", Model.Item.AppliedRevision, Model.Item.Profile.Revision]</span>
                }
                else
                {
                    <span class="badge badge-on">@T["instances.syncOk"]</span>
                    <span class="muted">@T["instances.syncRevision", Model.Item.AppliedRevision]</span>
                    @if (Model.Summary.Skipped > 0)
                    {
                        <span class="muted">— @T["instances.syncSkippedItems", Model.Summary.Skipped]</span>
                    }
                }
            </div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["instances.lastSync"]</div>
            <div class="kv-value muted">@(Model.Item.LastSyncUtc?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</div>
        </div>
    </div>

    @* Every completed apply, newest first. Appended only when the instance reports a NEW run, so a
       repeated heartbeat does not fill this with duplicates. *@
    @if (Model.Runs.Count > 0)
    {
        <div class="card">
            <div data-list data-list-key="instance-runs">
                <div class="page-head">
                    <h2>@T["instances.runs"]</h2>
                    <div class="list-toolbar">
                        <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
                    </div>
                </div>
                <p class="help">@T["instances.runsHint", MatCMS.Cloud.Models.InstanceSyncRun.KeepPerInstance]</p>
                <table class="data" data-list-table>
                    <thead>
                        <tr>
                            <th style="width:170px;">@T["common.time"]</th>
                            <th style="width:100px;">@T["profiles.revision"]</th>
                            <th>@T["instances.runOutcome"]</th>
                            <th>@T["instances.syncFailed"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in Model.Runs)
                        {
                            <tr data-search="@(run.Revision + " " + run.Error)">
                                <td class="muted mono">@run.RanAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td class="mono">@run.Revision</td>
                                <td>
                                    @if (run.Total == 0)
                                    {
                                        <span class="muted">@T["instances.runNothing"]</span>
                                    }
                                    else
                                    {
                                        @if (run.Installed > 0)
                                        {
                                            <span class="badge badge-on">@T["instances.runInstalled", run.Installed]</span>
                                        }
                                        @if (run.Updated > 0)
                                        {
                                            <span class="badge badge-on">@T["instances.runUpdated", run.Updated]</span>
                                        }
                                        @if (run.Skipped > 0)
                                        {
                                            <span class="badge badge-off">@T["instances.syncSkippedItems", run.Skipped]</span>
                                        }
                                        @if (run.Failed > 0)
                                        {
                                            <span class="badge badge-err">@T["instances.syncFailedItems", run.Failed]</span>
                                        }
                                    }
                                </td>
                                <td class="muted">@run.Error</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
            </div>
        </div>
    }

    @* The instance is the only side that knows what actually happened — whether a component already
       existed, whether a plugin import blew up. It says so, we show it verbatim. *@
    <div class="card">
        <div data-list>
            <div class="page-head">
                <h2>@T["instances.report"]</h2>
                @if (Model.SyncReport.Count > 0)
                {
                    <div class="list-toolbar">
                        <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
                    </div>
                }
            </div>
            <p class="help">@T["instances.reportHint"]</p>
            <table class="data" data-list-table>
                <thead>
                    <tr>
                        <th style="width:130px;">@T["instances.reportKind"]</th>
                        <th>@T["instances.reportId"]</th>
                        <th style="width:150px;">@T["instances.reportOutcome"]</th>
                        <th>@T["instances.reportDetail"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SyncReport.Count == 0)
                    {
                        <partial name="_EmptyRow" model='@T["instances.reportNone"]' />
                    }
                    else
                    {
                        @foreach (var r in Model.SyncReport)
                        {
                            @* Unknown kinds/outcomes fall back to the raw string: a newer instance may
                               report something this cloud has no label for, and hiding it would be worse
                               than showing it untranslated. *@
                            var kindKey = $"instances.kind.{r.Kind}";
                            var outcomeKey = $"instances.outcome.{r.Outcome}";
                            var kind = T[kindKey] == kindKey ? r.Kind : T[kindKey];
                            var outcome = T[outcomeKey] == outcomeKey ? r.Outcome : T[outcomeKey];
                            var badge = r.Outcome switch
                            {
                                "installed" or "updated" => "badge-on",
                                "failed" => "badge-err",
                                _ => "badge-off"
                            };
                            <tr data-search="@r.Kind @r.Id @r.Outcome @r.Detail">
                                <td class="muted">@kind</td>
                                <td class="mono">@r.Id</td>
                                <td><span class="badge @badge">@outcome</span></td>
                                <td class="muted">@r.Detail</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        </div>
    </div>
</div>

@* ============ EVENTS ============ *@
<div class="tab-panel" data-panel="mail" hidden>
    <div data-list>
        <div class="page-head">
            <h2>@T["spool.title"]</h2>
        </div>

        <p class="muted">@T["spool.hint"]</p>

        <table class="data" data-list-table>
            <thead>
                <tr>
                    <th>@T["spool.subject"]</th>
                    <th>@T["spool.recipients"]</th>
                    <th>@T["spool.queuedAt"]</th>
                    <th>@T["common.status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Spool.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["spool.none"]' />
                }
                else
                {
                    @foreach (var m in Model.Spool)
                    {
                        <tr data-search="@(m.Subject + " " + m.Recipients)">
                            <td><a asp-page="Mail" asp-route-id="@Model.Item.Id" asp-route-mailId="@m.Id">@m.Subject</a></td>
                            <td class="muted">@m.Recipients.Replace("\n", ", ")</td>
                            <td class="muted">@m.QueuedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @switch (m.Status)
                                {
                                    case SpoolStatus.Sent:
                                        <span class="badge badge-on">@T["spool.sent"]</span>
                                        break;
                                    case SpoolStatus.Failed:
                                        <span class="badge badge-err" title="@m.LastError">@T["spool.failed"]</span>
                                        break;
                                    default:
                                        <span class="badge badge-new">@T["spool.queued"]</span>
                                        break;
                                }
                                @* The attempt count only says something once there has been more than
                                   one — on a first-try delivery it is noise. *@
                                @if (m.Attempts > 1)
                                {
                                    <span class="muted">@T["spool.attempts"]: @m.Attempts</span>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    @if (m.Status == SpoolStatus.Failed)
                                    {
                                        <form class="inline-form" method="post" asp-page-handler="RetryMail"
                                              asp-route-id="@Model.Item.Id" asp-route-mailId="@m.Id">
                                            <button type="submit" class="btn btn-sm btn-ghost">@T["spool.retry"]</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>

        @if (Model.Spool.Any(m => m.Status == SpoolStatus.Failed))
        {
            <div class="list-actions">
                <form class="inline-form" method="post" asp-page-handler="RetryMail" asp-route-id="@Model.Item.Id">
                    <button type="submit" class="btn btn-ghost">@T["spool.retryAll"]</button>
                </form>
            </div>
        }
    </div>
</div>

@* ============ BACKUP ============ *@
<div class="tab-panel" data-panel="backup" hidden>
    <div data-list>
        <div class="page-head">
            <h2>@T["backups.title"]</h2>
            <div class="list-toolbar">
                @* Ein Backup lässt sich jederzeit anfordern, ohne dass irgendetwas entfernt wird: Die
                   Cloud hält die Platte und darf sich eine Kopie holen, wenn sie eine will. Der
                   Entfernen-Weg benutzt dasselbe, ist aber nicht der Grund dafür. *@
                <form class="inline-form" method="post" asp-page-handler="RequestBackup" asp-route-id="@Model.Item.Id">
                    <button type="submit" class="btn btn-sm">@T["instances.requestBackup"]</button>
                </form>
                <a class="btn btn-sm btn-ghost" asp-page="/Admin/Backups/Index" asp-route-instance="@Model.Item.Id" asp-route-tab="list">@T["backups.manage"]</a>
            </div>
        </div>

        @* The same three numbers the overview shows, because this is where somebody lands after
           clicking the instance there and the question does not change on the way. *@
        <div class="kv">
            <div class="kv-label">@T["backups.used"]</div>
            <div class="kv-value">
                @T["backups.usedOfQuota", Model.BackupUsed, Model.BackupQuota]
                @if (Model.BackupQuotaFromProfile is string quotaProfile)
                {
                    <span class="muted"> · @T["backups.quotaFromProfile", quotaProfile]</span>
                }
                else
                {
                    <span class="muted"> · @T["backups.quotaDefault"]</span>
                }
            </div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["backups.utilisation"]</div>
            <div class="kv-value">
                <div class="quota-row" style="max-width:320px;">
                    <div class="quota-bar @(Model.BackupPercent >= 90 ? "is-full" : Model.BackupPercent >= 75 ? "is-high" : null)">
                        <span style="width:@(Model.BackupPercent)%"></span>
                    </div>
                    <span class="quota-pct">@Model.BackupPercent&nbsp;%</span>
                </div>
            </div>
        </div>

        @* Upload from the operator's own machine. Stored as one of this instance's backups and, if
           asked, marked for restore in the same step — the site downloads and applies it on its next
           beat, exactly as it would one it made itself. *@
        <form class="upload-backup" method="post" asp-page-handler="UploadBackup" asp-route-id="@Model.Item.Id"
              enctype="multipart/form-data">
            <input type="file" name="file" accept=".zip" required aria-label="@T["instances.uploadBackup"]" />
            <label class="checkbox-row">
                <input type="checkbox" name="restoreNow" value="true" />
                <span>@T["instances.uploadRestoreNow"]</span>
            </label>
            <button type="submit" class="btn btn-sm">@T["instances.uploadBackup"]</button>
        </form>
        <div class="help">@T["instances.uploadBackupHint"]</div>

        <table class="data" data-list-table style="margin-top:14px;">
            <thead>
                <tr>
                    <th>@T["backups.file"]</th>
                    <th>@T["backups.created"]</th>
                    <th>@T["backups.size"]</th>
                    <th>@T["common.status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Backups.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["backups.none"]' />
                }
                else
                {
                    @foreach (var b in Model.Backups)
                    {
                        <tr data-search="@b.FileName">
                            <td>
                                @* Download goes to the backup area's handler — one place that streams
                                   a file, rather than a second copy of the range-request handling. *@
                                <a asp-page="/Admin/Backups/Index" asp-page-handler="Download" asp-route-id="@b.Id"><strong>@b.FileName</strong></a>
                                <div class="muted mono">@b.Origin</div>
                            </td>
                            <td class="muted">@b.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="muted">@MatCMS.Cloud.Pages.Admin.Backups.IndexModel.Size(b.SizeBytes)</td>
                            <td>
                                @if (b.RestorePending)
                                {
                                    <span class="badge badge-new">@T["backups.restorePending"]</span>
                                }
                                else if (b.RestoreError is not null)
                                {
                                    <span class="badge badge-err" title="@b.RestoreError">@T["backups.restoreFailed"]</span>
                                }
                                else if (b.RestoreDoneAt is DateTime done)
                                {
                                    <span class="badge badge-on" title="@done.ToLocalTime().ToString("dd.MM.yyyy HH:mm")">@T["backups.restored"]</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    @if (b.RestorePending)
                                    {
                                        <form class="inline-form" method="post" asp-page-handler="CancelRestore" asp-route-id="@Model.Item.Id" asp-route-backupId="@b.Id">
                                            <button type="submit" class="btn btn-sm btn-ghost">@T["backups.cancelRestore"]</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form class="inline-form" method="post" asp-page-handler="Restore" asp-route-id="@Model.Item.Id" asp-route-backupId="@b.Id"
                                              onsubmit="return confirm('@T["backups.restoreConfirm"]');">
                                            <button type="submit" class="btn btn-sm btn-ghost">@T["backups.restore"]</button>
                                        </form>
                                    }
                                    <form class="inline-form" method="post" asp-page-handler="DeleteBackup" asp-route-id="@Model.Item.Id" asp-route-backupId="@b.Id"
                                          onsubmit="return confirm('@T["backups.deleteConfirm"]');">
                                        <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="tab-panel" data-panel="events" hidden>
    <div data-list>
        <div class="page-head">
            <h2>@T["instances.events"]</h2>
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
            </div>
        </div>
        <table class="data" data-list-table>
            <thead>
                <tr><th style="width:170px;">@T["common.time"]</th><th>@T["common.event"]</th></tr>
            </thead>
            <tbody>
                @if (Model.Events.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["dashboard.noEvents"]' />
                }
                else
                {
                    @foreach (var e in Model.Events)
                    {
                        <tr data-search="@e.Message">
                            <td class="muted mono">@e.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@e.Message</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
    </div>
</div>

@* ============ SETTINGS ============ *@
<div class="tab-panel" data-panel="settings" hidden>
    @if (Model.NewToken is not null)
    {
        <div class="card">
            <h2>@T["instances.newToken"]</h2>
            <div class="alert alert-info">@T["instances.tokenOnce"]</div>
            <p class="mono is-secret">@Model.NewToken</p>
        </div>
    }

    <form method="post" asp-page-handler="Save" asp-route-id="@Model.Item.Id" id="instance-form">
        <div class="card">
            <h2>@T["instances.settings"]</h2>
            <div class="form-field">
                <label for="name">@T["common.name"]</label>
                <input id="name" name="name" value="@Model.Item.Name" required />
            </div>
            <div class="form-field">
                <label for="url">@T["instances.url"]</label>
                <input id="url" name="url" value="@Model.Item.Url" placeholder="https://beispiel.de" spellcheck="false" />
                <div class="help">@T["instances.urlHint"]</div>
            </div>
            <div class="form-field">
                <label for="notes">@T["instances.notes"]</label>
                <textarea id="notes" name="notes" rows="3">@Model.Item.Notes</textarea>
            </div>
        </div>
    </form>

    @* Every action for this instance on one line, positive before negative. *@
    <div class="form-actions">
        <button type="submit" class="btn" form="instance-form">@T["settings.save"]</button>
        @if (Model.Item.Status == InstanceStatus.Approved)
        {
            <form class="inline-form" method="post" asp-page-handler="Reject" asp-route-id="@Model.Item.Id"
                  onsubmit="return confirm('@T["instances.rejectConfirm"]');">
                <button type="submit" class="btn btn-ghost">@T["instances.reject"]</button>
            </form>
        }
        else if (Model.Item.Status == InstanceStatus.Rejected)
        {
            <form class="inline-form" method="post" asp-page-handler="Approve" asp-route-id="@Model.Item.Id">
                <button type="submit" class="btn btn-ghost">@T["instances.approve"]</button>
            </form>
        }
        <form class="inline-form" method="post" asp-page-handler="Rotate" asp-route-id="@Model.Item.Id"
              onsubmit="return confirm('@T["instances.rotateConfirm"]');">
            <button type="submit" class="btn btn-ghost">@T["instances.rotateToken"]</button>
        </form>
        @* Kein POST mit confirm() mehr: Entfernen hat vier verschiedene Ausgänge — abmelden,
           Container weg, Container UND Daten weg, und Backup holen und dann alles weg — und welcher
           davon gemeint ist, kann ein einzeiliger Browser-Dialog nicht fragen. Die Rückfrage ist
           eine eigene Seite. *@
        <a class="btn btn-danger" asp-page="Delete" asp-route-id="@Model.Item.Id">@T["instances.removeTitle"]</a>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var tabs = document.querySelectorAll('.tab');
            var panels = document.querySelectorAll('.tab-panel');
            function show(name) {
                tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.tab === name); });
                panels.forEach(function (p) { p.hidden = p.dataset.panel !== name; });
            }
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
            var want = new URLSearchParams(location.search).get('tab');
            if (want) show(want);
        })();
    </script>
}
