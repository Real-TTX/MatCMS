@page
@model MatCMS.Pages.Admin.Settings.IndexModel
@using MatCMS.Services
@{
    ViewData["Title"] = "Einstellungen";
    string V(string key) => Model.Values.TryGetValue(key, out var v) ? v : "";
}
<div class="page-head">
    <h1>Einstellungen</h1>
</div>

<form method="post">
    <div class="card">
        <h2>Allgemein</h2>
        <div class="form-field">
            <label>Seitenname</label>
            <input name="Values[@SettingKeys.SiteName]" value="@V(SettingKeys.SiteName)" />
        </div>
        <div class="form-field">
            <label>Logo</label>
            <div class="image-field">
                <div id="logo-preview" class="preview"></div>
                <div class="image-controls">
                    <input id="logo-url" name="Values[@SettingKeys.LogoUrl]" value="@V(SettingKeys.LogoUrl)" placeholder="/img/logo.svg oder /uploads/..." />
                    <div style="margin-top:8px;">
                        <button type="button" id="logo-upload-btn" class="btn btn-ghost btn-sm">Logo hochladen</button>
                        <input type="file" id="logo-file" accept="image/*" style="display:none;" />
                    </div>
                </div>
            </div>
        </div>
        <div class="form-field">
            <label>Footer-Text</label>
            <input name="Values[@SettingKeys.FooterText]" value="@V(SettingKeys.FooterText)" />
        </div>
        <div class="form-field">
            <label>Kontakt-E-Mail (Empfänger, informativ)</label>
            <input name="Values[@SettingKeys.ContactRecipient]" value="@V(SettingKeys.ContactRecipient)" />
            <div class="help">Wird aktuell nicht zum Versand genutzt – Anfragen erscheinen unter „Anfragen“.</div>
        </div>
    </div>

    <div class="card">
        <h2>Obere Leiste (Header)</h2>
        <div class="form-row">
            <div class="form-field">
                <label>Link 1 – Text</label>
                <input name="Values[@SettingKeys.TopBarLink1Text]" value="@V(SettingKeys.TopBarLink1Text)" />
            </div>
            <div class="form-field">
                <label>Link 1 – URL</label>
                <input name="Values[@SettingKeys.TopBarLink1Url]" value="@V(SettingKeys.TopBarLink1Url)" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-field">
                <label>Link 2 – Text</label>
                <input name="Values[@SettingKeys.TopBarLink2Text]" value="@V(SettingKeys.TopBarLink2Text)" />
            </div>
            <div class="form-field">
                <label>Link 2 – URL</label>
                <input name="Values[@SettingKeys.TopBarLink2Url]" value="@V(SettingKeys.TopBarLink2Url)" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn">Einstellungen speichern</button>
</form>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('logo-url');
            var file = document.getElementById('logo-file');
            var btn = document.getElementById('logo-upload-btn');
            var prev = document.getElementById('logo-preview');
            if (!btn) return;
            function setPrev(u) { if (prev) prev.style.backgroundImage = u ? "url('" + u + "')" : ''; }
            setPrev(input.value);
            input.addEventListener('input', function () { setPrev(input.value); });
            btn.addEventListener('click', function () { file.click(); });
            file.addEventListener('change', function () {
                if (!file.files || !file.files[0]) return;
                btn.disabled = true; btn.textContent = 'Lädt…';
                var fd = new FormData(); fd.append('file', file.files[0]);
                fetch('/admin/api/upload', { method: 'POST', body: fd })
                    .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
                    .then(function (r) {
                        if (r.ok && r.j.url) { input.value = r.j.url; setPrev(r.j.url); }
                        else alert(r.j.error || 'Upload fehlgeschlagen.');
                    })
                    .catch(function () { alert('Upload fehlgeschlagen.'); })
                    .then(function () { btn.disabled = false; btn.textContent = 'Logo hochladen'; file.value = ''; });
            });
        })();
    </script>
}
