@page
@model MatCMS.Cloud.Pages.Admin.Backups.IndexModel
@using MatCMS.Cloud.Services
@{
    ViewData["Title"] = T["backups.title"];
    var size = (Func<long, string>)MatCMS.Cloud.Pages.Admin.Backups.IndexModel.Size;
}
<div class="page-head">
    <h1>@T["backups.title"]</h1>
</div>

@* Two stages, because these are two different questions. "How full is everybody" is answered by
   scanning a short list of instances; "which file do I restore" needs the files. Putting both in one
   table meant the first question could only be answered by reading the second one's rows. *@
<div class="tabs" role="tablist">
    <button type="button" class="tab @(Model.ActiveTab == "overview" ? "active" : null)" data-tab="overview">@T["backups.tabOverview"]</button>
    <button type="button" class="tab @(Model.ActiveTab == "list" ? "active" : null)" data-tab="list">@T["backups.tabList"]</button>
    <button type="button" class="tab @(Model.ActiveTab == "archive" ? "active" : null)" data-tab="archive">@T["backups.tabArchive"]</button>
</div>

@* ============ ÜBERSICHT ============ *@
<div class="tab-panel" data-panel="overview" hidden="@(Model.ActiveTab == "overview" ? null : "hidden")">
    @* No card and no heading. The tab is already called Übersicht, and the list tab next to it puts
       its table straight on the page — a frame around this one made the two reiters look like two
       different kinds of page. *@
    <div>
        <table class="data">
            <thead>
                <tr>
                    <th>@T["instances.title"]</th>
                    <th>@T["backups.count"]</th>
                    <th>@T["backups.last"]</th>
                    <th>@T["backups.used"]</th>
                    <th>@T["backups.quota"]</th>
                    <th>@T["backups.utilisation"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Instances.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["instances.none"]' />
                }
                else
                {
                    @foreach (var i in Model.Instances)
                    {
                        var pct = Model.UsedPercent(i.Id);
                        <tr>
                            @* The second stage is the instance's own backup tab, not a filtered copy
                               of this list: once you have picked one instance, everything else about
                               it is one tab away, and a filtered list is a dead end by comparison. *@
                            <td><a asp-page="/Admin/Instances/Details" asp-route-id="@i.Id" asp-route-tab="backup"><strong>@i.Name</strong></a></td>
                            <td class="muted">@Model.CountFor(i.Id)</td>
                            <td class="muted">
                                @if (Model.LastBackupFor(i.Id) is DateTime last)
                                {
                                    @last.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    @* How long ago matters more than the date itself — a backup from
                                       March reads as fine until you work out that it is months old. *@
                                    var ago = MatCMS.Cloud.Pages.Admin.Backups.IndexModel.Ago(last);
                                    <span class="muted"> · @T[ago.Key, ago.Value]</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="muted">@size(Model.UsedBy(i.Id))</td>
                            <td class="muted">
                                @size(Model.QuotaFor(i.Id))
                                @* Named, not just the profile's name on its own: a profile called
                                   "Standard" would otherwise read as "this is the default value". *@
                                @if (Model.QuotaSource(i.Id) is string src)
                                {
                                    <span class="muted"> · @T["backups.quotaFromProfile", src]</span>
                                }
                                else
                                {
                                    <span class="muted"> · @T["backups.quotaDefault"]</span>
                                }
                            </td>
                            <td>
                                <div class="quota-row">
                                    @* The bar turns as it fills: past the warning mark the next upload
                                       is about to push this instance's oldest backup out, and that is
                                       worth seeing without reading the numbers. *@
                                    <div class="quota-bar @(pct >= 90 ? "is-full" : pct >= 75 ? "is-high" : null)">
                                        <span style="width:@(pct)%"></span>
                                    </div>
                                    <span class="quota-pct">@pct&nbsp;%</span>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="help">@T["backups.total", size(Model.TotalBytes)]</div>
    </div>

    @* ---- Verwaiste ---------------------------------------------------------------------------- *@
    @if (Model.Orphans.Count > 0)
    {
        <div class="card">
            <h2>@T["backups.orphans"]</h2>
            <p class="muted">@T["backups.orphansHint"]</p>
            <table class="data">
                <thead>
                    <tr><th>@T["backups.file"]</th><th>@T["backups.orphanKind"]</th><th>@T["backups.size"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Orphans)
                    {
                        <tr>
                            <td class="mono">@o.Name</td>
                            <td class="muted">@(o.Kind == "file" ? T["backups.orphanFile"] : T["backups.orphanRow"])</td>
                            <td class="muted">@size(o.SizeBytes)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="form-actions">
                <form class="inline-form" method="post" asp-page-handler="CleanOrphans" asp-route-instance="@Model.FilteredInstance"
                      onsubmit="return confirm('@T["backups.cleanConfirm"]');">
                    <button type="submit" class="btn btn-ghost">@T["backups.clean"]</button>
                </form>
            </div>
        </div>
    }
</div>

@* ============ LISTE ============ *@
<div class="tab-panel" data-panel="list" hidden="@(Model.ActiveTab == "list" ? null : "hidden")">
    <div data-list data-list-page-size="50">
        <div class="page-head">
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
                <select class="list-search" data-backup-filter aria-label="@T["instances.title"]">
                    <option value="@Url.Page("Index", new { tab = "list" })">@T["instances.filterAllInstances"]</option>
                    @foreach (var i in Model.Instances)
                    {
                        <option value="@Url.Page("Index", new { instance = i.Id, tab = "list" })"
                                selected="@(Model.FilteredInstance == i.Id ? "selected" : null)">@i.Name</option>
                    }
                </select>
            </div>
        </div>

        <table class="data" data-list-table>
            <thead>
                <tr>
                    <th>@T["backups.file"]</th>
                    <th>@T["instances.title"]</th>
                    <th>@T["backups.created"]</th>
                    <th>@T["backups.size"]</th>
                    <th>@T["common.status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["backups.none"]' />
                }
                else
                {
                    @foreach (var b in Model.Items)
                    {
                        <tr data-search="@(b.FileName + " " + Model.InstanceName(b.InstanceId))">
                            <td>
                                <a asp-page="Index" asp-page-handler="Download" asp-route-id="@b.Id"><strong>@b.FileName</strong></a>
                                <div class="muted mono">@b.Origin</div>
                            </td>
                            <td><a asp-page="/Admin/Instances/Details" asp-route-id="@b.InstanceId">@Model.InstanceName(b.InstanceId)</a></td>
                            <td class="muted">@b.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="muted">@size(b.SizeBytes)</td>
                            <td>
                                @if (b.RestorePending)
                                {
                                    <span class="badge badge-new">@T["backups.restorePending"]</span>
                                }
                                else if (b.RestoreError is not null)
                                {
                                    <span class="badge badge-err" title="@b.RestoreError">@T["backups.restoreFailed"]</span>
                                }
                                else if (b.RestoreDoneAt is DateTime done)
                                {
                                    <span class="badge badge-on" title="@done.ToLocalTime().ToString("dd.MM.yyyy HH:mm")">@T["backups.restored"]</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    @if (b.RestorePending)
                                    {
                                        <form class="inline-form" method="post" asp-page-handler="CancelRestore" asp-route-id="@b.Id" asp-route-instance="@Model.FilteredInstance">
                                            <button type="submit" class="btn btn-sm btn-ghost">@T["backups.cancelRestore"]</button>
                                        </form>
                                    }
                                    else
                                    {
                                        @* The one action here that overwrites a live site, so it asks. *@
                                        <form class="inline-form" method="post" asp-page-handler="Restore" asp-route-id="@b.Id" asp-route-instance="@Model.FilteredInstance"
                                              onsubmit="return confirm('@T["backups.restoreConfirm"]');">
                                            <button type="submit" class="btn btn-sm btn-ghost">@T["backups.restore"]</button>
                                        </form>
                                    }
                                    <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@b.Id" asp-route-instance="@Model.FilteredInstance"
                                          onsubmit="return confirm('@T["backups.deleteConfirm"]');">
                                        <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        <div class="list-pager" data-list-pager></div>
    </div>
</div>

@* ============ ARCHIVE ============ *@
@* Backups, deren Instanz es nicht mehr gibt. Eigener Reiter statt einer Zeile in der Liste: Sie
   gehören zu keiner Instanz mehr, lassen sich weder zurückspielen noch nach Instanz filtern, und in
   der Spalte Instanz stünde ein Name, der auf nichts mehr zeigt. *@
<div class="tab-panel" data-panel="archive" hidden="@(Model.ActiveTab == "archive" ? null : "hidden")">
    <div data-list data-list-page-size="50">
        <div class="page-head">
            <div class="list-toolbar">
                <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
            </div>
        </div>

        <p class="muted">@T["backups.archiveHint", size(Model.ArchivedBytes)]</p>

        <table class="data" data-list-table>
            <thead>
                <tr>
                    <th>@T["backups.file"]</th>
                    <th>@T["backups.archiveInstance"]</th>
                    <th>@T["backups.created"]</th>
                    <th>@T["backups.archivedAt"]</th>
                    <th>@T["backups.size"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Archived.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["backups.archiveNone"]' />
                }
                else
                {
                    @foreach (var a in Model.Archived)
                    {
                        <tr data-search="@(a.FileName + " " + a.InstanceName)">
                            <td>
                                <a asp-page="Index" asp-page-handler="DownloadArchived" asp-route-id="@a.Id"><strong>@a.FileName</strong></a>
                                <div class="muted">@a.Reason</div>
                            </td>
                            <td>
                                @a.InstanceName
                                <div class="muted mono">@a.InstancePublicId</div>
                            </td>
                            <td class="muted">@a.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="muted">@a.ArchivedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="muted">@size(a.SizeBytes)</td>
                            <td>
                                <div class="actions">
                                    <form class="inline-form" method="post" asp-page-handler="DeleteArchived" asp-route-id="@a.Id"
                                          onsubmit="return confirm('@T["backups.archiveDeleteConfirm"]');">
                                        <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
        <div class="list-pager" data-list-pager></div>
    </div>
</div>

@section Scripts {
    <partial name="_TabsScript" />
    <script>
        (function () {
            document.querySelectorAll('[data-backup-filter]').forEach(function (sel) {
                sel.addEventListener('change', function () { if (sel.value) location.href = sel.value; });
            });
        })();
    </script>
}
