@page
@model MatCMS.Pages.Admin.Media.IndexModel
@{
    ViewData["Title"] = T["media.title"];
    var words = new Dictionary<string, string>
    {
        ["uploading"] = T["action.uploading"], ["uploadFailed"] = T["media.uploadFailed"], ["copied"] = T["media.copied"],
        ["saving"] = T["media.saving"], ["saveFailed"] = T["media.saveFailed"], ["noUses"] = T["media.noUses"], ["usesLoading"] = T["media.usesLoading"],
        ["focalCenter"] = T["media.focalCenter"], ["edited"] = T["media.edited"], ["notEdited"] = T["media.notEdited"],
        ["resetConfirm"] = T["media.resetConfirm"], ["replaceConfirm"] = T["media.replaceConfirm"], ["leaveConfirm"] = T["media.leaveConfirm"],
        ["deleteUsed"] = T["media.deleteUsed"], ["output"] = T["media.output"], ["svgInvalid"] = T["media.svgInvalid"],
        ["kindImage"] = T["media.kindImage"], ["kindSvg"] = T["media.kindSvg"], ["kindGif"] = T["media.kindGif"], ["kindFile"] = T["media.kindFile"],
        ["usePage"] = T["media.usePage"], ["useTemplate"] = T["media.useTemplate"], ["useSetting"] = T["media.useSetting"], ["useMenu"] = T["media.useMenu"],
        ["useForm"] = T["media.useForm"], ["useComponent"] = T["media.useComponent"], ["usePlugin"] = T["media.usePlugin"],
    };
}
<link rel="stylesheet" href="~/lib/cropper/cropper.min.css" asp-append-version="true" />
<div data-list data-list-key="media" class="list-view-tiles">
    <div class="page-head">
        <h1>@T["media.title"]</h1>
        <div class="list-toolbar">
            <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
            <div class="view-toggle" data-list-viewtoggle>
                <button type="button" class="vt-btn" data-view="tiles" title="@T["media.viewTiles"]" aria-label="@T["media.viewTiles"]"><i class="ti ti-layout-grid" aria-hidden="true"></i></button>
                <button type="button" class="vt-btn" data-view="table" title="@T["media.viewTable"]" aria-label="@T["media.viewTable"]"><i class="ti ti-list" aria-hidden="true"></i></button>
            </div>
            <button type="button" id="media-upload-btn" class="btn btn-sm">@T["media.upload"]</button>
            <input type="file" id="media-file" accept="image/*,.svg,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip" multiple hidden />
        </div>
    </div>

@if (Model.AllTags.Count > 0)
{
    <div class="tag-filter">
        <a class="tag-chip @(Model.ActiveTag is null ? "active" : "")" asp-page="Index">@T["media.allTags"]</a>
        @foreach (var t in Model.AllTags)
        {
            <a class="tag-chip @(string.Equals(Model.ActiveTag, t, StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="Index" asp-route-tag="@t">@t</a>
        }
    </div>
}

@if (Model.Items.Count == 0)
{
    <div class="card"><p class="muted">@T["media.empty"]</p></div>
}

<div class="media-grid" id="media-grid" data-list-tiles>
    @foreach (var m in Model.Items)
    {
        var tagList = MatCMS.Content.TagUtil.Split(m.Tags).ToList();
        var isImg = MatCMS.Services.MediaEditor.IsImage(m);
        var ext = MatCMS.Services.MediaEditor.Ext(m.Url);
        <button type="button" class="media-card" data-search="@(m.FileName + " " + m.Tags)"
                data-media="@System.Text.Json.JsonSerializer.Serialize(MatCMS.Pages.Admin.Media.IndexModel.Dto(m))" title="@T["media.clickHint"]">
            @if (isImg)
            {
                <div class="media-thumb@(ext == ".svg" ? " media-thumb-svg" : "")" style="background-image:url('@MatCMS.Services.ThumbnailService.Url(m.Url, 320)')"></div>
            }
            else
            {
                <div class="media-thumb media-thumb-file"><span class="media-fileext">@(string.IsNullOrEmpty(ext) ? "FILE" : ext.TrimStart('.').ToUpperInvariant())</span></div>
            }
            <div class="media-meta">
                <div class="media-name" title="@m.FileName">@m.FileName</div>
                @if (tagList.Count > 0)
                {
                    <div class="media-card-tags">
                        @foreach (var t in tagList.Take(4))
                        {
                            <span class="mini-chip">@t</span>
                        }
                    </div>
                }
            </div>
        </button>
    }
</div>

    <table class="data" data-list-table>
        <thead><tr><th>@T["media.colFile"]</th><th>@T["media.colType"]</th><th>@T["media.colDims"]</th><th>@T["media.colSize"]</th><th>@T["media.tags"]</th></tr></thead>
        <tbody>
            @foreach (var m in Model.Items)
            {
                var rTags = MatCMS.Content.TagUtil.Split(m.Tags).ToList();
                var sizeStr = m.SizeBytes < 1048576 ? (m.SizeBytes / 1024.0).ToString("0.#") + " KB" : (m.SizeBytes / 1048576.0).ToString("0.#") + " MB";
                <tr class="media-row" data-search="@(m.FileName + " " + m.Tags)" data-media="@System.Text.Json.JsonSerializer.Serialize(MatCMS.Pages.Admin.Media.IndexModel.Dto(m))">
                    <td><strong>@m.FileName</strong></td>
                    <td class="mono">@m.ContentType</td>
                    <td class="muted">@(m.Width is > 0 ? $"{m.Width} × {m.Height}" : "")</td>
                    <td class="muted">@sizeStr</td>
                    <td>@foreach (var t in rTags) { <span class="mini-chip">@t</span> }</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
</div>

<div id="media-lib" data-words="@System.Text.Json.JsonSerializer.Serialize(words)"
     data-focal="@Url.Page("Index", "Focal")" data-edit="@Url.Page("Index", "Edit")" data-reset="@Url.Page("Index", "Reset")"
     data-replace="@Url.Page("Index", "Replace")" data-svg="@Url.Page("Index", "Svg")" data-uses="@Url.Page("Index", "Uses")">
    @Html.AntiForgeryToken()
</div>

@* ============ INFO ============ *@
<div class="modal-overlay" id="media-modal">
    <div class="modal modal-media" role="dialog" aria-modal="true" aria-labelledby="mm-title">
        <div class="modal-head">
            <h2 id="mm-title">@T["media.info"]</h2>
            <button type="button" class="modal-close" data-close aria-label="@T["action.close"]"><i class="ti ti-x" aria-hidden="true"></i></button>
        </div>
        <div class="modal-body media-modal-body">
            <div class="med-info-left">
                <div class="med-preview" id="mm-preview"><img id="mm-img" src="" alt="" /><span class="med-file-ext" id="mm-ext" hidden></span></div>
                <div class="med-actions">
                    <button type="button" class="btn btn-sm" id="mm-edit" hidden><i class="ti ti-pencil" aria-hidden="true"></i> @T["media.editImage"]</button>
                    <button type="button" class="btn btn-sm" id="mm-edit-svg" hidden><i class="ti ti-code" aria-hidden="true"></i> @T["media.editSvg"]</button>
                    <button type="button" class="btn btn-sm btn-ghost" id="mm-focal" hidden><i class="ti ti-focus-2" aria-hidden="true"></i> @T["media.focal"]</button>
                    <button type="button" class="btn btn-sm btn-ghost" id="mm-replace"><i class="ti ti-replace" aria-hidden="true"></i> @T["media.replace"]</button>
                    <a class="btn btn-sm btn-ghost" id="mm-download" href="#" download><i class="ti ti-download" aria-hidden="true"></i> @T["media.download"]</a>
                    <input type="file" id="mm-replace-file" hidden />
                </div>
            </div>
            <div class="media-detail">
                <div class="media-detail-name" id="mm-name"></div>
                <div class="kv"><div class="kv-label">@T["media.kind"]</div><div class="kv-value" id="mm-kind"></div></div>
                <div class="kv"><div class="kv-label">@T["media.dims"]</div><div class="kv-value" id="mm-dims"></div></div>
                <div class="kv"><div class="kv-label">@T["media.colSize"]</div><div class="kv-value" id="mm-size"></div></div>
                <div class="kv"><div class="kv-label">@T["media.uploaded"]</div><div class="kv-value" id="mm-created"></div></div>
                <div class="kv" id="mm-focal-row"><div class="kv-label">@T["media.focal"]</div><div class="kv-value" id="mm-focal-value"></div></div>
                <div class="kv" id="mm-edited-row"><div class="kv-label">@T["media.editState"]</div><div class="kv-value" id="mm-edited"></div></div>

                <div class="form-field">
                    <label for="mm-url">@T["media.url"]</label>
                    <div class="copy-row">
                        <input id="mm-url" readonly />
                        <button type="button" class="btn btn-sm btn-ghost" id="mm-copy">@T["media.copy"]</button>
                    </div>
                </div>

                <form id="mm-save-form" method="post" asp-page-handler="Save" asp-route-tag="@Model.ActiveTag" class="media-detail-form">
                    <input type="hidden" name="id" id="mm-id" />
                    <div class="form-field">
                        <label for="mm-alt">@T["media.alt"]</label>
                        <input id="mm-alt" name="alt" placeholder="@T["media.altPlaceholder"]" />
                    </div>
                    <div class="form-field">
                        <label for="mm-tag-entry">@T["media.tags"]</label>
                        <div class="tag-input" id="mm-tag-input">
                            <input type="text" id="mm-tag-entry" class="tag-entry" placeholder="@T["media.tagAdd"]" autocomplete="off" list="mm-tag-list" hidden />
                            <button type="button" class="tag-add-chip" id="mm-tag-add" title="@T["media.tagAdd"]" aria-label="@T["media.tagAdd"]">+</button>
                        </div>
                        <input type="hidden" name="tags" id="mm-tags" />
                        @if (Model.AllTags.Count > 0)
                        {
                            <datalist id="mm-tag-list">
                                @foreach (var t in Model.AllTags)
                                {
                                    <option value="@t"></option>
                                }
                            </datalist>
                            <div class="tag-suggest" id="mm-suggest">
                                @foreach (var t in Model.AllTags)
                                {
                                    <button type="button" class="mini-chip mini-chip-add" data-tag="@t">+ @t</button>
                                }
                            </div>
                        }
                    </div>
                </form>

                <div class="form-field">
                    <label>@T["media.uses"]</label>
                    <ul class="med-uses" id="mm-uses"></ul>
                </div>
            </div>

            <div class="modal-foot action-bar">
                <button type="submit" form="mm-save-form" class="btn">@T["action.save"]</button>
                <button type="button" class="btn btn-ghost" data-close>@T["action.close"]</button>
                <form method="post" asp-page-handler="Delete" asp-route-tag="@Model.ActiveTag" class="media-delete-form act-danger" id="mm-delete-form"
                      data-confirm="@T["media.confirmDelete"]">
                    <input type="hidden" name="id" id="mm-del-id" />
                    <button type="submit" class="btn btn-danger">@T["action.delete"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@* ============ BILD BEARBEITEN ============ *@
<div class="modal-overlay" id="med-editor">
    <div class="modal med-editor" role="dialog" aria-modal="true" aria-labelledby="me-title">
        <div class="modal-head">
            <h2 id="me-title">@T["media.editImage"]</h2>
            <button type="button" class="modal-close" data-close aria-label="@T["action.close"]"><i class="ti ti-x" aria-hidden="true"></i></button>
        </div>
        <div class="tabs med-tabs" role="tablist">
            <button type="button" class="tab active" data-me-tab="crop"><i class="ti ti-crop" aria-hidden="true"></i> @T["media.tabCrop"]</button>
            <button type="button" class="tab" data-me-tab="size"><i class="ti ti-dimensions" aria-hidden="true"></i> @T["media.tabSize"]</button>
            <button type="button" class="tab" data-me-tab="focal"><i class="ti ti-focus-2" aria-hidden="true"></i> @T["media.focal"]</button>
        </div>
        <div class="med-editor-body">
            <div class="med-stage" id="me-stage">
                <div class="med-crop-wrap" id="me-crop-wrap"><img id="me-img" alt="" /></div>
                <div class="med-focal-wrap" id="me-focal-wrap" hidden>
                    <img id="me-focal-img" alt="" />
                    <span class="med-focal-dot" id="me-focal-dot" hidden aria-hidden="true"></span>
                </div>
            </div>
            <aside class="med-side">
                <div data-me-panel="crop">
                    <div class="med-side-label">@T["media.ratio"]</div>
                    <div class="med-chips" id="me-ratios">
                        <button type="button" class="med-chip is-active" data-ratio="free">@T["media.cropFree"]</button>
                        <button type="button" class="med-chip" data-ratio="orig">@T["media.ratioOriginal"]</button>
                        <button type="button" class="med-chip" data-ratio="1">1:1</button>
                        <button type="button" class="med-chip" data-ratio="1.3333">4:3</button>
                        <button type="button" class="med-chip" data-ratio="1.5">3:2</button>
                        <button type="button" class="med-chip" data-ratio="1.7778">16:9</button>
                        <button type="button" class="med-chip" data-ratio="0.8">4:5</button>
                        <button type="button" class="med-chip" data-ratio="0.5625">9:16</button>
                    </div>
                    <div class="med-side-label">@T["media.rotate"]</div>
                    <div class="med-chips">
                        <button type="button" class="med-chip" data-op="rotL" title="@T["media.rotateLeft"]" aria-label="@T["media.rotateLeft"]"><i class="ti ti-rotate-2"></i></button>
                        <button type="button" class="med-chip" data-op="rotR" title="@T["media.rotateRight"]" aria-label="@T["media.rotateRight"]"><i class="ti ti-rotate-clockwise-2"></i></button>
                        <button type="button" class="med-chip" data-op="flipH" title="@T["media.flipH"]" aria-label="@T["media.flipH"]"><i class="ti ti-flip-vertical"></i></button>
                        <button type="button" class="med-chip" data-op="flipV" title="@T["media.flipV"]" aria-label="@T["media.flipV"]"><i class="ti ti-flip-horizontal"></i></button>
                    </div>
                    <button type="button" class="btn btn-ghost btn-sm" data-op="clear">@T["media.cropClear"]</button>
                    <div class="help" id="me-from-original" hidden>@T["media.fromOriginal"]</div>
                </div>
                <div data-me-panel="size" hidden>
                    <div class="form-field">
                        <label for="me-w">@T["media.width"]</label>
                        <input id="me-w" type="number" min="16" max="8000" inputmode="numeric" />
                    </div>
                    <div class="form-field">
                        <label for="me-h">@T["media.height"]</label>
                        <input id="me-h" type="number" min="16" max="8000" inputmode="numeric" />
                    </div>
                    <div class="med-chips" id="me-presets">
                        <button type="button" class="med-chip" data-w="0">@T["media.sizeFull"]</button>
                        <button type="button" class="med-chip" data-w="2560">2560</button>
                        <button type="button" class="med-chip" data-w="1920">1920</button>
                        <button type="button" class="med-chip" data-w="1200">1200</button>
                        <button type="button" class="med-chip" data-w="800">800</button>
                    </div>
                    <div class="help">@T["media.sizeHelp"]</div>
                </div>
                <div data-me-panel="focal" hidden>
                    <div class="help">@T["media.focalHint"]</div>
                    <div class="med-focal-previews" id="me-focal-previews">
                        <figure><div class="med-fp" data-ar="16/9"></div><figcaption>16:9</figcaption></figure>
                        <figure><div class="med-fp" data-ar="1/1"></div><figcaption>1:1</figcaption></figure>
                        <figure><div class="med-fp" data-ar="3/4"></div><figcaption>3:4</figcaption></figure>
                    </div>
                    <button type="button" class="btn btn-ghost btn-sm" id="me-focal-reset">@T["media.focalReset"]</button>
                </div>
                <div class="med-output muted" id="me-output"></div>
            </aside>
        </div>
        <div class="modal-foot med-editor-foot">
            <button type="button" class="btn btn-ghost" data-close>@T["action.cancel"]</button>
            <button type="button" class="btn btn-ghost" id="me-reset" hidden>@T["media.resetOriginal"]</button>
            <span class="med-gap"></span>
            <button type="button" class="btn btn-ghost" id="me-copy">@T["media.saveCopy"]</button>
            <button type="button" class="btn" id="me-apply">@T["media.apply"]</button>
        </div>
    </div>
</div>

@* ============ SVG BEARBEITEN ============ *@
<div class="modal-overlay" id="med-svg">
    <div class="modal med-editor" role="dialog" aria-modal="true" aria-labelledby="ms-title">
        <div class="modal-head">
            <h2 id="ms-title">@T["media.editSvg"]</h2>
            <button type="button" class="modal-close" data-close aria-label="@T["action.close"]"><i class="ti ti-x" aria-hidden="true"></i></button>
        </div>
        <div class="med-editor-body med-svg-body">
            <div class="med-svg-code"><textarea id="ms-code" spellcheck="false" aria-label="SVG"></textarea></div>
            <div class="med-svg-preview">
                <div class="med-preview med-preview-check"><img id="ms-img" alt="" /></div>
                <div class="help">@T["media.svgHelp"]</div>
                <div class="med-error" id="ms-error" hidden></div>
            </div>
        </div>
        <div class="modal-foot med-editor-foot">
            <button type="button" class="btn btn-ghost" data-close>@T["action.cancel"]</button>
            <span class="med-gap"></span>
            <button type="button" class="btn" id="ms-save">@T["action.save"]</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/cropper/cropper.min.js" asp-append-version="true"></script>
    <script src="~/js/media-library.js" asp-append-version="true"></script>
}
