@page "{id:int}"
@model MatCMS.Pages.Admin.Components.EditModel
@{
    ViewData["Title"] = T["components.edit"];
}
@* Nur die Überschrift: alle Aktionen dieser Seite stehen unten in EINER Reihe — dieselbe Ordnung
   wie im Plugin-Editor. Zwei Orte für Knöpfe, die dasselbe Formular betreffen, ließen einen oben
   nach dem suchen, was unten liegt. *@
<div class="page-head">
    <h1>@T["components.edit"]</h1>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    @* Reiter wie im Plugin-Editor, mit denselben Klassen (.tabs/.tab/.tab-panel) — und was hier
       BEWUSST FEHLT, ist der Dateibaum: eine Komponente hat keine Dateien. Sie ist eine Zeile mit
       Name, Typ, Beschreibung und Symbol, einer Feldliste und EINER HTML-Vorlage. Ein Baum mit einer
       Wurzel und einer einzigen „Datei“ darunter wäre Zierrat, der so tut, als gäbe es mehr zu
       ordnen. Ebenso fehlen Knotenmenü, Blaupausen und Rollen — nichts davon hat hier ein Ziel.

       ACHTUNG, DIE FALLE AUS Plugins/Edit: alle Reiterfelder MÜSSEN innerhalb dieses <form>
       bleiben. Ein ausgeblendetes Reiterfeld wird trotzdem mit abgeschickt — ein Feld AUSSERHALB
       des Formulars dagegen gar nicht, und dann kämen Name, Symbol oder Vorlage beim Speichern aus
       einem anderen Reiter LEER an und überschrieben den Bestand. *@
    <form method="post" class="form-grid" id="component-form">
        <div class="tabs" role="tablist">
            <button type="button" class="tab active" data-tab="general">@T["components.tabGeneral"]</button>
            <button type="button" class="tab" data-tab="fields">@T["components.fields"]</button>
            <button type="button" class="tab" data-tab="template">@T["components.template"]</button>
        </div>

        @* Reiter 1: womit jede Komponente anfängt. *@
        <div class="tab-panel form-grid" data-panel="general">
            <div class="form-row">
                <div class="form-field">
                    <label for="Name">@T["components.name"]</label>
                    <input id="Name" name="Name" value="@Model.Name" required />
                </div>
                <div class="form-field">
                    <label>@T["components.type"]</label>
                    <input value="@Model.Current.Type" class="mono" readonly />
                    <div class="help">@T["components.typeHelp"]</div>
                </div>
            </div>
            <div class="form-field">
                <label for="Description">@T["components.description"]</label>
                <input id="Description" name="Description" value="@Model.Description" />
            </div>
            @{
                var iconVm = new MatCMS.Pages.Shared.IconPickVm(
                    Model.Icon, LabelKey: "components.icon", HelpKey: "components.iconHelp");
            }
            <partial name="_IconPicker" model="iconVm" />
        </div>

        @* Reiter 2: die Felder. Der Hinweis auf die Platzhalter steht auch hier, weil er DIESE
           Liste erklärt — die Namen entstehen aus den Beschriftungen, die man hier eingibt. *@
        <div class="tab-panel form-grid" data-panel="fields" hidden>
            <div class="help">@T["components.fieldsHelp"]</div>
            <div id="field-rows" data-fields="@Model.FieldsJson"></div>
            <div><button type="button" class="btn btn-sm btn-ghost" id="add-field">＋ @T["components.addField"]</button></div>
            <input type="hidden" name="FieldsJson" id="FieldsJson" />
        </div>

        @* Reiter 3: die Vorlage MIT ihrer Vorschau. Sie standen als zwei Kästen untereinander, die
           Vorschau also außerhalb des Sichtfelds, sobald die Vorlage länger als ein paar Zeilen war
           — und genau beim Schreiben der Vorlage will man sehen, was dabei herauskommt. Beides
           gehört zusammen, deshalb steht es in EINEM Reiter. *@
        <div class="tab-panel form-grid" data-panel="template" hidden>
            <div class="form-field">
                <label for="TemplateHtml">@T["components.templateHtml"]</label>
                <textarea id="TemplateHtml" name="TemplateHtml" rows="14" class="code" spellcheck="false">@Model.TemplateHtml</textarea>
                <div class="help">@T["components.templateHelp"] <span id="placeholder-hint" class="mono"></span></div>
            </div>

            <div class="component-preview" id="cp-card">
                <div class="cp-head">
                    @* <h2> und nicht <h3>: die Regel .component-preview .cp-head h2 gibt es schon,
                       und für eine andere Ebene bräuchte es eine zweite. *@
                    <h2>@T["components.preview"]</h2>
                    <button type="button" class="btn btn-sm btn-ghost" id="cp-debug-toggle">@T["components.debug"]</button>
                </div>
                <div class="help">@T["components.sampleData"]</div>
                <div class="cp-sample" id="cp-sample"></div>
                <div class="cp-frame-wrap">
                    <iframe id="cp-frame" class="cp-frame" title="@T["components.preview"]"></iframe>
                </div>
                <div class="cp-debug" id="cp-debug" hidden></div>
            </div>
        </div>

        @* EINE Aktionsreihe unten, von positiv nach negativ, wie in Plugins/Edit: Speichern
           (gefüllt), dann Exportieren, dann Zurück — beide als .btn-ghost. Sie steht AUSSERHALB der
           Reiter und damit unter jedem von ihnen: ein Speichern-Knopf in einem Reiter verspräche,
           dass die anderen dabei unberührt bleiben, und das stimmt nicht.
           Was hier BEWUSST FEHLT, ist die zerstörende Aktion: das Löschen einer Komponente steht in
           der Liste, wo es schon immer stand und wo sein Rückfragetext hängt. Es hierher zu holen
           hieße, einen zweiten Löschweg zu bauen — und zwei Wege, eine Komponente loszuwerden, sind
           einer zu viel. *@
        <div class="form-actions">
            <button type="submit" class="btn">@T["action.save"]</button>
            <a class="btn btn-ghost" asp-page="Edit" asp-page-handler="ExportJson" asp-route-id="@Model.Current.Id">
                <i class="ti ti-download" aria-hidden="true"></i> @T["components.exportJson"]
            </a>
            <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
        </div>
    </form>
</div>

@section Scripts {
    @* Dieselben drei Zeilen wie auf jeder anderen Reiterseite des Admin (Einstellungen, Backup,
       Templates): Klick schaltet um, ?tab=<name> verlinkt einen. *@
    <script>
        (function () {
            var tabs = document.querySelectorAll('.tab');
            var panels = document.querySelectorAll('.tab-panel');
            function show(name) {
                tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.tab === name); });
                panels.forEach(function (p) { p.hidden = p.dataset.panel !== name; });
            }
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
            var want = new URLSearchParams(location.search).get('tab');
            if (want) show(want);
        })();
    </script>
    <script>
        window.MATCMS_CP = {
            debug: "@T["components.debug"]",
            dbgPlaceholders: "@T["components.dbgPlaceholders"]",
            dbgUnknown: "@T["components.dbgUnknown"]",
            dbgUnused: "@T["components.dbgUnused"]",
            dbgOutput: "@T["components.dbgOutput"]",
            dbgOk: "@T["components.dbgOk"]",
            dbgEmpty: "@T["components.dbgEmpty"]"
        };
    </script>
    <script>
        window.MATCMS_FIELD_TYPES = [
            ["text", "@T["components.type.text"]"],
            ["textarea", "@T["components.type.textarea"]"],
            ["richtext", "@T["components.type.richtext"]"],
            ["image", "@T["components.type.image"]"],
            ["url", "@T["components.type.url"]"]
        ];
        window.MATCMS_REMOVE = "@T["action.delete"]";
    </script>
    <script src="~/js/admin-component-editor.js" asp-append-version="true"></script>
}
