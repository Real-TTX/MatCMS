<Project Sdk="Microsoft.NET.Sdk">

  <!-- Moments: the guest area of a private event (a wedding, a birthday, a reunion) as a NATIVE plugin — personal access codes per household,
       a photo gallery the guests fill from their phones (released by the hosts), tags, hearts and comments, moderated in the back office.
       Same settings as the forum and the club plugin so it stays loadable and unloadable (docs/plugin-system-v2.md, section 7). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>MatCMS.Plugin.Moments</RootNamespace>
    <AssemblyName>Moments</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MatCMS.Plugin.Abstractions\MatCMS.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
