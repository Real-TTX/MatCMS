@page
@model MatCMS.Cloud.Pages.Admin.Hosting.UpdatesModel
@{
    ViewData["Title"] = T["hosting.title"];
}
<partial name="_HostingTabs" model='"updates"' />

<partial name="_CloudUpdateCard" model="Model.Card" />

@if (Model.RunId is null)
{
    <div class="card">
        <h2>@T["updates.instances"]</h2>
        <div class="kv">
            <div class="kv-label">@T["dashboard.latestRelease"]</div>
            <div class="kv-value">
                <span class="mono">@(Model.LatestVersion ?? T["common.unknown"])</span>
                @if (Model.LastChecked is { } lc) { <span class="muted mono">@lc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span> }
            </div>
        </div>
        <table class="data" style="margin-top:12px;">
            <thead><tr><th>@T["common.instance"]</th><th>@T["nodes.hostColumn"]</th><th>@T["updates.from"]</th><th></th><th>@T["updates.to"]</th></tr></thead>
            <tbody>
                @if (Model.Candidates.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["updates.none"]' />
                }
                @foreach (var i in Model.Candidates)
                {
                    <tr>
                        <td><a asp-page="/Admin/Instances/Details" asp-route-id="@i.Id" asp-route-tab="hosting">@i.Name</a></td>
                        <td>@(i.Node?.Name ?? T["nodes.thisHost"])</td>
                        <td class="muted mono">@(i.Version ?? "?")</td>
                        <td class="muted">→</td>
                        <td class="mono">@Model.LatestVersion</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Candidates.Count > 0)
        {
            <form method="post" asp-page-handler="Start" class="list-actions">
                <button type="submit" class="btn"><i class="ti ti-refresh" aria-hidden="true"></i> @T["updates.start", Model.Candidates.Count]</button>
            </form>
        }
    </div>

    <form method="post" asp-page-handler="Auto">
        <div class="card">
            <h2>@T["updates.auto"]</h2>
            <label class="checkbox-row">
                <input type="checkbox" name="autoUpdate" value="true" checked="@(Model.AutoUpdate ? "checked" : null)" />
                @T["settings.autoUpdateLocal"]
            </label>
            <div class="help">@T["settings.autoUpdateLocalHint"]</div>
            <div style="margin-top:14px;"><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
}
else
{
    @* Progress: the bar on top, the live table below with a status icon per instance. An error or warning
       gets a framed attention row under its line; on success the message sits in the icon's tooltip. *@
    <div class="card" data-run="@Model.RunId"
         data-labels='@System.Text.Json.JsonSerializer.Serialize(new {
             pending = T["updates.st.pending"], updating = T["updates.st.updating"], done = T["updates.st.done"],
             failed = T["updates.st.failed"], skipped = T["updates.st.skipped"],
             finished = T["updates.finished"], finishedErr = T["updates.finishedErr"] })'>
        <div class="ua-progress">
            <div class="ua-progress-head">
                <span id="ua-state" class="badge badge-new">@T["updates.running"]</span>
                <span class="ua-count"><span id="ua-done">0</span>&nbsp;/&nbsp;<span id="ua-total">?</span></span>
            </div>
            <div class="quota-bar ua-bar"><span id="ua-bar" style="width:0%"></span></div>
        </div>

        <table class="data ua-table" style="margin-top:16px;">
            <thead><tr><th>@T["common.instance"]</th><th>@T["updates.from"]</th><th></th><th>@T["updates.to"]</th><th class="ua-th-status">@T["common.status"]</th></tr></thead>
            <tbody id="ua-rows">
                <tr><td colspan="99" class="muted"><em>@T["updates.starting"]</em></td></tr>
            </tbody>
        </table>
        <div class="list-actions">
            <a class="btn btn-ghost" asp-page="Updates" id="ua-back" hidden>@T["action.back"]</a>
        </div>
    </div>

    <script>
            (function () {
                var card = document.querySelector('[data-run]');
                var run = card.getAttribute('data-run');
                var L = JSON.parse(card.getAttribute('data-labels'));
                var esc = function (s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; };
                // icon, colour class, label, and whether an error/warning attention row is shown.
                var STAT = {
                    pending:  { icon: 'ti-clock',                 cls: 'uas-pending',  label: L.pending,  attn: false },
                    updating: { icon: 'ti-loader-2',              cls: 'uas-updating', label: L.updating, attn: false },
                    done:     { icon: 'ti-circle-check-filled',   cls: 'uas-done',     label: L.done,     attn: false },
                    failed:   { icon: 'ti-alert-circle-filled',   cls: 'uas-failed',   label: L.failed,   attn: true },
                    skipped:  { icon: 'ti-alert-triangle-filled', cls: 'uas-warn',     label: L.skipped,  attn: true }
                };
                function render(d) {
                    document.getElementById('ua-total').textContent = d.total;
                    document.getElementById('ua-done').textContent = d.completed;
                    var pct = d.total ? Math.round(d.completed * 100 / d.total) : 0;
                    document.getElementById('ua-bar').style.width = pct + '%';

                    var html = '';
                    (d.items || []).forEach(function (i) {
                        var s = STAT[i.status] || { icon: 'ti-point', cls: 'uas-pending', label: i.status, attn: false };
                        var msg = i.message || '';
                        var title = (!s.attn && msg) ? msg : s.label;
                        var spin = i.status === 'updating' ? ' ua-spin' : '';
                        html += '<tr class="ua-row"><td><strong>' + esc(i.name) + '</strong></td>' +
                            '<td class="muted mono">' + esc(i.from || '?') + '</td><td class="muted">→</td>' +
                            '<td class="mono">' + esc(i.to) + '</td>' +
                            '<td class="ua-status"><i class="ti ' + s.icon + ' ' + s.cls + spin + '" title="' + esc(title) + '" aria-label="' + esc(s.label) + '"></i></td></tr>';
                        if (s.attn && msg) {
                            html += '<tr class="ua-attn-row"><td colspan="99">' +
                                '<div class="ua-attn ua-attn-' + (i.status === 'failed' ? 'err' : 'warn') + '">' +
                                '<i class="ti ' + (i.status === 'failed' ? 'ti-alert-circle' : 'ti-alert-triangle') + '" aria-hidden="true"></i>' +
                                '<span>' + esc(msg) + '</span></div></td></tr>';
                        }
                    });
                    if (html) document.getElementById('ua-rows').innerHTML = html;

                    if (d.done) {
                        var st = document.getElementById('ua-state');
                        var failed = (d.items || []).some(function (i) { return i.status === 'failed'; });
                        st.className = 'badge ' + (failed ? 'badge-err' : 'badge-on');
                        st.textContent = failed ? L.finishedErr : L.finished;
                        document.getElementById('ua-back').hidden = false;
                    }
                }
                function poll() {
                    fetch('?handler=Status&run=' + encodeURIComponent(run), { headers: { 'X-Requested-With': 'fetch' } })
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            if (!d.found) { return; }
                            render(d);
                            if (!d.done) setTimeout(poll, 1500);
                        })
                        .catch(function () { setTimeout(poll, 2000); });
                }
                poll();
            })();
    </script>
}
