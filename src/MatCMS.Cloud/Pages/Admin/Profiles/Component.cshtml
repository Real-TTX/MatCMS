@page "{profileId:int}/{id:int?}"
@model MatCMS.Cloud.Pages.Admin.Profiles.ComponentModel
@{
    ViewData["Title"] = Model.IsNew ? T["profiles.addComponent"] : Model.Item.Name;
    var ec = Model.Item;

    // Der Adapter. Der Editor selbst steht EINMAL in MatCMS.Shared.Web/Pages/Shared/_ComponentEditor
    // und wird vom CMS genauso benutzt — hier bleibt nur, was eine geteilte Ansicht nicht kann: die
    // Übersetzungen nachschlagen (sie kennt keinen der beiden Localizer) und sagen, wie DIESE Seite
    // ihre Felder nennt. Eine Komponente, die hier entsteht, verhält sich damit genau wie eine, die
    // auf einer Instanz entsteht — das war der Sinn der Übung.
    var editor = new MatCMS.Shared.Web.ComponentEditor(
        Names: new MatCMS.Shared.Web.ComponentEditorNames(
            Name: "name", Type: "type", Description: "description",
            FieldsJson: "fieldsJson", TemplateHtml: "templateHtml"),
        Labels: new MatCMS.Shared.Web.ComponentEditorLabels(
            TabGeneral: T["profiles.tabGeneral"],
            TabFields: T["profiles.componentFields"],
            TabTemplate: T["profiles.componentTemplate"],
            Name: T["common.name"],
            Type: T["profiles.componentType"],
            TypeHelp: T["profiles.componentTypeHint"],
            Description: T["profiles.description"],
            FieldsHelp: T["profiles.componentFieldsHelp"],
            AddField: T["profiles.addField"],
            TemplateLabel: T["profiles.componentTemplate"],
            TemplateHelp: T["profiles.placeholderHelp"],
            SampleData: T["profiles.sampleData"],
            Preview: T["profiles.livePreview"],
            PreviewNote: T["profiles.previewNote"],
            Debug: T["profiles.debug"],
            // Die Wörter, die das SKRIPT schreibt: die Feldzeilen und der Debug-Bereich entstehen in
            // JavaScript und können nicht im Markup stehen.
            Remove: T["common.delete"],
            DbgPlaceholders: T["profiles.dbgPlaceholders"],
            DbgUnknown: T["profiles.dbgUnknown"],
            DbgUnused: T["profiles.dbgUnused"],
            DbgOutput: T["profiles.dbgOutput"],
            DbgOk: T["profiles.dbgOk"],
            DbgEmpty: T["profiles.dbgEmpty"]),
        NameValue: ec.Name,
        TypeValue: ec.Type,
        DescriptionValue: ec.Description,
        FieldsJson: ec.FieldsJson,
        TemplateHtml: ec.TemplateHtml,
        IconPicker: new MatCMS.Cloud.Pages.Shared.IconPickVm(
            ec.Icon, HelpKey: "profiles.componentIconHelp"),
        // Anders als im CMS: hier wird die Komponente ANGELEGT, die Kennung ist also das, was der
        // Bearbeiter eingibt. Sie bleibt änderbar, weil sie erst auf der Instanz zur Identität wird.
        TypeReadOnly: false,
        // CodeMirror: das Bündel kommt weiter unten über _CodeEditorAssets.
        CodeMirror: true,
        TypePlaceholder: "hero-cta",
        FieldTypes: [
            new MatCMS.Shared.Web.ComponentFieldType("text", T["profiles.fieldText"]),
            new MatCMS.Shared.Web.ComponentFieldType("textarea", T["profiles.fieldTextarea"]),
            new MatCMS.Shared.Web.ComponentFieldType("richtext", T["profiles.fieldRichtext"]),
            new MatCMS.Shared.Web.ComponentFieldType("image", T["profiles.fieldImage"]),
            new MatCMS.Shared.Web.ComponentFieldType("url", T["profiles.fieldUrl"])
        ],
        // Die Vorschau borgt sich das Design des Templates, das dieses Profil aktiviert — ein Block
        // wird so in der Gestaltung beurteilt, in der er später wirklich steht. Genau hierin
        // unterscheidet sich die Cloud vom CMS, das die Farben seines Admin zeigt.
        PreviewTheme: new MatCMS.Shared.Web.ComponentPreviewTheme(
            Accent: Model.PreviewTheme?.AccentColor,
            Heading: Model.PreviewTheme?.HeadingColor,
            Text: Model.PreviewTheme?.TextColor,
            Background: Model.PreviewTheme?.BackgroundColor,
            AltBackground: Model.PreviewTheme?.AltBackground,
            ContainerWidth: Model.PreviewTheme?.ContainerWidth,
            ButtonRadius: Model.PreviewTheme?.ButtonRadius,
            HeadingFont: Model.PreviewTheme?.HeadingFont,
            BodyFont: Model.PreviewTheme?.BodyFont));
}
@* Heading only: every action on this page sits in ONE row at the bottom, in the CMS's order
   (save, export, back, destructive last). Two places for buttons that act on the same form had
   you looking up for what lives down. *@
<div class="page-head">
    <h1>
        @(Model.IsNew ? T["profiles.addComponent"] : Model.Item.Name)
        <span class="muted" style="font-size:14px;font-weight:400;"> — @Model.Owner.Name</span>
    </h1>
</div>

<form method="post" asp-route-profileId="@Model.Owner.Id" asp-route-id="@(Model.IsNew ? null : (int?)ec.Id)" id="component-form">
    @* Reiter mit den gewöhnlichen Klassen des Admin (.tabs/.tab/.tab-panel), genau wie im CMS —
       eine Komponente sieht hier aus wie dort. Was BEWUSST FEHLT, ist der Dateibaum des
       Plugin-Editors: eine Komponente hat keine Dateien, sondern eine Feldliste und EINE Vorlage.
       ACHTUNG: alle Reiterfelder bleiben INNERHALB des Formulars. Ein ausgeblendetes Feld wird
       mit abgeschickt, ein Feld außerhalb des Formulars gar nicht — und käme beim Speichern leer an. *@
    <div class="card">
        <partial name="_ComponentEditor" model="editor" />
    </div>

</form>

@* Save and delete on one line, positive before negative: what to do with this record is
   one decision, and burying the destructive half in a card further down made it read as a separate
   page. The delete keeps its confirm, which is what actually guards it. *@
<div class="form-actions">
    <button type="submit" class="btn" form="component-form">@T["settings.save"]</button>
    @if (!Model.IsNew)
    {
        <a class="btn btn-ghost" asp-page="Component" asp-page-handler="Export"
           asp-route-profileId="@Model.Owner.Id" asp-route-id="@ec.Id">
            <i class="ti ti-download" aria-hidden="true"></i> @T["components.exportJson"]
        </a>
    }
    <a class="btn btn-ghost" asp-page="Edit" asp-route-id="@Model.Owner.Id" asp-route-tab="components">@T["action.back"]</a>
    @if (!Model.IsNew)
    {
        <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-profileId="@Model.Owner.Id" asp-route-id="@ec.Id"
            onsubmit="return confirm('@T["profiles.componentDeleteConfirm"]');">
            <button type="submit" class="btn btn-danger">@T["common.delete"]</button>
        </form>
    }
</div>


@section Scripts {
    <partial name="_CodeEditorAssets" />
    <partial name="_TabsScript" />
    @* Das Skript des Editors liegt EINMAL in der geteilten Bibliothek — das CMS lädt dasselbe.
       Was diese Seite unterscheidet (Feldarten, die Wörter des Skripts, die Farben der Vorschau),
       hängt als data-Merkmal am #field-rows des geteilten Editors; ein window.*-Block davor
       entfällt damit. *@
    <script src="~/_content/MatCMS.Shared.Web/js/component-editor.js" asp-append-version="true"></script>
}
