@page
@model MatCMS.Pages.Admin.Attention.IndexModel
@{
    ViewData["Title"] = T["dashboard.attention"];
}
<div data-list data-list-page-size="50">
    <div class="page-head">
        <h1>@T["dashboard.attention"]</h1>
        <div class="list-toolbar">
            <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
            <select class="list-search" data-list-filter aria-label="@T["attention.filter"]">
                <option value="">@T["attention.filterAll"] (@Model.Items.Count)</option>
                <option value="err">@T["attention.filterErr"] (@Model.Items.Count(i => i.Level == "err"))</option>
                <option value="warn">@T["attention.filterWarn"] (@Model.Items.Count(i => i.Level == "warn"))</option>
                <option value="info">@T["attention.filterInfo"] (@Model.Items.Count(i => i.Level == "info"))</option>
            </select>
        </div>
    </div>

    <table class="data dash-attention attention-list" data-list-table>
        <colgroup><col class="dash-icon-col" /><col /><col class="attention-detail-col" /></colgroup>
        <thead><tr><th></th><th>@T["attention.colWhat"]</th><th>@T["attention.colWhy"]</th></tr></thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <partial name="_EmptyRow" model='@((string)T["dashboard.allClear"])' />
            }
            @foreach (var x in Model.Items)
            {
                <tr class="lvl-@x.Level" data-tags="@x.Level @x.Kind" data-search="@(x.Title + " " + x.Text + " " + x.Detail + " " + x.LastError)">
                    <td class="dash-icon"><i class="ti @x.Icon" aria-hidden="true"></i></td>
                    <td><a href="@x.Url"><strong>@x.Title</strong></a><div class="muted">@x.Text</div></td>
                    <td class="attention-why">
                        @if (!string.IsNullOrEmpty(x.Detail)) { <div>@x.Detail</div> }
                        @if (!string.IsNullOrEmpty(x.LastError)) { <div class="attention-err mono">@x.LastError</div> }
                        @if (string.IsNullOrEmpty(x.Detail) && string.IsNullOrEmpty(x.LastError)) { <span class="muted">—</span> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
    <nav class="list-pager" data-list-pager aria-label="@T["list.pager"]"></nav>
</div>
