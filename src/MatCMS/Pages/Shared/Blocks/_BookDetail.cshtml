@model MatCMS.Content.BlockData
@{
    var image = Model.Str("image");
    var badge = Model.Str("badge");
    var heading = Model.Str("heading");
    var sub = Model.Str("subheading");
    var body = Model.Str("body");
    var meta = Model.Str("meta");
    var btnText = Model.Str("buttonText");
    var side = Model.StrOr("imageSide", "left");

    static string Safe(string v, bool url = false) =>
        (!string.IsNullOrWhiteSpace(v)
            && (v.StartsWith("/") || v.StartsWith("http://") || v.StartsWith("https://") || (url && (v.StartsWith("#") || v.StartsWith("mailto:") || v.StartsWith("tel:"))))
            && v.IndexOfAny(new[] { '"', '\'', '(', ')', '\\', '\n', '\r', ' ' }) < 0)
            ? v : (url ? "#" : "");
    var safeImage = Safe(image);
    var href = Safe(Model.StrOr("buttonUrl", "#"), url: true);
    var chips = meta.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}
<section class="section bookdetail-block">
    <div class="container">
        <div class="bookdetail @(side == "right" ? "image-right" : "image-left")@(safeImage.Length > 0 ? "" : " no-image")">
            @if (safeImage.Length > 0)
            {
                <div class="bookdetail__cover">
                    <img src="@safeImage" alt="@heading" />
                </div>
            }
            <div class="bookdetail__body">
                @if (!string.IsNullOrWhiteSpace(badge))
                {
                    <p><span class="bookdetail__badge">@badge</span></p>
                }
                @if (!string.IsNullOrWhiteSpace(heading))
                {
                    <h2 class="bookdetail__title">@heading</h2>
                }
                @if (!string.IsNullOrWhiteSpace(sub))
                {
                    <p class="bookdetail__sub">@sub</p>
                }
                @if (!string.IsNullOrWhiteSpace(body))
                {
                    <div class="rich">@Html.Raw(body)</div>
                }
                @if (chips.Length > 0)
                {
                    <ul class="bookdetail__meta">
                        @foreach (var c in chips)
                        {
                            <li>@c</li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrWhiteSpace(btnText))
                {
                    <a class="btn bookdetail__btn" href="@href">@btnText</a>
                }
            </div>
        </div>
    </div>
</section>
<style>
    /* Self-contained and theme-driven (colours come from the active template's CSS variables), so the
       block looks at home on any site without per-site CSS. */
    .bookdetail { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: 44px; align-items: center; }
    .bookdetail.image-right { direction: rtl; }
    .bookdetail.image-right > * { direction: ltr; }
    .bookdetail.no-image { grid-template-columns: 1fr; }
    .bookdetail__cover img { display: block; width: 100%; height: auto; border-radius: 10px;
        filter: drop-shadow(0 18px 34px rgba(0, 0, 0, .18)); }
    .bookdetail__badge { display: inline-block; background: var(--accent, #2f7d95); color: #fff;
        font-weight: 700; border-radius: 999px; padding: 7px 18px; font-size: 14px; }
    .bookdetail__title { margin: 0 0 4px; }
    .bookdetail__sub { font-size: 1.1em; color: var(--muted, #6b7280); margin: 0 0 14px; }
    .bookdetail__body .rich { line-height: 1.65; }
    .bookdetail__meta { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
    .bookdetail__meta li { background: var(--bg-alt, #f2f5f8); color: var(--black, #1f2937);
        border-radius: 8px; padding: 6px 13px; font-size: 13.5px; font-weight: 600; }
    .bookdetail__btn { margin-top: 22px; }
    @@media (max-width: 820px) {
        .bookdetail, .bookdetail.image-right { grid-template-columns: 1fr; direction: ltr; gap: 26px; }
        .bookdetail__cover { max-width: 320px; margin: 0 auto; }
    }
</style>
