@model MatCMS.Content.ContainerBlockModel
@{
    var heading = Model.Data.Str("heading");
    var intro = Model.Data.Str("intro");
    var colors = Model.Data.StrOr("colors", "accent") == "vivid" ? "vivid" : "accent";
    var extrasHeading = Model.Data.Str("extrasHeading");
    var extrasIntro = Model.Data.Str("extrasIntro");
    var extras = Lines(Model.Data.Str("extras"));
    // Up to three plans sit side by side; a fourth would squeeze every card below readable width.
    var cols = Math.Clamp(Model.Children.Count, 1, 3);
}
<section class="section pr-block pr--@colors">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(heading) || !string.IsNullOrWhiteSpace(intro))
        {
            <div class="section__intro">
                @if (!string.IsNullOrWhiteSpace(heading)) { <h2 class="pr-title">@Html.Raw(GradientHeading(heading))</h2> }
                @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
            </div>
        }
        <div class="pr-plans" style="--pr-cols:@cols">
            @foreach (var plan in Model.Children)
            {
                @await Html.PartialAsync("Blocks/_Plan", plan.Data)
            }
        </div>
        @if (extras.Count > 0 || !string.IsNullOrWhiteSpace(extrasHeading))
        {
            <div class="pr-extras">
                @if (!string.IsNullOrWhiteSpace(extrasHeading)) { <h3>@extrasHeading</h3> }
                @if (!string.IsNullOrWhiteSpace(extrasIntro)) { <p class="pr-extras-intro">@extrasIntro</p> }
                @if (extras.Count > 0)
                {
                    <ul class="pr-extras-list">
                        @foreach (var x in extras) { <li><i class="pr-check" aria-hidden="true"></i>@x</li> }
                    </ul>
                }
            </div>
        }
    </div>
</section>
@functions {
    static List<string> Lines(string? s) => (s ?? "").Replace("\r\n", "\n").Split('\n')
        .Select(l => l.Trim()).Where(l => l.Length > 0).ToList();

    // HTML-encodes the heading and turns *…* into the gradient span — the herocta convention.
    static string GradientHeading(string s)
    {
        var enc = System.Net.WebUtility.HtmlEncode(s);
        enc = System.Text.RegularExpressions.Regex.Replace(enc, "\\*(.+?)\\*", "<span class=\"hc-grad\">$1</span>");
        return enc.Replace("\r\n", "\n").Replace("\n", "<br>");
    }
}
