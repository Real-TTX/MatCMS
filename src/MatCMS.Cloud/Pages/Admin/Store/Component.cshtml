@page "{id:int?}"
@model MatCMS.Cloud.Pages.Admin.Store.ComponentModel
@{
    ViewData["Title"] = Model.IsNew ? T["profiles.addComponent"] : Model.Item.Name;
    var ec = Model.Item;

    // Derselbe Adapter wie auf der Profilseite — der Editor selbst steht EINMAL in
    // MatCMS.Shared.Web/Pages/Shared/_ComponentEditor. Hier bleibt nur das Nachschlagen der
    // Übersetzungen und die Auskunft, wie DIESE Seite ihre Felder nennt.
    var editor = new MatCMS.Shared.Web.ComponentEditor(
        Names: new MatCMS.Shared.Web.ComponentEditorNames(
            Name: "name", Type: "type", Description: "description",
            FieldsJson: "fieldsJson", TemplateHtml: "templateHtml"),
        Labels: new MatCMS.Shared.Web.ComponentEditorLabels(
            TabGeneral: T["profiles.tabGeneral"],
            TabFields: T["profiles.componentFields"],
            TabTemplate: T["profiles.componentTemplate"],
            Name: T["common.name"],
            Type: T["profiles.componentType"],
            TypeHelp: T["profiles.componentTypeHint"],
            Description: T["profiles.description"],
            FieldsHelp: T["profiles.componentFieldsHelp"],
            AddField: T["profiles.addField"],
            TemplateLabel: T["profiles.componentTemplate"],
            TemplateHelp: T["profiles.placeholderHelp"],
            SampleData: T["profiles.sampleData"],
            Preview: T["profiles.livePreview"],
            Debug: T["profiles.debug"]),
        NameValue: ec.Name,
        TypeValue: ec.Type,
        DescriptionValue: ec.Description,
        FieldsJson: ec.FieldsJson,
        TemplateHtml: ec.TemplateHtml,
        IconPicker: new MatCMS.Cloud.Pages.Shared.IconPickVm(
            ec.Icon, HelpKey: "profiles.componentIconHelp"),
        TypeReadOnly: false,
        CodeMirror: true,
        TypePlaceholder: "hero-cta");
}
@* Heading only: every action on this page sits in ONE row at the bottom, in the CMS's order
   (save, export, back, destructive last). *@
<div class="page-head">
    <h1>
        @(Model.IsNew ? T["profiles.addComponent"] : Model.Item.Name)
        <span class="muted" style="font-size:14px;font-weight:400;"> — @T["store.title"]</span>
    </h1>
</div>

@if (!Model.IsNew && Model.UsedBy.Count > 0)
{
    <div class="alert alert-info">
        @T["store.usedByWarning"] <strong>@string.Join(", ", Model.UsedBy)</strong>
    </div>
}

<form method="post" asp-route-id="@(Model.IsNew ? null : (int?)ec.Id)" id="component-form">
    @* Dieselben Reiter wie auf der Profilseite und im CMS — eine Komponente sieht überall gleich
       aus. Kein Dateibaum: eine Komponente hat keine Dateien. Und alle Reiterfelder bleiben
       INNERHALB des Formulars, sonst kämen sie beim Speichern leer an. *@
    <div class="card">
        <partial name="_ComponentEditor" model="editor" />
    </div>

</form>

@* Save and delete on one line, positive before negative: what to do with this record is
   one decision, and burying the destructive half in a card further down made it read as a separate
   page. The delete keeps its confirm, which is what actually guards it. *@
<div class="form-actions">
    <button type="submit" class="btn" form="component-form">@T["settings.save"]</button>
    @if (!Model.IsNew)
    {
        <a class="btn btn-ghost" asp-page="Component" asp-page-handler="Export" asp-route-id="@ec.Id">
            <i class="ti ti-download" aria-hidden="true"></i> @T["components.exportJson"]
        </a>
    }
    <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
    @if (!Model.IsNew)
    {
        <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@ec.Id"
            onsubmit="return confirm('@T["store.componentDeleteConfirm"]');">
            <button type="submit" class="btn btn-danger">@T["common.delete"]</button>
        </form>
    }
</div>


@section Scripts {
    <partial name="_CodeEditorAssets" />
    <partial name="_TabsScript" />
    <script>
        window.CLOUD_FIELD_TYPES = [
            ["text", "@T["profiles.fieldText"]"],
            ["textarea", "@T["profiles.fieldTextarea"]"],
            ["richtext", "@T["profiles.fieldRichtext"]"],
            ["image", "@T["profiles.fieldImage"]"],
            ["url", "@T["profiles.fieldUrl"]"]
        ];
        window.CLOUD_CP = {
            remove: "@T["common.delete"]",
            dbgPlaceholders: "@T["profiles.dbgPlaceholders"]",
            dbgUnknown: "@T["profiles.dbgUnknown"]",
            dbgUnused: "@T["profiles.dbgUnused"]",
            dbgOutput: "@T["profiles.dbgOutput"]",
            dbgOk: "@T["profiles.dbgOk"]",
            dbgEmpty: "@T["profiles.dbgEmpty"]"
        };
        // No profile here, so no activated template to borrow a theme from — the preview uses the
        // neutral defaults baked into component-editor.js.
        window.CLOUD_PREVIEW_THEME = {};
    </script>
    <script src="~/js/component-editor.js" asp-append-version="true"></script>
}
