@page
@model MatCMS.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = T["users.new"];
}
<div class="page-head">
    <h1>@T["users.new"]</h1>
    <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" class="form-grid">
        <div class="form-row">
            <div class="form-field">
                <label for="Email">@T["users.email"]</label>
                <input id="Email" name="Email" type="email" value="@Model.Email" placeholder="name@example.com" required autofocus />
                <div class="help">@T["users.emailLogin"]</div>
            </div>
            <div class="form-field">
                <label for="DisplayName">@T["users.displayNameOptional"]</label>
                <input id="DisplayName" name="DisplayName" value="@Model.DisplayName" />
            </div>
        </div>
        <div class="form-field">
            <label for="Password">@T["users.password"]</label>
            <input id="Password" name="Password" type="password" required />
        </div>
        <div>
            <button type="submit" class="btn">@T["users.createSubmit"]</button>
        </div>
    </form>
</div>
