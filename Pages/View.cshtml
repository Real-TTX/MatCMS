@page "/{slug?}"
@model MatCMS.Pages.ViewModel
@{
    // Editor preview mode: only for admins, adds per-block wrappers + inspector highlighting.
    var http = ViewContext.HttpContext;
    var editor = http.Request.Query.ContainsKey("editor") && http.User.IsInRole("Admin");
}
@if (editor)
{
    <div id="mat-blocks">
        @await Html.PartialAsync("_BlockList", new MatCMS.Content.BlockListModel(Model.CurrentPage.Blocks, Model.Registry, true))
    </div>
}
else
{
    @await Html.PartialAsync("_BlockList", new MatCMS.Content.BlockListModel(Model.CurrentPage.Blocks, Model.Registry, false))
}

@if (editor)
{
    <style>
        /* Editor mode: only blocks are interactive — everything else (header, menu, footer) is off-limits. */
        html { cursor: not-allowed; }
        .mat-ed-block { position: relative; }
        .mat-ed-block::after {
            content: attr(data-block-name);
            position: absolute; top: 6px; left: 6px; z-index: 9998;
            background: #2563eb; color: #fff; font: 600 11px/1 Inter, sans-serif;
            padding: 4px 8px; border-radius: 5px; letter-spacing: .03em;
            opacity: 0; transform: translateY(-4px); transition: opacity .12s ease, transform .12s ease;
            pointer-events: none;
        }
        .mat-ed-block { cursor: pointer; }
        /* Subtle hover affordance — clearly different from the solid "selected" outline. */
        .mat-ed-block:hover { outline: 1px dashed rgba(37, 99, 235, .5); outline-offset: -1px; }
        .mat-ed-block:hover::after { opacity: 1; transform: translateY(0); }
        .mat-ed-block.mat-selected { outline: 3px solid #2563eb; outline-offset: -3px; }
        .mat-ed-block.mat-selected:hover { outline: 3px solid #2563eb; }
        .mat-ed-block.mat-flash { animation: matFlash 1s ease; }
        /* Insert-between-blocks zones (page-builder style) shown in the preview. */
        .mat-insert { display: block; width: 100%; border: none; background: none; padding: 0; margin: 0; cursor: pointer; position: relative; height: 22px; opacity: 0; transition: opacity .12s ease; z-index: 9997; }
        .mat-insert::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 3px; background: #2563eb; border-radius: 3px; transform: translateY(-50%); }
        .mat-insert span { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 1; font: 700 11px/1 Inter, sans-serif; background: #2563eb; color: #fff; padding: 4px 14px; border-radius: 999px; white-space: nowrap; box-shadow: 0 2px 8px rgba(37,99,235,.4); }
        body:hover .mat-insert { opacity: .16; }
        .mat-insert:hover { opacity: 1; }
        @@keyframes matFlash { 0%,100% { background: transparent; } 30% { background: rgba(37,99,235,.10); } }
    </style>
    <script>
        (function () {
            var selected = null;
            function post(msg) { if (window.parent && window.parent !== window) window.parent.postMessage(msg, "*"); }

            // Selecting a block reloads the editor page, which reloads this iframe. Persist the
            // scroll position so the preview stays put instead of jumping back to the top.
            var scrollKey = "mat-ed-scroll:" + location.pathname;
            function saveScroll() { try { sessionStorage.setItem(scrollKey, String(window.scrollY)); } catch (e) {} }
            function restoreScroll() {
                try { var y = parseInt(sessionStorage.getItem(scrollKey) || "0", 10); if (y > 0) window.scrollTo(0, y); } catch (e) {}
            }
            window.addEventListener("scroll", saveScroll, { passive: true });
            window.addEventListener("beforeunload", saveScroll);
            restoreScroll();
            window.addEventListener("load", restoreScroll);

            // Only scroll when the element isn't already comfortably in view (avoids re-scrolling
            // to a block that's already visible).
            function inView(el) {
                var r = el.getBoundingClientRect();
                var h = window.innerHeight || document.documentElement.clientHeight;
                return r.top >= 0 && r.bottom <= h;
            }
            function ensureVisible(el) {
                if (!inView(el)) el.scrollIntoView({ behavior: "smooth", block: "center" });
            }

            // In editor mode, clicking anywhere selects the containing block (and never navigates).
            document.addEventListener("click", function (e) {
                var block = e.target.closest(".mat-ed-block");
                if (block) { e.preventDefault(); e.stopPropagation(); post({ type: "mat-select-block", id: block.getAttribute("data-block-id") }); }
                else {
                    var a = e.target.closest("a");
                    if (a) e.preventDefault(); // keep the preview stable
                }
            }, true);

            // Receive scroll/select requests from the editor.
            window.addEventListener("message", function (e) {
                var d = e.data || {};
                if (d.type === "mat-scroll" && d.id) {
                    var el = document.getElementById("block-" + d.id);
                    if (el) { ensureVisible(el); el.classList.add("mat-flash"); setTimeout(function () { el.classList.remove("mat-flash"); }, 1000); }
                }
                if (d.type === "mat-select" && d.id) {
                    if (selected) selected.classList.remove("mat-selected");
                    selected = document.getElementById("block-" + d.id);
                    if (selected) { selected.classList.add("mat-selected"); ensureVisible(selected); }
                }
                // Live preview: replace the block area with freshly-rendered draft HTML (no reload).
                if (d.type === "mat-render" && typeof d.html === "string") {
                    var container = document.getElementById("mat-blocks");
                    if (container) { container.innerHTML = d.html; selected = null; buildInsertZones(); }
                }
            });

            // Insert-between-blocks zones: one before each top-level block + one at the end.
            // A function (not an IIFE) so it can be re-run after a live-preview swap.
            function buildInsertZones() {
                Array.prototype.slice.call(document.querySelectorAll(".mat-insert")).forEach(function (z) { z.remove(); });
                var blocks = Array.prototype.slice.call(document.querySelectorAll(".mat-ed-block"));
                function makeZone(index) {
                    var z = document.createElement("button");
                    z.type = "button";
                    z.className = "mat-insert";
                    z.title = "Block hier einfügen";
                    z.innerHTML = "<span>+ Block</span>";
                    z.addEventListener("click", function (e) {
                        e.preventDefault(); e.stopPropagation();
                        post({ type: "mat-insert-at", index: index });
                    });
                    return z;
                }
                blocks.forEach(function (b, i) { b.parentNode.insertBefore(makeZone(i), b); });
                if (blocks.length) blocks[blocks.length - 1].insertAdjacentElement("afterend", makeZone(blocks.length));
            }
            buildInsertZones();

            post({ type: "mat-preview-ready" });
        })();
    </script>
}
