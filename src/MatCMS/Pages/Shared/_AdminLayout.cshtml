@inject MatCMS.Services.SiteContext Site
@inject MatCMS.Services.AdminNav Nav
@inject MatCMS.Services.VersionService Version
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Builder.RequestLocalizationOptions> LocOptions
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject MatCMS.Services.SitePreview Preview
@inject MatCMS.Data.AppDbContext Db
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var title = ViewData["Title"] as string ?? "Admin";
    var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Admin";

    // Admin-UI language switcher: offer exactly the languages on Localizer.AdminUiCultures, and of
    // those only the ones that really ship a Resources/<lang>.json. Driving this off "a resource file
    // exists" alone put hr/sk in the menu although they hold 19 of ~1180 keys. Note the list is the
    // ADMIN-UI one on purpose — SupportedUICultures is the CONTENT universe, and narrowing THAT to
    // shrink this menu would take the /hr/ and /sk/ pages off a live site. The visitor-facing language
    // selector lives in the public template, not here, and is unaffected either way.
    var allUiCultures = LocOptions.Value.SupportedUICultures ?? new System.Collections.Generic.List<System.Globalization.CultureInfo>();
    string _uiLang(System.Globalization.CultureInfo c) => c.Name.Split('-', 2)[0];
    var cultures = allUiCultures
        .Where(c => MatCMS.Services.Localizer.IsAdminUiSupported(_uiLang(c)))
        .Where(c => System.IO.File.Exists(
            System.IO.Path.Combine(Env.ContentRootPath, "Resources", _uiLang(c) + ".json"))).ToList();
    // Use Name (not TwoLetterISOLanguageName): under InvariantGlobalization the latter collapses to "iv".
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name.Split('-', 2)[0];
    if (string.IsNullOrEmpty(currentCulture)) currentCulture = MatCMS.Services.Localizer.ResourceFallbackCulture;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    // The Cloud segment of the switch is shown whenever this instance is CLOUD-CONNECTED (a CloudUrl is
    // configured) — NOT only for an SSO session. The three segments (Cloud | Website | Admin) must always
    // be in the same control at the same place so switching back and forth is one predictable click, and
    // the account/logout group to its right never moves. It deep-links to THIS instance on the cloud when
    // the public id is known (the cloud resolves it → Details via /Admin/Instances/Open), else the cloud
    // home; from a direct login you simply sign in at the cloud on arrival.
    var cloudUrl = (Site.Get(MatCMS.Services.SettingKeys.CloudUrl) ?? "").Trim().TrimEnd('/');
    var cloudId = (Site.Get(MatCMS.Services.SettingKeys.CloudInstanceId) ?? "").Trim();
    var cloudLink = string.IsNullOrEmpty(cloudUrl)
        ? null
        : (!string.IsNullOrEmpty(cloudId) ? $"{cloudUrl}/Admin/Instances/Open/{Uri.EscapeDataString(cloudId)}" : cloudUrl);
    // The site's picture of its home page (SitePreview): only a site connected to a cloud shows it (here and in the cloud). When it is
    // missing or out of date, this admin's browser takes a new one in the background (admin-shell.js).
    var (shotVersion, shotDue) = cloudLink is null ? ((string?)null, false) : await Preview.StateAsync(Db);
    // MatUi's shell (SHELL-03): the user at the foot of the menu, opening a context menu; initials for the avatar.
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    var theme = Site.ThemeFor(User);
}
<!DOCTYPE html>
@* MatUi (MatDesign's toolkit, copied into MatCMS.Shared.Web/lib/matui, CODE-03): data-app picks the registered accent,
   data-theme the user's scheme, data-density="compact" the tighter back-office spacing (admin-matui.css). *@
<html lang="@currentCulture" data-app="matcms" data-theme="@theme" data-density="compact" data-dlg-ok="@T["dialog.ok"]" data-dlg-cancel="@T["action.cancel"]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@title – @Site.SiteName Admin</title>
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/lib/tabler-icons/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/lib/matui/matui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin-matui.css" asp-append-version="true" />
    @MatCMS.Shared.Web.Pwa.Head(theme, MatCMS.Shared.Web.Pwa.ShortName(Site.SiteName), "matcms")
    <link rel="icon" href="@Site.FaviconUrl" />
    @* Own confirm/alert/prompt dialogs — loaded early, inline page scripts call MatDialog. *@
    <script src="~/_content/MatCMS.Shared.Web/js/mat-dialogs.js" asp-append-version="true"></script>
</head>
<body class="admin admin--matui">
    <div class="mat-app" data-admin-app>
        <aside class="mat-nav" id="mat-nav">
            <div class="mat-nav__brand">
                <a href="/admin" title="@Site.SiteName">
                    @if (Site.LogoDarkUrl is { } darkLogo)
                    {
                        @* A dark twin (the site's own, or MatCMS's while its logo is in use): admin.css shows the one that fits the scheme. *@
                        <img class="admin-logo logo-light" src="@Site.LogoUrl" alt="@Site.SiteName" />
                        <img class="admin-logo logo-dark" src="@darkLogo" alt="@Site.SiteName" />
                    }
                    else
                    {
                        <img class="admin-logo" src="@Site.LogoUrl" alt="@Site.SiteName" />
                    }
                </a>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-nav__close" data-admin-close aria-label="@T["nav.menu"]"><i class="ti ti-x" aria-hidden="true"></i></button>
            </div>
            @if (cloudLink is not null)
            {
                @* A site connected to a cloud has the cloud's switcher in the same place (MatUi's menu switcher, SHELL-15), so moving
                   between the two never changes where it is — but from here it offers only THIS site and the way back to the cloud:
                   the other sites are the cloud's business, and a site does not list its neighbours. *@
                var siteName = string.IsNullOrWhiteSpace(Site.SiteName) ? Context.Request.Host.Host : Site.SiteName;
                <div class="inst-ctx mat-nav__switch">
                    <div class="inst-picker">
                        <button type="button" class="mat-switcher inst-picker-btn" data-admin-menu="site-switch-menu" data-menu-place="bottom" aria-haspopup="menu" aria-expanded="false">
                            <span class="mat-switcher__icon inst-switch-shot">
                                <span class="inst-picker-initial">@siteName.Trim().FirstOrDefault().ToString().ToUpperInvariant()</span>
                                @* The site's own home page, small: one frame, after the page has loaded, desktop only (admin-shell.js). *@
                                @if (shotVersion is not null)
                                {
                                    <img class="site-shot" src="/_preview.webp?v=@shotVersion" alt="" aria-hidden="true" data-fallback="/" />
                                }
                                else
                                {
                                    <iframe data-src="/" title="@siteName" tabindex="-1" scrolling="no" aria-hidden="true"></iframe>
                                }
                            </span>
                            <span class="mat-switcher__text">
                                <small>@T["adminbar.viewWebsite"]</small>
                                <span class="mat-switcher__name inst-picker-name">@siteName</span>
                            </span>
                            <i class="ti ti-selector mat-switcher__chev" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            }
            @* Content, then design and configuration, then administration and system. Every line — the CMS's own
               and the plugins' — comes from the AdminNav registry, ordered within its group.
               Inside a plugin section that has a menu of its own (the shop), that menu replaces the main one, with a way back. *@
            <nav class="mat-nav__scroll admin-nav" aria-label="@T["nav.menu"]">
                <ul class="mat-nav__list">
                    @{ var submenu = await Nav.SubmenuAsync(Context.Request.Path, Context.RequestServices, Context.RequestAborted); }
                    @if (submenu is not null)
                    {
                        @await Html.PartialAsync("_AdminNavSub", submenu)
                    }
                    else
                    {
                        <li class="mat-nav__group" role="presentation">@T["nav.groupContent"]</li>
                        @await Html.PartialAsync("_AdminNavGroup", MatCMS.Plugin.AdminGroup.Content)
                        <li class="mat-nav__group" role="presentation">@T["nav.groupDesign"]</li>
                        @await Html.PartialAsync("_AdminNavGroup", MatCMS.Plugin.AdminGroup.Design)
                        <li class="mat-nav__group" role="presentation">@T["nav.groupSystem"]</li>
                        @await Html.PartialAsync("_AdminNavGroup", MatCMS.Plugin.AdminGroup.System)
                        @if (Nav.HasPluginEntries(MatCMS.Plugin.AdminGroup.Plugins))
                        {
                            <li class="mat-nav__group" role="presentation">@T["nav.plugins"]</li>
                            @await Html.PartialAsync("_AdminNavGroup", MatCMS.Plugin.AdminGroup.Plugins)
                        }
                    }
                </ul>
            </nav>
            <div class="mat-nav__foot">
                <div class="mat-nav__account">
                    <button type="button" class="mat-user" data-admin-menu="admin-user-menu" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-avatar" aria-hidden="true">@initials</span>
                        <span class="mat-user__text">
                            <span class="mat-user__name">@displayName</span>
                            <span class="mat-user__role">@role</span>
                        </span>
                        <i class="ti ti-chevron-up mat-user__chev" aria-hidden="true"></i>
                    </button>
                    @* The 3-state theme button (SHELL-04): system → light → dark, kept on the user (Account?handler=Theme). *@
                    <button type="button" class="mat-theme" data-admin-theme data-theme-state="@theme"
                            data-save="@Url.Page("/Admin/Account/Index", "Theme")"
                            data-names="@T["account.themeSystem"]|@T["account.themeLight"]|@T["account.themeDark"]"
                            title="@T["account.theme"]" aria-label="@T["account.theme"]">
                        <i class="ti ti-device-desktop" data-theme-icon="system" aria-hidden="true"></i>
                        <i class="ti ti-sun" data-theme-icon="light" aria-hidden="true"></i>
                        <i class="ti ti-moon" data-theme-icon="dark" aria-hidden="true"></i>
                    </button>
                </div>
                <a class="mat-nav__version" asp-page="/Admin/About/Index" title="@T["nav.about"]">MatCMS v@(Version.Current)</a>
            </div>
        </aside>
        <div class="mat-backdrop" data-admin-close></div>

        <div class="mat-main">
            <header class="mat-topbar">
                <button type="button" class="mat-burger" data-admin-toggle aria-label="@T["nav.menu"]" aria-controls="mat-nav" aria-expanded="false"><i class="ti ti-menu-2" aria-hidden="true"></i></button>
                <nav class="mat-crumbs" aria-label="Breadcrumb">
                    <ol>
                        <li class="mat-hide-sm"><a href="/admin">@Site.SiteName</a></li>
                        <li aria-current="page">@title</li>
                    </ol>
                </nav>
                @* The Cloud | Website | Admin switch stays in the bar (the one way between the three views);
                   account and sign-out moved into the user menu at the foot of the sidebar (SHELL-03). *@
                <div class="mat-topbar__actions">
                    <partial name="_ViewSwitch" model="@(new MatCMS.Shared.Web.ViewSwitch(
                        Active: "admin",
                        CloudUrl: cloudLink, WebUrl: "/", AdminUrl: null,
                        CloudLabel: T["adminbar.viewCloud"], WebLabel: T["adminbar.viewWebsite"], AdminLabel: T["adminbar.viewAdmin"]))" />
                </div>
            </header>

            <main class="mat-page mat-page--wide admin-content" id="main">
                @if (TempData["Flash"] is string flash && !string.IsNullOrWhiteSpace(flash))
                {
                    <div class="alert alert-success">@flash</div>
                }
                @if (TempData["FlashError"] is string flashError && !string.IsNullOrWhiteSpace(flashError))
                {
                    <div class="alert alert-error">@flashError</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    @if (cloudLink is not null)
    {
        @* The site switcher's popup: this site (where you are) and the way back to the cloud — to this site's page there. *@
        <div class="mat-menu" id="site-switch-menu" role="menu" aria-label="@T["adminbar.viewWebsite"]" hidden>
            <a class="mat-menu__item" role="menuitemradio" aria-checked="true" href="/admin"><i class="ti ti-world" aria-hidden="true"></i><span>@(string.IsNullOrWhiteSpace(Site.SiteName) ? Context.Request.Host.Host : Site.SiteName)</span><i class="ti ti-check mat-menu__check" aria-hidden="true"></i></a>
            <div class="mat-menu__sep" role="separator"></div>
            <a class="mat-menu__item" role="menuitem" href="@cloudLink"><i class="ti ti-arrow-left" aria-hidden="true"></i><span>@T["nav.backToCloud"]</span></a>
        </div>
    }
    @* The user's context menu (SHELL-03): account, the website, the admin language, sign out last. *@
    <div class="mat-menu" id="admin-user-menu" role="menu" aria-label="@displayName" hidden>
        <div class="mat-menu__head">
            <span class="mat-avatar" aria-hidden="true">@initials</span>
            <div><strong>@displayName</strong><small>@role</small></div>
        </div>
        <a class="mat-menu__item" role="menuitem" asp-page="/Admin/Account/Index"><i class="ti ti-user-circle" aria-hidden="true"></i><span>@T["nav.account"]</span></a>
        <a class="mat-menu__item" role="menuitem" href="/" target="_blank" rel="noopener"><i class="ti ti-world" aria-hidden="true"></i><span>@T["nav.viewSite"]</span></a>
        @if (cultures.Count > 1)
        {
            <div class="mat-menu__sep" role="separator"></div>
            @foreach (var c in cultures)
            {
                var lc = _uiLang(c);
                <form method="post" action="/set-language" class="mat-menu__form">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="hidden" name="culture" value="@lc" />
                    <button type="submit" class="mat-menu__item" role="menuitemradio" aria-checked="@(lc == currentCulture ? "true" : "false")"><i class="ti @(lc == currentCulture ? "ti-check" : "ti-language")" aria-hidden="true"></i><span>@T["lang." + lc]</span></button>
                </form>
            }
        }
        <div class="mat-menu__sep" role="separator"></div>
        <form method="post" asp-page="/Logout" class="mat-menu__form">
            <button type="submit" class="mat-menu__item mat-menu__item--danger" role="menuitem"><i class="ti ti-logout" aria-hidden="true"></i><span>@T["nav.logout"]</span></button>
        </form>
    </div>
    @Html.AntiForgeryToken()

    @if (shotDue)
    {
        <div hidden data-site-shot-due data-lib="@Url.Content("~/lib/modern-screenshot/modern-screenshot.js")"
             data-token="@Antiforgery.GetAndStoreTokens(Context).RequestToken"></div>
    }
    <script src="~/_content/MatCMS.Shared.Web/js/admin-shell.js" asp-append-version="true"></script>
    <script src="~/js/media-picker.js" asp-append-version="true"></script>
    <script src="~/_content/MatCMS.Shared.Web/js/ui-fields.js" asp-append-version="true"></script>
    <script src="~/_content/MatCMS.Shared.Web/js/admin-list.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
