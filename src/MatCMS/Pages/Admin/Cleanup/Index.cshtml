@page
@model MatCMS.Pages.Admin.Cleanup.IndexModel
@{
    ViewData["Title"] = T["cleanup.title"];
    // Human-readable byte size — small helper so the view can label media weight.
    string Hsize(long b) => b >= 1048576 ? $"{b / 1048576.0:0.#} MB" : b >= 1024 ? $"{b / 1024.0:0.#} KB" : $"{b} B";
    // Bare file name from a /uploads/… URL (avoids System.IO.Path, which collides in the Razor scope).
    string FileOf(string? url) => string.IsNullOrEmpty(url) ? "" : url[(url.LastIndexOf('/') + 1)..];
    var r = Model.Report;
}
@* All three lists — media, components, plugins — are ONE shape, in the selection and in the confirmation:
   [checkbox] · name · identifier · info. Only media carries a thumbnail in front: that is the one kind you
   recognise by looking at it; for components and plugins a picture would only be noise. *@
<div class="page-head">
    <h1>@T["cleanup.title"]</h1>
</div>
<p class="muted">@T["cleanup.intro"]</p>

@if (Model.Confirming)
{
    @* ---- Step 2: confirmation. Shows EXACTLY what will be deleted; a second, red submit + JS confirm. ---- *@
    <div class="card">
        <div class="form-section">
            <h2>@T["cleanup.confirmTitle"]</h2>
            <div class="help">@T["cleanup.confirmIntro"]</div>
        </div>

        @if (Model.SelMedia.Count > 0)
        {
            <h3>@T["cleanup.media"] <span class="muted">(@Model.SelMedia.Count · @Hsize(Model.SelMediaBytes))</span></h3>
            <table class="data cleanup-list">
                <thead><tr><th class="cleanup-thumb"></th><th>@T["cleanup.name"]</th><th>@T["cleanup.ident"]</th><th class="cleanup-info">@T["cleanup.info"]</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.SelMedia)
                    {
                        <tr>
                            <td class="cleanup-thumb"><img src="@m.Url" alt="" loading="lazy" /></td>
                            <td>@(FileOf(m.Url))</td>
                            <td class="muted">@m.Alt</td>
                            <td class="cleanup-info muted mono">@Hsize(m.SizeBytes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (Model.SelComponents.Count > 0)
        {
            <h3>@T["cleanup.components"] <span class="muted">(@Model.SelComponents.Count)</span></h3>
            <table class="data cleanup-list">
                <thead><tr><th>@T["cleanup.name"]</th><th>@T["cleanup.ident"]</th><th class="cleanup-info">@T["cleanup.info"]</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.SelComponents)
                    {
                        <tr><td>@c.Name</td><td class="muted mono">@c.Type</td><td class="cleanup-info muted">—</td></tr>
                    }
                </tbody>
            </table>
        }
        @if (Model.SelPlugins.Count > 0)
        {
            <h3>@T["cleanup.plugins"] <span class="muted">(@Model.SelPlugins.Count)</span></h3>
            <table class="data cleanup-list">
                <thead><tr><th>@T["cleanup.name"]</th><th>@T["cleanup.ident"]</th><th class="cleanup-info">@T["cleanup.info"]</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.SelPlugins)
                    {
                        <tr><td>@p.Name</td><td class="muted mono">@p.Key</td><td class="cleanup-info muted">@(string.IsNullOrWhiteSpace(p.Version) ? "—" : "v" + p.Version)</td></tr>
                    }
                </tbody>
            </table>
        }

        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('@T["cleanup.confirmJs"]');">
            @foreach (var m in Model.SelMedia) { <input type="hidden" name="mediaIds" value="@m.Id" /> }
            @foreach (var c in Model.SelComponents) { <input type="hidden" name="componentTypes" value="@c.Type" /> }
            @foreach (var p in Model.SelPlugins) { <input type="hidden" name="pluginKeys" value="@p.Key" /> }
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">@T["cleanup.finalDelete"]</button>
                <a class="btn btn-ghost" asp-page="Index">@T["action.cancel"]</a>
            </div>
        </form>
    </div>
    return;
}

@if (r.UnusedMedia.Count == 0 && r.UnusedComponents.Count == 0 && r.Plugins.Count == 0)
{
    <div class="card"><p>@T["cleanup.nothing"]</p></div>
    return;
}

<form method="post" asp-page-handler="Review">
    @* ---- Media: unused, pre-ticked (safest signal) ---- *@
    <div class="card">
        <div class="form-section">
            <h2>@T["cleanup.media"] <span class="muted">(@r.UnusedMedia.Count · @Hsize(r.UnusedMediaBytes))</span></h2>
            <div class="help">@T["cleanup.mediaHelp"]</div>
        </div>
        <table class="data cleanup-list">
            <thead>
                <tr>
                    <th class="cleanup-check"><input type="checkbox" data-check-all="media" checked="@(r.UnusedMedia.Count > 0 ? "checked" : null)" title="@T["cleanup.selectAll"]" aria-label="@T["cleanup.selectAll"]" /></th>
                    <th class="cleanup-thumb"></th>
                    <th>@T["cleanup.name"]</th>
                    <th>@T["cleanup.ident"]</th>
                    <th class="cleanup-info">@T["cleanup.info"]</th>
                </tr>
            </thead>
            <tbody>
                @if (r.UnusedMedia.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["cleanup.mediaNone"]' />
                }
                @foreach (var m in r.UnusedMedia)
                {
                    <tr>
                        <td class="cleanup-check"><input type="checkbox" name="mediaIds" value="@m.Id" data-check="media" checked /></td>
                        <td class="cleanup-thumb"><img src="@m.Url" alt="" loading="lazy" /></td>
                        <td>@(FileOf(m.Url))</td>
                        <td class="muted">@m.Alt</td>
                        <td class="cleanup-info muted mono">@Hsize(m.SizeBytes)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ---- Components: unused (no block of this type), pre-ticked ---- *@
    <div class="card">
        <div class="form-section">
            <h2>@T["cleanup.components"] <span class="muted">(@r.UnusedComponents.Count)</span></h2>
            <div class="help">@T["cleanup.componentsHelp"]</div>
        </div>
        <table class="data cleanup-list">
            <thead>
                <tr>
                    <th class="cleanup-check"><input type="checkbox" data-check-all="comp" checked="@(r.UnusedComponents.Count > 0 ? "checked" : null)" title="@T["cleanup.selectAll"]" aria-label="@T["cleanup.selectAll"]" /></th>
                    <th>@T["cleanup.name"]</th>
                    <th>@T["cleanup.ident"]</th>
                    <th class="cleanup-info">@T["cleanup.info"]</th>
                </tr>
            </thead>
            <tbody>
                @if (r.UnusedComponents.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["cleanup.componentsNone"]' />
                }
                @foreach (var c in r.UnusedComponents)
                {
                    <tr>
                        <td class="cleanup-check"><input type="checkbox" name="componentTypes" value="@c.Type" data-check="comp" checked /></td>
                        <td>@c.Name</td>
                        <td class="muted mono">@c.Type</td>
                        <td class="cleanup-info muted">—</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ---- Plugins: NO safe auto-detection — manual choice only, never pre-ticked ---- *@
    <div class="card">
        <div class="form-section">
            <h2>@T["cleanup.plugins"] <span class="muted">(@r.Plugins.Count)</span></h2>
            <div class="help">@T["cleanup.pluginsHelp"]</div>
        </div>
        <table class="data cleanup-list">
            <thead>
                <tr>
                    <th class="cleanup-check"><input type="checkbox" data-check-all="plugin" title="@T["cleanup.selectAll"]" aria-label="@T["cleanup.selectAll"]" /></th>
                    <th>@T["cleanup.name"]</th>
                    <th>@T["cleanup.ident"]</th>
                    <th class="cleanup-info">@T["cleanup.info"]</th>
                </tr>
            </thead>
            <tbody>
                @if (r.Plugins.Count == 0)
                {
                    <partial name="_EmptyRow" model='@T["cleanup.pluginsNone"]' />
                }
                @foreach (var p in r.Plugins)
                {
                    <tr>
                        <td class="cleanup-check"><input type="checkbox" name="pluginKeys" value="@p.Key" data-check="plugin" /></td>
                        <td>@p.Name</td>
                        <td class="muted mono">@p.Key</td>
                        <td class="cleanup-info">
                            <span class="badge @(p.Enabled ? "badge-on" : "badge-off")">@(p.Enabled ? T["cleanup.enabled"] : T["cleanup.disabled"])</span>
                            @if (!string.IsNullOrWhiteSpace(p.Version)) { <span class="muted">v@p.Version</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">@T["cleanup.next"]</button>
    </div>
</form>

@section Scripts {
    <script>
        // "Select all" in each table's header toggles its group; each master reflects its group.
        document.querySelectorAll('[data-check-all]').forEach(function (master) {
            var group = master.getAttribute('data-check-all');
            var boxes = document.querySelectorAll('[data-check="' + group + '"]');
            master.addEventListener('change', function () { boxes.forEach(function (b) { b.checked = master.checked; }); });
            boxes.forEach(function (b) {
                b.addEventListener('change', function () {
                    master.checked = Array.prototype.every.call(boxes, function (x) { return x.checked; });
                });
            });
        });
    </script>
}
