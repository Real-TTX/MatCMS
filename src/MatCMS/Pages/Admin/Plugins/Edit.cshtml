@page "{id:int}"
@model MatCMS.Pages.Admin.Plugins.EditModel
@{
    ViewData["Title"] = T["plugins.edit"];

    // Der Baum wird vom Skript gezeichnet und kann darin kein T[...] aufrufen — also kommen seine Texte
    // hier an einer Stelle zusammen und gehen als ein Stück hinüber. Einzeln in den Code gestreute
    // Übersetzungen sind der Weg, auf dem eine davon irgendwann Deutsch bleibt.
    var treeTexts = System.Text.Json.JsonSerializer.Serialize(new
    {
        title = T["plugins.title"],
        settings = T["plugins.settings"],
        fileNew = T["plugins.fileNew"],
        folderNew = T["plugins.folderNew"],
        fileAsk = T["plugins.fileAskName"],
        folderAsk = T["plugins.folderAskName"],
        folderFirst = T["plugins.folderFirstFile"],
        folderNothing = T["plugins.folderNothingCreated"],
        pathInvalid = T["plugins.pathInvalid"],
        del = T["action.delete"],
        fileDel = T["plugins.fileDeleteConfirm"],
        folderDel = T["plugins.folderDeleteConfirm"],
        delHint = T["plugins.deleteSaveHint"],
        assetUpload = T["plugins.assetUpload"],
        assetDelete = T["plugins.assetDelete"],
        assetDel = T["plugins.assetDeleteConfirm"],
        assetDelHint = T["plugins.assetDeleteHint"],
        assetUrlCopy = T["plugins.assetUrlCopy"],
        assetUrlCopied = T["plugins.assetUrlCopied"],
        assetUnsaved = T["plugins.assetUnsaved"],
        broken = T["plugins.filesBroken"],
        menu = T["plugins.nodeMenu"],
        toggle = T["plugins.treeToggle"],
        entryTitle = T["plugins.entryFileTitle"],
        sysFolder = T["plugins.systemFolderTitle"]
    });

    // Die hochgeladenen Dateien kommen als Liste vom Server ins Skript. Nur er weiß, was im Ordner
    // liegt — und was der Baum später löscht, ist genau dieser Name und nichts, was aus der Seite
    // zusammengesucht wurde.
    var treeAssets = System.Text.Json.JsonSerializer.Serialize(
        Model.Assets.Select(a => new
        {
            name = a.Name,
            size = a.Size,
            kind = a.Kind,
            url = $"/plugin-assets/{Model.Current.Key}/{a.Name}"
        }));
}
@* Nur die Überschrift: alle Aktionen dieser Seite stehen unten in EINER Reihe. Zwei Orte für
   Knöpfe, die dasselbe Formular betreffen, ließen einen oben nach dem suchen, was unten liegt. *@
<div class="page-head">
    <h1>@T["plugins.edit"]</h1>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.RunError))
    {
        <div class="alert alert-error"><strong>@T["plugins.runError"]:</strong> <span class="mono">@Model.RunError</span></div>
    }
    <form method="post" class="form-grid" id="plugin-form">
        @* Kein eigener Abschnitt mehr: der Code IST eine Datei des Plugins und steht als erste im
           Baum. Das Feld bleibt bestehen und wird vom Baum beschrieben — es ist weiterhin das, was
           abgeschickt wird, und bei ausgefallenem Skript unter "Rohform" erreichbar. *@
        <textarea id="Code" name="Code" hidden>@Model.Code</textarea>

        @* Ohne Überschrift: der Baum zeigt den Namen des Plugins als Wurzel und darunter seine Dateien.
           Ein "Weitere Dateien" davor stimmte nicht mehr, seit die Einstiegsdatei mit darin steht —
           es sind nicht weitere, es sind ALLE. *@
        @* Das Merkmal data-plugin-files sitzt hier und NICHT am Baum: das Skript sucht alles von
           diesem Punkt aus, und die Reiter samt Log und Rohform liegen neben dem Baum, nicht darin.
           Solange es am Baum hing, fand das Skript die Reiterknöpfe nicht mehr und das Umschalten
           blieb wirkungslos — der Fehler war im Browser sofort zu sehen, im Markup nicht. *@
        <div class="form-field" data-plugin-files>
            @* Der Baum SCHREIBT in das Feld darunter, er ersetzt es nicht. Jede Änderung landet
               sofort dort, und das Feld bleibt sichtbar: fällt das Skript aus, ist trotzdem alles da
               und von Hand zu retten. Ein Editor, der seinen Inhalt erst beim Absenden erzeugt,
               verliert ihn beim ersten Fall, an den niemand gedacht hat. *@
            @* Zwei Spalten: links, was es gibt, rechts, woran man arbeitet. Die Wurzel ist das Plugin
               selbst — sie macht sichtbar, dass alle Dateien IHM gehören und nirgendwo sonst
               hinreichen, was beim Auflösen von #load auch tatsächlich so ist. *@
            @* Die Reiter stehen ÜBER dem Editor, nicht in seiner Menüleiste: der Editor ist selbst
               einer der Reiter — er zeigt den Code des Plugins und sonst nichts. Log und Rohform
               sind seine Geschwister, nicht seine Unterpunkte, und ein Reiter in der Menüleiste
               hätte genau das behauptet. Dieselben Klassen wie überall im Admin (.tabs/.tab). *@
            <div class="tabs" data-pf-tabs>
                <button type="button" class="tab active" data-pf-tab="editor">@T["plugins.tabEditor"]</button>
                <button type="button" class="tab" data-pf-tab="log">@T["plugins.log"]</button>
                <button type="button" class="tab" data-pf-tab="raw">@T["plugins.tabRaw"]</button>
            </div>

            @* Reiter 1: der Editor — Baum und Datei zusammen, denn ohne den Baum wäre nicht zu
               sehen, WELCHE Datei im Feld steht. *@
            <div class="tab-panel" data-pf-panel="editor">
            <div class="pf-tree">
                @* EIN Baum, eine Wurzel: das Plugin. Darunter hängen die Systemdatei plugin.csx,
                   der Systemordner assets/ und die eigenen Ordner und Dateien — eingerückt, auf-
                   und zuklappbar. Zwei nebeneinanderstehende Listen mit je eigener Kopfzeile waren
                   keine Baumansicht, sondern zwei Listen, die so taten.
                   Vollständig vom Skript gezeichnet, weil der Baum sich beim Anlegen einer Datei
                   ändern muss, ohne dass die Seite neu lädt — die hochgeladenen Dateien kommen
                   dafür als Liste vom Server ins Skript (siehe ASSETS unten) und nicht aus dem
                   Markup: was gelöscht wird, ist genau der Name, den der Server geschickt hat. *@
                <aside class="pf-side">
                    <div class="pf-list" data-pf-list></div>
                </aside>
                <div class="pf-main">
                    @* Menüleiste des Editors: sie sagt, WELCHE Datei offen ist. Angelegt wird am
                       Knoten im Baum, zu dem es gehört — ein "Neue Datei" hier oben sagte nicht,
                       in welchem Ordner die Datei landet. *@
                    <div class="pf-menu">
                        <span class="pf-menu-file mono" data-pf-current></span>
                    </div>
                    @* Fläche für eine Skriptdatei. *@
                    <div class="tab-panel" data-pf-view="file">
                        <div class="pf-editor" data-pf-editor hidden>

                            <textarea class="code" spellcheck="false" data-pf-content></textarea>
                        </div>
                        @* Kein leerer Kasten, sondern der Hinweis, was zu tun ist. *@
                        <div class="pf-empty" data-pf-empty>@T["plugins.filePick"]</div>
                    </div>
                    @* Fläche für eine hochgeladene Datei. Sie ist KEIN Reiter, sondern erscheint an
                       derselben Stelle wie der Code, wenn im Zweig assets/ eine Datei gewählt wird
                       — sie gehört zu einer Auswahl im Baum, genau wie der Editor zu einer
                       Skriptdatei. Kein Textfeld: der Inhalt liegt auf der Platte und wird nicht
                       über dieses Formular geschrieben. *@
                    <div class="tab-panel" data-pf-view="asset" hidden style="padding:12px; gap:10px;">
                        <div>
                            <strong class="mono" data-pf-asset-name></strong>
                            <span class="badge" data-pf-asset-kind></span>
                            <span class="muted" data-pf-asset-size></span>
                        </div>
                        <img data-pf-asset-preview hidden alt="" style="max-width:320px; max-height:200px; border:1px solid var(--line, #eceef1);" />
                        <div class="form-field">
                            <label for="asset-url">URL</label>
                            <input id="asset-url" class="a-url" readonly onclick="this.select()" data-pf-asset-url />
                        </div>
                        <div class="help">@Html.Raw(T["plugins.assetsHelp"])</div>
                        <div>
                            <button type="button" class="btn btn-sm btn-danger" data-pf-asset-del>@T["plugins.assetDelete"]</button>
                        </div>
                    </div>
                </div>
            </div>
            </div>

            @* Reiter 2: der Log. Er stand als eigener Kasten unter der Seite — dieselbe Ausgabe,
               nur weit weg von dem Code, über den sie etwas sagt. Reine Ausgabe: kein Eingabefeld,
               nichts, was beim Reiterwechsel am Formular hängt. Serverseitig beim Seitenaufbau
               gefüllt, wie zuvor — der Reiter lädt nichts nach, was es vorher nicht gab. *@
            <div class="tab-panel" data-pf-panel="log" hidden style="padding:12px 0;">
                @if (Model.Log.Count == 0)
                {
                    <p class="muted">@T["plugins.logEmpty"]</p>
                }
                else
                {
                    <pre class="plugin-log">@string.Join("\n", Model.Log.Reverse())</pre>
                }
            </div>
            @* Reiter 3: die Rohform. Sie stand früher als <details> am Seitenende — dieselben zwei
               Felder, nur weit weg von dem, was sie zeigen. Beide schreiben weiterhin in DIESELBEN
               Felder: Code (versteckt, gespiegelt in CodeRaw) und FilesJson. Verschoben, nicht neu
               gebaut — ein zweites Paar Felder wäre genau der Weg, auf dem Code verlorengeht. *@
            <div class="tab-panel pf-editor" data-pf-panel="raw" hidden>
                <label class="pf-editor-head" for="CodeRaw">@MatCMS.Pages.Admin.Plugins.EditModel.EntryFile</label>
                <textarea id="CodeRaw" rows="12" class="code" spellcheck="false" data-pf-code-mirror>@Model.Code</textarea>
                <label class="pf-editor-head" for="FilesJson">@T["plugins.filesRaw"]</label>
                <textarea id="FilesJson" name="FilesJson" rows="12" class="code" spellcheck="false">@Model.FilesJson</textarea>
            </div>
            <div class="help">@Html.Raw(T["plugins.filesHelp"])</div>
            <div class="help">@Html.Raw(T["plugins.codeHelp"])</div>
        </div>

        @* Die Einstellungen des Plugins liegen im Dialog am Wurzelelement — sie stehen aber
           INNERHALB dieses Formulars. Ein Dialog neben dem Formular sähe genauso aus und würde beim
           Speichern nichts beitragen: Name, Version und Konfiguration kämen leer an und wären damit
           weg. Deshalb steht das Overlay hier und nicht am Seitenende. *@
        <div class="modal-overlay" data-pf-settings-dialog>
            <div class="modal" role="dialog" aria-modal="true" aria-labelledby="pf-settings-title">
                <div class="modal-head">
                    <h2 id="pf-settings-title">@T["plugins.settings"]</h2>
                    <button type="button" class="modal-close" data-pf-settings-close aria-label="@T["action.close"]">✕</button>
                </div>
                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-row">
                            <div class="form-field">
                                <label for="Name">@T["plugins.name"]</label>
                                <input id="Name" name="Name" value="@Model.Name" required />
                            </div>
                            <div class="form-field" style="max-width:130px;">
                                <label for="Version">Version</label>
                                <input id="Version" name="Version" value="@Model.Version" placeholder="z.B. 1.0" spellcheck="false" />
                                @if (!string.IsNullOrWhiteSpace(Model.Current.DataVersion))
                                {
                                    <div class="help">@T["plugins.dataVersion", Model.Current.DataVersion]</div>
                                }
                            </div>
                        </div>
                        <div class="form-field">
                            <label for="Description">@T["plugins.description"]</label>
                            <input id="Description" name="Description" value="@Model.Description" />
                        </div>
                        <label class="check">
                            <input type="checkbox" name="Enabled" value="true" @(Model.Enabled ? "checked" : "") /> @T["plugins.enabledLabel"]
                        </label>

                        <h3 class="form-section">@T["plugins.config"]</h3>
                        <div class="help">@Html.Raw(T["plugins.configHelp"])</div>
                        <div id="cfg-rows" data-config="@Model.ConfigJson"></div>
                        <div style="margin-top:8px;"><button type="button" class="btn btn-sm btn-ghost" id="cfg-add">＋ @T["plugins.configField"]</button></div>
                        <input type="hidden" name="ConfigJson" id="ConfigJson" />
                    </div>
                </div>
                @* Der Dialog SPEICHERT nicht selbst — gespeichert wird das ganze Formular unten.
                   Ein zweiter Speichern-Knopf hier würde versprechen, dass die Dateien draußen
                   bleiben, wo sie sind, und genau das stimmt nicht. *@
                <div class="modal-body" style="padding-top:0;">
                    <div class="modal-foot">
                        <span class="help" style="flex:1;">@T["plugins.settingsHint"]</span>
                        <button type="button" class="btn btn-sm btn-ghost" data-pf-settings-close>@T["action.close"]</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@* Alle Aktionen der Seite in EINER Reihe, von positiv nach negativ: Speichern, Exportieren,
   Zurück, Löschen (rot, ganz rechts) — dieselbe Ordnung und dieselben Klassen wie in
   Menus/EditMenu und Posts/Edit, wo Speichern das gefüllte .btn ist, Wege daneben .btn-ghost und
   das Löschen ein eigenes .inline-form mit .btn-danger.
   Der Speichern-Knopf steht außerhalb seines Formulars und erreicht es über form="plugin-form",
   weil das Löschen ein eigenes Formular ist und zwei Formulare nicht ineinander stehen dürfen. *@
<div class="form-actions">
    <button type="submit" class="btn" form="plugin-form">@T["action.save"]</button>
    <a class="btn btn-ghost" asp-page-handler="Export" asp-route-id="@Model.Current.Id">
        <i class="ti ti-download" aria-hidden="true"></i> @T["plugins.exportZip"]
    </a>
    <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
    <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@Model.Current.Id"
          onsubmit="return confirm('@T["plugins.confirmDelete"]');">
        <button type="submit" class="btn btn-danger">@T["plugins.deletePlugin"]</button>
    </form>
</div>

@* Die beiden Formulare für den Asset-Zweig im Baum. Sie stehen HIER und nicht dort, weil ein
   Formular nicht in einem anderen stehen darf und die Dateiauswahl mehrteilig (multipart)
   abgeschickt werden muss — das Plugin-Formular ist es nicht. Beide gehen an dieselben Handler
   wie bisher; der Baum bedient sie nur.
   Das Ziel des Entfernens ist der Name, den der Server an den Knopf im Baum geschrieben hat, und
   nichts, was aus der Seite geraten wurde. *@
<form id="asset-upload-form" method="post" asp-page-handler="UploadAsset" asp-route-id="@Model.Current.Id"
      enctype="multipart/form-data" hidden>
    <input type="file" name="file" id="asset-file" accept="@string.Join(",", MatCMS.Shared.PluginBundle.AllowedAssetExt)" />
</form>
<form id="asset-delete-form" method="post" asp-page-handler="DeleteAsset" asp-route-id="@Model.Current.Id" hidden>
    <input type="hidden" name="name" id="asset-delete-name" />
</form>

@section Scripts {
    <script>
(function () {
            var root = document.querySelector('[data-plugin-files]');
            var field = document.getElementById('FilesJson');
            if (!root || !field) return;

            var list = root.querySelector('[data-pf-list]');
            var editor = root.querySelector('[data-pf-editor]');
            var current = root.querySelector('[data-pf-current]');
            var content = root.querySelector('[data-pf-content]');
            var open = null;
            // Zwei Arten von Auswahl im selben Baum: eine Skriptdatei (steht im Formular) oder eine
            // hochgeladene Datei (liegt auf der Platte). Nur eine von beiden ist hervorgehoben,
            // sonst sähe es aus, als wäre beides gleichzeitig offen.
            var openAsset = null;
            // Die Einstiegsdatei liegt NICHT in der Karte, sondern im eigenen Feld Code — sie ist
            // das, was ausgeführt wird, die anderen werden von ihr geladen. Im Baum ist sie die
            // Systemdatei: immer da, an der Wurzel, ohne Menü zum Löschen oder Verschieben.
            var ENTRY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(MatCMS.Pages.Admin.Plugins.EditModel.EntryFile));
            // Der Systemordner. Ohne "/" — hier wird ein Pfadabschnitt verglichen.
            var ASSETDIR = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(MatCMS.Shared.PluginBundle.AssetFolder.TrimEnd('/')));
            var ASSETS = @Html.Raw(treeAssets);
            var TXT = @Html.Raw(treeTexts);
            var codeField = document.getElementById('Code');
            var codeMirror = document.querySelector('[data-pf-code-mirror]');
            var nameField = document.getElementById('Name');
            var empty = root.querySelector('[data-pf-empty]');
            // Zugeklappte Knoten, nach Kennung. Voreingestellt ist AUFgeklappt: nach dem Speichern
            // lädt die Seite neu, und ein Baum, der dann zugeklappt dasteht, sieht aus, als wäre
            // die Arbeit weg.
            var collapsed = {};

            function read() {
                try { return JSON.parse(field.value || '{}') || {}; } catch (e) { return null; }
            }
            // Jede Änderung geht SOFORT ins Feld. Nichts wird gesammelt und beim Absenden erzeugt —
            // was man sieht, ist bereits gespeichert, sobald man das Formular abschickt.
            function write(map) {
                field.value = JSON.stringify(map, null, 2);
            }

            // ---- Der Baum ---------------------------------------------------------------------
            // Aus der FLACHEN Karte Pfad → Inhalt wird hier — und nur hier, zum Zeichnen — ein
            // verschachtelter Baum. Gespeichert bleibt die Karte: ein Ordner ist nichts als ein "/"
            // im Pfad. Ein zweites Speicherformat müsste jeder, der die Karte liest, mitlernen.
            function build(map) {
                var top = { name: '', path: '', dirs: {}, files: [] };
                Object.keys(map).forEach(function (p) {
                    var segs = p.split('/');
                    var node = top;
                    for (var i = 0; i < segs.length - 1; i++) {
                        var s = segs[i];
                        if (!node.dirs[s]) node.dirs[s] = { name: s, path: (node.path ? node.path + '/' : '') + s, dirs: {}, files: [] };
                        node = node.dirs[s];
                    }
                    node.files.push({ name: segs[segs.length - 1], path: p });
                });
                return top;
            }

            function byName(a, b) { return a.toLowerCase() < b.toLowerCase() ? -1 : (a.toLowerCase() > b.toLowerCase() ? 1 : 0); }

            function hint(text, depth) {
                var d = document.createElement('div');
                d.className = 'help';
                d.style.paddingLeft = (10 + depth * 14) + 'px';
                d.textContent = text;
                return d;
            }

            function render() {
                var map = read();
                list.innerHTML = '';
                if (map === null) { list.appendChild(hint(TXT.broken, 1)); return; }

                // Die Wurzel ist das Plugin selbst. Alles hängt darunter — auch der Systemordner,
                // der bisher als zweite Liste danebenstand und damit behauptete, er gehöre nicht
                // dazu.
                list.appendChild(rowFor({
                    id: ':root', kind: 'root', depth: 0, path: '',
                    label: (nameField && nameField.value.trim()) || TXT.title,
                    icon: 'ti-package', expandable: true
                }));
                if (collapsed[':root']) return;

                // EINE Regel auf JEDER Ebene: erst alle Ordner, dann alle Dateien. Die
                // Systemeinträge bleiben oben — aber nur INNERHALB ihrer Gruppe: assets/ vor den
                // eigenen Ordnern, plugin.csx vor den eigenen Dateien. Vorher stand plugin.csx über
                // dem Systemordner und brach damit als einziger Knoten die Regel; wer den Baum
                // überfliegt, liest die Einrückung, nicht die Ausnahme.
                list.appendChild(rowFor({
                    id: ':assets', kind: 'assetdir', depth: 1, path: ASSETDIR, label: ASSETDIR + '/',
                    icon: collapsed[':assets'] ? 'ti-folder' : 'ti-folder-open',
                    title: TXT.sysFolder, mono: true, expandable: true
                }));
                // Ein leerer Zweig zeigt NICHTS — wie in einer Entwicklungsumgebung. Die Zeile
                // "Noch keine hochgeladenen Dateien." sagte nur, was die fehlende Einrückung
                // darunter schon sagte, und sah dabei aus wie ein Eintrag.
                if (!collapsed[':assets']) {
                    ASSETS.forEach(function (a) {
                        list.appendChild(rowFor({
                            id: ':a:' + a.name, kind: 'asset', depth: 2, path: ASSETDIR + '/' + a.name,
                            label: a.name, icon: /\.(png|jpe?g|gif|webp)$/i.test(a.name) ? 'ti-photo' : 'ti-file',
                            mono: true, asset: a, isOpen: openAsset === a.name,
                            activate: function () { showAsset(a); }
                        }));
                    });
                }

                var top = build(map);
                // Erst die eigenen Ordner …
                renderDirs(top, 1);
                // … dann die Dateien, und unter ihnen zuerst die Einstiegsdatei: sie ist immer da
                // und sie ist der Anfang, deshalb steht sie vor den selbst angelegten Dateien.
                list.appendChild(rowFor({
                    id: ':entry', kind: 'entry', depth: 1, path: ENTRY, label: ENTRY,
                    icon: 'ti-file-code', title: TXT.entryTitle, mono: true,
                    isOpen: open === ENTRY && openAsset === null,
                    activate: function () { show(ENTRY); }
                }));
                renderFiles(top, 1);
            }

            // Ordner und Dateien getrennt zeichnen, damit die Wurzel ihre Systemeinträge dazwischen
            // schieben kann, ohne die Regel "erst Ordner, dann Dateien" zu brechen.
            function renderDir(node, depth) {
                renderDirs(node, depth);
                renderFiles(node, depth);
            }

            function renderDirs(node, depth) {
                Object.keys(node.dirs).sort(byName).forEach(function (key) {
                    var dir = node.dirs[key];
                    var id = ':d:' + dir.path;
                    list.appendChild(rowFor({
                        // Mit "/" wie der Systemordner: ein Ordner sieht auf einen Blick anders aus
                        // als eine Datei ohne Endung.
                        id: id, kind: 'folder', depth: depth, path: dir.path, label: dir.name + '/',
                        icon: collapsed[id] ? 'ti-folder' : 'ti-folder-open', mono: true, expandable: true
                    }));
                    if (!collapsed[id]) renderDir(dir, depth + 1);
                });
            }

            function renderFiles(node, depth) {
                node.files.sort(function (a, b) { return byName(a.name, b.name); }).forEach(function (f) {
                    list.appendChild(rowFor({
                        id: ':f:' + f.path, kind: 'file', depth: depth, path: f.path, label: f.name,
                        icon: 'ti-file-text', mono: true, isOpen: open === f.path && openAsset === null,
                        activate: function () { show(f.path); }
                    }));
                });
            }

            function icon(name) {
                var i = document.createElement('i');
                i.className = 'ti ' + name;
                i.setAttribute('aria-hidden', 'true');
                return i;
            }

            // Eine Zeile des Baums. Alles, was sie später tut, hängt an DIESEM Knoten: der Pfad
            // steht in o.path und wird nicht aus Beschriftungen oder Nachbarzeilen erraten.
            function rowFor(o) {
                var row = document.createElement('div');
                row.className = 'pf-file' + (o.isOpen ? ' is-open' : '');
                row.style.paddingLeft = (4 + o.depth * 14) + 'px';

                var twist = document.createElement('button');
                twist.type = 'button';
                twist.className = 'pf-twist';
                if (o.expandable) {
                    twist.appendChild(icon(collapsed[o.id] ? 'ti-chevron-right' : 'ti-chevron-down'));
                    twist.title = TXT.toggle;
                    twist.setAttribute('aria-label', TXT.toggle + ': ' + o.label);
                    twist.setAttribute('aria-expanded', collapsed[o.id] ? 'false' : 'true');
                    twist.addEventListener('click', function (ev) {
                        ev.stopPropagation();
                        collapsed[o.id] = !collapsed[o.id];
                        render();
                    });
                } else {
                    twist.tabIndex = -1;
                    twist.setAttribute('aria-hidden', 'true');
                }
                row.appendChild(twist);

                var name = document.createElement('button');
                name.type = 'button';
                name.className = 'pf-file-name' + (o.mono ? ' mono' : '');
                name.appendChild(icon(o.icon));
                name.appendChild(document.createTextNode(o.label));
                if (o.title) name.title = o.title;
                name.addEventListener('click', o.activate || function () {
                    if (o.expandable) { collapsed[o.id] = !collapsed[o.id]; render(); }
                });
                row.appendChild(name);

                // Das Zahnrad bleibt an der Wurzel: die Einstellungen gehören dem PLUGIN, und ein
                // Weg, der ohne Rechtsklick auskommt, muss sichtbar bleiben.
                if (o.kind === 'root') {
                    var gear = document.createElement('button');
                    gear.type = 'button';
                    gear.className = 'pf-menu-item';
                    gear.title = TXT.settings;
                    gear.setAttribute('aria-label', TXT.settings);
                    gear.appendChild(icon('ti-settings'));
                    gear.addEventListener('click', function (ev) { ev.stopPropagation(); openSettings(); });
                    row.appendChild(gear);
                }

                // Das Menü hängt am Knoten und richtet sich nach ihm. plugin.csx bekommt keins:
                // löschen, umbenennen, verschieben kann man sie nicht — ein Menü mit ausgegrauten
                // Einträgen behauptete, es ginge doch irgendwie.
                var items = menuFor(o);
                if (items.length) {
                    var more = document.createElement('button');
                    more.type = 'button';
                    more.className = 'pf-more';
                    more.title = TXT.menu;
                    more.setAttribute('aria-label', TXT.menu + ': ' + o.label);
                    more.appendChild(icon('ti-dots'));
                    more.addEventListener('click', function (ev) {
                        ev.stopPropagation();
                        var r = more.getBoundingClientRect();
                        showMenu(r.left, r.bottom, items);
                    });
                    row.appendChild(more);
                    // Rechtsklick auf die ganze Zeile — und, weil nicht jedes Gerät eine rechte
                    // Maustaste hat, derselbe Inhalt über den Knopf oben und die Kontextmenü-Taste.
                    row.addEventListener('contextmenu', function (ev) {
                        ev.preventDefault();
                        showMenu(ev.clientX, ev.clientY, items);
                    });
                    name.addEventListener('keydown', function (ev) {
                        if (ev.key !== 'ContextMenu' && !(ev.shiftKey && ev.key === 'F10')) return;
                        ev.preventDefault();
                        var r = name.getBoundingClientRect();
                        showMenu(r.left, r.bottom, items);
                    });
                }
                return row;
            }

            // ---- Kontextmenü ------------------------------------------------------------------
            var menuEl = null;
            function closeMenu() { if (menuEl) { menuEl.remove(); menuEl = null; } }
            function showMenu(x, y, items) {
                closeMenu();                                   // nie zwei gleichzeitig
                var m = document.createElement('div');
                m.className = 'pf-ctx';
                m.setAttribute('role', 'menu');
                items.forEach(function (it) {
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'pf-ctx-item' + (it.danger ? ' is-danger' : '');
                    b.setAttribute('role', 'menuitem');
                    b.textContent = it.label;
                    b.addEventListener('click', function () { closeMenu(); it.run(); });
                    m.appendChild(b);
                });
                document.body.appendChild(m);
                // Am Zeiger, aber im Fenster: sonst steht das Menü einer Datei ganz unten in der
                // Liste zur Hälfte außerhalb und die Hälfte, die man braucht, fehlt.
                m.style.left = Math.max(4, Math.min(x, window.innerWidth - m.offsetWidth - 6)) + 'px';
                m.style.top = Math.max(4, Math.min(y, window.innerHeight - m.offsetHeight - 6)) + 'px';
                menuEl = m;
                var first = m.querySelector('.pf-ctx-item');
                if (first) first.focus();
            }
            document.addEventListener('click', function (ev) {
                if (menuEl && !menuEl.contains(ev.target)) closeMenu();
            });
            document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape') closeMenu(); });
            window.addEventListener('resize', closeMenu);
            list.addEventListener('scroll', closeMenu);

            function menuFor(o) {
                var items = [];
                if (o.kind === 'root' || o.kind === 'folder') {
                    var dir = o.kind === 'root' ? '' : o.path;
                    items.push({ label: TXT.fileNew, run: function () { newFile(dir); } });
                    items.push({ label: TXT.folderNew, run: function () { newFolder(dir); } });
                }
                if (o.kind === 'root') items.push({ label: TXT.settings, run: openSettings });
                if (o.kind === 'folder') items.push({ label: TXT.del, danger: true, run: function () { deleteFolder(o.path); } });
                if (o.kind === 'file') items.push({ label: TXT.del, danger: true, run: function () { deleteFile(o.path); } });
                // Im Systemordner liegen Dateien von der PLATTE. "Neue Datei" wäre dort ein Eintrag
                // in der Karte und würde beim Speichern nirgends landen — deshalb hochladen.
                if (o.kind === 'assetdir') items.push({ label: TXT.assetUpload, run: uploadAsset });
                if (o.kind === 'asset') {
                    items.push({ label: TXT.assetUrlCopy, run: function () { copyUrl(o.asset.url); } });
                    items.push({ label: TXT.assetDelete, danger: true, run: function () { deleteAsset(o.asset.name); } });
                }
                return items;
            }

            function openSettings() { document.dispatchEvent(new CustomEvent('pf-settings-open')); }

            // ---- Anlegen und Löschen ----------------------------------------------------------
            // Dieselben Regeln wie serverseitig in NormalizeFiles: was hier durchkommt, kommt auch
            // dort durch. Eine Oberfläche, die etwas anbietet, das der Server zurückweist, schickt
            // einen los und lässt einen auflaufen.
            function clean(raw) {
                var s = (raw || '').replace(/\\/g, '/').trim();
                if (!s || /\/$/.test(s)) return null;
                var segs = [], ok = true;
                s.split('/').forEach(function (part) {
                    var t = part.trim();
                    if (t === '' || t === '.') return;
                    if (t === '..' || /[\u0000-\u001f:*?"<>|]/.test(t)) ok = false;
                    segs.push(t);
                });
                if (!ok || !segs.length) return null;
                if (segs[0].toLowerCase() === ASSETDIR.toLowerCase()) return null;
                var p = segs.join('/');
                if (p.toLowerCase() === ENTRY.toLowerCase()) return null;
                return p;
            }

            function join(dir, name) { return dir ? dir + '/' + name : name; }

            function expandTo(path) {
                collapsed[':root'] = false;
                var segs = path.split('/'), acc = '';
                for (var i = 0; i < segs.length - 1; i++) {
                    acc = acc ? acc + '/' + segs[i] : segs[i];
                    collapsed[':d:' + acc] = false;
                }
            }

            function newFile(dir) {
                var raw = prompt(TXT.fileAsk + (dir ? ' — ' + dir + '/' : ''), 'neu.csx');
                if (raw === null) return;
                var path = clean(join(dir, raw.trim()));
                if (!path) { alert(TXT.pathInvalid); return; }
                var map = read();
                if (map === null) { alert(TXT.broken); return; }
                // Eine bestehende Datei wird geöffnet statt überschrieben — derselbe Name zweimal
                // anzulegen ist fast immer ein Vertipper, kein Wunsch, sie zu leeren.
                if (!(path in map)) { map[path] = ''; write(map); }
                expandTo(path);
                show(path);
            }

            // Ein Ordner entsteht MIT seiner ersten Datei. Die flache Karte Pfad → Inhalt kann
            // keinen leeren Ordner tragen; einen anzubieten und ihn beim Speichern stillschweigend
            // fallenzulassen, nähme dem Bearbeiter etwas weg, das er angelegt zu haben glaubte.
            // Deshalb wird die erste Datei gleich hier verlangt — und wer abbricht, bekommt gesagt,
            // dass nichts entstanden ist.
            function newFolder(dir) {
                var raw = prompt(TXT.folderAsk + (dir ? ' — ' + dir + '/' : ''), 'Elements');
                if (raw === null) return;
                var folder = clean(join(dir, raw.trim()));
                if (!folder) { alert(TXT.pathInvalid); return; }
                var first = prompt(TXT.folderFirst + ' ' + folder + '/', 'neu.csx');
                if (first === null || !first.trim()) { alert(TXT.folderNothing); return; }
                var path = clean(folder + '/' + first.trim());
                if (!path) { alert(TXT.pathInvalid); return; }
                var map = read();
                if (map === null) { alert(TXT.broken); return; }
                if (!(path in map)) { map[path] = ''; write(map); }
                expandTo(path);
                show(path);
            }

            function closeIfOpen(path) {
                if (open !== path) return;
                open = null;
                current.textContent = '';
                editor.hidden = true;
                if (empty) empty.hidden = false;
            }

            // Gelöscht wird GENAU der Pfad des Knotens, und die Frage nennt ihn — man soll sehen,
            // was man trifft, statt es aus der Zeile zu schließen, auf die man gezielt hat.
            function deleteFile(path) {
                if (!confirm(TXT.fileDel + '\n\n' + path + '\n\n' + TXT.delHint)) return;
                var map = read(); if (map === null) return;
                delete map[path];
                write(map);
                closeIfOpen(path);
                render();
            }

            // Ein Ordner nimmt seinen Inhalt mit — deshalb steht in der Frage, WIE VIELE Dateien
            // das sind. "Sind ja nur ein paar" ist genau der Fall, der später weh tut.
            function deleteFolder(path) {
                var map = read(); if (map === null) return;
                var prefix = path + '/';
                var hit = Object.keys(map).filter(function (k) { return k.indexOf(prefix) === 0; });
                if (!confirm(TXT.folderDel.replace('{0}', hit.length) + '\n\n' + prefix + '\n\n' + TXT.delHint)) return;
                hit.forEach(function (k) { delete map[k]; closeIfOpen(k); });
                write(map);
                render();
            }

            // ---- Reiter über dem Editor ------------------------------------------------------
            // Sie schalten nur um, WAS zu sehen ist. Die Felder Code und FilesJson bleiben
            // dieselben, werden weiterhin bei jedem Tastendruck geschrieben und stehen in beiden
            // Reitern nebeneinander — es gibt keinen zweiten Stand, der beim Wechseln gewinnen
            // oder verlorengehen könnte.
            var tabs = root.querySelectorAll('[data-pf-tab]');
            var panels = root.querySelectorAll('[data-pf-panel]');
            var views = root.querySelectorAll('[data-pf-view]');
            // Zwei Ebenen, und das ist Absicht: oben die Reiter (Editor | Log | Erweitert), innen
            // im Editor die Fläche für eine Skriptdatei ODER eine hochgeladene Datei. Ein Asset ist
            // kein Reiter — es wird im Baum gewählt und bleibt damit INNERHALB des Editors, der
            // Reiter oben bleibt dabei "Editor". Andernfalls stünde die Auswahl im Baum neben einem
            // Reiter, der sie nicht enthält.
            function activateTab(name) {
                var top = name === 'asset' ? 'editor' : name;
                tabs.forEach(function (t) { t.classList.toggle('active', t.getAttribute('data-pf-tab') === top); });
                panels.forEach(function (p) { p.hidden = p.getAttribute('data-pf-panel') !== top; });
                var view = name === 'asset' ? 'asset' : 'file';
                views.forEach(function (v) { v.hidden = v.getAttribute('data-pf-view') !== view; });
            }
            tabs.forEach(function (t) {
                t.addEventListener('click', function () {
                    var name = t.getAttribute('data-pf-tab');
                    activateTab(name);
                    // Ein Reiter der Leiste gehört keiner hochgeladenen Datei — die Auswahl im
                    // Zweig assets/ endet hier, sonst bliebe sie hervorgehoben, während rechts
                    // längst etwas anderes steht.
                    if (openAsset !== null) {
                        openAsset = null;
                        render();
                    }
                    // Zurück zum Editor: die offene Datei wird NEU aus den Feldern gelesen. Wer
                    // unter "Erweitert" von Hand am JSON gearbeitet hat, sieht dasselbe auch im
                    // Editor — sonst stünde dort noch der alte Text und würde beim nächsten
                    // Tastendruck die Handarbeit überschreiben.
                    if (name === 'editor') { if (open !== null) show(open); }
                    else if (codeMirror) codeMirror.value = codeField.value;
                });
            });

            // ---- Zweig assets/ ----------------------------------------------------------------
            // Hochladen und Entfernen sind Vorgänge auf der Platte: sie schicken ein eigenes
            // Formular ab und die Seite lädt neu. Alles, was im Editor noch nicht gespeichert ist,
            // wäre danach weg — deshalb wird vorher gefragt, statt es stillschweigend zu opfern.
            var savedCode = codeField ? codeField.value : '';
            var savedFiles = field.value;
            function unsavedOk() {
                if ((!codeField || codeField.value === savedCode) && field.value === savedFiles) return true;
                return confirm(TXT.assetUnsaved);
            }
            var upForm = document.getElementById('asset-upload-form');
            var upInput = document.getElementById('asset-file');
            var delForm = document.getElementById('asset-delete-form');
            var delName = document.getElementById('asset-delete-name');
            var panel = root.querySelector('[data-pf-view="asset"]');

            // Was hier angezeigt wird, kommt aus dem Eintrag, den der Server geschickt hat — nicht
            // aus dem Markup der Zeile. Als die Anzeige ihre Werte noch aus dem Baum las, schrieb
            // sie im Test den Dateinamen im Baum durch "35 B" — sie schrieb in ihre eigene Quelle.
            function showAsset(a) {
                openAsset = a.name;
                activateTab('asset');
                render();
                panel.querySelector('[data-pf-asset-name]').textContent = a.name;
                panel.querySelector('[data-pf-asset-kind]').textContent = a.kind || '';
                panel.querySelector('[data-pf-asset-size]').textContent = a.size < 1024 ? a.size + ' B' : Math.round(a.size / 1024) + ' KB';
                panel.querySelector('[data-pf-asset-url]').value = a.url;
                // Bilder zeigt man, statt sie zu beschreiben — bei den übrigen Typen gäbe es nichts
                // zu sehen und ein kaputtes Bildsymbol wäre die einzige Aussage.
                var img = panel.querySelector('[data-pf-asset-preview]');
                if (img) {
                    var isImage = /\.(png|jpe?g|gif|webp)$/i.test(a.name);
                    img.hidden = !isImage;
                    img.src = isImage ? a.url : '';
                }
            }

            // Ein Klick, nicht zwei: wer eine Datei gewählt hat, will sie hochladen. Die Grenzen
            // (Typ, Größe, Anzahl) prüft weiterhin der Server — das accept ist Bequemlichkeit im
            // Dateidialog, keine Zusicherung.
            if (upInput && upForm) upInput.addEventListener('change', function () {
                if (upInput.files && upInput.files.length) upForm.submit();
            });
            function uploadAsset() {
                if (!upInput || !upForm) return;
                if (unsavedOk()) upInput.click();
            }

            // Der Unterschied gehört in die Frage: eine Skriptdatei verschwindet erst mit dem
            // Speichern aus der Karte, diese hier ist sofort von der Platte weg. Beides gleich
            // harmlos aussehen zu lassen, wäre die eigentliche Falle.
            function deleteAsset(name) {
                if (!delForm || !delName) return;
                if (!confirm(TXT.assetDel + '\n\n' + ASSETDIR + '/' + name + '\n\n' + TXT.assetDelHint)) return;
                if (!unsavedOk()) return;
                delName.value = name;
                delForm.submit();
            }

            function copyUrl(url) {
                var done = function () { alert(TXT.assetUrlCopied + ' ' + url); };
                if (navigator.clipboard && navigator.clipboard.writeText)
                    navigator.clipboard.writeText(url).then(done, function () { prompt(TXT.assetUrlCopy, url); });
                else prompt(TXT.assetUrlCopy, url);
            }

            var delBtn = panel ? panel.querySelector('[data-pf-asset-del]') : null;
            if (delBtn) delBtn.addEventListener('click', function () {
                if (openAsset !== null) deleteAsset(openAsset);
            });

            function show(name) {
                var map = read(); if (map === null) return;
                // Eine Datei zu öffnen heißt, sie sehen zu wollen: dazu gehört der Reiter, in dem
                // der Editor steht.
                activateTab('editor');
                openAsset = null;
                open = name;
                current.textContent = name;
                content.value = name === ENTRY ? codeField.value : (map[name] != null ? map[name] : '');
                editor.hidden = false;
                if (empty) empty.hidden = true;
                render();
                content.focus();
            }

            // Beim Tippen, nicht beim Wechseln: wer eine andere Datei öffnet oder das Formular
            // abschickt, hat seinen Text damit schon drin.
            content.addEventListener('input', function () {
                if (open === null) return;
                if (open === ENTRY) {
                    codeField.value = content.value;
                    if (codeMirror) codeMirror.value = content.value;
                    return;
                }
                var map = read(); if (map === null) return;
                map[open] = content.value;
                write(map);
            });

            // Von Hand am Rohfeld geändert: der Baum zieht nach.
            field.addEventListener('input', function () { render(); });
            // Der Name des Plugins steht an der Wurzel und zieht beim Tippen im Dialog mit — sonst
            // widerspricht der Baum dem Dialog, solange nicht gespeichert wurde.
            if (nameField) nameField.addEventListener('input', function () { render(); });
            if (codeMirror) codeMirror.addEventListener('input', function () {
                codeField.value = codeMirror.value;
                if (open === ENTRY) content.value = codeMirror.value;
            });
            // Beim Öffnen gleich die Einstiegsdatei zeigen — sie ist der Anfang jedes Plugins.
            show(ENTRY);
            render();
        })();

        // Einstellungsdialog am Wurzelelement.
        (function () {
            var dialog = document.querySelector('[data-pf-settings-dialog]');
            if (!dialog) return;
            var nameField = document.getElementById('Name');

            function open() {
                dialog.classList.add('open');
                if (nameField) nameField.focus();
            }
            function close() { dialog.classList.remove('open'); }

            // Der Baum zeichnet seine Wurzel selbst und ersetzt sie bei jeder Änderung. Ein Knopf,
            // an dem hier ein Zuhörer hinge, wäre nach dem ersten Neuzeichnen tot — deshalb ruft
            // der Baum den Dialog über ein Ereignis, nicht über ein Element.
            document.addEventListener('pf-settings-open', open);
            dialog.querySelectorAll('[data-pf-settings-close]').forEach(function (b) { b.addEventListener('click', close); });
            // Klick auf den Schleier schließt, Klick im Dialog nicht.
            dialog.addEventListener('click', function (e) { if (e.target === dialog) close(); });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && dialog.classList.contains('open')) close();
            });

            // Ein required-Feld in einem ausgeblendeten Dialog kann der Browser nicht anspringen: er
            // bricht das Absenden ab und sagt nichts. Also den Dialog öffnen, sobald etwas darin
            // beanstandet wird — sonst klickt man auf Speichern und es passiert einfach nichts.
            var form = document.getElementById('plugin-form');
            if (form) form.addEventListener('invalid', function (e) {
                if (!dialog.contains(e.target)) return;
                if (!dialog.classList.contains('open')) dialog.classList.add('open');
            }, true);
        })();

        // Plugin configuration: key/value rows -> hidden ConfigJson on submit of the main form.
        (function () {
            var rows = document.getElementById('cfg-rows');
            var addBtn = document.getElementById('cfg-add');
            var hidden = document.getElementById('ConfigJson');
            var form = hidden ? hidden.closest('form') : null;
            if (!rows || !form || !addBtn) return;
            function addRow(k, v) {
                var row = document.createElement('div'); row.className = 'field-row';
                var key = document.createElement('input'); key.type = 'text'; key.placeholder = '@T["plugins.configKey"]'; key.className = 'cfg-key fr-label'; key.value = k || '';
                var val = document.createElement('input'); val.type = 'text'; val.placeholder = '@T["plugins.configValue"]'; val.className = 'cfg-val fr-label'; val.value = v || '';
                var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'btn btn-sm btn-danger btn-icon'; rm.title = '@T["action.delete"]';
                rm.innerHTML = '<i class="ti ti-trash" aria-hidden="true"></i>';
                rm.addEventListener('click', function () { row.remove(); });
                row.appendChild(key); row.appendChild(val); row.appendChild(rm);
                rows.appendChild(row);
            }
            var data = {};
            try { data = JSON.parse(rows.getAttribute('data-config') || '{}') || {}; } catch (e) { }
            Object.keys(data).forEach(function (k) { addRow(k, data[k]); });
            addBtn.addEventListener('click', function () { addRow('', ''); });
            form.addEventListener('submit', function () {
                var o = {};
                Array.prototype.slice.call(rows.querySelectorAll('.field-row')).forEach(function (r) {
                    var k = r.querySelector('.cfg-key').value.trim();
                    if (k) o[k] = r.querySelector('.cfg-val').value;
                });
                hidden.value = JSON.stringify(o);
            });
        })();
    </script>
}
