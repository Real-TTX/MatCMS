@page
@model MatCMS.Cloud.Pages.Admin.Settings.IndexModel
@using MatCMS.Cloud.Services
@{
    ViewData["Title"] = T["settings.title"];
}
<div class="page-head">
    <h1>@T["settings.title"]</h1>
</div>

<div class="tabs" role="tablist">
    <button type="button" class="tab active" data-tab="general">@T["settings.tabGeneral"]</button>
    <button type="button" class="tab" data-tab="notifications">@T["settings.tabNotifications"]</button>
    <button type="button" class="tab" data-tab="smtp">@T["settings.tabSmtp"]</button>
    <button type="button" class="tab" data-tab="backup">@T["backups.title"]</button>
    <button type="button" class="tab" data-tab="hosting">@T["settings.tabHosting"]</button>
    <button type="button" class="tab" data-tab="docker">@T["settings.tabDocker"]</button>
</div>

@* ============ GENERAL ============ *@
<div class="tab-panel" data-panel="general">
    <form method="post" asp-page-handler="General">
        <div class="card">
            <h2>@T["settings.general"]</h2>
            <div class="form-field">
                <label>@T["settings.cloudName"]</label>
                <input name="cloudName" value="@Model.Get(SettingKeys.CloudName)" />
            </div>
            <div class="form-field">
                <label>URL</label>
                <input name="canonicalUrl" value="@Model.Get(SettingKeys.CanonicalUrl)" placeholder="https://cloud.beispiel.de" spellcheck="false" />
                <div class="help">@T["settings.canonicalUrlHint"]</div>
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="forceHttps" value="true" checked="@(Model.Flag(SettingKeys.ForceHttpsUrls) ? "checked" : null)" />
                @T["settings.forceHttps"]
            </label>
            <div class="help">@T["settings.forceHttpsHint"]</div>
            <div><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
</div>

@* ============ NOTIFICATIONS ============ *@
<div class="tab-panel" data-panel="notifications" hidden>
    <form method="post" asp-page-handler="Notifications">
        <div class="card">
            <h2>@T["settings.notifications"]</h2>
            <div class="form-field">
                <label>@T["settings.recipients"]</label>
                <input name="recipients" value="@Model.Get(SettingKeys.NotifyRecipients)" placeholder="ops@@beispiel.de, admin@@beispiel.de" />
                <div class="help">@T["settings.recipientsHint"]</div>
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="notifyOffline" value="true" checked="@(Model.Flag(SettingKeys.NotifyOffline) ? "checked" : null)" />
                @T["settings.notifyOffline"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="notifyUpdate" value="true" checked="@(Model.Flag(SettingKeys.NotifyUpdate) ? "checked" : null)" />
                @T["settings.notifyUpdate"]
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="autoUpdateLocal" value="true" checked="@(Model.Flag(SettingKeys.AutoUpdateLocal) ? "checked" : null)" />
                @T["settings.autoUpdateLocal"]
            </label>
            <div class="help">@T["settings.autoUpdateLocalHint"]</div>
            <div style="margin-top:14px;"><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
</div>

@* ============ SMTP ============ *@
<div class="tab-panel" data-panel="smtp" hidden>
    <form method="post" asp-page-handler="Smtp">
        <div class="card">
            <h2>@T["settings.smtpHeading"]</h2>
            <div class="form-grid">
                <div class="form-row">
                    <div class="form-field">
                        <label>@T["settings.smtpHost"]</label>
                        <input name="host" value="@Model.Get(SettingKeys.SmtpHost)" spellcheck="false" />
                    </div>
                    <div class="form-field">
                        <label>@T["settings.smtpPort"]</label>
                        <input name="port" value="@Model.Get(SettingKeys.SmtpPort)" placeholder="587" inputmode="numeric" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label>@T["settings.smtpUser"]</label>
                        <input name="user" value="@Model.Get(SettingKeys.SmtpUser)" spellcheck="false" />
                    </div>
                    <div class="form-field">
                        <label>@T["settings.smtpPassword"]</label>
                        <input name="password" type="password" autocomplete="new-password" placeholder="@T["settings.smtpPasswordKeep"]" />
                        @* An empty field means "keep", so without this there is no way to get rid of a
                           stored password at all — the operator could only ever replace it. *@
                        @if (!string.IsNullOrEmpty(Model.Get(SettingKeys.SmtpPassword)))
                        {
                            <label class="checkbox-row">
                                <input type="checkbox" name="clearPassword" value="true" />
                                @T["settings.smtpPasswordClear"]
                            </label>
                        }
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label>@T["settings.smtpFromEmail"]</label>
                        <input name="fromEmail" value="@Model.Get(SettingKeys.SmtpFromEmail)" spellcheck="false" />
                    </div>
                    <div class="form-field">
                        <label>@T["settings.smtpFromName"]</label>
                        <input name="fromName" value="@Model.Get(SettingKeys.SmtpFromName)" />
                    </div>
                </div>
            </div>
            <label class="checkbox-row">
                <input type="checkbox" name="ssl" value="true" checked="@(Model.Flag(SettingKeys.SmtpSsl) ? "checked" : null)" />
                @T["settings.smtpSsl"]
            </label>
            <div><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>

    <div class="card">
        <h2>@T["settings.smtpTest"]</h2>
        <form method="post" asp-page-handler="SmtpTest">
            <div class="form-field">
                <label>@T["settings.smtpTestTo"]</label>
                <input name="testTo" type="email" placeholder="test@@beispiel.de" spellcheck="false" />
                <div class="help">@T["settings.smtpTestHint"]</div>
            </div>
            <div><button type="submit" class="btn btn-ghost">@T["settings.smtpTestSend"]</button></div>
        </form>
    </div>
</div>

@* ============ BACKUP ============ *@
@* Eigener Reiter: Backups sind ein Bereich mit eigener Seite, eigener Belegung und eigenem
   Kontingent — als eine Zeile unter "Allgemein" war das die einzige Einstellung, die man dort
   suchen musste, obwohl sie zu etwas anderem gehört. *@
<div class="tab-panel" data-panel="backup" hidden>
    <form method="post" asp-page-handler="Backup">
        <div class="card">
            <h2>@T["backups.title"]</h2>
            <div class="form-field">
                <label>@T["settings.backupQuota"]</label>
                <input name="backupQuotaGb" value="@Model.Get(SettingKeys.BackupQuotaGb)"
                       placeholder="@MatCMS.Cloud.Services.BackupStore.DefaultQuotaGb" inputmode="numeric" />
                <div class="help">@T["settings.backupQuotaHint"]</div>
            </div>
            <div><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
</div>

@* ============ HOSTING ============ *@
@* Eigener Reiter, weil hier mehr hinkommt als ein Haken: das Anlegen neuer Instanzen und was daran
   hängt (Adressvergabe, Image, Volumes). Der Haken ist das Tor davor. *@
<div class="tab-panel" data-panel="hosting" hidden>
    <form method="post" asp-page-handler="Hosting">
        <div class="card">
            <h2>@T["settings.tabHosting"]</h2>
            <label class="checkbox-row">
                <input type="checkbox" name="hostingEnabled" value="true" checked="@(Model.Flag(SettingKeys.HostingEnabled) ? "checked" : null)" />
                @T["settings.hostingEnabled"]
            </label>
            <div class="help">@T["settings.hostingEnabledHint"]</div>
            @* Der Haken allein genügt nicht — ohne erreichbaren Daemon kann die Cloud nichts anlegen,
               und das gehört hier gesagt und nicht erst beim ersten Fehlschlag. *@
            <div class="kv" style="margin-top:12px;">
                <div class="kv-label">Docker</div>
                <div class="kv-value">
                    @if (Model.DockerReachable)
                    {
                        <span class="badge badge-on">@T["settings.dockerOk"]</span>
                    }
                    else
                    {
                        <span class="badge badge-err">@T["settings.dockerUnreachable"]</span>
                        <span class="muted">@T["settings.hostingNeedsDocker"]</span>
                    }
                </div>
            </div>
        </div>

        @* Wie eine neue Instanz erreichbar wird. Zwei Wege, und der zweite ist kein Notbehelf: ohne
           Matcad läuft der Container trotzdem, nur muss dann jemand sagen, unter welcher Domain. *@
        <div class="card">
            <h2>@T["settings.hostingRouting"]</h2>
            <div class="form-field">
                <label for="hostingMode">@T["settings.hostingMode"]</label>
                <select id="hostingMode" name="hostingMode" data-hosting-mode>
                    @* Der Weg ohne Zusatzangaben steht oben und ist die Vorgabe. *@
                    <option value="docker" selected="@(Model.Get(SettingKeys.HostingMode) != "matcad" ? "selected" : null)">@T["settings.hostingModeDocker"]</option>
                    <option value="matcad" selected="@(Model.Get(SettingKeys.HostingMode) == "matcad" ? "selected" : null)">@T["settings.hostingModeMatcad"]</option>
                </select>
                <div class="help">@T["settings.hostingModeHint"]</div>
            </div>
            <div data-matcad-only hidden="@(Model.Get(SettingKeys.HostingMode) == "matcad" ? null : "hidden")">
                <div class="form-field">
                    <label for="matcadUrl">@T["settings.hostingMatcadUrl"]</label>
                    <input id="matcadUrl" name="matcadUrl" value="@Model.Get(SettingKeys.HostingMatcadUrl)" placeholder="http://matcad:8080" spellcheck="false" />
                </div>
                <div class="form-field">
                    <label for="matcadToken">@T["settings.hostingMatcadToken"]</label>
                    <input id="matcadToken" name="matcadToken" type="password" autocomplete="new-password" placeholder="@T["settings.smtpPasswordKeep"]" />
                    @* Leer heißt KEEP — sonst würde jedes Speichern der anderen Felder das Geheimnis
                       löschen, nur weil das Feld leer gerendert wird. *@
                    @if (!string.IsNullOrEmpty(Model.Get(SettingKeys.HostingMatcadToken)))
                    {
                        <label class="checkbox-row">
                            <input type="checkbox" name="clearMatcadToken" value="true" /> @T["settings.smtpPasswordClear"]
                        </label>
                    }
                </div>
            </div>
        </div>

        @* Der Portbereich gilt für beide Wege: auch eine Instanz hinter Matcad braucht einen Port auf
           dem Host, unter dem der Proxy sie findet. *@
        <div class="card">
            <h2>@T["settings.hostingPorts"]</h2>
            <div class="form-grid">
                <div class="form-row">
                    <div class="form-field">
                        <label for="portFrom">@T["settings.hostingPortFrom"]</label>
                        <input id="portFrom" name="portFrom" value="@Model.Get(SettingKeys.HostingPortFrom)" placeholder="9201" inputmode="numeric" />
                    </div>
                    <div class="form-field">
                        <label for="portTo">@T["settings.hostingPortTo"]</label>
                        <input id="portTo" name="portTo" value="@Model.Get(SettingKeys.HostingPortTo)" placeholder="9299" inputmode="numeric" />
                    </div>
                </div>
            </div>
            <div class="form-field">
                <label for="namePattern">@T["settings.hostingNamePattern"]</label>
                <input id="namePattern" name="namePattern" value="@Model.Get(SettingKeys.HostingNamePattern)" placeholder="@MatCMS.Cloud.Services.HostingService.DefaultNamePattern" spellcheck="false" />
                <div class="help">@T["settings.hostingNamePatternHint"]</div>
                @* Vorschau, weil ein Muster mit Platzhalter erst dann eindeutig ist, wenn man das
                   Ergebnis sieht — besonders bei der Normalisierung, die Punkte und Leerzeichen
                   schluckt. *@
                <div class="help mono" data-name-preview></div>
            </div>
            <div class="help">@T["settings.hostingPortsHint"]</div>
            @* Zeigt die Vergabe, bevor sie zum ersten Mal etwas anlegt — ein Bereich, in dem nichts
               mehr frei ist, soll hier auffallen und nicht beim Erzeugen. *@
            <div class="kv" style="margin-top:12px;">
                <div class="kv-label">@T["settings.hostingNextPort"]</div>
                <div class="kv-value">
                    @if (Model.NextPort is int np)
                    {
                        <span class="mono">@np</span>
                        <span class="muted">@T["settings.hostingPortsUsed", Model.UsedPortCount]</span>
                    }
                    else
                    {
                        <span class="badge badge-err">@T["settings.hostingNoPort"]</span>
                    }
                </div>
            </div>
            <div style="margin-top:14px;"><button type="submit" class="btn">@T["settings.save"]</button></div>
        </div>
    </form>
</div>

@* ============ DOCKER ============ *@
<div class="tab-panel" data-panel="docker" hidden>
    <div class="card">
        <h2>@T["settings.docker"]</h2>
        <p class="muted">@T["settings.dockerHint"]</p>
        <div class="kv">
            <div class="kv-label">@T["common.status"]</div>
            <div class="kv-value">
                @if (!Model.DockerConfigured)
                {
                    <span class="badge badge-off">@T["settings.dockerOff"]</span>
                }
                else if (Model.DockerReachable)
                {
                    <span class="badge badge-on">@T["settings.dockerOk"]</span>
                }
                else
                {
                    <span class="badge badge-err">@T["settings.dockerUnreachable"]</span>
                }
            </div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["settings.dockerEndpoint"]</div>
            <div class="kv-value mono">MatCmsCloud__Docker__Endpoint</div>
        </div>
        <div class="kv">
            <div class="kv-label">@T["settings.dockerLocalCount"]</div>
            <div class="kv-value">@Model.LocalCount</div>
        </div>
        <div class="help">@T["settings.dockerConfigHint"]</div>
    </div>
</div>

@section Scripts {
    <script>
        // Tabs — identical to MatCMS's settings page, including the ?tab=<name> deep link that every
        // handler redirects back to.
        (function () {
            var tabs = document.querySelectorAll('.tab');
            var panels = document.querySelectorAll('.tab-panel');
            function show(name) {
                tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.tab === name); });
                panels.forEach(function (p) { p.hidden = p.dataset.panel !== name; });
            }
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
            // Die Matcad-Felder nur zeigen, wenn sie etwas bewirken — sonst fragt die Seite nach
            // Zugangsdaten für einen Weg, den man gerade abgewählt hat.
            var mode = document.querySelector('[data-hosting-mode]');
            var matcadOnly = document.querySelector('[data-matcad-only]');
            if (mode && matcadOnly) {
                var syncMode = function () { matcadOnly.hidden = mode.value === 'docker'; };
                mode.addEventListener('change', syncMode);
                syncMode();
            }

            // Spiegelt HostingService.Normalise: klein, alles Nicht-Alphanumerische zu Bindestrichen.
            // Zwei Umsetzungen derselben Regel — die hier zeigt nur an, entschieden wird im Dienst.
            var pat = document.getElementById('namePattern');
            var prev = document.querySelector('[data-name-preview]');
            if (pat && prev) {
                var demo = 'Meine Seite.de';
                var slug = demo.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
                var syncPreview = function () {
                    var p = (pat.value || pat.placeholder || '').trim();
                    var out = /{name}/i.test(p) ? p.replace(/{name}/ig, slug)
                            : p.indexOf('$NAME') >= 0 ? p.split('$NAME').join(slug)
                            : (p.replace(/-+$/, '') + '-' + slug);
                    prev.textContent = '„' + demo + '" → ' + out.toLowerCase();
                };
                pat.addEventListener('input', syncPreview);
                syncPreview();
            }

            var want = new URLSearchParams(location.search).get('tab');
            if (want) show(want);
        })();
    </script>
}
