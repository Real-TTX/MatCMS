<Project Sdk="Microsoft.NET.Sdk">

  <!-- The reference plugin, written as a NATIVE plugin. tests/Fixtures/ref-plugin.csx is the same plugin as
       a script; the conformance test runs the same assertions against both. It is also the proof that a
       plugin compiles against MatCMS.Plugin.Abstractions alone. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>RefPlugin</RootNamespace>
    <!-- The same copy of these on both sides, or the host would not recognise the plugin's IPlugin. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\MatCMS.Plugin.Abstractions\MatCMS.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
