@page
@using MatCMS.Services
@model MatCMS.Pages.Admin.Pages.IndexModel
@{
    ViewData["Title"] = T["pages.title"];
}
<div data-list data-list-page-size="25">
    <div class="page-head">
        <h1>@T["pages.title"]</h1>
        <div class="list-toolbar">
            <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
        </div>
    </div>

    <table class="data" data-list-table>
        <thead>
            <tr>
                <th>@T["pages.colTitle"]</th>
                <th>@T["editor.language"]</th>
                <th>@T["pages.colUrl"]</th>
                <th>@T["pages.colStatus"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Groups.Count == 0)
            {
                <partial name="_EmptyRow" model='@T["pages.none"]' />
            }
            @foreach (var g in Model.Groups)
            {
                var p = g.Primary;
                var multi = g.Versions.Count > 1;
                var primaryVer = g.Versions.FirstOrDefault(v => v.Id == p.Id) ?? g.Versions[0];
                var children = g.Versions.Where(v => v.Id != p.Id).ToList();
                var gid = "g" + p.Id;
                var search = p.Title + " " + string.Join(" ", g.Versions.Select(v => v.Locale + " " + v.Url));
                <tr data-search="@search">
                    <td><strong>@p.Title</strong></td>
                    <td>
                        <span class="badge badge-on mono">@primaryVer.Locale.ToUpperInvariant()</span>
                        <span class="muted" style="font-size:12px;">@Localizer.DisplayName(primaryVer.Locale) · Original</span>
                    </td>
                    <td><a class="mono" href="@primaryVer.Url" target="_blank">@primaryVer.Url</a></td>
                    <td>
                        @if (primaryVer.IsPublished)
                        {
                            <span class="badge badge-on">@T["pages.published"]</span>
                        }
                        else
                        {
                            <span class="badge badge-off">@T["pages.draft"]</span>
                        }
                    </td>
                    <td>
                        <div class="actions">
                            <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@p.Id">@T["action.edit"]</a>
                            <form class="inline-form" method="post" asp-page-handler="Delete" asp-route-id="@p.Id"
                                  onsubmit="return confirm('@T["pages.confirmDelete", p.Title]');">
                                <button type="submit" class="btn btn-sm btn-danger btn-icon" title="@T["action.delete"]" aria-label="@T["action.delete"]"><partial name="_IconTrash" /></button>
                            </form>
                        </div>
                    </td>
                </tr>
                @foreach (var v in children)
                {
                    <tr class="pg-child" data-pg-child="@gid" data-search="@search">
                        <td><span class="pg-branch" aria-hidden="true">↳</span></td>
                        <td>
                            <span class="badge badge-off mono">@v.Locale.ToUpperInvariant()</span>
                            <span class="muted" style="font-size:12px;">@Localizer.DisplayName(v.Locale)</span>
                        </td>
                        <td><a class="mono" href="@v.Url" target="_blank">@v.Url</a></td>
                        <td>
                            @if (v.IsPublished)
                            {
                                <span class="badge badge-on">@T["pages.published"]</span>
                            }
                            else
                            {
                                <span class="badge badge-off">@T["pages.draft"]</span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <a class="btn btn-sm btn-ghost" asp-page="Edit" asp-route-id="@v.Id">@T["action.edit"]</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
    <nav class="list-pager" data-list-pager aria-label="@T["list.pager"]"></nav>
    @* Aktions-Buttons gehören UNTER die Liste (.list-actions), nicht in die Kopf-Toolbar. *@
    <div class="list-actions">
        <a class="btn" asp-page="Create">@T["pages.create"]</a>
        @if (Model.AiEnabled)
        {
            <button type="button" class="btn btn-ghost" id="ai-newpage-btn">
                <i class="ti ti-sparkles" aria-hidden="true"></i> @T["pages.aiNewPageButton"]
            </button>
            <button type="button" class="btn btn-ghost" id="ai-sitegen-btn" data-ai-url="@Url.Page(null, "AiGenerateSite")">
                <i class="ti ti-sparkles" aria-hidden="true"></i> @T["pages.aiSiteGenButton"]
            </button>
        }
    </div>
</div>

@if (Model.AiEnabled)
{
    @* Einzelne (Unter-)Seite per KI: Titel + kurze Beschreibung → Seite als ENTWURF anlegen + Blöcke
       generieren in einem Schritt → direkt im Editor öffnen (dort prüfen/veröffentlichen). Ein-Schuss,
       ohne Vorschlags-Runde — der Editor IST die Vorschau. *@
    <dialog id="ai-newpage-dialog" class="ai-dialog">
        <h3>@T["pages.aiNewPageTitle"]</h3>
        <form method="post" asp-page-handler="AiNewPage">
            <label class="ai-instr-label" for="ai-newpage-title">@T["pages.aiNewPageName"]</label>
            <input id="ai-newpage-title" name="title" required placeholder="@T["pages.aiNewPageNamePh"]" />
            <label class="ai-instr-label" for="ai-newpage-brief">@T["pages.aiNewPageBrief"]</label>
            <textarea id="ai-newpage-brief" name="briefing" rows="2" placeholder="@T["pages.aiNewPageBriefPh"]"></textarea>
            <label class="checkbox-row" style="margin-top:8px;"><input type="checkbox" name="nav" value="true" /> @T["pages.aiNewPageNav"]</label>
            <div class="ai-dialog-foot">
                <button type="submit" class="btn btn-sm"><i class="ti ti-sparkles" aria-hidden="true"></i> @T["pages.aiNewPageCreate"]</button>
                <button type="button" class="btn btn-sm btn-ghost" id="ai-newpage-cancel">@T["editor.aiCancel"]</button>
            </div>
        </form>
    </dialog>
    <script>
        (function () {
            var b = document.getElementById('ai-newpage-btn'), d = document.getElementById('ai-newpage-dialog');
            var c = document.getElementById('ai-newpage-cancel');
            if (!b || !d) return;
            b.addEventListener('click', function () { d.showModal(); });
            if (c) c.addEventListener('click', function () { d.close(); });
        })();
    </script>
}

@if (Model.AiEnabled)
{
    @* Website-Generator: die KI schlägt mehrere Seiten (mit Blöcken + Menü) vor → Liste bestätigen →
       per normalem Formular anlegen (add-only, PRG). Reuse der .ai-dialog/.ai-pagegen-*-Styles. *@
    <dialog id="ai-sitegen-dialog" class="ai-dialog ai-dialog-wide" data-lbl-working="@T["editor.aiWorking"]"
            data-lbl-blocks="@T["pages.aiSiteGenBlocks"]" data-lbl-nav="@T["pages.aiSiteGenNav"]">
        <h3>@T["pages.aiSiteGenTitle"]</h3>
        <label class="ai-instr-label" for="ai-sitegen-instruction">@T["pages.aiSiteGenInstruction"]</label>
        <textarea id="ai-sitegen-instruction" rows="2" placeholder="@T["pages.aiSiteGenPlaceholder"]"></textarea>
        <div class="ai-dialog-actions">
            <button type="button" id="ai-sitegen-propose" class="btn btn-sm">@T["pages.aiSiteGenPropose"]</button>
            <span id="ai-sitegen-status" class="ai-status muted"></span>
        </div>
        @* Seiten-Umschalter (eine Karte je Seite) + visuelle Vorschau der gewählten Seite im iFrame. *@
        <div id="ai-sitegen-tabs" class="ai-preview-tabs"></div>
        <iframe id="ai-sitegen-frame" name="ai-sitegen-frame" class="ai-preview-frame" title="@T["pages.aiSiteGenTitle"]"></iframe>
        <div class="ai-dialog-foot">
            <button type="button" id="ai-sitegen-apply" class="btn btn-sm" disabled>@T["pages.aiSiteGenApply"]</button>
            <button type="button" id="ai-sitegen-cancel" class="btn btn-sm btn-ghost">@T["editor.aiCancel"]</button>
        </div>
    </dialog>
    @* Website anlegen (bestätigt) *@
    <form id="ai-sitegen-form" method="post" asp-page-handler="AiCreateSite">
        <input type="hidden" name="sitesJson" id="ai-sitegen-data" />
    </form>
    @* Vorschau-Render: postet die Blöcke EINER Seite in den iFrame (read-only). *@
    <form id="ai-sitegen-preview-form" method="post" action="/Admin/Pages/AiPreview" target="ai-sitegen-frame">
        <input type="hidden" name="blocksJson" id="ai-sitegen-preview-data" />
        <input type="hidden" name="title" id="ai-sitegen-preview-title" />
    </form>
    <script src="~/js/ai-site-gen.js" asp-append-version="true"></script>
}

<style>
    /* Language versions are always shown as indented child rows (no collapse). */
    tr.pg-child > td:first-child { text-align: right; color: var(--muted, #6b7078); padding-left: 28px; }
    tr.pg-child { background: #fafbfc; }
</style>
