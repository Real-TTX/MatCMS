@page "{id:int?}"
@model MatCMS.Pages.Admin.Templates.EditModel
@using MatCMS.Content
@{
    ViewData["Title"] = T["templates.edit"];
}
<div class="page-head">
    <h1>@T["templates.edit"]</h1>
    <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    @if (Model.IsActive)
    {
        <p class="muted">@Html.Raw(T["templates.activeNotice"])</p>
    }
    <form method="post" class="form-grid">
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="form-row">
            <div class="form-field">
                <label for="Name">@T["templates.name"]</label>
                <input id="Name" name="Name" value="@Model.Name" required autofocus />
            </div>
            <div class="form-field">
                <label for="AccentColor">@T["templates.accentColor"]</label>
                <input id="AccentColor" name="AccentColor" type="color" value="@Model.AccentColor" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-field">
                <label for="HeadingFont">@T["templates.headingFont"]</label>
                <select id="HeadingFont" name="HeadingFont">
                    @foreach (var f in TemplateFonts.Families)
                    {
                        <option value="@f" selected="@(Model.HeadingFont == f)">@f</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label for="BodyFont">@T["templates.bodyFont"]</label>
                <select id="BodyFont" name="BodyFont">
                    @foreach (var f in TemplateFonts.Families)
                    {
                        <option value="@f" selected="@(Model.BodyFont == f)">@f</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-field">
            <label for="ButtonStyle">@T["templates.buttonStyle"]</label>
            <select id="ButtonStyle" name="ButtonStyle">
                <option value="solid" selected="@(Model.ButtonStyle != "outline")">@T["templates.buttonSolid"]</option>
                <option value="outline" selected="@(Model.ButtonStyle == "outline")">@T["templates.buttonOutline"]</option>
            </select>
        </div>
        <div>
            <button type="submit" class="btn">@T["action.save"]</button>
        </div>
    </form>
</div>
