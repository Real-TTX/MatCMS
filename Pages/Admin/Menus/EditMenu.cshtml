@page "{id:int}"
@model MatCMS.Pages.Admin.Menus.EditMenuModel
@{
    ViewData["Title"] = T["menus.editMenu"];
}
<div class="page-head">
    <h1>@T["menus.editMenu"]</h1>
    <a class="btn btn-sm btn-ghost" asp-page="Index">@T["action.back"]</a>
</div>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" class="form-grid">
        <div class="form-row">
            <div class="form-field">
                <label for="Name">@T["menus.menuName"]</label>
                <input id="Name" name="Name" value="@Model.Name" required autofocus />
            </div>
            <div class="form-field">
                <label>@T["menus.menuKey"]</label>
                <input value="@Model.Current.Key" class="mono" readonly />
            </div>
        </div>
        <div><button type="submit" class="btn">@T["action.save"]</button></div>
    </form>
</div>

@if (!Model.Current.BuiltIn)
{
    <div class="card">
        <h2>@T["menus.deleteMenu"]</h2>
        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Current.Id" onsubmit="return confirm('@T["menus.confirmDeleteMenu"]');">
            <button type="submit" class="btn btn-danger">@T["menus.deleteMenu"]</button>
        </form>
    </div>
}
else
{
    <p class="muted">@T["menus.builtinNote"]</p>
}
