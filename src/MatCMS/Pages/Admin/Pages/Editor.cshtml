@page "{id:int}"
@model MatCMS.Pages.Admin.Pages.EditorModel
@inject MatCMS.Services.SiteContext Site
@{
    // Full screen on purpose: the editor brings its own frame (back, tree, preview, inspector) in the
    // admin's look — inside the admin layout it would be a page within a page, with two menus.
    Layout = null;
    var p = Model.Current;
    var l10n = new Dictionary<string, string>
    {
        ["saved"] = T["ev2.saved"], ["unsaved"] = T["ev2.unsaved"], ["saving"] = T["ev2.saving"], ["saveFailed"] = T["ev2.saveFailed"],
        ["addSection"] = T["ev2.addSection"], ["addElement"] = T["ev2.addElement"], ["add"] = T["ev2.add"],
        ["duplicate"] = T["ev2.duplicate"], ["remove"] = T["ev2.remove"], ["moveUp"] = T["ev2.moveUp"], ["moveDown"] = T["ev2.moveDown"],
        ["confirmRemove"] = T["ev2.confirmRemove"], ["confirmLeave"] = T["ev2.confirmLeave"],
        ["empty"] = T["ev2.empty"], ["noSelection"] = T["ev2.noSelection"], ["noFields"] = T["ev2.noFields"],
        ["notFound"] = T["ev2.notFound"], ["page"] = T["ev2.page"], ["tabContent"] = T["ev2.tabContent"],
        ["tabDesign"] = T["ev2.tabDesign"], ["tabAdvanced"] = T["ev2.tabAdvanced"], ["all"] = T["blockcat.all"],
        ["cat.layout"] = T["blockcat.layout"], ["cat.text"] = T["blockcat.text"], ["cat.media"] = T["blockcat.media"],
        ["cat.design"] = T["blockcat.design"], ["cat.form"] = T["blockcat.form"], ["cat.embed"] = T["blockcat.embed"],
        ["cat.plugins"] = T["blockcat.plugins"], ["cat.custom"] = T["blockcat.custom"], ["blockEmpty"] = T["editor.blockEmpty"],
        ["cat.presets"] = T["ev2.presets"],
        ["inlineHint"] = T["ev2.inlineHint"],
        ["aiWorking"] = T["editor.aiWorking"], ["aiBefore"] = T["editor.aiBefore"], ["aiAfter"] = T["editor.aiAfter"],
        ["preset.hero"] = T["ev2.preset.hero"], ["preset.hero.desc"] = T["ev2.preset.hero.desc"],
        ["preset.imageText"] = T["ev2.preset.imageText"], ["preset.imageText.desc"] = T["ev2.preset.imageText.desc"],
        ["preset.text"] = T["ev2.preset.text"], ["preset.text.desc"] = T["ev2.preset.text.desc"],
        ["preset.threeCols"] = T["ev2.preset.threeCols"], ["preset.threeCols.desc"] = T["ev2.preset.threeCols.desc"],
        ["starter.heading"] = T["ev2.starter.heading"], ["starter.text"] = T["ev2.starter.text"],
        ["starter.button"] = T["ev2.starter.button"], ["starter.button2"] = T["ev2.starter.button2"],
    };
}
<!DOCTYPE html>
<html lang="@(System.Globalization.CultureInfo.CurrentUICulture.Name.Split('-', 2)[0] is { Length: > 0 } lc ? lc : MatCMS.Services.Localizer.ResourceFallbackCulture)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@p.Title – @T["ev2.title"] – @Site.SiteName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@@500;600;700&family=Inter:wght@@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/lib/tabler-icons/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin.css" asp-append-version="true" />
    @* Multi-select fields in the block editor are built from the public forms' dropdown. *@
    <link rel="stylesheet" href="~/css/mat-richselect.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/editor-v2.css" asp-append-version="true" />
    <link rel="icon" href="@Site.FaviconUrl" />
</head>
<body class="ev2" data-page-id="@p.Id"
      data-render-url="@Url.Page("Edit", "RenderPreview", new { id = p.Id })"
      data-save-url="@Url.Page("Edit", "SaveAll", new { id = p.Id })">
    @Html.AntiForgeryToken()
    <script id="ev2-blocks" type="application/json">@Html.Raw(Model.BlocksJson.Replace("</", "<\\/"))</script>
    <script id="ev2-types" type="application/json">@Html.Raw(Model.TypesJson.Replace("</", "<\\/"))</script>
    <script id="ev2-l10n" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(l10n).Replace("</", "<\\/"))</script>

    <header class="ev2-top">
        <a class="ev2-back" asp-page="Index" id="ev2-back" title="@T["ev2.backTitle"]">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            <span>@T["ev2.back"]<small>@T["ev2.backSub"]</small></span>
        </a>
        <button type="button" class="ev2-ico ev2-tree-toggle" id="ev2-tree-toggle" title="@T["ev2.tree"]" aria-label="@T["ev2.tree"]"><i class="ti ti-list-tree"></i></button>
        <div class="ev2-title">
            @* The title is the page switcher: one click to the next page, as in the classic editor. *@
            <button type="button" class="ev2-title-btn" id="ev2-pages-open" title="@T["ev2.switchPage"] — @Model.PublicUrl" aria-haspopup="true">
                <span class="ev2-title-text">@p.Title</span><i class="ti ti-chevron-down" aria-hidden="true"></i>
            </button>
            <span class="badge @(p.IsPublished ? "badge-on" : "badge-off")">@(p.IsPublished ? T["ev2.published"] : T["ev2.draft"])</span>
            @if (Model.SupportedLocales.Count > 1)
            {
                <button type="button" class="badge mono ev2-lang-btn" id="ev2-langs-open" title="@T["ev2.languages"]" aria-haspopup="true">@p.Locale.ToUpperInvariant() <i class="ti ti-chevron-down" aria-hidden="true"></i></button>
            }
        </div>
        <span class="ev2-status" id="ev2-status" aria-live="polite"></span>
        <div class="ev2-sp"></div>
        <button type="button" class="ev2-ico" id="ev2-undo" title="@T["ev2.undo"] (Strg+Z)" aria-label="@T["ev2.undo"]" disabled><i class="ti ti-arrow-back-up"></i></button>
        <button type="button" class="ev2-ico" id="ev2-redo" title="@T["ev2.redo"] (Strg+Y)" aria-label="@T["ev2.redo"]" disabled><i class="ti ti-arrow-forward-up"></i></button>
        <div class="ev2-seg" id="ev2-dev" role="group" aria-label="@T["ev2.device"]">
            <button type="button" class="is-on" data-dev="desktop" title="@T["ev2.desktop"]"><i class="ti ti-device-desktop"></i></button>
            <button type="button" data-dev="tablet" title="@T["ev2.tablet"]"><i class="ti ti-device-tablet"></i></button>
            <button type="button" data-dev="phone" title="@T["ev2.phone"]"><i class="ti ti-device-mobile"></i></button>
        </div>
        @if (Model.AiEnabled)
        {
            <button type="button" class="ev2-ico" id="ev2-aipage-open" title="@T["editor.aiPageGenButton"]" aria-label="@T["editor.aiPageGenButton"]"><i class="ti ti-sparkles"></i></button>
        }
        <button type="button" class="ev2-ico" id="ev2-settings-open" title="@T["ev2.settings"]" aria-label="@T["ev2.settings"]"><i class="ti ti-settings"></i></button>
        <a class="btn btn-ghost btn-sm ev2-hide-s" href="@Model.PublicUrl" target="_blank" rel="noopener"><i class="ti ti-external-link" aria-hidden="true"></i> @T["ev2.view"]</a>
        <button type="button" class="btn btn-sm" id="ev2-save" disabled>@T["ev2.save"]</button>
    </header>

    <aside class="ev2-nav" aria-label="@T["ev2.tree"]">
        <div class="ev2-nav-head">@T["ev2.page"]</div>
        <a class="ev2-node is-locked" asp-page="/Admin/Templates/Index" title="@T["ev2.templateHint"]">
            <span class="tw"></span><span class="ic"><i class="ti ti-layout-navbar"></i></span>
            <span class="lbl">@T["ev2.header"] <em>@T["ev2.fromTemplate"]</em></span><span class="act"><i class="ti ti-lock"></i></span>
        </a>
        <div class="ev2-sep"></div>
        <div id="ev2-tree" role="tree"></div>
        <button type="button" class="ev2-add root" id="ev2-add-root"><i class="ti ti-plus"></i> @T["ev2.addSection"]</button>
        <div class="ev2-sep"></div>
        <a class="ev2-node is-locked" asp-page="/Admin/Templates/Index" title="@T["ev2.templateHint"]">
            <span class="tw"></span><span class="ic"><i class="ti ti-layout-bottombar"></i></span>
            <span class="lbl">@T["ev2.footer"] <em>@T["ev2.fromTemplate"]</em></span><span class="act"><i class="ti ti-lock"></i></span>
        </a>
        <a class="ev2-classic" asp-page="Edit" asp-route-id="@p.Id"><i class="ti ti-layout-sidebar-left-collapse"></i> @T["ev2.classic"]</a>
    </aside>

    <main class="ev2-stage" id="ev2-stage">
        <div class="ev2-frame" id="ev2-frame">
            <iframe id="ev2-preview" src="@Model.PreviewUrl" title="@T["editor.livePreview"]"></iframe>
        </div>
    </main>

    <aside class="ev2-insp" id="ev2-insp" aria-label="@T["ev2.inspector"]">
        <div class="ev2-insp-head">
            <button type="button" class="ev2-insp-close" id="ev2-insp-close" aria-label="@T["action.close"]"><i class="ti ti-x"></i></button>
            <div class="ev2-crumb" id="ev2-crumb"></div>
            <h3 id="ev2-insp-title"></h3>
        </div>
        <div class="ev2-tabs" id="ev2-tabs" role="tablist"></div>
        <div class="ev2-body" id="ev2-body"></div>
        <div class="ev2-foot" id="ev2-foot" hidden>
            @* Classic hero / image+text / text / call-to-action → the same content as a section of elements. *@
            <button type="button" class="btn btn-ghost btn-sm ev2-convert" id="ev2-convert" hidden title="@T["ev2.convertHint"]"><i class="ti ti-transform"></i> @T["ev2.convert"]</button>
            @if (Model.AiEnabled)
            {
                <button type="button" class="btn btn-ghost btn-sm ev2-ai-btn" id="ev2-aiblock-open" title="@T["editor.aiImprove"]"><i class="ti ti-sparkles"></i></button>
            }
            <button type="button" class="btn btn-ghost btn-sm" id="ev2-dup"><i class="ti ti-copy"></i> @T["ev2.duplicate"]</button>
            <button type="button" class="btn btn-ghost btn-sm ev2-danger" id="ev2-del"><i class="ti ti-trash"></i> @T["ev2.remove"]</button>
        </div>
    </aside>

    @* Block picker: one popover for every level — the root offers sections, a container only what
       it may hold (AllowedChildren). Filled by editor-v2.js. *@
    <div class="ev2-pop" id="ev2-pop" role="dialog" aria-label="@T["ev2.add"]" hidden>
        <input type="search" id="ev2-pop-search" placeholder="@T["ev2.search"]" autocomplete="off" />
        <div class="ev2-pop-cats" id="ev2-pop-cats"></div>
        <div class="ev2-pop-list" id="ev2-pop-list"></div>
    </div>

    <dialog class="mat-dialog ev2-settings" id="ev2-settings">
        <form method="post" asp-page="Edit" asp-page-handler="Meta" asp-route-id="@p.Id" asp-route-back="v2" class="form-grid" id="ev2-settings-form">
            <h3 class="ev2-settings-title">@T["ev2.settings"]</h3>
            <div class="form-field">
                <label>@T["editor.metaTitle"]</label>
                <input name="Meta.Title" value="@p.Title" required />
            </div>
            <div class="form-field">
                <label>@T["editor.slug"]</label>
                <input name="Meta.Slug" value="@p.Slug" required />
            </div>
            @if (Model.SupportedLocales.Count > 1)
            {
                <div class="form-field">
                    <label>@T["editor.locale"]</label>
                    <select name="Meta.Locale">
                        @foreach (var loc in Model.SupportedLocales)
                        {
                            <option value="@loc" selected="@(loc == p.Locale)">@T["lang." + loc]</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" name="Meta.Locale" value="@p.Locale" />
            }
            <div class="form-field">
                <label>@T["editor.metaDescription"]</label>
                <input name="Meta.MetaDescription" value="@p.MetaDescription" />
            </div>
            <div class="form-field">
                <label>Template</label>
                <select name="Meta.TemplateId">
                    <option value="">— Aktives Template —</option>
                    @foreach (var t in Model.AllTemplates)
                    {
                        <option value="@t.Id" selected="@(p.TemplateId == t.Id ? "selected" : null)">@t.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>Zugriff</label>
                <select name="Meta.Access">
                    <option value="Public" selected="@(p.Access == MatCMS.Models.PageAccess.Public ? "selected" : null)">Öffentlich</option>
                    <option value="Members" selected="@(p.Access == MatCMS.Models.PageAccess.Members ? "selected" : null)">Nur angemeldete Mitglieder</option>
                </select>
            </div>
            <div class="form-field">
                <label>Benötigte Rolle</label>
                <select name="Meta.RequiredRole">
                    <option value="">— jede/r Angemeldete —</option>
                    @foreach (var role in Model.AllRoles)
                    {
                        <option value="@role" selected="@(p.RequiredRole == role ? "selected" : null)">@role</option>
                    }
                </select>
            </div>
            <details>
                <summary>@T["ev2.settingsAdvanced"]</summary>
                <div class="form-field">
                    <label>@T["editor.pageCss"]</label>
                    <textarea name="Meta.CustomCss" rows="5" spellcheck="false" class="mono">@p.CustomCss</textarea>
                </div>
                <div class="form-field">
                    <label>Template-Parameter (JSON)</label>
                    <textarea name="Meta.TemplateParamsJson" rows="3" spellcheck="false" class="mono">@p.TemplateParamsJson</textarea>
                </div>
            </details>
            <label class="checkbox-row"><input type="checkbox" name="Meta.IsPublished" value="true" @(p.IsPublished ? "checked" : "") /> @T["editor.published"]</label>
            <div class="help" id="ev2-settings-dirty" hidden>@T["ev2.settingsDirty"]</div>
            <div class="form-actions">
                <button type="submit" class="btn btn-sm">@T["action.save"]</button>
                <button type="button" class="btn btn-ghost btn-sm" id="ev2-settings-close">@T["action.cancel"]</button>
            </div>
        </form>
    </dialog>

    @* Page switcher: every page with its address and language; leaving asks first when unsaved. *@
    <div class="ev2-pop ev2-pages" id="ev2-pages" hidden>
        <input type="search" id="ev2-pages-search" placeholder="@T["editor.switchSearch"]" autocomplete="off" />
        <div class="ev2-pages-list" id="ev2-pages-list">
            @foreach (var pg in Model.AllPages)
            {
                var pu = MatCMS.Services.SiteContext.LocalizedUrl(pg.Locale, pg.Slug);
                <a class="ev2-page@(pg.Id == p.Id ? " is-cur" : "")" asp-page="Editor" asp-route-id="@pg.Id"
                   data-search="@((pg.Title + " " + pu + " " + pg.Locale).ToLowerInvariant())">
                    <span class="t">@pg.Title</span>
                    <span class="u mono">@pu</span>
                    <span class="badge @(pg.IsPublished ? "badge-on" : "badge-off")">@(pg.IsPublished ? T["ev2.published"] : T["ev2.draft"])</span>
                    @if (Model.SupportedLocales.Count > 1)
                    {
                        <span class="badge mono">@pg.Locale.ToUpperInvariant()</span>
                    }
                </a>
            }
        </div>
    </div>

    @if (Model.SupportedLocales.Count > 1)
    {
        @* Language versions: switch to one, create a missing one, machine-translate this one. *@
        <div class="ev2-pop ev2-langs" id="ev2-langs" hidden>
            <div class="ev2-pop-head">@T["ev2.languages"]</div>
            @foreach (var v in Model.Versions)
            {
                <a class="ev2-page@(v.Id == p.Id ? " is-cur" : "")" asp-page="Editor" asp-route-id="@v.Id">
                    <span class="badge mono">@v.Locale.ToUpperInvariant()</span>
                    <span class="t">@v.Title</span>
                </a>
            }
            @foreach (var loc in Model.MissingLocales)
            {
                <form method="post" asp-page="Edit" asp-page-handler="CreateTranslation" asp-route-id="@p.Id" asp-route-locale="@loc" asp-route-back="v2" class="ev2-langs-form">
                    <button type="submit" class="ev2-add"><i class="ti ti-plus"></i> @T["editor.translationCreate", T["lang." + loc]]</button>
                </form>
            }
            @if (Model.TranslatorConfigured && p.Locale != MatCMS.Services.Localizer.DefaultCulture)
            {
                <form method="post" asp-page="Edit" asp-page-handler="AutoTranslate" asp-route-id="@p.Id" asp-route-back="v2" class="ev2-langs-form"
                      data-confirm="@T["editor.autoTranslateConfirm"]">
                    <button type="submit" class="ev2-add"><i class="ti ti-language"></i> @T["editor.autoTranslate"]</button>
                </form>
            }
            @if (Model.Versions.Count > 1)
            {
                <a class="ev2-add" asp-page="Diff" asp-route-id="@p.Id"><i class="ti ti-arrows-diff"></i> @T["diff.title"]</a>
            }
        </div>
    }

    @if (Model.AiEnabled)
    {
        @* KI: improve the selected block's texts — proposal against the CURRENT draft, applied into the
           draft (nothing is saved until "Speichern"). *@
        <dialog class="mat-dialog ev2-ai" id="ev2-aiblock" data-url="@Url.Page("Edit", "AiRewriteBlock", new { id = p.Id })">
            <h3>@T["editor.aiDialogTitle"]</h3>
            <label for="ev2-aiblock-instr">@T["editor.aiInstruction"]</label>
            <textarea id="ev2-aiblock-instr" rows="2" placeholder="@T["editor.aiInstructionPlaceholder"]"></textarea>
            <div class="ev2-ai-row"><button type="button" class="btn btn-sm" id="ev2-aiblock-go">@T["editor.aiPropose"]</button><span class="ev2-ai-status" id="ev2-aiblock-status"></span></div>
            <div class="ev2-ai-diff" id="ev2-aiblock-diff"></div>
            <div class="form-actions">
                <button type="button" class="btn btn-sm" id="ev2-aiblock-apply" disabled>@T["editor.aiApply"]</button>
                <button type="button" class="btn btn-ghost btn-sm" data-close>@T["editor.aiCancel"]</button>
            </div>
        </dialog>
        @* KI: a whole set of blocks for this page, appended to the draft. *@
        <dialog class="mat-dialog ev2-ai" id="ev2-aipage" data-url="@Url.Page("Edit", "AiGeneratePage", new { id = p.Id })">
            <h3>@T["editor.aiPageGenTitle"]</h3>
            <label for="ev2-aipage-instr">@T["editor.aiPageGenInstruction"]</label>
            <textarea id="ev2-aipage-instr" rows="3" placeholder="@T["editor.aiPageGenPlaceholder"]"></textarea>
            <div class="ev2-ai-row"><button type="button" class="btn btn-sm" id="ev2-aipage-go">@T["editor.aiPageGenPropose"]</button><span class="ev2-ai-status" id="ev2-aipage-status"></span></div>
            <ol class="ev2-ai-list" id="ev2-aipage-list"></ol>
            <div class="form-actions">
                <button type="button" class="btn btn-sm" id="ev2-aipage-apply" disabled>@T["editor.aiPageGenApply"]</button>
                <button type="button" class="btn btn-ghost btn-sm" data-close>@T["editor.aiCancel"]</button>
            </div>
        </dialog>
    }

    @if (TempData["Flash"] is string flash && !string.IsNullOrWhiteSpace(flash))
    {
        <div class="ev2-toast" role="status">@flash</div>
    }
    @if (TempData["FlashError"] is string flashError && !string.IsNullOrWhiteSpace(flashError))
    {
        <div class="ev2-toast is-error" role="alert">@flashError</div>
    }

    <script src="~/js/media-picker.js" asp-append-version="true"></script>
    <script src="~/js/mat-richselect.js" asp-append-version="true"></script>
    <script src="~/js/admin-blocks.js" asp-append-version="true"></script>
    <script src="~/js/editor-v2.js" asp-append-version="true"></script>
</body>
</html>
