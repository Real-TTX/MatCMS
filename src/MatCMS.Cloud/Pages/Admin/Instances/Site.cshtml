@page "{id:int}"
@model MatCMS.Cloud.Pages.Admin.Instances.SiteModel
@{
    ViewData["Title"] = Model.Item.Name;
    // No sidebar: the site gets the window, and this page carries its own bar.
    ViewData["NoSidebar"] = true;
    // The switcher lives in the layout now; these two tell it WHICH instance is current and that
    // the page title comes from the frame rather than from here.
    ViewData["InstanceId"] = Model.Item.Id;
    ViewData["FrameTitle"] = true;
}

@section TopbarActions {
    @* A browser's controls, because that is what this is: an address and the few things you do to
       one. Icon-only and coloured by function — five labels would not fit beside the switcher, and
       these five are the ones every browser draws without words. *@
    <div class="site-embed-actions">
        @if (!string.IsNullOrWhiteSpace(Model.Item.PreviewUrl))
        {
            @* The address. Read-only on purpose: it says where the frame was SENT, and cross-origin
               there is no way to follow where it went from there — an editable box would promise
               navigation this page cannot deliver. Hidden when the bar gets narrow; the switcher and
               the buttons do something, this only tells. *@
            <input type="text" class="site-addr" data-site-addr readonly tabindex="-1"
                   value="@Model.Item.PreviewUrl" aria-label="@T["instances.address"]" />
            <div class="site-tools">
                <button type="button" class="stool stool-home" data-site-home data-home-url="@Model.Item.PreviewUrl"
                        title="@T["instances.home"]" aria-label="@T["instances.home"]">
                    <i class="ti ti-home" aria-hidden="true"></i>
                </button>
                <button type="button" class="stool stool-reload" data-site-reload
                        title="@T["instances.reload"]" aria-label="@T["instances.reload"]">
                    <i class="ti ti-refresh" aria-hidden="true"></i>
                </button>
                <button type="button" class="stool stool-admin" data-site-admin
                        data-admin-url="@Model.AdminUrl" data-site-url="@Model.Item.PreviewUrl"
                        title="@T["instances.openAdmin"]" aria-label="@T["instances.openAdmin"]">
                    <i class="ti ti-settings" aria-hidden="true"></i>
                </button>
                <a class="stool stool-new" data-site-newtab href="@Model.Item.PreviewUrl" target="_blank" rel="noopener"
                   title="@T["instances.openSite"]" aria-label="@T["instances.openSite"]">
                    <i class="ti ti-external-link" aria-hidden="true"></i>
                </a>
            </div>
        }
        @* Set apart and red: it leaves the page, which is the one thing here that is not navigation
           WITHIN the site. Not a filled primary button though — this bar has no main action, and
           making the way out the loudest thing on it would be an odd thing to invite. *@
        <a class="stool stool-close" asp-page="Index" asp-route-profile="@Model.Item.ProfileId"
           title="@T["action.close"]" aria-label="@T["action.close"]">
            <i class="ti ti-x" aria-hidden="true"></i>
        </a>
    </div>
}

@if (string.IsNullOrWhiteSpace(Model.Item.PreviewUrl))
{
    <div class="site-embed-note">
        <div class="alert alert-info">@T["instances.previewNoUrl"]</div>
    </div>
}
else
{
    @if (Model.Item.PreviewIsGuessed)
    {
        <div class="site-embed-hint muted">
            <i class="ti ti-info-circle" aria-hidden="true"></i>
            @T["instances.previewGuessedHint"] <span class="mono">@Model.Item.PreviewUrl</span>
        </div>
    }
    @* A site may refuse to be framed (X-Frame-Options / frame-ancestors). Cross-origin there is no
       honest way to detect that, so instead of pretending to, the bar simply always offers the tab —
       and this line says what an empty frame means. *@
    <div class="site-embed">
        @if (MatCMS.Cloud.Services.MixedContent.IsBlocked(Model.Request.IsHttps, Model.Item.PreviewUrl))
        {
            @* No frame at all: this one is not "the site might refuse", it is certain. Rendering it
               anyway would put the general "could not be embedded" note under a blank rectangle and
               send the operator looking for a fault in their site. *@
            <div class="site-embed-fallback muted">
                @T["instances.previewInsecure"]
                <a href="@Model.Item.PreviewUrl" target="_blank" rel="noopener">@T["instances.openSite"]</a>
            </div>
        }
        else
        {
            <iframe class="site-embed-frame" data-site-frame src="@Model.Item.PreviewUrl" title="@Model.Item.Name"
                    referrerpolicy="no-referrer" sandbox="allow-same-origin allow-scripts allow-forms allow-popups"></iframe>
            <div class="site-embed-fallback muted">
                @T["instances.embedBlocked"]
                <a href="@Model.Item.PreviewUrl" target="_blank" rel="noopener">@T["instances.openSite"]</a>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        (function () {
            var frame = document.querySelector('[data-site-frame]');
            var reload = document.querySelector('[data-site-reload]');
            // Re-assigning src rather than calling contentWindow.location.reload(): the frame is
            // cross-origin, so reaching into it throws.
            if (frame && reload) reload.addEventListener('click', function () { frame.src = frame.src; });

            // Admin ⇄ Website in the same frame.
            var addr = document.querySelector('[data-site-addr]');
            var newTab = document.querySelector('[data-site-newtab]');
            // One place that changes what the frame shows, so the address, the tab link and the
            // admin button can never describe three different pages.
            function go(url, isAdmin) {
                frame.src = url;
                if (addr) addr.value = url;
                if (newTab) newTab.href = url;
                var b = document.querySelector('[data-site-admin]');
                if (b) b.classList.toggle('is-active', !!isAdmin);
                if (crumb) { crumb.hidden = true; crumb.textContent = ''; }
            }
            var homeBtn = document.querySelector('[data-site-home]');
            if (frame && homeBtn) homeBtn.addEventListener('click', function () {
                go(homeBtn.getAttribute('data-home-url'), false);
            });

            var adminBtn = document.querySelector('[data-site-admin]');
            if (frame && adminBtn) {
                var onAdmin = false;
                adminBtn.addEventListener('click', function () {
                    onAdmin = !onAdmin;
                    go(adminBtn.getAttribute(onAdmin ? 'data-admin-url' : 'data-site-url'), onAdmin);
                });
            }

            // The framed admin hides its own bar and posts its page title here instead.
            var crumb = document.querySelector('[data-frame-title]');
            var expectedOrigin = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SiteOrigin ?? ""));
            window.addEventListener('message', function (e) {
                var d = e.data || {};
                if (d.type !== 'mat-admin-title' && d.type !== 'mat-frame-url') return;
                // Only from the instance this page is showing. Checked by ORIGIN, which is what
                // postMessage is designed to be checked by — comparing window objects across a
                // sandboxed, cross-origin frame is the kind of test that fails silently and takes
                // every message with it.
                if (e.origin !== expectedOrigin) return;
                // The address the frame actually ARRIVED at. Cross-origin this page cannot look it
                // up — but the instance is the same software, so every page in there says where it
                // is. That is also the limit: follow a link to a foreign site and nothing is sent,
                // so the bar keeps showing the last page that did.
                if (typeof d.url === 'string' && d.url) {
                    if (addr) addr.value = d.url;
                    if (newTab) newTab.href = d.url;
                    var ab = document.querySelector('[data-site-admin]');
                    // The admin button reflects where the frame IS, not what was last clicked —
                    // clicking into the admin from inside the site would otherwise leave it unlit.
                    if (ab) ab.classList.toggle('is-active', d.url.indexOf('/Admin') >= 0);
                }
                if (!crumb) return;
                var txt = String(d.title || '').slice(0, 80);
                crumb.textContent = txt;
                crumb.hidden = txt.length === 0;
            });
        })();
    </script>
}
