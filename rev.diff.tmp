+        // A settings group shows its fields only while its checkbox is ticked. Server-rendered from
+        // the stored flag, so it is already right before this runs.
+        (function () {
+            document.querySelectorAll("[data-group-toggle]").forEach(function (box) {
+                var body = document.querySelector("[data-group=\"" + box.dataset.groupToggle + "\"]");
+                if (!body) return;
+                box.addEventListener("change", function () { body.hidden = !box.checked; });
+            });
+        })();
