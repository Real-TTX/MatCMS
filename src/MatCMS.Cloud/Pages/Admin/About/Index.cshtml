@page
@model MatCMS.Cloud.Pages.Admin.About.IndexModel
@{
    ViewData["Title"] = T["about.title"];
}
<div class="page-head">
    <h1>@T["about.title"]</h1>
    <div class="list-toolbar">
        <a class="btn btn-sm" asp-page="Index" asp-route-check="true">@T["about.checkUpdates"]</a>
    </div>
</div>

@* The cloud's own version + self-update: the same card the Hosting page shows. *@
<partial name="_CloudUpdateCard" model="Model.Card" />

<div class="card">
    <h2>@T["about.instanceImage"]</h2>
    <p class="muted">@T["about.instanceImageHint"]</p>
    <div class="kv">
        <div class="kv-label">@T["about.image"]</div>
        <div class="kv-value mono">@Model.InstanceImageRef</div>
    </div>
    <div class="kv">
        <div class="kv-label">@T["dashboard.latestRelease"]</div>
        <div class="kv-value mono">@(Model.InstanceLatest ?? T["common.unknown"])</div>
    </div>
    <div class="kv">
        <div class="kv-label">@T["dashboard.lastCheck"]</div>
        <div class="kv-value muted">
            @(Model.InstanceChecked is null ? T["common.never"] : Model.InstanceChecked.Value.ToString("dd.MM.yyyy HH:mm") + " UTC")
        </div>
    </div>
</div>

<div class="card">
    <h2>@T["settings.docker"]</h2>
    <div class="kv">
        <div class="kv-label">@T["common.status"]</div>
        <div class="kv-value">
            @if (!Model.DockerConfigured)
            {
                <span class="badge badge-off">@T["settings.dockerOff"]</span>
            }
            else if (Model.DockerReachable)
            {
                <span class="badge badge-on">@T["settings.dockerOk"]</span>
            }
            else
            {
                <span class="badge badge-err">@T["settings.dockerUnreachable"]</span>
            }
        </div>
    </div>
</div>
