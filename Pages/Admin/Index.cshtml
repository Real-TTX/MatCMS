@page
@model MatCMS.Pages.Admin.IndexModel
@{
    ViewData["Title"] = T["dashboard.title"];
    var dashUser = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Admin";
}
<div class="page-head">
    <h1>@T["dashboard.title"]</h1>
    <div class="dash-actions" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <span class="muted">Willkommen, <strong>@dashUser</strong></span>
        <a class="btn btn-sm" href="/" target="_blank" rel="noopener"><i class="ti ti-external-link" aria-hidden="true"></i> Website aufrufen</a>
        <form method="post" asp-page="/Logout" class="inline-form" style="margin:0;">
            <button type="submit" class="btn btn-sm btn-ghost"><i class="ti ti-logout" aria-hidden="true"></i> Ausloggen</button>
        </form>
    </div>
</div>

@if (!Model.SetupComplete)
{
    <div class="alert alert-info setup-banner">
        <div>
            <strong>Willkommen!</strong> Richten Sie Admin-Konto, Theme, E-Mail und erste Seite in wenigen Schritten ein.
        </div>
        <a class="btn btn-sm" asp-page="/Admin/Setup/Index">Einrichtung starten</a>
    </div>
}

<div class="stat-grid">
    <a class="stat" asp-page="/Admin/Pages/Index">
        <div class="n">@Model.PageCount</div>
        <div class="l">@T["dashboard.pages"]</div>
    </a>
    <a class="stat" asp-page="/Admin/Forms/Index">
        <div class="n">@Model.UnreadCount</div>
        <div class="l">@T["dashboard.newSubmissions"]</div>
    </a>
    <a class="stat" asp-page="/Admin/Forms/Index">
        <div class="n">@Model.SubmissionCount</div>
        <div class="l">@T["dashboard.totalSubmissions"]</div>
    </a>
    <a class="stat" asp-page="/Admin/Users/Index">
        <div class="n">@Model.UserCount</div>
        <div class="l">@T["dashboard.users"]</div>
    </a>
</div>

<div class="card">
    <h2>@T["dashboard.quickstart"]</h2>
    <p class="muted">
        @Html.Raw(T["dashboard.quickstartText"])
    </p>
</div>
