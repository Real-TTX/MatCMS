@page
@model MatCMS.Cloud.Pages.Admin.Hosting.InstancesModel
@using MatCMS.Cloud.Services
@{
    ViewData["Title"] = T["hosting.title"];
}
<div data-list>
    <partial name="_HostingTabs" model='"instances"' />
    <div class="page-head">
        <h1>@T["hosting.title"]</h1>
        <div class="list-toolbar">
            <input type="search" class="list-search" data-list-search placeholder="@T["action.search"]" aria-label="@T["action.search"]" autocomplete="off" />
            <select class="list-search" data-list-filter aria-label="@T["common.status"]">
                <option value="">@T["hostdash.filterAll"]</option>
                <option value="running">@T["hostdash.filterRunning"]</option>
                <option value="stopped">@T["hostdash.filterStopped"]</option>
                <option value="update">@T["hostdash.filterUpdate"]</option>
            </select>
        </div>
    </div>

    <partial name="_HostSites" model="(Model.Data.Sites, true)" />
    <div class="list-empty" data-list-empty hidden>@T["list.noResults"]</div>
</div>

@if (Model.ModuleEnabled)
{
    <div class="list-actions">
        <a class="btn" asp-page="/Admin/Instances/New">@T["hosting.newInstance"]</a>
    </div>
}
