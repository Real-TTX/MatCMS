@page "{id:int}"
@model MatCMS.Pages.Admin.Plugins.BuiltInModel
@{
    ViewData["Title"] = Model.Current.Name;
    var p = Model.Current;
}
<div class="page-head">
    <h1>
        @p.Name
        <span class="badge badge-new">@T["plugins.kind.builtin"]</span>
        @if (!string.IsNullOrWhiteSpace(p.Version)) { <span class="badge">v@(p.Version)</span> }
        @if (Model.Loaded) { <span class="badge badge-on">@T["plugins.native.running"]</span> }
        else if (p.Enabled && Model.RunError is not null) { <span class="badge badge-err">@T["plugins.error"]</span> }
        else { <span class="badge badge-off">@T["plugins.disabled"]</span> }
    </h1>
    @if (!string.IsNullOrWhiteSpace(p.Description)) { <p class="muted">@p.Description</p> }
</div>

@if (!string.IsNullOrWhiteSpace(Model.RunError))
{
    <div class="alert alert-error"><strong>@T["plugins.runError"]:</strong> <span class="mono">@Model.RunError</span></div>
}

<div class="card">
    <p class="help">@T["plugins.builtin.help"]</p>
    <div class="kv"><span class="kv-label">@T["plugins.native.key"]</span><span class="kv-value mono">@p.Key</span></div>
    <form method="post" asp-page-handler="Toggle" asp-route-id="@p.Id" class="form-actions">
        <button type="submit" class="btn @(p.Enabled ? "btn-ghost" : "")" data-confirm="@(p.Enabled ? T["plugins.builtin.confirmOff"].ToString() : null)">
            @(p.Enabled ? T["plugins.disable"] : T["plugins.enable"])
        </button>
        @if (Model.HasSettings)
        {
            <a class="btn btn-ghost" href="/admin/p/@p.Key/_settings"><i class="ti ti-adjustments" aria-hidden="true"></i> @T["plugins.settings.tab"]</a>
        }
        <a class="btn btn-ghost" asp-page="Index">@T["action.back"]</a>
    </form>
</div>

<partial name="_PluginOverview" model="@p.Key" />

@if (Model.Tables.Count > 0)
{
    <div class="card">
        <h3 class="form-section">@T["plugins.builtin.data"]</h3>
        <p class="help">@T["plugins.builtin.dataHelp"]</p>
        <table class="data">
            <thead><tr><th>@T["plugins.builtin.table"]</th><th style="width:110px;text-align:right;">@T["plugins.builtin.rows"]</th></tr></thead>
            <tbody>
                @foreach (var t in Model.Tables)
                {
                    <tr><td class="mono">@t.Physical</td><td style="text-align:right;">@t.Rows</td></tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="card">
    <h3 class="form-section">@T["plugins.log"]</h3>
    @if (Model.Log.Count == 0)
    {
        <p class="muted">@T["plugins.native.logEmpty"]</p>
    }
    else
    {
        <pre class="code-block" style="max-height:260px;overflow:auto;">@string.Join("\n", Model.Log)</pre>
    }
</div>
