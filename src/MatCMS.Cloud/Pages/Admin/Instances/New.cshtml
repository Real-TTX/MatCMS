@page
@model MatCMS.Cloud.Pages.Admin.Instances.NewModel
@{
    ViewData["Title"] = T["instances.new"];
}
@* Heading only: the way back sits next to the create button at the bottom, as in the CMS. *@
<div class="page-head">
    <h1>@T["instances.new"]</h1>
</div>

<form method="post">
    <div class="card">
        <div class="form-field">
            <label for="name">@T["common.name"]</label>
            <input id="name" name="name" required placeholder="Kundenseite" />
            <div class="help">@T["instances.newNameHint"]</div>
        </div>

        @* Das Profil ist nicht Beiwerk: sein Join-Code ist der Weg, auf dem sich die neue Instanz
           anmeldet, und sein Inhalt ist das, womit sie startet. *@
        <div class="form-field">
            <label for="profileId">@T["profiles.title"]</label>
            <select id="profileId" name="profileId" required>
                @foreach (var p in Model.Profiles)
                {
                    <option value="@p.Id" selected="@(p.IsDefault ? "selected" : null)">@p.Name</option>
                }
            </select>
            <div class="help">@T["instances.newProfileHint"]</div>
        </div>

        @if (Model.Nodes.Count > 0)
        {
            @* Nur wenn es überhaupt Nodes gibt — sonst ist "Dieser Host" die einzige Antwort und die Frage
               überflüssig. *@
            <div class="form-field">
                <label for="nodeId">@T["nodes.where"]</label>
                <select id="nodeId" name="nodeId">
                    <option value="" disabled="@(Model.NextPort is null ? "disabled" : null)">@T["nodes.thisHost"]@(Model.NextPort is null ? " — " + T["settings.hostingNoPort"] : "")</option>
                    @foreach (var n in Model.Nodes)
                    {
                        var on = n.IsOnline(DateTime.UtcNow);
                        <option value="@n.Id" disabled="@(on ? null : "disabled")" selected="@(Model.NextPort is null && on ? "selected" : null)">@n.Name@(on ? "" : " — " + T["nodes.offline"])</option>
                    }
                </select>
                <div class="help">@T["nodes.whereHint"]</div>
            </div>
        }

        <div class="form-field">
            <label for="imageTag">@T["instances.newVersion"]</label>
            <input id="imageTag" name="imageTag" value="latest" spellcheck="false" />
            <div class="help">
                @T["instances.newVersionHint"]
                @if (Model.LatestVersion is string v)
                {
                    <span class="mono">@v</span>
                }
            </div>
        </div>

        <div class="form-field">
            <label for="domain">@T["instances.newDomain"]</label>
            @* Optional in every mode: without it the site is reachable on its host port. *@
            <input id="domain" name="domain" placeholder="kunde.beispiel.de" spellcheck="false" />
            <div class="help">@(Model.ProxyRoutes ? T["instances.newDomainMatcad"] : T["instances.newDomainPlain"])</div>
        </div>

        <div class="kv">
            <div class="kv-label">@T["settings.hostingNextPort"]@(Model.Nodes.Count > 0 ? " (" + T["nodes.thisHost"] + ")" : "")</div>
            <div class="kv-value">
                @if (Model.NextPort is int np)
                {
                    <span class="mono">@np</span>
                }
                else
                {
                    <span class="badge badge-err">@T["settings.hostingNoPort"]</span>
                }
            </div>
        </div>
    </div>

    @* .form-actions, not .list-actions: this row belongs to a form, not to a list — same class the
       CMS uses for the same thing. *@
    <div class="form-actions">
        <button type="submit" class="btn" disabled="@(Model.CanCreate ? null : "disabled")">@T["instances.newCreate"]</button>
        <a class="btn btn-ghost" asp-page="/Admin/Hosting/Index">@T["action.back"]</a>
    </div>
</form>
