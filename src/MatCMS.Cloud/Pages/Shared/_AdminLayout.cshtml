@inject MatCMS.Cloud.Services.CloudContext Cloud
@inject MatCMS.Cloud.Services.VersionService Version
@inject MatCMS.Cloud.Services.ContextSwitcher Switcher
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Builder.RequestLocalizationOptions> LocOptions
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject MatCMS.Cloud.Services.AuthService Auth
@{
    // The signed-in user's colour scheme for <html data-theme> (light by default, see admin.css).
    var theme = await Auth.ThemeAsync(User);
}
@{
    var title = ViewData["Title"] as string ?? "Admin";
    // An item of MatUi's menu is current with is-active (+ aria-current, written by Item below).
    string Active(string path) =>
        Context.Request.Path.StartsWithSegments(path, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
    // "Neue Instanz" is reached from Hosting and belongs to it; the rest of /admin/instances is "Instanzen".
    string ActiveInstances() =>
        ActiveExact("/admin/instances/new") != "" ? "" : Active("/admin/instances") + Active("/admin/cleanup");
    string ActiveHosting() => Active("/admin/hosting") + ActiveExact("/admin/instances/new");
    string ActiveExact(params string[] paths) =>
        paths.Any(p => string.Equals(Context.Request.Path.Value?.TrimEnd('/'), p, StringComparison.OrdinalIgnoreCase)) ? "is-active" : "";
    var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Admin";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    // Only offer cultures that actually have a translation file (Resources/<lang>.json).
    var allUiCultures = LocOptions.Value.SupportedUICultures ?? new System.Collections.Generic.List<System.Globalization.CultureInfo>();
    string _uiLang(System.Globalization.CultureInfo c) => c.Name.Split('-', 2)[0];
    var cultures = allUiCultures.Where(c => System.IO.File.Exists(
        System.IO.Path.Combine(Env.ContentRootPath, "Resources", _uiLang(c) + ".json"))).ToList();
    // Use Name (not TwoLetterISOLanguageName): under InvariantGlobalization the latter collapses to "iv".
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name.Split('-', 2)[0];
    if (string.IsNullOrEmpty(currentCulture)) currentCulture = MatCMS.Cloud.Services.Localizer.FallbackCulture;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var bare = ViewData["NoSidebar"] is true;
}
<!DOCTYPE html>
@* The same MatUi shell as the CMS's back office (MatCMS.Shared.Web: lib/matui/matui.css, css/admin-matui.css,
   js/admin-shell.js) — the two admins look and work alike. The cloud keeps its instance switcher in the bar. *@
<html lang="@currentCulture" data-app="matcms" data-theme="@theme" data-density="compact" data-dlg-ok="@T["dialog.ok"]" data-dlg-cancel="@T["action.cancel"]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@title – @Cloud.CloudName</title>
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/lib/tabler-icons/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/lib/matui/matui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cloud.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/MatCMS.Shared.Web/css/admin-matui.css" asp-append-version="true" />
    @MatCMS.Shared.Web.Pwa.Head(theme, MatCMS.Shared.Web.Pwa.ShortName(Cloud.CloudName), "cloud")
    <link rel="icon" href="@Cloud.FaviconUrl" />
    @* Own confirm/alert/prompt dialogs — loaded early, inline page scripts call MatDialog. *@
    <script src="~/_content/MatCMS.Shared.Web/js/mat-dialogs.js" asp-append-version="true"></script>
</head>
<body class="admin admin--matui">
    @{
        // What you are looking at — the cloud itself or one of its sites. ViewData["InstanceId"] names the instance
        // being viewed; absent means the cloud. The Cloud|Website|Admin switch in the bar goes to that instance through
        // its SSO (same tab, auto-approved), so the operator lands signed in.
        var currentInstanceId = ViewData["InstanceId"] as int?;
        var vsInstance = currentInstanceId is int vsid
            ? (await Switcher.InstancesAsync()).FirstOrDefault(i => i.Id == vsid) : null;
        var vsUrl = vsInstance?.PreviewUrl?.Trim().TrimEnd('/');
    }
    @* A page may drop the menu (admin-bare): it then has the bar alone. *@
    <div class="mat-app@(bare ? " admin-bare" : "")" data-admin-app>
    @if (!bare)
    {
        <aside class="mat-nav" id="mat-nav">
            <div class="mat-nav__brand">
                <a asp-page="/Admin/Index" title="@Cloud.CloudName">
                    <img class="admin-logo logo-light" src="@Cloud.LogoUrl" alt="@Cloud.CloudName" />
                    <img class="admin-logo logo-dark" src="/img/logo-dark.svg" alt="@Cloud.CloudName" />
                </a>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-nav__close" data-admin-close aria-label="@T["nav.menu"]"><i class="ti ti-x" aria-hidden="true"></i></button>
            </div>
            @* The context switcher (MatUi's menu switcher, SHELL-15) under the logo, on every page: the cloud or one
               of its sites, with a picture of each — the same question everywhere, answered in the same place. *@
            <partial name="_ContextPicker" model="currentInstanceId" />
            @{ var isAdmin = User.IsInRole("Admin"); }
            <nav class="mat-nav__scroll admin-nav" aria-label="@T["nav.menu"]">
                <ul class="mat-nav__list">
                    @* Hosting is ONE item and the first: everything about hosts, containers, images and domains is in its
                       tabs. It is Admin-only (fleet-wide); an Operator only manages its own instances. The fleet areas below
                       are hidden AND server-side blocked (AuthorizeFolder "Admin" in Program.cs). *@
                    @if (isAdmin)
                    {
                        <li class="mat-nav__group" role="presentation">@T["nav.groupOperations"]</li>
                        @Item(ActiveHosting(), "/Admin/Hosting/Index", "ti-server-2", T["hosting.title"])
                    }
                    @Item(ActiveInstances(), "/Admin/Instances/Index", "ti-device-desktop", T["nav.instances"])
                    @Item(Active("/admin/stats"), "/Admin/Stats/Index", "ti-chart-bar", T["stats.title"])
                    @if (isAdmin)
                    {
                        @Item(Active("/admin/profiles"), "/Admin/Profiles/Index", "ti-adjustments", T["nav.profiles"])
                        @Item(Active("/admin/store"), "/Admin/Store/Index", "ti-package", T["nav.store"])
                        @Item(Active("/admin/mail"), "/Admin/Mail/Index", "ti-mail", T["spool.title"])
                        @Item(Active("/admin/backups"), "/Admin/Backups/Index", "ti-device-floppy", T["backups.title"])
                        <li class="mat-nav__group" role="presentation">@T["nav.groupSystem"]</li>
                        @Item(Active("/admin/settings") + Active("/admin/apikeys") + Active("/admin/oauthclients"), "/Admin/Settings/Index", "ti-settings", T["nav.settings"])
                        @Item(Active("/admin/notifications"), "/Admin/Notifications/Index", "ti-bell", T["notify.title"])
                        @Item(Active("/admin/users"), "/Admin/Users/Index", "ti-users", T["nav.users"])
                        @Item(Active("/admin/logs"), "/Admin/Logs/Index", "ti-list-details", T["nav.logs"])
                    }
                </ul>
            </nav>
            <div class="mat-nav__foot">
                <div class="mat-nav__account">
                    <button type="button" class="mat-user" data-admin-menu="admin-user-menu" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-avatar" aria-hidden="true">@initials</span>
                        <span class="mat-user__text">
                            <span class="mat-user__name">@displayName</span>
                            <span class="mat-user__role">@role</span>
                        </span>
                        <i class="ti ti-chevron-up mat-user__chev" aria-hidden="true"></i>
                    </button>
                    @* The 3-state theme button (SHELL-04): system → light → dark, kept on the user (Account?handler=Theme). *@
                    <button type="button" class="mat-theme" data-admin-theme data-theme-state="@theme"
                            data-save="@Url.Page("/Admin/Account/Index", "Theme")"
                            data-names="@T["account.themeSystem"]|@T["account.themeLight"]|@T["account.themeDark"]"
                            title="@T["account.theme"]" aria-label="@T["account.theme"]">
                        <i class="ti ti-device-desktop" data-theme-icon="system" aria-hidden="true"></i>
                        <i class="ti ti-sun" data-theme-icon="light" aria-hidden="true"></i>
                        <i class="ti ti-moon" data-theme-icon="dark" aria-hidden="true"></i>
                    </button>
                </div>
                <a class="mat-nav__version" asp-page="/Admin/About/Index" title="@T["about.title"]">MatCMS.Cloud v@(Version.Current)</a>
            </div>
        </aside>
        <div class="mat-backdrop" data-admin-close></div>
    }

        <div class="mat-main">
            <header class="mat-topbar">
                @if (!bare)
                {
                    <button type="button" class="mat-burger" data-admin-toggle aria-label="@T["nav.menu"]" aria-controls="mat-nav" aria-expanded="false"><i class="ti ti-menu-2" aria-hidden="true"></i></button>
                }
                @* MatUi's breadcrumb: the cloud, the site being viewed (if any), the page. On a site's own page
                   (NoTopbarTitle) the site's name IS the title. *@
                <nav class="mat-crumbs" aria-label="Breadcrumb">
                    <ol>
                        <li class="mat-hide-sm"><a asp-page="/Admin/Index">@Cloud.CloudName</a></li>
                        @if (vsInstance is not null)
                        {
                            if (ViewData["NoTopbarTitle"] is true)
                            {
                                <li aria-current="page">@vsInstance.Name</li>
                            }
                            else
                            {
                                <li><a asp-page="/Admin/Instances/Details" asp-route-id="@vsInstance.Id">@vsInstance.Name</a></li>
                                <li aria-current="page">@title</li>
                            }
                        }
                        else
                        {
                            <li aria-current="page">@title</li>
                        }
                    </ol>
                </nav>
                <div class="mat-topbar__actions">
                    @* The bar's own actions first: the Cloud|Website|Admin switch is always the LAST thing, so it stands on
                       the same pixels here, on the site's bar and in the site's back office. *@
                    @await RenderSectionAsync("TopbarActions", required: false)
                    @if (bare)
                    {
                        @* No menu, so no user at its foot: account and sign-out stay in the bar. *@
                        <a class="mat-btn mat-btn--ghost mat-btn--icon" asp-page="/Admin/Account/Index" title="@T["nav.account"]" aria-label="@T["nav.account"]"><i class="ti ti-user-circle" aria-hidden="true"></i></a>
                        <form method="post" asp-page="/Logout" class="mat-menu__form">
                            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon" title="@T["nav.logout"]" aria-label="@T["nav.logout"]"><i class="ti ti-logout-2" aria-hidden="true"></i></button>
                        </form>
                    }
                    @* The switch appears only when an instance is the context (somewhere to switch TO); "Cloud" is the active
                       segment here. Web/Admin go through the instance's SSO (auto-approved). Account and sign-out are in the
                       user menu at the foot of the menu (SHELL-03). *@
                    @if (!string.IsNullOrEmpty(vsUrl))
                    {
                        <partial name="_ViewSwitch" model="@(new MatCMS.Shared.Web.ViewSwitch(
                            Active: "cloud", CloudUrl: null,
                            WebUrl: $"{vsUrl}/sso/start?returnUrl=/&via=cloud",
                            AdminUrl: $"{vsUrl}/sso/start?returnUrl=/admin&via=cloud",
                            CloudLabel: T["instances.viewCloud"], WebLabel: T["instances.viewWebsite"], AdminLabel: T["instances.viewAdmin"]))" />
                    }
                </div>
            </header>

            <main class="mat-page mat-page--wide admin-content" id="main">
                @if (TempData["Flash"] is string flash && !string.IsNullOrWhiteSpace(flash))
                {
                    <div class="alert alert-success">@flash</div>
                }
                @if (TempData["FlashError"] is string flashError && !string.IsNullOrWhiteSpace(flashError))
                {
                    <div class="alert alert-error">@flashError</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    @* The user's context menu (SHELL-03): account, the admin language, sign out last. *@
    <div class="mat-menu" id="admin-user-menu" role="menu" aria-label="@displayName" hidden>
        <div class="mat-menu__head">
            <span class="mat-avatar" aria-hidden="true">@initials</span>
            <div><strong>@displayName</strong><small>@role</small></div>
        </div>
        <a class="mat-menu__item" role="menuitem" asp-page="/Admin/Account/Index"><i class="ti ti-user-circle" aria-hidden="true"></i><span>@T["nav.account"]</span></a>
        @if (cultures.Count > 1)
        {
            <div class="mat-menu__sep" role="separator"></div>
            @foreach (var c in cultures)
            {
                var lc = _uiLang(c);
                <form method="post" action="/set-language" class="mat-menu__form">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="hidden" name="culture" value="@lc" />
                    <button type="submit" class="mat-menu__item" role="menuitemradio" aria-checked="@(lc == currentCulture ? "true" : "false")"><i class="ti @(lc == currentCulture ? "ti-check" : "ti-language")" aria-hidden="true"></i><span>@MatCMS.Cloud.Services.Localizer.DisplayName(lc)</span></button>
                </form>
            }
        }
        <div class="mat-menu__sep" role="separator"></div>
        <form method="post" asp-page="/Logout" class="mat-menu__form">
            <button type="submit" class="mat-menu__item mat-menu__item--danger" role="menuitem"><i class="ti ti-logout" aria-hidden="true"></i><span>@T["nav.logout"]</span></button>
        </form>
    </div>
    @Html.AntiForgeryToken()

    <script src="~/_content/MatCMS.Shared.Web/js/admin-shell.js" asp-append-version="true"></script>
    <script src="~/_content/MatCMS.Shared.Web/js/admin-list.js" asp-append-version="true"></script>
    @* Belongs to the switcher in the bar above, so it loads wherever that bar does. *@
    <script src="~/js/context-picker.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@functions {
    // One item of the menu: MatUi's markup (SHELL-02), Tabler icon in front, current one marked.
    private Microsoft.AspNetCore.Html.IHtmlContent Item(string active, string page, string icon, string label)
    {
        var on = active.Contains("is-active");
        var href = Url.Page(page);
        var html = $"<li><a class=\"mat-nav__item{(on ? " is-active" : "")}\" href=\"{href}\"{(on ? " aria-current=\"page\"" : "")}>"
                 + $"<i class=\"ti {icon}\" aria-hidden=\"true\"></i><span>{System.Net.WebUtility.HtmlEncode(label)}</span></a></li>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}
