<Project Sdk="Microsoft.NET.Sdk">

  <!-- The blog as a NATIVE plugin of the MatCMS Store (it shipped with the CMS until 2026-11, docs/builtin-extraction.md). It ADOPTS the
       core table Posts, which only a plugin signed by the store may do — so it runs (and needs no "Native Plugins erlauben") as the
       code-signed package only. Same settings as Forum and Booking so it stays loadable and unloadable (docs/plugin-system-v2.md, section 7). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>MatCMS.Plugin.Blog</RootNamespace>
    <AssemblyName>Blog</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MatCMS.Plugin.Abstractions\MatCMS.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The texts travel inside the assembly (read at load). WithCulture="false": "blog.de.json" would otherwise be taken for a German
         satellite resource and leave the DLL. -->
    <EmbeddedResource Include="Strings\*.json" WithCulture="false" />
    <!-- assets/ is the plugin's static files (pack-native.ps1 puts them into the bundle's assets/), not part of the build. -->
    <None Remove="assets\**" />
  </ItemGroup>

</Project>
