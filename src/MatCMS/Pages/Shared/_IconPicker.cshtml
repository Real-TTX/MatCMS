@model MatCMS.Pages.Shared.IconPickVm
@*
    Nur noch der Adapter. Die Auswahl selbst — Knopf, Dialog, Suche, Raster — steht EINMAL in
    MatCMS.Shared.Web/Pages/Shared/_IconField.cshtml und wird von der Cloud genauso benutzt. Hier
    bleiben die zwei Dinge, die eine geteilte Ansicht nicht kann: die Übersetzungen (sie kennt keinen
    der beiden Localizer) und die alten Icon-Namen (MenuIcons.Resolve gibt es nur im CMS).

    Der Name der Datei bleibt _IconPicker, damit die Seiten, die sie einbinden, sie weiter finden.
*@
@{
    // Alte, kuratierte Namen ("whatsapp", "globe") auf ihren Tabler-Namen bringen — sonst stünde auf
    // dem Knopf ein leeres Kästchen für ein Symbol, das es sehr wohl gibt.
    var current = MatCMS.Content.MenuIcons.Resolve(Model.Value);
    var field = new MatCMS.Shared.Web.IconField(
        Value: current,
        FieldName: Model.FieldName,
        Label: T[Model.LabelKey],
        Labels: new MatCMS.Shared.Web.IconFieldLabels(
            Pick: T["icons.pick"],
            DialogTitle: T["icons.dialogTitle"],
            Search: T["icons.search"],
            None: T["icons.none"],
            NoResults: T["icons.noResults"],
            Apply: T["icons.apply"],
            Cancel: T["action.cancel"],
            Unknown: T["icons.unknown"],
            Empty: T["icons.empty"],
            Count: T["icons.count"]),
        Help: string.IsNullOrEmpty(Model.HelpKey) ? "" : T[Model.HelpKey],
        WhenSelectId: Model.MenuOnly ? "Menu" : "",
        WhenSelectValue: "toolbar");
}
<partial name="_IconField" model="field" />
