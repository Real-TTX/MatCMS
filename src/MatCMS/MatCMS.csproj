<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MatCMS</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Invariant globalization keeps the image small & formatting stable, but we still want to
         create named CultureInfo objects (de, and future languages) for RequestLocalization. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <!-- Default assembly version. InformationalVersion is supplied at build time
         via -p:InformationalVersion=<APP_VERSION> (see Dockerfile / GitHub Actions). -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Localization resource files (Resources/<culture>.json) must ship to output & publish.
         Use Update (not Include): the Web SDK already globs JSON as Content by default. -->
    <Content Update="Resources\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Floating 10.0.* so restores/rebuilds always pick up the latest patch ("immer aktuell"). -->
    <!-- Design-time only (PrivateAssets), for `dotnet ef migrations add`. Ships nothing at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.*" />
    <!-- Roslyn C# scripting: runs admin-authored plugin code at runtime. Held at 5.0.*, the Roslyn
         that ships with .NET 10: EntityFrameworkCore.Design pulls CodeAnalysis 5.0.0, and mixing it
         with a 4.x scripting package is a hard NU1107 version conflict. Roslyn assemblies must move
         together. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.*" />
    <!-- MailKit: proper SMTP (implicit SSL port 465 AND STARTTLS port 587). The built-in
         System.Net.Mail.SmtpClient can't do implicit SSL, which breaks IONOS/others on 465. -->
    <PackageReference Include="MailKit" Version="4.*" />
    <!-- Override the transitive (vulnerable) SQLitePCLRaw 2.1.11 with the current 3.0.x bundle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MatCMS.Shared\MatCMS.Shared.csproj" />
    <ProjectReference Include="..\MatCMS.Shared.Web\MatCMS.Shared.Web.csproj" />
  </ItemGroup>

</Project>
